/-! ## Tor interfaces used in the proof -/

def TorOneVanishing {R : Type u} [CommRing R]
    (M N : ModuleCat.{u} R) : Prop :=
  IsZero (Formalization.Books.Algebra.Unit75.Tor M N 1)

noncomputable abbrev restrictedTargetModule
    {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) :
    ModuleCat.{u} R :=
  (ModuleCat.restrictScalars φ).obj (ModuleCat.of S S)

noncomputable abbrev principalIdealModule
    {R : Type u} [CommRing R] (f : R) (n : ℕ) : ModuleCat.{u} R :=
  ModuleCat.of R (Ideal.span ({f ^ n} : Set R))

noncomputable def localizedModuleMap
    {R : Type u} [CommRing R]
    (f : R) (N : ModuleCat.{u} R) :
    N ⟶ ModuleCat.of R (LocalizedModule (Submonoid.powers f) (N : Type u)) :=
  ModuleCat.ofHom (LocalizedModule.mkLinearMap (Submonoid.powers f) (N : Type u))

def TorOneVanishingOnPrincipalIdeal
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (n : ℕ) : Prop :=
  TorOneVanishing (restrictedTargetModule φ) (principalIdealModule f n)

theorem tor_one_vanishes_on_principal_ideal
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hpair : IsGlueingPair φ f) (n : ℕ) (hn : 0 < n) :
    TorOneVanishingOnPrincipalIdeal φ f n := by
  sorry

noncomputable abbrev torsionFreeQuotientModule
    {R : Type u} [CommRing R] (f : R) : ModuleCat.{u} R :=
  ModuleCat.of R (R ⧸ fPowerTorsionSubmodule (R := R) (M := R) f)

theorem tor_one_vanishes_on_torsion_free_quotient
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hpair : IsGlueingPair φ f) :
    TorOneVanishing (restrictedTargetModule φ) (torsionFreeQuotientModule f) := by
  sorry

theorem tor_one_vanishes_on_localization_cokernel
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hpair : IsGlueingPair φ f)
    (M : ModuleCat.{u} R) :
    TorOneVanishing (restrictedTargetModule φ)
      (cokernel (localizedModuleMap f M : M ⟶
        ModuleCat.of R (LocalizedModule (Submonoid.powers f) (M : Type u)))) := by
  sorry

def TorOneVanishingOnAllLocalizationCokernels {R S : Type u}
    [CommRing R] [CommRing S] (φ : R →+* S) (f : R) : Prop :=
  ∀ M : ModuleCat.{u} R,
    TorOneVanishing (restrictedTargetModule φ)
      (cokernel (localizedModuleMap f M : M ⟶
        ModuleCat.of R (LocalizedModule (Submonoid.powers f) (M : Type u))))

theorem tor_one_vanishes_on_all_localization_cokernels
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hpair : IsGlueingPair φ f) :
    TorOneVanishingOnAllLocalizationCokernels φ f := by
  sorry

/-! ## Glueing data and the Beauville--Laszlo equivalence -/

/- `blGlueingCategory` is the source's category `Glue(R → R', f)`: its
objects are an `S`-module, an `R_f`-module, and the canonical overlap
isomorphism.  The implementation is Mathlib's `IsoComma` module category,
already used by Chapters 5 and 90. -/

abbrev GlueingDataCategory {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) :=
  blGlueingCategory φ f

noncomputable abbrev Can {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) :
    ModuleCat.{u} R ⥤ GlueingDataCategory φ f :=
  blCanFunctor φ f

noncomputable abbrev H0 {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) :
    GlueingDataCategory φ f ⥤ ModuleCat.{u} R :=
  blH0Functor φ f

noncomputable abbrev H0CompatiblePairEquiv
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (X : GlueingDataCategory φ f) :
    ((H0 φ f).obj X : Type u) ≃
      {p // p ∈ moduleFiberCompatiblePairs (blRingSquare φ f) X} :=
  moduleFiberProduct_compatiblePairEquiv (blRingSquare φ f) X

def H0IsKernelStatement {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  ∀ X : GlueingDataCategory φ f,
    Nonempty (((H0 φ f).obj X : Type u) ≃
      {p // p ∈ moduleFiberCompatiblePairs (blRingSquare φ f) X})

theorem H0_is_kernel_of_glueing_difference
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : H0IsKernelStatement φ f := by
  intro X
  exact ⟨H0CompatiblePairEquiv φ f X⟩

def GlueableModuleProperty {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) :
    ObjectProperty (ModuleCat.{u} R) :=
  fun M => IsGlueable φ f (M := (M : Type u))

abbrev GlueableModuleCategory {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) :=
  (GlueableModuleProperty φ f).FullSubcategory

theorem beauville_laszlo_equivalence
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hpair : IsGlueingPair φ f) :
    Nonempty (GlueableModuleCategory φ f ≌ GlueingDataCategory φ f) := by
  sorry

structure CanonicalizationData {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (M : ModuleCat.{u} R) where
  module : ModuleCat.{u} R
  canonicalMap : M ⟶ module
  glueable : IsGlueable φ f (M := (module : Type u))
  surjective : Function.Surjective canonicalMap.hom
  formalIso : (ModuleCat.extendScalars φ).obj M ≅
    (ModuleCat.extendScalars φ).obj module
  openIso : (ModuleCat.extendScalars (algebraMap R (Localization.Away f))).obj M ≅
    (ModuleCat.extendScalars (algebraMap R (Localization.Away f))).obj module

theorem canonicalization_of_any_module
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hpair : IsGlueingPair φ f)
    (M : ModuleCat.{u} R) :
    Nonempty (CanonicalizationData φ f M) := by
  sorry

/-! ## Flatness and finite projectivity -/

theorem flatness_descends_along_bl_pair
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hpair : IsGlueingPair φ f)
    (M : ModuleCat.{u} R) :
    Module.Flat R (M : Type u) ↔
      (Module.Flat S ((ModuleCat.extendScalars φ).obj M : Type u) ∧
        Module.Flat (Localization.Away f)
          ((ModuleCat.extendScalars (algebraMap R (Localization.Away f))).obj M : Type u)) := by
  sorry

def FiniteProjectiveModule {R M : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] : Prop :=
  Module.Finite R M ∧ Module.Projective R M

theorem finite_projectivity_descends_along_bl_pair
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hpair : IsGlueingPair φ f)
    (M : ModuleCat.{u} R) :
    FiniteProjectiveModule (R := R) (M := (M : Type u)) ↔
      (FiniteProjectiveModule
          (R := S) (M := ((ModuleCat.extendScalars φ).obj M : Type u)) ∧
        FiniteProjectiveModule
          (R := Localization.Away f)
          (M := ((ModuleCat.extendScalars (algebraMap R (Localization.Away f))).obj M : Type u))) := by
  sorry

theorem finite_projectivity_descends_for_noetherian_completion
    {R : Type u} [CommRing R] [IsNoetherianRing R]
    (f : R) (M : ModuleCat.{u} R) :
    FiniteProjectiveModule (R := R) (M := (M : Type u)) ↔
      (FiniteProjectiveModule
          (R := fAdicCompletion R f)
          (M := (((ModuleCat.extendScalars (fAdicCompletionMap R f)).obj M :
            ModuleCat.{u} (fAdicCompletion R f)) : Type u)) ∧
        FiniteProjectiveModule
          (R := Localization.Away f)
          (M := (((ModuleCat.extendScalars (algebraMap R (Localization.Away f))).obj M :
            ModuleCat.{u} (Localization.Away f)) : Type u))) := by
  sorry

