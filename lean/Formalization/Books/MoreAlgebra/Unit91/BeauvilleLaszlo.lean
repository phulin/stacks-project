theorem first_torsion_injective_implies_glueable
    {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    (f : R) (hpair : IsSelfGlueingPair f)
    (hinj : FirstTorsionToCompletionInjective (M := M) f) :
