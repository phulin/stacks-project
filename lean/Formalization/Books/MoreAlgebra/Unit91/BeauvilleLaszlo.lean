theorem glueable_iff_injective_when_pair_is_glueing
    {R S M : Type u} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (φ : R →+* S) (f : R)
    (hpair : IsGlueingPair φ f) :
    IsGlueable (M := M) φ f ↔
      InjectiveOnModuleFPowerTorsion (M := M) φ f := by
