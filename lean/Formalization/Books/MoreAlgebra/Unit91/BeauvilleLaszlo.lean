theorem isSelfGlueingPair_iff_fPowerTorsion_bijective
    {R : Type u} [CommRing R] (f : R) :
    IsSelfGlueingPair f ↔
      BijectiveOnFPowerTorsion (fAdicCompletionMap R f) f := by
