import Mathlib.CategoryTheory.Limits.Constructions.Over.Connected

/-!
# Categories, Chapter 16: Connected limits

The source's connectedness definition is represented by Mathlib's canonical
`CategoryTheory.IsConnected` class.  Its `Zigzag` characterization records the
source's generated-equivalence-relation formulation, while the connected
limit-preservation instances for `Over.forget` and `Under.forget` express the
two universal-property lemmas.
-/

namespace Formalization.Books.Categories.Unit16

open CategoryTheory
open CategoryTheory.Limits

universe u v u' v'

noncomputable section

/-! ## Connected limits -/

/- The source's phrase “connected (co)limit” means that the indexing category
   is connected.  We use `[IsConnected I]` directly in the interfaces below;
   no duplicate predicate for connected limits or colimits is introduced. -/

/- The relation generated by the existence of a morphism in either direction
   is Mathlib's `Zigzag` relation.  This is the source's definition of a
   connected category, including its nonemptiness convention. -/
theorem category_connected_iff_zigzag (I : Type u) [Category.{v} I] :
    IsConnected I ↔ Nonempty I ∧ ∀ i j : I, Zigzag i j := by
  constructor
  · intro hI
    exact ⟨@IsConnected.is_nonempty I _ hI,
      fun i j => @isPreconnected_zigzag I _ hI.toIsPreconnected i j⟩
  · rintro ⟨hI, h⟩
    exact @zigzag_isConnected I _ hI h

/- The following two declarations state the “same limit” part of the first
   source lemma at the cone level, then derive the existence statement. -/
def isLimit_forget_over_of_isConnected
    {I : Type u} [Category.{v} I] {C : Type u'} [Category.{v'} C]
    {X : C} {M : I ⥤ Over X} [IsConnected I] {c : Cone M} (hc : IsLimit c) :
    IsLimit ((Over.forget X).mapCone c) :=
  isLimitOfPreserves (Over.forget X) hc

theorem hasLimit_comp_forget_over_of_isConnected
    {I : Type u} [Category.{v} I] {C : Type u'} [Category.{v'} C]
    {X : C} (M : I ⥤ Over X) [IsConnected I] [HasLimit M] :
    HasLimit (M ⋙ Over.forget X) :=
  HasLimit.mk
    { cone := (Over.forget X).mapCone (limit.cone M)
      isLimit := isLimit_forget_over_of_isConnected (limit.isLimit M) }

/- The dual pair records the corresponding “same colimit” assertion for a
   diagram in the under category. -/
def isColimit_forget_under_of_isConnected
    {I : Type u} [Category.{v} I] {C : Type u'} [Category.{v'} C]
    {X : C} {M : I ⥤ Under X} [IsConnected I] {c : Cocone M} (hc : IsColimit c) :
    IsColimit ((Under.forget X).mapCocone c) :=
  isColimitOfPreserves (Under.forget X) hc

theorem hasColimit_comp_forget_under_of_isConnected
    {I : Type u} [Category.{v} I] {C : Type u'} [Category.{v'} C]
    {X : C} (M : I ⥤ Under X) [IsConnected I] [HasColimit M] :
    HasColimit (M ⋙ Under.forget X) :=
  HasColimit.mk
    { cocone := (Under.forget X).mapCocone (colimit.cocone M)
      isColimit := isColimit_forget_under_of_isConnected (colimit.isColimit M) }

end

end Formalization.Books.Categories.Unit16
