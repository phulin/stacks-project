theorem glueable_iff_module_fPowerTorsion_bijective
    {R S M : Type u} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (φ : R →+* S) (f : R)
    (hquot : SamePowerQuotients φ f) :
    IsGlueable (M := M) φ f ↔
      InjectiveOnModuleFPowerTorsion (M := M) φ f ∧
