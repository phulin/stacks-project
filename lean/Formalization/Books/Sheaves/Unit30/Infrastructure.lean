        (ConcreteCategory.hom (N.val.map f.op))
          (r • (ConcreteCategory.hom (α.app (op (unop U)))) m)
      rw [hh2]
      dsimp [hr, hm0, S, φ, Rb]
      have hαm :
          (ConcreteCategory.hom (α.app (op (A i))))
              ((ConcreteCategory.hom (M.val.map f.op)) m) =
            (ModuleCat.Hom.hom (h.val.app (op i.1)))
