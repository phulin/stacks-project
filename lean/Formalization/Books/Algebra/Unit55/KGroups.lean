      map_smul' := by
        intro r x
        rw [prodFactor₂.val_smul, h₂.map_smul]
        rcases (h₂ x.val).property with ⟨z, hz⟩
        change ((((0 : R₁), r.2) : R₁ × R₂) • (h₂ x.val : N)) =
