/-!
# Smoothing Ring Maps, Chapter 6: The lifting lemma

The chapter's proof is presentation based.  The explicit polynomial
construction below records the auxiliary choices and the equations used in
the proof, while the final theorem uses the intrinsic finite-presentation and
smoothness interfaces from the preceding algebra chapters.
-/

namespace Formalization.Books.Smoothing.Unit06

open Set
open Formalization.Books.Algebra.Unit03
open scoped BigOperators

noncomputable section

universe u

/-! ## Quotients by a principal element -/

/-- The quotient by the principal ideal generated by an element. -/
abbrev piQuotient (A : Type u) [CommRing A] (a : A) : Type u :=
  A ⧸ Ideal.span ({a} : Set A)

/-- The quotient map onto `A / aA`. -/
def piQuotientMk {A : Type u} [CommRing A] (a : A) : A →+* piQuotient A a :=
  Ideal.Quotient.mk _

/-- The canonical reduction map `A / a²A → A / aA`. -/
def piSquaredToPi {A : Type u} [CommRing A] (a : A) :
    piQuotient A (a ^ 2) →+* piQuotient A a :=
  Ideal.quotientMap (Ideal.span ({a} : Set A)) (RingHom.id A) (by
    apply Ideal.span_le.2
    intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    exact Ideal.mem_span_singleton'.2 ⟨a, by simp [pow_two]⟩)

/-- The ring map to an algebra which factors through a quotient of the base. -/
def quotientAlgebraMap
    {R A : Type u} [CommRing R] [CommRing A]
    (I : Ideal R) [Algebra (R ⧸ I) A] : R →+* A :=
  (algebraMap (R ⧸ I) A).comp (Ideal.Quotient.mk I)

/-! ## The polynomial data in the proof -/

/-- The polynomial ring containing the `x` and `z` variables of the proof. -/
abbrev liftingPolynomial (R : Type u) [CommRing R] (n m : ℕ) : Type u :=
  MvPolynomial (Fin n ⊕ Fin m) R

/-- Inclusion of the `x`-polynomial ring into the ring with `x` and `z`. -/
def liftLiftingPolynomial
    {R : Type u} [CommRing R] {n m : ℕ}
    (f : MvPolynomial (Fin n) R) : liftingPolynomial R n m :=
  MvPolynomial.rename Sum.inl f

/-- The lifted relation `f_ℓ - π z_ℓ`. -/
def liftingBaseRelation
    {R : Type u} [CommRing R] {n m : ℕ} (π : R)
    (f : Fin m → MvPolynomial (Fin n) R) (ℓ : Fin m) :
    liftingPolynomial R n m :=
  liftLiftingPolynomial (f ℓ) -
    MvPolynomial.C π * MvPolynomial.X (Sum.inr ℓ)

/-- The correction relation `p_{k,ℓ}` from the proof. -/
def liftingCorrectionRelation
    {R : Type u} [CommRing R] {n m r : ℕ} {e : Fin r → ℕ}
    (π : R) (a : Fin r → MvPolynomial (Fin n) R)
    (h : ∀ k : Fin r, Fin m → Fin (e k) → MvPolynomial (Fin n) R)
    (g : ∀ _k : Fin r, Fin m → MvPolynomial (Fin n) R)
    (E : ∀ k : Fin r, Fin (e k) ↪ Fin m) (k : Fin r) (ℓ : Fin m) :
    liftingPolynomial R n m :=
  liftLiftingPolynomial (a k) * MvPolynomial.X (Sum.inr ℓ) -
      ∑ j : Fin (e k),
        liftLiftingPolynomial (h k ℓ j) *
          MvPolynomial.X (Sum.inr (E k j)) -
    MvPolynomial.C π * liftLiftingPolynomial (g k ℓ)

/-- Evaluation of the `x`-polynomial presentation at elements of an algebra. -/
def liftingEvaluation
    {R Λ : Type u} [CommRing R] [CommRing Λ] [Algebra R Λ]
    {n : ℕ} (lambda : Fin n → Λ) :
    MvPolynomial (Fin n) R →ₐ[R] Λ :=
  MvPolynomial.aeval lambda

/-- The finite presentation and coefficient data used to construct `D`. -/
structure LiftingConstructionData (R : Type u) [CommRing R] (π : R) where
  n : ℕ
  m : ℕ
  r : ℕ
  e : Fin r → ℕ
  relations : Fin m → MvPolynomial (Fin n) R
  selected : ∀ k : Fin r, Fin (e k) ↪ Fin m
  a : Fin r → MvPolynomial (Fin n) R
  h : ∀ k : Fin r, Fin m → Fin (e k) → MvPolynomial (Fin n) R
  g : ∀ _k : Fin r, Fin m → MvPolynomial (Fin n) R
  relation_identity :
    ∀ k : Fin r, ∀ ℓ : Fin m,
      a k * relations ℓ =
        (∑ j : Fin (e k), h k ℓ j * relations (selected k j)) +
          MvPolynomial.C (π ^ 2) * g k ℓ
  selected_h :
    ∀ k : Fin r, ∀ j : Fin (e k), ∀ j' : Fin (e k),
      h k (selected k j) j' = if j' = j then a k else 0
  selected_g : ∀ k : Fin r, ∀ j : Fin (e k), g k (selected k j) = 0

/-- The ideal `I = (f_1, ..., f_m)` in the polynomial presentation. -/
def liftingRelationIdeal
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) :
    Ideal (MvPolynomial (Fin d.n) R) :=
  Ideal.span (Set.range d.relations)

/-- The ideal `I_k = (f_j : j ∈ E_k)` used at a smooth basic open. -/
def liftingSelectedRelationIdeal
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
    Ideal (MvPolynomial (Fin d.n) R) :=
  Ideal.span (Set.range (fun j : Fin (d.e k) => d.relations (d.selected k j)))

/-- The image `\bar I` of the presentation ideal modulo `π²`. -/
def liftingReducedRelationIdeal
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) :
    Ideal (MvPolynomial (Fin d.n) (piQuotient R (π ^ 2))) :=
  Ideal.map
    (MvPolynomial.map (piQuotientMk (π ^ 2)) :
      MvPolynomial (Fin d.n) R →+*
        MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)))
    (liftingRelationIdeal d)

/-- The image `\bar I_k` of the selected relation ideal modulo `π²`. -/
def liftingReducedSelectedRelationIdeal
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
    Ideal (MvPolynomial (Fin d.n) (piQuotient R (π ^ 2))) :=
  Ideal.map
    (MvPolynomial.map (piQuotientMk (π ^ 2)) :
      MvPolynomial (Fin d.n) R →+*
        MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)))
    (liftingSelectedRelationIdeal d k)

/-- The defining ideal of the ring `D` in the proof. -/
def liftingDefiningIdeal
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) :
    Ideal (liftingPolynomial R d.n d.m) :=
  Ideal.span
    (Set.range (fun ℓ : Fin d.m => liftingBaseRelation π d.relations ℓ) ∪
      ⋃ k : Fin d.r, Set.range (fun ℓ : Fin d.m =>
        liftingCorrectionRelation π d.a d.h d.g d.selected k ℓ))

/-- The ring `D` constructed in the proof. -/
abbrev liftingRing
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) : Type u :=
  liftingPolynomial R d.n d.m ⧸ liftingDefiningIdeal d

/-- The image in `D` of a polynomial in the `x` variables. -/
def liftingElement
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π)
    (f : MvPolynomial (Fin d.n) R) : liftingRing d :=
  Ideal.Quotient.mk _ (liftLiftingPolynomial f)

/-- The auxiliary ring `D_k`, where only the selected `f_j - π z_j` are used. -/
def liftingAuxiliaryDefiningIdeal
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
    Ideal (liftingPolynomial R d.n d.m) :=
  Ideal.span
    (Set.range (fun j : Fin (d.e k) =>
        liftingBaseRelation π d.relations (d.selected k j)) ∪
      Set.range (fun ℓ : Fin d.m =>
        liftingCorrectionRelation π d.a d.h d.g d.selected k ℓ))

/-- The auxiliary ring `D_k` used in the local smoothness argument. -/
abbrev liftingAuxiliaryRing
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) : Type u :=
  liftingPolynomial R d.n d.m ⧸ liftingAuxiliaryDefiningIdeal d k

/-- The image of `a_k` in `D_k`. -/
def liftingAuxiliaryElement
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) : liftingAuxiliaryRing d k :=
  Ideal.Quotient.mk _ (liftLiftingPolynomial (d.a k))

/-- The values used in the proof to define the map from `D` to `Λ`. -/
structure LiftingEvaluationData
    {R Λ : Type u} [CommRing R] [CommRing Λ] [Algebra R Λ]
    {π : R} (d : LiftingConstructionData R π) where
  lambda : Fin d.n → Λ
  mu : Fin d.m → Λ
  relation_evaluation :
    ∀ ℓ : Fin d.m,
      liftingEvaluation lambda (d.relations ℓ) =
        (algebraMap R Λ π) ^ 2 * mu ℓ

/-- The polynomial evaluation sending `x_i` to `λ_i` and `z_j` to `π μ_j`. -/
def liftingEvaluationPolynomial
    {R Λ : Type u} [CommRing R] [CommRing Λ] [Algebra R Λ]
    {π : R} (d : LiftingConstructionData R π)
    (ev : LiftingEvaluationData (Λ := Λ) d) :
    liftingPolynomial R d.n d.m →ₐ[R] Λ :=
  MvPolynomial.aeval (fun v =>
    match v with
    | Sum.inl i => ev.lambda i
    | Sum.inr j => algebraMap R Λ π * ev.mu j)

/-- The evaluation descends through the defining equations of `D`. -/
theorem liftingRing_evaluation_descends
    {R Λ : Type u} [CommRing R] [CommRing Λ] [Algebra R Λ]
    {π : R} (d : LiftingConstructionData R π)
    (ev : LiftingEvaluationData (Λ := Λ) d)
    (hAnnΛ :
      annihilatorOf (R := Λ) (M := Λ) (algebraMap R Λ π) =
        annihilatorOf (R := Λ) (M := Λ) ((algebraMap R Λ π) ^ 2)) :
    ∃ φ : liftingRing d →ₐ[R] Λ,
      ∀ v : Fin d.n ⊕ Fin d.m,
        φ (Ideal.Quotient.mk (liftingDefiningIdeal d) (MvPolynomial.X v)) =
          liftingEvaluationPolynomial d ev (MvPolynomial.X v) := by
  let F := liftingEvaluationPolynomial d ev
  have hIdeal : liftingDefiningIdeal d ≤ Ideal.comap F.toRingHom (⊥ : Ideal Λ) := by
    apply Ideal.span_le.2
    intro p hp
    rcases hp with hp | hp
    · rcases hp with ⟨ℓ, rfl⟩
      simp [F, liftingEvaluationPolynomial, liftingBaseRelation,
        liftLiftingPolynomial, MvPolynomial.aeval_rename]
      change liftingEvaluation ev.lambda (d.relations ℓ) -
        (algebraMap R Λ π) * ((algebraMap R Λ π) * ev.mu ℓ) = 0
      rw [ev.relation_evaluation]
      simp [pow_two, mul_assoc]
    · rcases Set.mem_iUnion.1 hp with ⟨k, hp⟩
      rcases hp with ⟨ℓ, rfl⟩
      simp [F, liftingEvaluationPolynomial, liftingCorrectionRelation,
        liftLiftingPolynomial, MvPolynomial.aeval_rename]
      change liftingEvaluation ev.lambda (d.a k) *
          ((algebraMap R Λ π) * ev.mu ℓ) -
        ∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
          ((algebraMap R Λ π) * ev.mu (d.selected k x)) -
        (algebraMap R Λ π) * liftingEvaluation ev.lambda (d.g k ℓ) = 0
      have hrel :=
        congrArg (liftingEvaluation ev.lambda) (d.relation_identity k ℓ)
      simp only [map_mul, map_add, map_sum, map_pow]
        at hrel
      simp only [MvPolynomial.algHom_C] at hrel
      simp [mul_comm] at hrel
      simp only [ev.relation_evaluation] at hrel
      have hsum :
          (∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
            ((algebraMap R Λ π) ^ 2 * ev.mu (d.selected k x))) =
            (algebraMap R Λ π) ^ 2 *
              ∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
                ev.mu (d.selected k x) := by
        calc
          (∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
              ((algebraMap R Λ π) ^ 2 * ev.mu (d.selected k x))) =
              ∑ x, (algebraMap R Λ π) ^ 2 *
                (liftingEvaluation ev.lambda (d.h k ℓ x) *
                  ev.mu (d.selected k x)) := by
                apply Finset.sum_congr rfl
                intro x hx
                ring
          _ = (algebraMap R Λ π) ^ 2 *
                ∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
                  ev.mu (d.selected k x) := by
                rw [Finset.mul_sum]
      rw [hsum] at hrel
      have hq2 : (algebraMap R Λ π) ^ 2 *
          (liftingEvaluation ev.lambda (d.a k) * ev.mu ℓ -
            ∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
              ev.mu (d.selected k x) -
            liftingEvaluation ev.lambda (d.g k ℓ)) = 0 := by
        linear_combination hrel
      have hcancel : ∀ x : Λ,
          (algebraMap R Λ π) ^ 2 * x = 0 →
            (algebraMap R Λ π) * x = 0 := by
        intro x hx
        have hx' : x ∈ annihilatorOf (R := Λ) (M := Λ)
            ((algebraMap R Λ π) ^ 2) := by
          apply (annihilatorOf_mem_iff
            (R := Λ) (M := Λ) ((algebraMap R Λ π) ^ 2) x).2
          simpa [smul_eq_mul, mul_comm] using hx
        rw [← hAnnΛ] at hx'
        have hx'' := (annihilatorOf_mem_iff
          (R := Λ) (M := Λ) (algebraMap R Λ π) x).1 hx'
        simpa [smul_eq_mul, mul_comm] using hx''
      have hsum' :
          (∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
            ((algebraMap R Λ π) * ev.mu (d.selected k x))) =
            (algebraMap R Λ π) *
              ∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
                ev.mu (d.selected k x) := by
        calc
          (∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
              ((algebraMap R Λ π) * ev.mu (d.selected k x))) =
              ∑ x, (algebraMap R Λ π) *
                (liftingEvaluation ev.lambda (d.h k ℓ x) *
                  ev.mu (d.selected k x)) := by
                apply Finset.sum_congr rfl
                intro x hx
                ring
          _ = (algebraMap R Λ π) *
                ∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
                  ev.mu (d.selected k x) := by
                rw [Finset.mul_sum]
      calc
        liftingEvaluation ev.lambda (d.a k) *
              ((algebraMap R Λ π) * ev.mu ℓ) -
            ∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
              ((algebraMap R Λ π) * ev.mu (d.selected k x)) -
            (algebraMap R Λ π) * liftingEvaluation ev.lambda (d.g k ℓ) =
          (algebraMap R Λ π) *
            (liftingEvaluation ev.lambda (d.a k) * ev.mu ℓ -
              ∑ x, liftingEvaluation ev.lambda (d.h k ℓ x) *
                ev.mu (d.selected k x) -
              liftingEvaluation ev.lambda (d.g k ℓ)) := by
          rw [hsum']
          ring
        _ = 0 := hcancel _ hq2
  have hF : ∀ p : liftingPolynomial R d.n d.m,
      p ∈ liftingDefiningIdeal d → F p = 0 := fun p hp => hIdeal hp
  refine ⟨Ideal.Quotient.liftₐ (liftingDefiningIdeal d) F hF, ?_⟩
  intro v
  change F (MvPolynomial.X v) = F (MvPolynomial.X v)
  rfl

/-- The quotient map `D_k → D` supplied by inclusion of defining ideals. -/
noncomputable def liftingAuxiliaryToLiftingRing
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
  liftingAuxiliaryRing d k →+* liftingRing d :=
  Ideal.Quotient.factor (show
    liftingAuxiliaryDefiningIdeal d k ≤ liftingDefiningIdeal d from by
      apply Ideal.span_le.2
      intro x hx
      rcases hx with hx | hx
      · rcases hx with ⟨j, rfl⟩
        exact Ideal.subset_span (Or.inl ⟨d.selected k j, rfl⟩)
      · rcases hx with ⟨ℓ, rfl⟩
        exact Ideal.subset_span
          (Or.inr (Set.mem_iUnion.2 ⟨k, ⟨ℓ, rfl⟩⟩)))

/-! ## Identities and local calculations in the construction -/

/-- The chosen relations in `E_k` give zero correction equations. -/
theorem liftingCorrectionRelation_selected
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) (j : Fin (d.e k)) :
    liftingCorrectionRelation π d.a d.h d.g d.selected k (d.selected k j) = 0 := by
  classical
  unfold liftingCorrectionRelation
  rw [Finset.sum_eq_single j]
  · simp [d.selected_h, d.selected_g, liftLiftingPolynomial]
  · intro b hb hbj
    simp [d.selected_h, hbj, liftLiftingPolynomial]
  · intro hj
    exact (hj (Finset.mem_univ j)).elim

/-- The key equality expressing `π p_{k,ℓ}` in the base relations. -/
theorem liftingKeyIdentity
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) (ℓ : Fin d.m) :
    MvPolynomial.C π *
        liftingCorrectionRelation π d.a d.h d.g d.selected k ℓ =
      -liftLiftingPolynomial (d.a k) *
          liftingBaseRelation π d.relations ℓ +
        ∑ j : Fin (d.e k),
          liftLiftingPolynomial (d.h k ℓ j) *
            liftingBaseRelation π d.relations (d.selected k j) := by
  have hrel :=
    congrArg (fun p : MvPolynomial (Fin d.n) R =>
      liftLiftingPolynomial (m := d.m) p) (d.relation_identity k ℓ)
  simp only [liftLiftingPolynomial, map_mul, map_add, map_sum, map_pow] at hrel
  rw [MvPolynomial.rename_C] at hrel
  change liftLiftingPolynomial (d.a k) * liftLiftingPolynomial (d.relations ℓ) =
      (∑ j : Fin (d.e k),
        liftLiftingPolynomial (d.h k ℓ j) *
          liftLiftingPolynomial (d.relations (d.selected k j))) +
        (MvPolynomial.C π) ^ 2 * liftLiftingPolynomial (d.g k ℓ) at hrel
  have hsumX :
      (∑ j : Fin (d.e k),
        liftLiftingPolynomial (d.h k ℓ j) *
          (MvPolynomial.C π * MvPolynomial.X (Sum.inr (d.selected k j)))) =
        MvPolynomial.C π *
          ∑ j : Fin (d.e k),
            liftLiftingPolynomial (d.h k ℓ j) *
              MvPolynomial.X (Sum.inr (d.selected k j)) := by
    calc
      (∑ j : Fin (d.e k),
          liftLiftingPolynomial (d.h k ℓ j) *
            (MvPolynomial.C π * MvPolynomial.X (Sum.inr (d.selected k j)))) =
          ∑ j : Fin (d.e k), MvPolynomial.C π *
            (liftLiftingPolynomial (d.h k ℓ j) *
              MvPolynomial.X (Sum.inr (d.selected k j))) := by
            apply Finset.sum_congr rfl
            intro j hj
            ring
      _ = MvPolynomial.C π *
          ∑ j : Fin (d.e k),
            liftLiftingPolynomial (d.h k ℓ j) *
              MvPolynomial.X (Sum.inr (d.selected k j)) := by
            rw [Finset.mul_sum]
  have hsumSub :
      (∑ j : Fin (d.e k),
        liftLiftingPolynomial (d.h k ℓ j) *
          (liftLiftingPolynomial (d.relations (d.selected k j)) -
            MvPolynomial.C π * MvPolynomial.X (Sum.inr (d.selected k j)))) =
        (∑ j : Fin (d.e k),
          liftLiftingPolynomial (d.h k ℓ j) *
            liftLiftingPolynomial (d.relations (d.selected k j))) -
          ∑ j : Fin (d.e k),
            liftLiftingPolynomial (d.h k ℓ j) *
              (MvPolynomial.C π * MvPolynomial.X (Sum.inr (d.selected k j))) := by
    calc
      (∑ j : Fin (d.e k),
          liftLiftingPolynomial (d.h k ℓ j) *
            (liftLiftingPolynomial (d.relations (d.selected k j)) -
              MvPolynomial.C π * MvPolynomial.X (Sum.inr (d.selected k j)))) =
          ∑ j : Fin (d.e k),
            (liftLiftingPolynomial (d.h k ℓ j) *
              liftLiftingPolynomial (d.relations (d.selected k j)) -
            liftLiftingPolynomial (d.h k ℓ j) *
              (MvPolynomial.C π * MvPolynomial.X (Sum.inr (d.selected k j)))) := by
            apply Finset.sum_congr rfl
            intro j hj
            rw [mul_sub]
      _ = _ := by rw [Finset.sum_sub_distrib]
  simp [liftingCorrectionRelation, liftingBaseRelation]
  rw [hsumSub, hsumX]
  linear_combination hrel

/-- The polynomial presentation model for `\bar C`. -/
abbrev liftingPresentationModel
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) : Type u :=
  MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)) ⧸
    liftingReducedRelationIdeal d

noncomputable instance liftingPresentationModel.commRing
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) :
    CommRing (liftingPresentationModel d) :=
  Ideal.Quotient.commRing (liftingReducedRelationIdeal d)

noncomputable instance liftingPresentationModel.algebraR
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) : Algebra R (liftingPresentationModel d) :=
  Algebra.compHom (liftingPresentationModel d) (piQuotientMk (π ^ 2))

/-- The image of `a_k` in the presentation model of `\bar C`. -/
def liftingPresentationElement
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
    liftingPresentationModel d :=
  Ideal.Quotient.mk _
    ((MvPolynomial.map (piQuotientMk (π ^ 2)) :
      MvPolynomial (Fin d.n) R →+*
        MvPolynomial (Fin d.n) (piQuotient R (π ^ 2))) (d.a k))

/-- The base map from `R` to the presentation model. -/
def liftingPresentationModelMap
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) : R →+* liftingPresentationModel d :=
  (algebraMap (piQuotient R (π ^ 2)) (liftingPresentationModel d)).comp
    (piQuotientMk (π ^ 2))

def liftingPresentationModPiIdeal
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) : Ideal (liftingPresentationModel d) :=
  Ideal.map (liftingPresentationModelMap d) (Ideal.span ({π} : Set R))

noncomputable instance liftingPresentationModPiIdeal.isTwoSided
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) :
    (liftingPresentationModPiIdeal d).IsTwoSided := by
  refine ⟨fun {a} b ha => ?_⟩
  have h := (liftingPresentationModPiIdeal d).smul_mem b ha
  rw [smul_eq_mul] at h
  rw [mul_comm b a] at h
  exact h

/-- The mod-`π` presentation model for `\bar C / π\bar C`. -/
abbrev liftingPresentationModPiModel
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) : Type u :=
  liftingPresentationModel d ⧸
    liftingPresentationModPiIdeal d

/-- The image of `a_k` in the mod-`π` presentation model. -/
def liftingPresentationModPiElement
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
  liftingPresentationModPiModel d :=
  Ideal.Quotient.mk (liftingPresentationModPiIdeal d) (liftingPresentationElement d k)

def liftingAuxiliaryModPiIdeal
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
    Ideal (liftingAuxiliaryRing d k) :=
  Ideal.map (algebraMap R (liftingAuxiliaryRing d k))
    (Ideal.span ({π} : Set R))

/-- The mod-`π` auxiliary ring `D_k / π D_k`. -/
abbrev liftingAuxiliaryModPiRing
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) : Type u :=
  liftingAuxiliaryRing d k ⧸
    liftingAuxiliaryModPiIdeal d k

/-- The image of `a_k` in `D_k / π D_k`. -/
def liftingAuxiliaryModPiElement
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
  liftingAuxiliaryModPiRing d k :=
  (Ideal.Quotient.mk (liftingAuxiliaryModPiIdeal d k))
    (Ideal.Quotient.mk (liftingAuxiliaryDefiningIdeal d k)
      (liftLiftingPolynomial (d.a k)))

private structure liftingAuxiliaryModPiLocalizedBaseSetup
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r)
    [hA : CommRing (liftingAuxiliaryModPiRing d k)] where
  qmk : liftingPolynomial R d.n d.m →+*
    liftingAuxiliaryModPiRing d k
  rmapU : R →+* Localization.Away (liftingAuxiliaryModPiElement d k)
  qvar : (Fin d.n ⊕ Fin d.m) →
    Localization.Away (liftingAuxiliaryModPiElement d k)
  qmap : liftingPolynomial R d.n d.m →+*
    Localization.Away (liftingAuxiliaryModPiElement d k)
  qkill : ∀ p : liftingPolynomial R d.n d.m,
    p ∈ liftingAuxiliaryDefiningIdeal d k → qmap p = 0
  hpi : qmap (MvPolynomial.C π) = 0
  hrpi : rmapU π = 0
  hbase : ∀ ℓ : Fin d.m,
    qmap (liftLiftingPolynomial (d.relations ℓ)) = 0
  rmap2 : piQuotient R (π ^ 2) →+*
    Localization.Away (liftingAuxiliaryModPiElement d k)
  hrmap2 : ∀ r : R,
    rmap2 (piQuotientMk (π ^ 2) r) = rmapU r
  xvar : Fin d.n → Localization.Away (liftingAuxiliaryModPiElement d k)
  pmap : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)) →+*
    Localization.Away (liftingAuxiliaryModPiElement d k)
  pmap_eq : pmap = MvPolynomial.eval₂Hom rmap2 xvar
  pmap_lift : ∀ p : MvPolynomial (Fin d.n) R,
    pmap ((MvPolynomial.map (piQuotientMk (π ^ 2))) p) =
      qmap (liftLiftingPolynomial p)
  hred : ∀ p : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)),
    p ∈ liftingReducedRelationIdeal d → pmap p = 0
  qmap_spec : ∀ p : liftingPolynomial R d.n d.m,
    qmap p = algebraMap (liftingAuxiliaryModPiRing d k)
      (Localization.Away (liftingAuxiliaryModPiElement d k))
      (qmk p)
  qmap_C : ∀ r : R, qmap (MvPolynomial.C r) = rmapU r
  qmk_spec : ∀ p : liftingPolynomial R d.n d.m,
    qmk p = (Ideal.Quotient.mk (liftingAuxiliaryModPiIdeal d k))
      ((Ideal.Quotient.mk (liftingAuxiliaryDefiningIdeal d k)) p)

private structure liftingAuxiliaryModPiLocalizedSetup
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r)
    [hA : CommRing (liftingAuxiliaryModPiRing d k)] where
  qmk : liftingPolynomial R d.n d.m →+*
    liftingAuxiliaryModPiRing d k
  rmapU : R →+* Localization.Away (liftingAuxiliaryModPiElement d k)
  qvar : (Fin d.n ⊕ Fin d.m) → Localization.Away (liftingAuxiliaryModPiElement d k)
  qmap : liftingPolynomial R d.n d.m →+*
    Localization.Away (liftingAuxiliaryModPiElement d k)
  qkill : ∀ p : liftingPolynomial R d.n d.m,
    p ∈ liftingAuxiliaryDefiningIdeal d k → qmap p = 0
  hpi : qmap (MvPolynomial.C π) = 0
  qmap_spec : ∀ p : liftingPolynomial R d.n d.m,
    qmap p = algebraMap (liftingAuxiliaryModPiRing d k)
      (Localization.Away (liftingAuxiliaryModPiElement d k)) (qmk p)
  qmap_C : ∀ r : R, qmap (MvPolynomial.C r) = rmapU r
  rmap2 : piQuotient R (π ^ 2) →+*
    Localization.Away (liftingAuxiliaryModPiElement d k)
  hrmap2 : ∀ r : R,
    rmap2 (piQuotientMk (π ^ 2) r) = rmapU r
  xvar : Fin d.n → Localization.Away (liftingAuxiliaryModPiElement d k)
  pmap : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)) →+*
    Localization.Away (liftingAuxiliaryModPiElement d k)
  pmap_eq : pmap = MvPolynomial.eval₂Hom rmap2 xvar
  pmap_lift : ∀ p : MvPolynomial (Fin d.n) R,
    pmap ((MvPolynomial.map (piQuotientMk (π ^ 2))) p) =
      qmap (liftLiftingPolynomial p)
  qmk_spec : ∀ p : liftingPolynomial R d.n d.m,
    qmk p = (Ideal.Quotient.mk (liftingAuxiliaryModPiIdeal d k))
      ((Ideal.Quotient.mk (liftingAuxiliaryDefiningIdeal d k)) p)
  smap : liftingPresentationModel d →+*
    Localization.Away (liftingAuxiliaryModPiElement d k)
  smap_spec : ∀ p : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)),
    smap (Ideal.Quotient.mk (liftingReducedRelationIdeal d) p) = pmap p
  smap2 : liftingPresentationModPiModel d →+*
    Localization.Away (liftingAuxiliaryModPiElement d k)
  smap2_spec : ∀ p : liftingPresentationModel d,
    smap2 (Ideal.Quotient.mk (liftingPresentationModPiIdeal d) p) = smap p
  smap2_element :
    smap2 (liftingPresentationModPiElement d k) =
      algebraMap (liftingAuxiliaryModPiRing d k)
        (Localization.Away (liftingAuxiliaryModPiElement d k))
        (liftingAuxiliaryModPiElement d k)

private opaque liftingAuxiliary_modPi_base_vanish
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r)
    (U : Type u) [CommRing U]
    (rmapU : R →+* U) (qvar : (Fin d.n ⊕ Fin d.m) → U)
    (hrpi : rmapU π = 0)
    (hsel : ∀ j : Fin (d.e k),
      MvPolynomial.eval₂Hom rmapU qvar
        (liftingBaseRelation π d.relations (d.selected k j)) = 0)
    (haunit : IsUnit (MvPolynomial.eval₂Hom rmapU qvar
      (liftLiftingPolynomial (d.a k)))) :
    ∀ ℓ : Fin d.m,
      MvPolynomial.eval₂Hom rmapU qvar
        (liftLiftingPolynomial (d.relations ℓ)) = 0 := by
  intro ℓ
  let qmap : liftingPolynomial R d.n d.m →+* U :=
    MvPolynomial.eval₂Hom rmapU qvar
  have hid := congrArg
    (fun p : MvPolynomial (Fin d.n) R => qmap (liftLiftingPolynomial p))
    (d.relation_identity k ℓ)
  simp only [qmap, liftLiftingPolynomial, MvPolynomial.eval₂Hom_rename,
    map_mul, map_add, map_sum, map_pow] at hid
  have hsel' : ∀ j : Fin (d.e k),
      (MvPolynomial.eval₂Hom rmapU (qvar ∘ Sum.inl))
          (d.relations (d.selected k j)) = 0 := by
    intro j
    simpa [qmap, liftingBaseRelation, liftLiftingPolynomial,
      MvPolynomial.eval₂Hom_rename, MvPolynomial.eval₂_rename, hrpi] using hsel j
  simp only [hsel', MvPolynomial.eval₂Hom_C, hrpi] at hid
  apply haunit.mul_left_cancel
  simpa [qmap, liftLiftingPolynomial, MvPolynomial.eval₂Hom_rename] using hid

private opaque liftingAuxiliary_modPi_localized_base_setup
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
    liftingAuxiliaryModPiLocalizedBaseSetup d k := by
  classical
  let A := liftingAuxiliaryModPiRing d k
  let U := Localization.Away (liftingAuxiliaryModPiElement d k)
  letI : CommRing A := Ideal.Quotient.commRing _
  let qmk : liftingPolynomial R d.n d.m →+* A :=
    (Ideal.Quotient.mk (liftingAuxiliaryModPiIdeal d k)).comp
      (Ideal.Quotient.mk (liftingAuxiliaryDefiningIdeal d k))
  let rmapU : R →+* U :=
    (algebraMap A U).comp (qmk.comp MvPolynomial.C)
  let qvar : (Fin d.n ⊕ Fin d.m) → U := fun v =>
    algebraMap A U (qmk (MvPolynomial.X v))
  let qmap : liftingPolynomial R d.n d.m →+* U :=
    MvPolynomial.eval₂Hom rmapU qvar
  have qmap_eq : qmap = (algebraMap A U).comp qmk := by
    apply MvPolynomial.ringHom_ext'
    · ext r
      simp [qmap, rmapU]
    · intro v
      simp [qmap, qvar]
  have qkill : ∀ p : liftingPolynomial R d.n d.m,
      p ∈ liftingAuxiliaryDefiningIdeal d k → qmap p = 0 := by
    intro p hp
    rw [qmap_eq]
    have hp' : Ideal.Quotient.mk (liftingAuxiliaryDefiningIdeal d k) p = 0 :=
      (Ideal.Quotient.eq_zero_iff_mem).2 hp
    simp [qmk, hp']
  have hpi : qmap (MvPolynomial.C π) = 0 := by
    rw [qmap_eq]
    change algebraMap A U
      (Ideal.Quotient.mk (liftingAuxiliaryModPiIdeal d k)
        (algebraMap R (liftingAuxiliaryRing d k) π)) = 0
    have hzero : Ideal.Quotient.mk (liftingAuxiliaryModPiIdeal d k)
        (algebraMap R (liftingAuxiliaryRing d k) π) = 0 := by
      apply Ideal.Quotient.eq_zero_iff_mem.2
      exact Ideal.mem_map_of_mem (algebraMap R (liftingAuxiliaryRing d k))
        (Ideal.subset_span (by simp))
    rw [hzero]
    simp
  have hrpi : rmapU π = 0 := by
    simpa [qmap] using hpi
  have hsel : ∀ j : Fin (d.e k),
      qmap (liftingBaseRelation π d.relations (d.selected k j)) = 0 := by
    intro j
    apply qkill
    exact Ideal.subset_span (Or.inl ⟨j, rfl⟩)
  have haunit : IsUnit (qmap (liftLiftingPolynomial (d.a k))) := by
    rw [qmap_eq]
    change IsUnit (algebraMap A U (liftingAuxiliaryModPiElement d k))
    exact IsLocalization.Away.algebraMap_isUnit _
  have hbase : ∀ ℓ : Fin d.m,
      qmap (liftLiftingPolynomial (d.relations ℓ)) = 0 := by
    exact liftingAuxiliary_modPi_base_vanish d k U rmapU qvar hrpi hsel haunit
  let rmap2 : piQuotient R (π ^ 2) →+* U :=
    Ideal.Quotient.lift (Ideal.span ({π ^ 2} : Set R)) rmapU (by
      intro x hx
      change x ∈ Ideal.comap rmapU ⊥
      have hle : Ideal.span ({π ^ 2} : Set R) ≤ Ideal.comap rmapU ⊥ :=
        (Ideal.map_le_iff_le_comap).1
          (show Ideal.map rmapU (Ideal.span ({π ^ 2} : Set R)) ≤ ⊥ by
            apply Ideal.map_le_iff_le_comap.2
            apply Ideal.span_le.2
            intro y hy
            rcases Set.mem_singleton_iff.mp hy with rfl
            simp [hrpi])
      exact hle hx)
  let xvar : Fin d.n → U := fun i => qvar (Sum.inl i)
  let pmap : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)) →+* U :=
    MvPolynomial.eval₂Hom rmap2 xvar
  have hrmap2 : ∀ r : R,
      rmap2 (piQuotientMk (π ^ 2) r) = rmapU r := by
    intro r
    simp [rmap2, piQuotientMk]
  have hrmap2_hom : rmap2.comp (piQuotientMk (π ^ 2)) = rmapU := by
    ext r
    exact hrmap2 r
  have hpmap_lift : ∀ p : MvPolynomial (Fin d.n) R,
      pmap ((MvPolynomial.map (piQuotientMk (π ^ 2))) p) =
        qmap (liftLiftingPolynomial p) := by
    intro p
    change MvPolynomial.eval₂Hom rmap2 xvar
        ((MvPolynomial.map (piQuotientMk (π ^ 2))) p) =
      MvPolynomial.eval₂Hom rmapU qvar (liftLiftingPolynomial p)
    rw [MvPolynomial.eval₂Hom_map_hom, hrmap2_hom]
    change MvPolynomial.eval₂Hom rmapU (qvar ∘ Sum.inl) p =
      MvPolynomial.eval₂Hom rmapU qvar (MvPolynomial.rename Sum.inl p)
    rw [MvPolynomial.eval₂Hom_rename]
  have hred : ∀ p : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)),
      p ∈ liftingReducedRelationIdeal d → pmap p = 0 := by
    intro p hp
    have hle : liftingReducedRelationIdeal d ≤ Ideal.comap pmap ⊥ := by
      unfold liftingReducedRelationIdeal
      rw [Ideal.map_le_iff_le_comap]
      apply Ideal.span_le.2
      rintro _ ⟨ℓ, rfl⟩
      change pmap
        ((MvPolynomial.map (piQuotientMk (π ^ 2))) (d.relations ℓ)) = 0
      change MvPolynomial.eval₂Hom rmap2 xvar
        ((MvPolynomial.map (piQuotientMk (π ^ 2))) (d.relations ℓ)) = 0
      rw [MvPolynomial.eval₂Hom_map_hom, hrmap2_hom]
      have hb := hbase ℓ
      change MvPolynomial.eval₂Hom rmapU qvar
        (MvPolynomial.rename Sum.inl (d.relations ℓ)) = 0 at hb
      rw [MvPolynomial.eval₂Hom_rename] at hb
      change MvPolynomial.eval₂Hom rmapU (qvar ∘ Sum.inl)
        (d.relations ℓ) = 0
      exact hb
    exact hle hp
  have hqmap_C : ∀ r : R, qmap (MvPolynomial.C r) = rmapU r := by
    intro r
    simp [qmap, rmapU]
  exact
    { qmk := qmk
      rmapU := rmapU
      qvar := qvar
      qmap := qmap
      qkill := qkill
      hpi := hpi
      hrpi := hrpi
      hbase := hbase
      rmap2 := rmap2
      hrmap2 := hrmap2
      xvar := xvar
      pmap := pmap
      pmap_eq := rfl
      pmap_lift := hpmap_lift
      hred := hred
      qmap_spec := by
        intro p
        exact RingHom.congr_fun qmap_eq p
      qmap_C := hqmap_C
      qmk_spec := by
        intro p
        rfl }

private theorem liftingAuxiliary_modPi_span_kernel
    {R C U : Type u} [CommRing R] [CommRing C] [CommRing U] {π : R}
    (f : R →+* C) (g : C →+* U) (hπ : g (f π) = 0) :
    ∀ p : C, p ∈ Ideal.map f (Ideal.span ({π} : Set R)) → g p = 0 := by
  intro p hp
  have hle : Ideal.map f (Ideal.span ({π} : Set R)) ≤ Ideal.comap g ⊥ := by
    rw [Ideal.map_le_iff_le_comap]
    apply Ideal.span_le.2
    intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    simpa [Ideal.mem_comap] using hπ
  exact hle hp

private opaque liftingAuxiliary_modPi_localized_smap2_kernel
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r)
    (pmap : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)) →+*
      Localization.Away (liftingAuxiliaryModPiElement d k))
    (rmapU : R →+* Localization.Away (liftingAuxiliaryModPiElement d k))
    (rmap2 : piQuotient R (π ^ 2) →+*
      Localization.Away (liftingAuxiliaryModPiElement d k))
    (xvar : Fin d.n → Localization.Away (liftingAuxiliaryModPiElement d k))
    (pmap_eq : pmap = MvPolynomial.eval₂Hom rmap2 xvar)
    (hrmap2 : ∀ r : R, rmap2 (piQuotientMk (π ^ 2) r) =
      rmapU r)
    (hrpi : rmapU π = 0)
    (smap : liftingPresentationModel d →+*
      Localization.Away (liftingAuxiliaryModPiElement d k))
    (smap_spec : ∀ p : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)),
      smap (Ideal.Quotient.mk (liftingReducedRelationIdeal d) p) = pmap p) :
    ∀ p : liftingPresentationModel d,
      p ∈ liftingPresentationModPiIdeal d → smap p = 0 := by
  intro p hp
  have hp' : p ∈ Ideal.map (liftingPresentationModelMap d)
      (Ideal.span ({π} : Set R)) := hp
  have hpiS : smap (liftingPresentationModelMap d π) = 0 := by
    change smap (Ideal.Quotient.mk (liftingReducedRelationIdeal d)
      (MvPolynomial.C (piQuotientMk (π ^ 2) π))) = 0
    rw [smap_spec]
    rw [pmap_eq]
    rw [MvPolynomial.eval₂Hom_C, hrmap2]
    exact hrpi
  exact liftingAuxiliary_modPi_span_kernel
    (liftingPresentationModelMap d) smap hpiS p hp'

private opaque liftingAuxiliary_modPi_localized_setup
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
    liftingAuxiliaryModPiLocalizedSetup d k := by
  classical
  let A := liftingAuxiliaryModPiRing d k
  let U := Localization.Away (liftingAuxiliaryModPiElement d k)
  letI : CommRing A := Ideal.Quotient.commRing _
  let base := liftingAuxiliary_modPi_localized_base_setup d k
  let qmk := base.qmk
  let rmapU := base.rmapU
  let qvar := base.qvar
  let qmap := base.qmap
  let qkill := base.qkill
  let hpi := base.hpi
  let rmap2 := base.rmap2
  let hrmap2 := base.hrmap2
  let xvar := base.xvar
  let pmap := base.pmap
  let hred := base.hred
  let qmap_eq : qmap = (algebraMap A U).comp qmk := by
    apply RingHom.ext
    intro p
    simpa only [RingHom.comp_apply] using base.qmap_spec p
  let qmk_spec := base.qmk_spec
  let smap : liftingPresentationModel d →+* U :=
    Ideal.Quotient.lift (liftingReducedRelationIdeal d) pmap (by
      intro p hp
      exact hred p hp)
  let smap_spec : ∀ p : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)),
      smap (Ideal.Quotient.mk (liftingReducedRelationIdeal d) p) = pmap p := by
    intro p
    rfl
  let smap2 : liftingPresentationModPiModel d →+* U :=
    Ideal.Quotient.lift (liftingPresentationModPiIdeal d) smap (by
      exact liftingAuxiliary_modPi_localized_smap2_kernel d k pmap rmapU rmap2 xvar
        base.pmap_eq hrmap2 base.hrpi smap (by
          intro p
          rfl))
  let smap2_spec : ∀ p : liftingPresentationModel d,
      smap2 (Ideal.Quotient.mk (liftingPresentationModPiIdeal d) p) = smap p := by
    intro p
    rfl
  have hsmap2_element :
      smap2 (liftingPresentationModPiElement d k) =
        algebraMap A U (liftingAuxiliaryModPiElement d k) := by
    have hsmap_spec : ∀ p : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)),
        smap (Ideal.Quotient.mk (liftingReducedRelationIdeal d) p) = pmap p := by
      intro p
      rfl
    have hsmap2_spec : ∀ p : liftingPresentationModel d,
        smap2 (Ideal.Quotient.mk (liftingPresentationModPiIdeal d) p) = smap p := by
      intro p
      rfl
    calc
      smap2 (liftingPresentationModPiElement d k) =
          smap (liftingPresentationElement d k) := by
        exact hsmap2_spec (liftingPresentationElement d k)
      _ = pmap ((MvPolynomial.map (piQuotientMk (π ^ 2))) (d.a k)) := by
        exact hsmap_spec
          ((MvPolynomial.map (piQuotientMk (π ^ 2))) (d.a k))
      _ = qmap (liftLiftingPolynomial (d.a k)) := by
        exact base.pmap_lift (d.a k)
      _ = algebraMap A U (liftingAuxiliaryModPiElement d k) := by
        rw [qmap_eq]
        simp only [RingHom.comp_apply]
        rw [qmk_spec]
        rfl
  exact
    { qmk := qmk
      rmapU := rmapU
      qvar := qvar
      qmap := qmap
      qkill := qkill
      hpi := hpi
      qmap_spec := by
        intro p
        exact RingHom.congr_fun qmap_eq p
      rmap2 := rmap2
      hrmap2 := hrmap2
      xvar := xvar
      pmap := pmap
      pmap_eq := base.pmap_eq
      pmap_lift := base.pmap_lift
      qmap_C := base.qmap_C
      qmk_spec := qmk_spec
      smap := smap
      smap_spec := smap_spec
      smap2 := smap2
      smap2_spec := smap2_spec
      smap2_element := hsmap2_element }

private structure liftingAuxiliaryModPiLocalizedBSetup
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) where
  p2mk : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)) →+*
    liftingPresentationModPiModel d
  p2mk_spec : ∀ p : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)),
    p2mk p = (Ideal.Quotient.mk (liftingPresentationModPiIdeal d))
      ((Ideal.Quotient.mk (liftingReducedRelationIdeal d)) p)
  evalx : MvPolynomial (Fin d.n) R →+*
    Localization.Away (liftingPresentationModPiElement d k)
  evalx_spec : ∀ p : MvPolynomial (Fin d.n) R,
    evalx p = (algebraMap (liftingPresentationModPiModel d)
      (Localization.Away (liftingPresentationModPiElement d k)))
      (p2mk ((MvPolynomial.map (piQuotientMk (π ^ 2))) p))
  pmod : R →+* Localization.Away (liftingPresentationModPiElement d k)
  pmod_spec : ∀ r : R, pmod r = evalx (MvPolynomial.C r)
  pX : Fin d.n → Localization.Away (liftingPresentationModPiElement d k)
  pX_spec : ∀ i : Fin d.n, pX i = evalx (MvPolynomial.X i)
  bcoeff : R →+*
    MvPolynomial (Fin (d.e k))
      (Localization.Away (liftingPresentationModPiElement d k))
  ainv : Localization.Away (liftingPresentationModPiElement d k)
  ainv_spec : ainv = IsLocalization.Away.invSelf
    (liftingPresentationModPiElement d k)
  bvar : (Fin d.n ⊕ Fin d.m) →
    MvPolynomial (Fin (d.e k))
      (Localization.Away (liftingPresentationModPiElement d k))
  bmap : liftingPolynomial R d.n d.m →+*
    MvPolynomial (Fin (d.e k))
      (Localization.Away (liftingPresentationModPiElement d k))
  bmap_lift : ∀ p : MvPolynomial (Fin d.n) R,
    bmap (liftLiftingPolynomial p) = MvPolynomial.C (evalx p)
  bcoeff_spec : ∀ r : R, bcoeff r = MvPolynomial.C (pmod r)
  bmap_C : ∀ r : R, bmap (MvPolynomial.C r) = bcoeff r
  bmap_X : ∀ v : Fin d.n ⊕ Fin d.m,
    bmap (MvPolynomial.X v) = bvar v
  bvar_inl : ∀ i : Fin d.n,
    bvar (Sum.inl i) = MvPolynomial.C (pX i)
  bvar_inr : ∀ ℓ : Fin d.m,
    bvar (Sum.inr ℓ) = MvPolynomial.C ainv * ∑ j : Fin (d.e k),
      MvPolynomial.C (evalx (d.h k ℓ j)) * MvPolynomial.X j
  bpi : bcoeff π = 0
  bmap_pi : bmap (MvPolynomial.C π) = 0
  haT : evalx (d.a k) * ainv = 1
  evalx_a_isUnit : IsUnit
    ((MvPolynomial.C : Localization.Away (liftingPresentationModPiElement d k) →+*
      MvPolynomial (Fin (d.e k))
        (Localization.Away (liftingPresentationModPiElement d k)))
      (evalx (d.a k)))
  hDideal : ∀ p : liftingPolynomial R d.n d.m,
    p ∈ liftingAuxiliaryDefiningIdeal d k → bmap p = 0

private opaque liftingAuxiliary_modPi_localized_b_setup
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
    liftingAuxiliaryModPiLocalizedBSetup d k := by
  classical
  let T := Localization.Away (liftingPresentationModPiElement d k)
  let B := MvPolynomial (Fin (d.e k)) T
  let p2mk : MvPolynomial (Fin d.n) (piQuotient R (π ^ 2)) →+*
      liftingPresentationModPiModel d :=
    (Ideal.Quotient.mk (liftingPresentationModPiIdeal d)).comp
      (Ideal.Quotient.mk (liftingReducedRelationIdeal d))
  let evalx : MvPolynomial (Fin d.n) R →+* T :=
    (algebraMap (liftingPresentationModPiModel d) T).comp p2mk |>.comp
      (MvPolynomial.map (piQuotientMk (π ^ 2)))
  let pmod : R →+* T := evalx.comp MvPolynomial.C
  let pX : Fin d.n → T := fun i => evalx (MvPolynomial.X i)
  let bcoeff : R →+* B := MvPolynomial.C.comp pmod
  let ainv : T := IsLocalization.Away.invSelf (liftingPresentationModPiElement d k)
  let bvar : (Fin d.n ⊕ Fin d.m) → B := fun v =>
    match v with
    | Sum.inl i => MvPolynomial.C (pX i)
    | Sum.inr ℓ =>
        MvPolynomial.C ainv * ∑ j : Fin (d.e k),
          MvPolynomial.C (evalx (d.h k ℓ j)) * MvPolynomial.X j
  let bmap : liftingPolynomial R d.n d.m →+* B :=
    MvPolynomial.eval₂Hom bcoeff bvar
  have bmap_lift : ∀ p : MvPolynomial (Fin d.n) R,
      bmap (liftLiftingPolynomial p) = MvPolynomial.C (evalx p) := by
    have hbmap : bmap.comp (MvPolynomial.rename Sum.inl).toRingHom =
        MvPolynomial.C.comp evalx := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        simp [bmap, bcoeff, pmod, evalx]
      · intro i
        simp [bmap, bvar, pX, evalx]
    intro p
    exact RingHom.congr_fun hbmap p
  have bcoeff_spec : ∀ r : R, bcoeff r = MvPolynomial.C (pmod r) := by
    intro r
    rfl
  have bmap_C : ∀ r : R, bmap (MvPolynomial.C r) = bcoeff r := by
    intro r
    simp [bmap]
  have bmap_X : ∀ v : Fin d.n ⊕ Fin d.m,
      bmap (MvPolynomial.X v) = bvar v := by
    intro v
    simp [bmap]
  have bvar_inl : ∀ i : Fin d.n,
      bvar (Sum.inl i) = MvPolynomial.C (pX i) := by
    intro i
    rfl
  have bvar_inr : ∀ ℓ : Fin d.m,
      bvar (Sum.inr ℓ) = MvPolynomial.C ainv * ∑ j : Fin (d.e k),
        MvPolynomial.C (evalx (d.h k ℓ j)) * MvPolynomial.X j := by
    intro ℓ
    rfl
  have hpiModel :
      p2mk (MvPolynomial.C (piQuotientMk (π ^ 2) π)) = 0 := by
    change Ideal.Quotient.mk (liftingPresentationModPiIdeal d)
      (liftingPresentationModelMap d π) = 0
    apply Ideal.Quotient.eq_zero_iff_mem.2
    exact Ideal.mem_map_of_mem (liftingPresentationModelMap d)
      (Ideal.subset_span (by simp))
  have bpi : bcoeff π = 0 := by
    change MvPolynomial.C (evalx (MvPolynomial.C π)) = 0
    change MvPolynomial.C
      ((algebraMap (liftingPresentationModPiModel d) T)
        (p2mk ((MvPolynomial.map (piQuotientMk (π ^ 2)))
          (MvPolynomial.C π)))) = 0
    rw [MvPolynomial.map_C, hpiModel]
    simp
  have bmap_pi : bmap (MvPolynomial.C π) = 0 := by
    have hcoeff : bmap (MvPolynomial.C π) = bcoeff π := by
      simp [bmap]
    rw [hcoeff, bpi]
  have hevalbase : ∀ ℓ : Fin d.m, evalx (d.relations ℓ) = 0 := by
    intro ℓ
    have hmem :
        (MvPolynomial.map (piQuotientMk (π ^ 2))) (d.relations ℓ) ∈
          liftingReducedRelationIdeal d :=
      Ideal.mem_map_of_mem (MvPolynomial.map (piQuotientMk (π ^ 2)))
        (Ideal.subset_span ⟨ℓ, rfl⟩)
    have hzero' :
        Ideal.Quotient.mk (liftingReducedRelationIdeal d)
          ((MvPolynomial.map (piQuotientMk (π ^ 2))) (d.relations ℓ)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.2 hmem
    have hzero : p2mk
        ((MvPolynomial.map (piQuotientMk (π ^ 2))) (d.relations ℓ)) = 0 := by
      change Ideal.Quotient.mk (liftingPresentationModPiIdeal d)
        (Ideal.Quotient.mk (liftingReducedRelationIdeal d)
          ((MvPolynomial.map (piQuotientMk (π ^ 2))) (d.relations ℓ))) = 0
      rw [hzero']
      simp
    change (algebraMap (liftingPresentationModPiModel d) T)
        (p2mk ((MvPolynomial.map (piQuotientMk (π ^ 2)))
          (d.relations ℓ))) = 0
    rw [hzero]
    simp
  have bbase : ∀ ℓ : Fin d.m,
      bmap (liftingBaseRelation π d.relations ℓ) = 0 := by
    intro ℓ
    change bmap (liftLiftingPolynomial (d.relations ℓ) -
      MvPolynomial.C π * MvPolynomial.X (Sum.inr ℓ)) = 0
    rw [map_sub, bmap_lift, map_mul]
    have hcoeff : bmap (MvPolynomial.C π) = bcoeff π := by
      simp [bmap]
    rw [hcoeff, bpi]
    rw [hevalbase ℓ]
    simp
  have haT : evalx (d.a k) * ainv = 1 := by
    change (algebraMap (liftingPresentationModPiModel d) T)
        (liftingPresentationModPiElement d k) *
        IsLocalization.Away.invSelf (liftingPresentationModPiElement d k) = 1
    exact IsLocalization.Away.mul_invSelf _
  have evalx_a_isUnit : IsUnit
      ((MvPolynomial.C : T →+* B) (evalx (d.a k))) := by
    have hevalxa :
        (MvPolynomial.C : T →+* B) (evalx (d.a k)) =
          (MvPolynomial.C : T →+* B)
            ((algebraMap (liftingPresentationModPiModel d) T)
              (liftingPresentationModPiElement d k)) := by
      change (MvPolynomial.C : T →+* B)
          ((algebraMap (liftingPresentationModPiModel d) T)
            (p2mk ((MvPolynomial.map (piQuotientMk (π ^ 2))) (d.a k)))) = _
      rfl
    rw [hevalxa]
    exact IsUnit.map (MvPolynomial.C : T →+* B)
      (IsLocalization.Away.algebraMap_isUnit _)
  have bcorr : ∀ ℓ : Fin d.m,
      bmap (liftingCorrectionRelation π d.a d.h d.g d.selected k ℓ) = 0 := by
    have hX : ∀ t : Fin d.m,
        bmap (MvPolynomial.X (Sum.inr t)) =
          MvPolynomial.C ainv * ∑ j : Fin (d.e k),
            MvPolynomial.C (evalx (d.h k t j)) * MvPolynomial.X j := by
      intro t
      simp [bmap, bvar]
    have hXsel : ∀ j : Fin (d.e k),
        bmap (MvPolynomial.X (Sum.inr (d.selected k j))) =
          MvPolynomial.C ainv * MvPolynomial.C (evalx (d.a k)) *
            MvPolynomial.X j := by
      intro j
      rw [hX]
      rw [Finset.sum_eq_single j]
      · rw [d.selected_h]
        simp only [if_true]
        ring
      · intro b hb hbj
        rw [d.selected_h]
        simp [hbj]
      · intro hj
        exact (hj (Finset.mem_univ j)).elim
    have hCpi : bmap (MvPolynomial.C π) = 0 := by
      have hcoeff : bmap (MvPolynomial.C π) = bcoeff π := by
        simp [bmap]
      rw [hcoeff, bpi]
    intro ℓ
    have hrel :
        bmap (liftingCorrectionRelation π d.a d.h d.g d.selected k ℓ) =
          MvPolynomial.C (evalx (d.a k)) *
              (MvPolynomial.C ainv * ∑ j : Fin (d.e k),
                MvPolynomial.C (evalx (d.h k ℓ j)) * MvPolynomial.X j) -
            (∑ j : Fin (d.e k),
              MvPolynomial.C (evalx (d.h k ℓ j)) *
                (MvPolynomial.C ainv * MvPolynomial.C (evalx (d.a k)) *
                  MvPolynomial.X j)) - 0 := by
      change bmap (liftLiftingPolynomial (d.a k) *
          MvPolynomial.X (Sum.inr ℓ) -
        ∑ j : Fin (d.e k),
          liftLiftingPolynomial (d.h k ℓ j) *
            MvPolynomial.X (Sum.inr (d.selected k j)) -
        MvPolynomial.C π * liftLiftingPolynomial (d.g k ℓ)) = _
      calc
        bmap (liftLiftingPolynomial (d.a k) *
            MvPolynomial.X (Sum.inr ℓ) -
          ∑ j : Fin (d.e k),
            liftLiftingPolynomial (d.h k ℓ j) *
              MvPolynomial.X (Sum.inr (d.selected k j)) -
          MvPolynomial.C π * liftLiftingPolynomial (d.g k ℓ)) =
            bmap (liftLiftingPolynomial (d.a k)) *
                bmap (MvPolynomial.X (Sum.inr ℓ)) -
              (∑ j : Fin (d.e k),
                bmap (liftLiftingPolynomial (d.h k ℓ j)) *
                  bmap (MvPolynomial.X (Sum.inr (d.selected k j)))) -
              bmap (MvPolynomial.C π) *
                bmap (liftLiftingPolynomial (d.g k ℓ)) := by
          rw [map_sub, map_sub, map_mul, map_sum]
          simp only [map_mul]
        _ = _ := by
          simp only [bmap_lift, hXsel, hX, hCpi, zero_mul, sub_zero]
    rw [hrel]
    simp only [sub_zero]
    have hscalar :
        (MvPolynomial.C : T →+* B) (evalx (d.a k)) *
          (MvPolynomial.C : T →+* B) ainv = 1 := by
      rw [← map_mul, haT, map_one]
    have hleft :
        MvPolynomial.C (evalx (d.a k)) *
            (MvPolynomial.C ainv * ∑ j : Fin (d.e k),
              MvPolynomial.C (evalx (d.h k ℓ j)) * MvPolynomial.X j) =
          ∑ j : Fin (d.e k),
            (MvPolynomial.C (evalx (d.a k)) * MvPolynomial.C ainv) *
              (MvPolynomial.C (evalx (d.h k ℓ j)) * MvPolynomial.X j) := by
      rw [← mul_assoc, Finset.mul_sum]
    have hright :
        (∑ j : Fin (d.e k),
          MvPolynomial.C (evalx (d.h k ℓ j)) *
            (MvPolynomial.C ainv * MvPolynomial.C (evalx (d.a k)) *
              MvPolynomial.X j)) =
          ∑ j : Fin (d.e k),
            (MvPolynomial.C (evalx (d.a k)) * MvPolynomial.C ainv) *
              (MvPolynomial.C (evalx (d.h k ℓ j)) * MvPolynomial.X j) := by
      apply Finset.sum_congr rfl
      intro j hj
      ring
    rw [hleft, hright, hscalar]
    simp
  have hDideal : ∀ p : liftingPolynomial R d.n d.m,
      p ∈ liftingAuxiliaryDefiningIdeal d k → bmap p = 0 := by
    intro p hp
    have hle : liftingAuxiliaryDefiningIdeal d k ≤ Ideal.comap bmap ⊥ := by
      apply Ideal.span_le.2
      intro x hx
      rcases hx with hx | hx
      · rcases hx with ⟨j, rfl⟩
        exact bbase (d.selected k j)
      · rcases hx with ⟨ℓ, rfl⟩
        exact bcorr ℓ
    exact hle hp
  exact
    { p2mk := p2mk
      p2mk_spec := by
        intro p
        rfl
      evalx := evalx
      evalx_spec := by
        intro p
        rfl
      pmod := pmod
      pmod_spec := by
        intro r
        rfl
      pX := pX
      pX_spec := by
        intro i
        rfl
      bcoeff := bcoeff
      ainv := ainv
      ainv_spec := by
        rfl
      bvar := bvar
      bmap := bmap
      bmap_lift := bmap_lift
      bcoeff_spec := bcoeff_spec
      bmap_C := bmap_C
      bmap_X := bmap_X
      bvar_inl := bvar_inl
      bvar_inr := bvar_inr
      bpi := bpi
      bmap_pi := bmap_pi
      haT := haT
      evalx_a_isUnit := evalx_a_isUnit
      hDideal := hDideal }

private opaque liftingAuxiliary_modPi_solve_z_variables
    {R U : Type u} [CommRing R] [CommRing U] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r)
    (qmap : liftingPolynomial R d.n d.m →+* U) (ainv : U)
    (hpi : qmap (MvPolynomial.C π) = 0)
    (qcorr : ∀ ℓ : Fin d.m,
      qmap (liftingCorrectionRelation π d.a d.h d.g d.selected k ℓ) = 0)
    (hqainv : qmap (liftLiftingPolynomial (d.a k)) * ainv = 1) :
    ∀ ℓ : Fin d.m,
      qmap (MvPolynomial.X (Sum.inr ℓ)) =
        ainv * ∑ j : Fin (d.e k),
          qmap (liftLiftingPolynomial (d.h k ℓ j)) *
            qmap (MvPolynomial.X (Sum.inr (d.selected k j))) := by
  intro ℓ
  have h := qcorr ℓ
  change qmap (liftLiftingPolynomial (d.a k) *
      MvPolynomial.X (Sum.inr ℓ) -
    ∑ j : Fin (d.e k),
      liftLiftingPolynomial (d.h k ℓ j) *
        MvPolynomial.X (Sum.inr (d.selected k j)) -
    MvPolynomial.C π * liftLiftingPolynomial (d.g k ℓ)) = 0 at h
  rw [map_sub, map_sub, map_sum] at h
  simp only [map_mul] at h
  rw [hpi] at h
  have hmul : qmap (liftLiftingPolynomial (d.a k)) *
        qmap (MvPolynomial.X (Sum.inr ℓ)) =
      ∑ j : Fin (d.e k),
        qmap (liftLiftingPolynomial (d.h k ℓ j)) *
          qmap (MvPolynomial.X (Sum.inr (d.selected k j))) := by
    apply sub_eq_zero.mp
    simpa only [zero_mul, sub_zero] using h
  calc
    qmap (MvPolynomial.X (Sum.inr ℓ)) =
        1 * qmap (MvPolynomial.X (Sum.inr ℓ)) := by simp
    _ = (ainv * qmap (liftLiftingPolynomial (d.a k))) *
        qmap (MvPolynomial.X (Sum.inr ℓ)) := by
          rw [show ainv * qmap (liftLiftingPolynomial (d.a k)) = 1 by
            simpa [mul_comm] using hqainv]
    _ = ainv * (qmap (liftLiftingPolynomial (d.a k)) *
        qmap (MvPolynomial.X (Sum.inr ℓ))) := by ring
    _ = _ := congrArg (fun z => ainv * z) hmul

