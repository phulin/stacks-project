def TorsionToCompletionInjective {R M : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] (f : R) : Prop :=
  InjectiveOnModuleFPowerTorsion (M := M) (fAdicCompletionMap R f) f

def FirstTorsionToCompletionInjective {R M : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] (f : R) : Prop :=
  ∀ ⦃x y : M⦄,
    x ∈ idealPowerTorsionSubmodule (Ideal.span ({f} : Set R)) 1 →
    y ∈ idealPowerTorsionSubmodule (Ideal.span ({f} : Set R)) 1 →
    tensorUnitMapOfRingHom (M := M) (fAdicCompletionMap R f) x =
      tensorUnitMapOfRingHom (M := M) (fAdicCompletionMap R f) y → x = y

def FPowerTorsionIntersectionVanishing {R M : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] (f : R) : Prop :=
  ∀ x : M,
    x ∈ idealPowerTorsionSubmodule (Ideal.span ({f} : Set R)) 1 →
      (∀ n : ℕ, ∃ y : M, f ^ (n + 1) • y = x) → x = 0

theorem first_torsion_injective_iff_intersection_vanishing
    {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    (f : R) :
    FirstTorsionToCompletionInjective (M := M) f ↔
      FPowerTorsionIntersectionVanishing (M := M) f := by
  sorry

theorem glueable_of_torsion_to_completion_injective
    {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    (f : R) (hpair : IsSelfGlueingPair f)
    (hinj : TorsionToCompletionInjective (M := M) f) :
    IsSelfGlueable (M := M) f := by
