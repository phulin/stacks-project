/-! ## The two explicit non-glueing examples -/

open MvPolynomial

def firstBlRelationIdeal (k : Type u) [Field k] :
    Ideal (MvPolynomial (Option ℕ) k) :=
  Ideal.span
    ((Set.range (fun n : ℕ => X none * X (some n))) ∪
      (Set.range (fun n : ℕ =>
        X none * X (some (n + 1)) - X (some n))))

abbrev firstBlPresentedRing (k : Type u) [Field k] :=
  MvPolynomial (Option ℕ) k ⧸ firstBlRelationIdeal k

def firstBlF (k : Type u) [Field k] : firstBlPresentedRing k :=
  Ideal.Quotient.mk (firstBlRelationIdeal k) (X none)

def secondBlRelationIdeal (k : Type u) [Field k] :
    Ideal (MvPolynomial (Option ℕ) k) :=
  Ideal.span (Set.range (fun n : ℕ =>
    (X none) ^ (n + 1) * X (some n)))

abbrev secondBlPresentedRing (k : Type u) [Field k] :=
  MvPolynomial (Option ℕ) k ⧸ secondBlRelationIdeal k

def secondBlF (k : Type u) [Field k] : secondBlPresentedRing k :=
  Ideal.Quotient.mk (secondBlRelationIdeal k) (X none)

theorem first_presented_ring_is_not_a_glueing_pair
    (k : Type u) [Field k] :
    ¬ IsSelfGlueingPair (firstBlF k) := by
  sorry

theorem first_presented_ring_torsion_map_not_injective
    (k : Type u) [Field k] :
    ¬ InjectiveOnFPowerTorsion
      (fAdicCompletionMap (firstBlPresentedRing k) (firstBlF k))
      (firstBlF k) := by
  sorry

theorem second_presented_ring_torsion_map_not_surjective
    (k : Type u) [Field k] :
    ¬ SurjectiveOnFPowerTorsion
      (fAdicCompletionMap (secondBlPresentedRing k) (secondBlF k))
      (secondBlF k) := by
  sorry

/-! ## Faithfulness, finite generation, and spectra -/

def faithfulBaseChangePair {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  ∀ (M : ModuleCat.{u} R), Nontrivial (M : Type u) →
    Nontrivial (((ModuleCat.extendScalars φ).obj M : ModuleCat.{u} S) : Type u) ∨
      Nontrivial (((ModuleCat.extendScalars
        (algebraMap R (Localization.Away f))).obj M :
          ModuleCat.{u} (Localization.Away f)) : Type u)

theorem faithfulBaseChangePair_of_same_quotients
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hquot : SamePowerQuotients φ f) :
    faithfulBaseChangePair φ f := by
  sorry

theorem faithfulBaseChangePair_for_fAdicCompletion
    {R : Type u} [CommRing R] (f : R) :
    faithfulBaseChangePair (fAdicCompletionMap R f) f := by
  apply faithfulBaseChangePair_of_same_quotients
  exact same_quotients_for_fAdicCompletion f

def spectrumCoverSurjective {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  ∀ p : PrimeSpectrum R,
    (∃ q : PrimeSpectrum S, PrimeSpectrum.comap φ q = p) ∨
      (∃ q : PrimeSpectrum (Localization.Away f),
        PrimeSpectrum.comap (algebraMap R (Localization.Away f)) q = p)

theorem spectrum_cover_surjective_of_mod_f_isomorphism
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R)
    (hquot : Function.Bijective (powerQuotientMap φ f 1)) :
    spectrumCoverSurjective φ f := by
  sorry

theorem spectrum_cover_surjective_for_fAdicCompletion
    {R : Type u} [CommRing R] (f : R) :
    spectrumCoverSurjective (fAdicCompletionMap R f) f := by
  apply spectrum_cover_surjective_of_mod_f_isomorphism
  simpa using (same_quotients_for_fAdicCompletion f 1 (Nat.zero_lt_succ 0))

theorem finite_generation_descends_along_bl_cover
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hquot : SamePowerQuotients φ f)
    (M : ModuleCat.{u} R) :
    Module.Finite R (M : Type u) ↔
      (Module.Finite S
          (((ModuleCat.extendScalars φ).obj M : ModuleCat.{u} S) : Type u) ∧
        Module.Finite (Localization.Away f)
          (((ModuleCat.extendScalars (algebraMap R (Localization.Away f))).obj M :
            ModuleCat.{u} (Localization.Away f)) : Type u)) := by
  sorry

theorem finite_generation_descends_for_fAdicCompletion
    {R : Type u} [CommRing R] (f : R) (M : ModuleCat.{u} R) :
    Module.Finite R (M : Type u) ↔
      (Module.Finite (fAdicCompletion R f)
          (((ModuleCat.extendScalars (fAdicCompletionMap R f)).obj M :
            ModuleCat.{u} (fAdicCompletion R f)) : Type u) ∧
        Module.Finite (Localization.Away f)
          (((ModuleCat.extendScalars (algebraMap R (Localization.Away f))).obj M :
            ModuleCat.{u} (Localization.Away f)) : Type u)) := by
  sorry

/-! ## Glueable modules -/

def moduleCechLeftMap {R S M : Type u} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (φ : R →+* S) (f : R) :
    M →
      (((blCanFunctor φ f).obj (ModuleCat.of R M)).obj.left : Type u) ×
        (((blCanFunctor φ f).obj (ModuleCat.of R M)).obj.right : Type u) :=
  fun x => moduleFiberProductPair (blRingSquare φ f)
    ((blCanFunctor φ f).obj (ModuleCat.of R M))
    ((blCanH0Unit φ f (ModuleCat.of R M)).hom x)

def moduleCechRightMap {R S M : Type u} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (φ : R →+* S) (f : R) :
    (((blCanFunctor φ f).obj (ModuleCat.of R M)).obj.left : Type u) ×
        (((blCanFunctor φ f).obj (ModuleCat.of R M)).obj.right : Type u) →
      (moduleFiberCommonTarget (blRingSquare φ f)
        ((blCanFunctor φ f).obj (ModuleCat.of R M)) : Type u) :=
  fun x =>
    (moduleFiberLeftMap (blRingSquare φ f)
      ((blCanFunctor φ f).obj (ModuleCat.of R M))).hom x.1 -
      (moduleFiberRightMap (blRingSquare φ f)
        ((blCanFunctor φ f).obj (ModuleCat.of R M))).hom x.2

def ModuleCechExactOnRight {R S M : Type u} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (φ : R →+* S) (f : R) : Prop :=
  Function.Surjective (moduleCechRightMap (M := M) φ f)

def ModuleCechExactOnLeft {R S M : Type u} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (φ : R →+* S) (f : R) : Prop :=
  Function.Injective (moduleCechLeftMap (M := M) φ f)

def ModuleCechExactInMiddle {R S M : Type u} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (φ : R →+* S) (f : R) : Prop :=
  Function.Exact (moduleCechLeftMap (M := M) φ f)
    (moduleCechRightMap (M := M) φ f)

def ModuleCechSequenceExact {R S M : Type u} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (φ : R →+* S) (f : R) : Prop :=
  ModuleCechExactOnLeft (M := M) φ f ∧
    ModuleCechExactInMiddle (M := M) φ f ∧
      ModuleCechExactOnRight (M := M) φ f

def IsGlueable {R S M : Type u} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (φ : R →+* S) (f : R) : Prop :=
  ModuleCechSequenceExact (M := M) φ f

def IsSelfGlueable {R M : Type u} [CommRing R] [AddCommGroup M]
    [Module R M] (f : R) : Prop :=
  IsGlueable (M := M) (fAdicCompletionMap R f) f

structure NonGlueableModuleWitness {R M : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] (f : R) : Prop where
  regular : IsRegular f
  pair : IsSelfGlueingPair f
  torsionWitness : ∃ x : M, x ≠ 0 ∧
    x ∈ fPowerTorsionSubmoduleAt f 1 ∧
      tensorUnitMapOfRingHom (M := M) (fAdicCompletionMap R f) x = 0
  notGlueable : ¬ IsSelfGlueable (M := M) f

theorem exists_nonGlueableModuleWitness :
    ∃ (R M : Type u) (_ : CommRing R) (_ : AddCommGroup M) (_ : Module R M)
      (f : R), NonGlueableModuleWitness (M := M) f := by
  sorry

def InjectiveOnModuleFPowerTorsion {R S M : Type u}
    [CommRing R] [CommRing S] [AddCommGroup M] [Module R M]
    (φ : R →+* S) (f : R) : Prop :=
  ∀ ⦃x y : M⦄,
    x ∈ fPowerTorsionSubmodule f → y ∈ fPowerTorsionSubmodule f →
      tensorUnitMapOfRingHom (M := M) φ x =
        tensorUnitMapOfRingHom (M := M) φ y → x = y

/- The two optimized hypotheses highlighted in the introduction: bijectivity
on ring `f`-power torsion and injectivity on the torsion of a module after
base change. -/
def BeauvilleLaszloHypotheses {R S M : Type u}
    [CommRing R] [CommRing S] [AddCommGroup M] [Module R M]
    (φ : R →+* S) (f : R) : Prop :=
  BijectiveOnFPowerTorsion φ f ∧
    InjectiveOnModuleFPowerTorsion (M := M) φ f

noncomputable def moduleBaseChangeUnit {R S M : Type u}
    [CommRing R] [CommRing S] [AddCommGroup M] [Module R M]
    (φ : R →+* S) (x : M) :
    ((ModuleCat.extendScalars φ).obj (ModuleCat.of R M) : Type u) :=
  ((ModuleCat.extendRestrictScalarsAdj φ).unit.app
    (ModuleCat.of R M)).hom x

def SurjectiveOnModuleFPowerTorsion {R S M : Type u}
    [CommRing R] [CommRing S] [AddCommGroup M] [Module R M]
    (φ : R →+* S) (f : R) : Prop :=
  ∀ y : ((ModuleCat.extendScalars φ).obj (ModuleCat.of R M) : Type u),
    (∃ n : ℕ, 0 < n ∧ (φ f) ^ n • y = 0) →
      ∃ x : M, x ∈ fPowerTorsionSubmodule f ∧
        moduleBaseChangeUnit φ x = y

theorem beauvilleLaszloHypotheses_of_nonzerodivisors
    {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    (f : R) (hR : IsRegular f) (hM : IsFRegularOnModule (M := M) f) :
    BeauvilleLaszloHypotheses (M := M) (fAdicCompletionMap R f) f := by
  sorry

