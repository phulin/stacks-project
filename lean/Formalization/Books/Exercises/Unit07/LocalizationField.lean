import Mathlib.Algebra.Polynomial.RingDivision
import Mathlib.RingTheory.Ideal.Maximal
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Spectrum.Prime.Basic

/-!
# Exercises, Chapter 7: Localization

This file gives an explicit pair for the field-localization exercise.  The
base ring is a polynomial ring over `ℚ`, localized away from the two prime
ideals generated by `X` and `X - 1`; inverting their product then gives the
fraction field while the original ring still has the zero prime and the two
displayed prime ideals.
-/

noncomputable section

namespace Formalization.Books.Exercises.Unit07

/-! ## A domain with a field principal localization -/

abbrev localizationFieldBaseRing : Type := Polynomial ℚ

/-- The prime ideal `(X)` in `ℚ[X]`. -/
def localizationFieldOriginIdeal : Ideal localizationFieldBaseRing :=
  Ideal.span {(Polynomial.X : localizationFieldBaseRing)}

instance localizationFieldOriginIdeal_isPrime :
    localizationFieldOriginIdeal.IsPrime := by
  exact Ideal.isPrime_span_singleton_of_prime Polynomial.prime_X

/-- The prime ideal `(X - 1)` in `ℚ[X]`. -/
def localizationFieldOneIdeal : Ideal localizationFieldBaseRing :=
  Ideal.span {Polynomial.X - Polynomial.C (1 : ℚ)}

instance localizationFieldOneIdeal_isPrime : localizationFieldOneIdeal.IsPrime := by
  exact Ideal.isPrime_span_singleton_of_prime (Polynomial.prime_X_sub_C (1 : ℚ))

/-- The multiplicative subset of `ℚ[X]` consisting of polynomials outside both
`(X)` and `(X - 1)`. -/
def localizationFieldSubmonoid : Submonoid localizationFieldBaseRing :=
  localizationFieldOriginIdeal.primeCompl ⊓ localizationFieldOneIdeal.primeCompl

/-- The explicit domain used in the exercise. -/
abbrev localizationFieldExampleRing : Type :=
  Localization localizationFieldSubmonoid

/-- The product of the two excluded prime generators, viewed in the localized
ring. -/
def localizationFieldExampleElement : localizationFieldExampleRing :=
  algebraMap localizationFieldBaseRing localizationFieldExampleRing
    (Polynomial.X * (Polynomial.X - Polynomial.C (1 : ℚ)))

/-- The source's principal localization `A_f` for the displayed pair. -/
abbrev localizationFieldPrincipalLocalization : Type :=
  Localization.Away localizationFieldExampleElement

/-- The displayed pair has a domain as its first component, at least three
pairwise distinct prime ideals, and a field as its principal localization. -/
theorem localization_field_example :
    IsDomain localizationFieldExampleRing ∧
      (∃ p q r : PrimeSpectrum localizationFieldExampleRing,
        p ≠ q ∧ p ≠ r ∧ q ≠ r) ∧
        IsField localizationFieldPrincipalLocalization := by
  sorry

end Formalization.Books.Exercises.Unit07
