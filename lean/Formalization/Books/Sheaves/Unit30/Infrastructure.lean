          exact Opens.mem_iSup.mpr ⟨⟨i, hi⟩, hxV⟩
      let R : Presieve U.unop := TopCat.Presheaf.presieveOfCoveringAux A U.unop
      have hR : Sieve.generate R ∈ Opens.grothendieckTopology X U.unop := by
        change Sieve.generate
