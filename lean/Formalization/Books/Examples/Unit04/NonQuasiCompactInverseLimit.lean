import Mathlib.CategoryTheory.Limits.Types.Limits
import Mathlib.Order.Directed
import Mathlib.Topology.Bases
import Mathlib.Topology.Category.TopCat.Limits.Basic
import Mathlib.Topology.Compactness.Compact

/-!
# Examples, Chapter 4: Non-quasi-compact inverse limit of quasi-compact spaces

The source constructs a decreasing family of topologies on `ℕ`.  The
topologies below use the canonical `Set.Ioi` notation for the tails.  Since
Lean's `ℕ` contains `0`, the finite singleton part of the basis is indexed by
`k ≤ n`; this is the corresponding version of the source's
`{1}, ..., {n}` basis when natural numbers are taken to start at `1`.
The inverse system and its limit are expressed in Mathlib's category `TopCat`.
-/

open CategoryTheory CategoryTheory.Limits
open Set TopologicalSpace
open Opposite

namespace Formalization.Books.Examples.Unit04

/-! ## The finite-tail topologies -/

/-- The tail `Iₙ = {k | n < k}` from the source. -/
def tailSet (n : ℕ) : Set ℕ := Set.Ioi n

/-- The singleton-and-tail basis used to generate `Tₙ`. -/
def basicOpen (n : ℕ) : Set (Set ℕ) :=
  {U | ∃ k ≤ n, U = ({k} : Set ℕ)} ∪ {tailSet n}

/-! The topology generated by the singleton-and-tail basis. -/
@[instance_reducible]
def topologyAt (n : ℕ) : TopologicalSpace ℕ :=
  TopologicalSpace.generateFrom (basicOpen n)

/-- The source's assertion that the displayed family is a topological basis. -/
theorem topologyAt_has_basis (n : ℕ) :
    @TopologicalSpace.IsTopologicalBasis ℕ (topologyAt n) (basicOpen n) := by
  sorry

/-- The displayed basis determines `topologyAt n` uniquely. -/
theorem topologyAt_unique (n : ℕ) {t : TopologicalSpace ℕ}
    (h : @TopologicalSpace.IsTopologicalBasis ℕ t (basicOpen n)) :
    t = topologyAt n := by
  simpa [topologyAt] using h.eq_generateFrom

/-- Every singleton occurring in the finite part of the basis is open. -/
theorem basic_singleton_open (n k : ℕ) (hk : k ≤ n) :
    @IsOpen ℕ (topologyAt n) ({k} : Set ℕ) := by
  rw [topologyAt]
  exact isOpen_generateFrom_of_mem (Or.inl ⟨k, hk, rfl⟩)

/-- The tail is open in its corresponding topology. -/
theorem tailSet_open (n : ℕ) :
    @IsOpen ℕ (topologyAt n) (tailSet n) := by
  rw [topologyAt]
  exact isOpen_generateFrom_of_mem (Or.inr rfl)

/-! The topologies become finer as the index increases.  The order on
`TopologicalSpace` is the reverse of inclusion of open sets. -/
theorem topologyAt_antitone {m n : ℕ} (h : m ≤ n) :
    topologyAt n ≤ topologyAt m := by
  sorry

/-- The identity map from a later stage to an earlier stage is continuous. -/
theorem identity_continuous {m n : ℕ} (h : m ≤ n) :
    @Continuous ℕ ℕ (topologyAt n) (topologyAt m) id := by
  rw [continuous_iff_le_induced]
  simpa only [induced_id] using topologyAt_antitone h

/-- The topological space `Xₙ = (ℕ, Tₙ)`. -/
def X (n : ℕ) : TopCat :=
  @TopCat.of ℕ (topologyAt n)

/-! ## The inverse system -/

/-- The identity transition map `Xₙ → Xₘ` for `m ≤ n`. -/
def transition {m n : ℕ} (h : m ≤ n) : X n ⟶ X m :=
  @TopCat.ofHom ℕ ℕ (topologyAt n) (topologyAt m)
    (@ContinuousMap.mk ℕ ℕ (topologyAt n) (topologyAt m) id (identity_continuous h))

/-- The strict-index version of the source's transition maps `fₙ,ₘ`. -/
def f (n m : ℕ) (h : m < n) : X n ⟶ X m :=
  transition (Nat.le_of_lt h)

/-- The strict transition maps are continuous identity maps. -/
theorem f_continuous (n m : ℕ) (h : m < n) :
    Continuous ((f n m h : X n ⟶ X m) : X n → X m) := by
  exact (f n m h).hom.2

/-- The transition maps satisfy the composition law of the source. -/
theorem transition_comp {k j i : ℕ} (hkj : k ≤ j) (hji : j ≤ i) :
    transition hji ≫ transition hkj = transition (hkj.trans hji) := by
  apply TopCat.ext
  intro x
  change (transition hkj : X j → X k) ((transition hji : X i → X j) x) =
    (transition (hkj.trans hji) : X i → X k) x
  rfl

/-- The strict-index form of the transition composition identity. -/
theorem f_comp {m n p : ℕ} (hmn : m < n) (hnp : n < p) :
    f p n hnp ≫ f n m hmn = f p m (hmn.trans hnp) := by
  apply TopCat.ext
  intro x
  change (f n m hmn : X n → X m) ((f p n hnp : X p → X n) x) =
    (f p m (hmn.trans hnp) : X p → X m) x
  rfl

/-- The directed inverse system of the spaces `Xₙ`. -/
def inverseSystem : ℕᵒᵖ ⥤ TopCat where
  obj i := X i.unop
  map {i j} p := transition p.unop.le
  map_id := by
    intro i
    apply TopCat.ext
    intro x
    change (transition (m := i.unop) (n := i.unop) (le_refl _) :
      X i.unop → X i.unop) x = x
    rfl
  map_comp := by
    intro i j k p q
    apply TopCat.ext
    intro x
    change (transition (p ≫ q).unop.le : X i.unop → X k.unop) x =
      (transition q.unop.le : X j.unop → X k.unop)
        ((transition p.unop.le : X i.unop → X j.unop) x)
    rfl

/-- Each stage is quasi-compact in the sense of Mathlib's `CompactSpace`. -/
theorem X_is_quasiCompact (n : ℕ) : CompactSpace (X n : Type) := by
  sorry

/-- The index order is directed, and every object of `inverseSystem` is quasi-compact. -/
theorem inverseSystem_is_directed_quasiCompact :
    IsDirectedOrder ℕ ∧ ∀ n : ℕ, CompactSpace (X n : Type) := by
  refine ⟨inferInstance, ?_⟩
  intro n
  exact X_is_quasiCompact n

/-! ## The discrete limit and the universal property -/

/-- The discrete space `X = (ℕ, T)` from the source. -/
abbrev limitSpace : TopCat := TopCat.discrete.obj ℕ

/-- Every map from the discrete topology to a stage is continuous. -/
theorem discrete_to_stage_continuous (n : ℕ) :
    @Continuous ℕ ℕ (⊥ : TopologicalSpace ℕ) (topologyAt n) id := by
  sorry

/-- The identity map from the discrete space to the `n`-th stage. -/
def limitProjection (n : ℕ) : limitSpace ⟶ X n :=
  @TopCat.ofHom ℕ ℕ (⊥ : TopologicalSpace ℕ) (topologyAt n)
    (@ContinuousMap.mk ℕ ℕ (⊥ : TopologicalSpace ℕ) (topologyAt n)
      id (discrete_to_stage_continuous n))

/-- The projections are the identity functions on the underlying set. -/
theorem limitProjection_apply (n : ℕ) (x : limitSpace) :
    limitProjection n x = x := by
  change (id : ℕ → ℕ) x = x
  rfl

/-- The cone with point `limitSpace` and the identity projections. -/
def limitCone : Cone inverseSystem where
  pt := limitSpace
  π :=
    { app := fun i => limitProjection i.unop
      naturality := by
        intro i j p
        apply TopCat.ext
        intro x
        change (limitProjection j.unop : limitSpace → X j.unop) x =
          (transition p.unop.le : X i.unop → X j.unop)
            ((limitProjection i.unop : limitSpace → X i.unop) x)
        rfl }

/-- The discrete space is a categorical inverse limit of the system. -/
theorem limitCone_isLimit_exists : Nonempty (IsLimit limitCone) := by
  sorry

/-- A chosen limit proof for `limitCone`. -/
noncomputable def limitCone_isLimit : IsLimit limitCone :=
  Classical.choice limitCone_isLimit_exists

/-- Strict compatibility of a family of maps into the stages. -/
def StrictlyCompatible {Y : TopCat} (g : ∀ n : ℕ, Y ⟶ X n) : Prop :=
  ∀ ⦃m n : ℕ⦄ (h : m < n), g n ≫ f n m h = g m

/-- The common underlying set map of a compatible family. -/
def commonMap {Y : TopCat} (g : ∀ n : ℕ, Y ⟶ X n) : Y → ℕ :=
  fun y => g 0 y

/-- Compatibility forces all underlying maps to be the common set map. -/
theorem compatible_commonMap {Y : TopCat} (g : ∀ n : ℕ, Y ⟶ X n)
    (hg : StrictlyCompatible g) (n : ℕ) :
    (g n : Y → ℕ) = commonMap g := by
  sorry

/-- In particular, the singleton `{n}` is open in `Xₙ`. -/
theorem singleton_open_in_X (n : ℕ) :
    @IsOpen ℕ (topologyAt n) ({n} : Set ℕ) := by
  exact basic_singleton_open n n le_rfl

/-- The preimage of a singleton under the common map agrees with the stagewise preimage. -/
theorem commonMap_preimage_singleton {Y : TopCat}
    (g : ∀ n : ℕ, Y ⟶ X n) (hg : StrictlyCompatible g) (n : ℕ) :
    commonMap g ⁻¹' ({n} : Set ℕ) =
      (g n : Y → ℕ) ⁻¹' ({n} : Set ℕ) := by
  sorry

/-- Each singleton preimage of the common map is open in `Y`. -/
theorem commonMap_preimage_singleton_isOpen {Y : TopCat}
    (g : ∀ n : ℕ, Y ⟶ X n) (hg : StrictlyCompatible g) (n : ℕ) :
    IsOpen (commonMap g ⁻¹' ({n} : Set ℕ)) := by
  rw [commonMap_preimage_singleton g hg n]
  exact (g n).hom.2.isOpen_preimage _ (singleton_open_in_X n)

/-- The common set map is continuous to the discrete topology. -/
theorem commonMap_continuous {Y : TopCat}
    (g : ∀ n : ℕ, Y ⟶ X n) (hg : StrictlyCompatible g) :
    @Continuous Y ℕ Y.str (⊥ : TopologicalSpace ℕ) (commonMap g) := by
  sorry

/-- The continuous map to the discrete limit induced by a compatible family. -/
def commonMapHom {Y : TopCat} (g : ∀ n : ℕ, Y ⟶ X n)
    (hg : StrictlyCompatible g) : Y ⟶ limitSpace :=
  TopCat.ofHom ⟨commonMap g, commonMap_continuous g hg⟩

/-- The induced map has the prescribed stagewise components. -/
theorem commonMapHom_comp_projection {Y : TopCat}
    (g : ∀ n : ℕ, Y ⟶ X n) (hg : StrictlyCompatible g) (n : ℕ) :
    commonMapHom g hg ≫ limitProjection n = g n := by
  sorry

/-- The induced map is the unique map with those prescribed components. -/
theorem commonMapHom_unique {Y : TopCat}
    (g : ∀ n : ℕ, Y ⟶ X n) (hg : StrictlyCompatible g)
    (l : Y ⟶ limitSpace)
    (hl : ∀ n : ℕ, l ≫ limitProjection n = g n) :
    l = commonMapHom g hg := by
  sorry

/-! ## The singleton cover and non-quasi-compactness -/

/-- The open-cover family of singleton subsets of the discrete limit. -/
def singletonCover (n : ℕ) : Set ℕ := {n}

/-- Every member of the singleton cover is open in the discrete limit. -/
theorem singletonCover_isOpen (n : ℕ) :
    @IsOpen ℕ (⊥ : TopologicalSpace ℕ) (singletonCover n) := by
  sorry

/-- The singleton family covers the whole underlying set. -/
theorem singletonCover_covers :
    (Set.univ : Set ℕ) ⊆ ⋃ n : ℕ, singletonCover n := by
  intro n _
  exact mem_iUnion.2 ⟨n, by simp [singletonCover]⟩

/-- No finite subfamily of the singleton cover covers `ℕ`. -/
theorem singletonCover_no_finite_subcover :
    ¬ ∃ t : Finset ℕ, (Set.univ : Set ℕ) ⊆ ⋃ n ∈ t, singletonCover n := by
  sorry

/-- The discrete inverse-limit space is not quasi-compact. -/
theorem limitSpace_not_quasiCompact : ¬ CompactSpace (limitSpace : Type) := by
  sorry

/-! ## The chapter lemma -/

/-- There is an inverse system of quasi-compact spaces over `ℕ` with a
non-quasi-compact limit cone. -/
lemma exists_nonQuasiCompact_inverse_limit :
    ∃ F : ℕᵒᵖ ⥤ TopCat,
      (∀ n : ℕ, CompactSpace (F.obj (op n) : Type)) ∧
        ∃ C : Cone F, Nonempty (IsLimit C) ∧ ¬ CompactSpace (C.pt : Type) := by
  refine ⟨inverseSystem, ?_, limitCone, ⟨limitCone_isLimit⟩, ?_⟩
  · intro n
    change CompactSpace (X n : Type)
    exact X_is_quasiCompact n
  · exact limitSpace_not_quasiCompact

end Formalization.Books.Examples.Unit04
