/-- The source's isomorphism `M ≅ I`, made available as a linear equivalence. -/
noncomputable def zeroDimensionalFlatIdealModuleToIdealEquiv
    (k : Type u) [Field k] :
    zeroDimensionalFlatIdealModule k ≃ₗ[zeroDimensionalFlatIdealRing k]
      zeroDimensionalFlatIdeal k :=
  LinearEquiv.ofBijective (zeroDimensionalFlatIdealModuleToIdeal k)
    (zeroDimensionalFlatIdealModuleToIdeal_bijective k)

theorem zeroDimensionalFlatIdealModuleToIdealEquiv_generator
    (k : Type u) [Field k] (i : ℕ) :
    zeroDimensionalFlatIdealModuleToIdealEquiv k
        (zeroDimensionalFlatIdealModuleGenerator k i) =
