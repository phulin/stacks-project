namespace Formalization.Books.Exercises.Unit14

universe u v w

noncomputable section

/-! ## The node and its cubic perturbations -/

/-- The formal power-series ring in the two variables used for a node. -/
abbrev twoVariablePowerSeries (k : Type u) [Field k] :=
  MvPowerSeries (Fin 2) k

/-- The ideal generated by the two formal variables. -/
def twoVariableMaximalIdeal (k : Type u) [Field k] :
    Ideal (twoVariablePowerSeries k) :=
  Ideal.span (Set.range (fun i : Fin 2 => MvPowerSeries.X i))

/-! ### Coordinate changes and principal quotients -/

/-- A substitution is tangent to the identity when its coordinates agree with
the original coordinates through degree one. -/
def IsTangentToIdentitySubstitution
    {k : Type u} [Field k]
    (a : Fin 2 → twoVariablePowerSeries k) : Prop :=
  ∀ i, a i - MvPowerSeries.X i ∈ twoVariableMaximalIdeal k ^ 2

/-- The `HasSubst` witness supplied by zero constant coefficients. -/
theorem zeroConstantCoeffHasSubst
    {k : Type u} [Field k]
    (a : Fin 2 → twoVariablePowerSeries k)
    (ha : ∀ i, MvPowerSeries.constantCoeff (a i) = 0) :
    MvPowerSeries.HasSubst a :=
  MvPowerSeries.hasSubst_of_constantCoeff_zero ha

/-- The algebra homomorphism associated to a convergent substitution of the
two formal variables. -/
noncomputable def powerSeriesSubstitutionAlgHom
    {k : Type u} [Field k]
    (a : Fin 2 → twoVariablePowerSeries k)
    (ha : ∀ i, MvPowerSeries.constantCoeff (a i) = 0) :
    twoVariablePowerSeries k →ₐ[k] twoVariablePowerSeries k :=
  MvPowerSeries.substAlgHom (zeroConstantCoeffHasSubst a ha)

/-- Data for a substitution of `k[[x,y]]` tangent to the identity. -/
structure TangentToIdentitySubstitution (k : Type u) [Field k] where
  coordinates : Fin 2 → twoVariablePowerSeries k
  constantCoeff_zero :
    ∀ i, MvPowerSeries.constantCoeff (coordinates i) = 0
  tangent_to_identity : IsTangentToIdentitySubstitution coordinates

/-- The algebra homomorphism represented by a tangent-to-identity
substitution. -/
noncomputable def TangentToIdentitySubstitution.toAlgHom
    {k : Type u} [Field k]
    (s : TangentToIdentitySubstitution k) :
    twoVariablePowerSeries k →ₐ[k] twoVariablePowerSeries k :=
  powerSeriesSubstitutionAlgHom s.coordinates s.constantCoeff_zero

@[simp]
theorem TangentToIdentitySubstitution.toAlgHom_X
    {k : Type u} [Field k]
    (s : TangentToIdentitySubstitution k) (i : Fin 2) :
    s.toAlgHom (MvPowerSeries.X i) = s.coordinates i := by
  unfold TangentToIdentitySubstitution.toAlgHom powerSeriesSubstitutionAlgHom
  exact MvPowerSeries.substAlgHom_X _ i

/-- A pair of mutually inverse tangent-to-the-identity substitutions. -/
structure TangentToIdentityAutomorphism (k : Type u) [Field k] where
  forward : TangentToIdentitySubstitution k
  inverse : TangentToIdentitySubstitution k
  left_inverse :
    ∀ f, inverse.toAlgHom (forward.toAlgHom f) = f
  right_inverse :
    ∀ f, forward.toAlgHom (inverse.toAlgHom f) = f

/-- The algebra equivalence represented by a pair of inverse substitutions. -/
noncomputable def TangentToIdentityAutomorphism.toAlgEquiv
    {k : Type u} [Field k]
    (s : TangentToIdentityAutomorphism k) :
    twoVariablePowerSeries k ≃ₐ[k] twoVariablePowerSeries k :=
  AlgEquiv.ofBijective s.forward.toAlgHom
    ⟨fun f g h => by
      calc
        f = s.inverse.toAlgHom (s.forward.toAlgHom f) := (s.left_inverse f).symm
        _ = s.inverse.toAlgHom (s.forward.toAlgHom g) := congrArg _ h
        _ = g := s.left_inverse g,
      fun f => ⟨s.inverse.toAlgHom f, s.right_inverse f⟩⟩

/-- Tangency to the identity for an algebra automorphism of the formal power
series ring. -/
def IsTangentToIdentityAlgEquiv
    {K : Type v} [Field K]
    (e : MvPowerSeries (Fin 2) K ≃ₐ[K] MvPowerSeries (Fin 2) K) : Prop :=
  ∀ i, e (MvPowerSeries.X i) - MvPowerSeries.X i ∈ twoVariableMaximalIdeal K ^ 2

/-- Transport a principal ideal along a ring equivalence. -/
def principalIdealTransport
    {R : Type u} [CommRing R] {S : Type v} [CommRing S]
    (e : R ≃+* S) (f : R) : Ideal S :=
  Ideal.map (e : R →+* S) (Ideal.span {f})

/-- The principal ideal generated by a unit multiple of an element is the
same principal ideal. -/
theorem principalIdeal_unitMultiple
    {R : Type u} [CommRing R] (u : Rˣ) (f : R) :
    Ideal.span ({(u : R) * f} : Set R) = Ideal.span {f} := by
  simpa using Ideal.span_singleton_mul_left_unit u.isUnit f

/-- The principal quotient transported by a ring equivalence. -/
noncomputable def principalQuotientEquivOfRingEquiv
    {R : Type u} [CommRing R] {S : Type v} [CommRing S]
    (e : R ≃+* S) (f : R) :
    R ⧸ Ideal.span {f} ≃+* S ⧸ principalIdealTransport e f :=
  Ideal.quotientEquiv (Ideal.span {f}) (principalIdealTransport e f) e rfl

/-- The quotient equivalence induced by replacing an equation by a unit
multiple. -/
noncomputable def principalQuotientEquivOfUnitMultiple
    {R : Type u} [CommRing R] (u : Rˣ) (f : R) :
    R ⧸ Ideal.span {f} ≃+* R ⧸ Ideal.span ({(u : R) * f} : Set R) :=
  Ideal.quotEquivOfEq (principalIdeal_unitMultiple u f).symm

/-- A formal Morse datum consists of a tangent-to-the-identity coordinate
change and the unit relating the two principal equations. -/
structure FormalMorseData (k : Type u) [Field k]
    {K : Type v} [Field K] [Algebra k K]
    (f g : MvPowerSeries (Fin 2) K) where
  coordinateChange : MvPowerSeries (Fin 2) K ≃ₐ[K] MvPowerSeries (Fin 2) K
  tangent_to_identity : IsTangentToIdentityAlgEquiv coordinateChange
  unit : (MvPowerSeries (Fin 2) K)ˣ
  equation : coordinateChange f = (unit : MvPowerSeries (Fin 2) K) * g

/-- A formal Morse datum transports the principal ideal of its equation. -/
theorem FormalMorseData.map_principalIdeal
    {k : Type u} [Field k]
    {K : Type v} [Field K] [Algebra k K]
    {f g : MvPowerSeries (Fin 2) K} (M : FormalMorseData k f g) :
    Ideal.map (M.coordinateChange : MvPowerSeries (Fin 2) K →+*
      MvPowerSeries (Fin 2) K) (Ideal.span {f}) = Ideal.span {g} := by
  rw [Ideal.map_span, Set.image_singleton]
  have h :
      (M.coordinateChange : MvPowerSeries (Fin 2) K →+*
        MvPowerSeries (Fin 2) K) f =
        (M.unit : MvPowerSeries (Fin 2) K) * g := M.equation
  rw [h]
  exact principalIdeal_unitMultiple M.unit g

/-- The quotient algebra equivalence attached to formal Morse data. -/
noncomputable def FormalMorseData.quotientAlgEquiv
    {k : Type u} [Field k]
    {K : Type v} [Field K] [Algebra k K]
    {f g : MvPowerSeries (Fin 2) K} (M : FormalMorseData k f g) :
    (MvPowerSeries (Fin 2) K ⧸ Ideal.span {f}) ≃ₐ[k]
      (MvPowerSeries (Fin 2) K ⧸ Ideal.span {g}) :=
  Ideal.quotientEquivAlg (Ideal.span {f}) (Ideal.span {g})
    (M.coordinateChange.restrictScalars k) (by
      change Ideal.span {g} =
        Ideal.map (M.coordinateChange : MvPowerSeries (Fin 2) K →+*
          MvPowerSeries (Fin 2) K) (Ideal.span {f})
      exact M.map_principalIdeal.symm)

/-- The equation `xy` for the ordinary node. -/
def nodeEquation (k : Type u) [Field k] : twoVariablePowerSeries k :=
  MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2)

/-- The equation `uv + δ` in the perturbed presentation. -/
def perturbedNodeEquation (k : Type u) [Field k]
    (δ : twoVariablePowerSeries k) : twoVariablePowerSeries k :=
  nodeEquation k + δ

/-- The convergent two-variable formal Morse lemma for the node. -/
theorem formalMorse_node
    {k : Type u} [Field k] (δ : twoVariablePowerSeries k)
    (hδ : δ ∈ twoVariableMaximalIdeal k ^ 3) :
    Nonempty (FormalMorseData k (nodeEquation k) (perturbedNodeEquation k δ)) := by
  sorry

/-- The quotient ring `k[[x,y]]/(xy)`. -/
abbrev nodeRing (k : Type u) [Field k] :=
  twoVariablePowerSeries k ⧸ Ideal.span {nodeEquation k}

/-- The quotient ring `k[[u,v]]/(uv + δ)`. -/
abbrev perturbedNodeRing (k : Type u) [Field k]
    (δ : twoVariablePowerSeries k) :=
  twoVariablePowerSeries k ⧸ Ideal.span {perturbedNodeEquation k δ}

/-- A cubic perturbation of the node has the same quotient ring up to isomorphism. -/
theorem nodeRing_equiv_perturbedNodeRing
    {k : Type u} [Field k] (δ : twoVariablePowerSeries k)
    (hδ : δ ∈ twoVariableMaximalIdeal k ^ 3) :
    Nonempty (nodeRing k ≃+* perturbedNodeRing k δ) := by
  obtain ⟨M⟩ := formalMorse_node δ hδ
  exact ⟨M.quotientAlgEquiv.toRingEquiv⟩

/-! ## Ordinary double points -/

/-- A binary quadratic form written in the coordinates used by the source. -/
def binaryQuadraticFormOfCoefficients
    {K : Type v} [Field K] (a b c : K) :
    QuadraticForm K (Fin 2 → K) :=
  a • QuadraticMap.proj (R := K) (A := K) (0 : Fin 2) 0 +
      b • QuadraticMap.proj (R := K) (A := K) (0 : Fin 2) 1 +
      c • QuadraticMap.proj (R := K) (A := K) (1 : Fin 2) 1

/-- The same quadratic expression regarded as a power series. -/
def binaryQuadraticPowerSeries
    {K : Type v} [Field K] (a b c : K) : MvPowerSeries (Fin 2) K :=
  a • (MvPowerSeries.X (0 : Fin 2)) ^ 2 +
      b • (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2)) +
      c • (MvPowerSeries.X (1 : Fin 2)) ^ 2

/-- The precise initial-term condition for a power series to define a node. -/
def HasBinaryQuadraticInitialTerm
    {K : Type v} [Field K] (f : MvPowerSeries (Fin 2) K)
    (a b c : K) : Prop :=
  f.order = 2 ∧
    f.homogeneousComponent 2 = binaryQuadraticPowerSeries a b c ∧
      (a ≠ 0 ∨ b ≠ 0 ∨ c ≠ 0)

/-- In characteristic two, the binary form is nondegenerate exactly when its
mixed coefficient is nonzero. -/
theorem binaryQuadraticForm_nondegenerate_iff_charTwo
    {K : Type v} [Field K] [CharP K 2] {a b c : K} :
    (binaryQuadraticFormOfCoefficients a b c).Nondegenerate ↔ b ≠ 0 := by
  constructor
  · intro h
    have hp := h.rank_rad_polar_le
    by_cases hb : b = 0
    · subst b
      have hzero :
          QuadraticMap.polarBilin (binaryQuadraticFormOfCoefficients a 0 c) = 0 := by
        apply LinearMap.ext
        intro x
        apply LinearMap.ext
        intro y
        simp [binaryQuadraticFormOfCoefficients, QuadraticMap.polarBilin,
          QuadraticMap.polar, QuadraticMap.proj_apply]
        linear_combination
          (a * x 0 * y 0 + c * x 1 * y 1) * CharP.cast_eq_zero K 2
      rw [hzero] at hp
      rw [show LinearMap.ker
        (0 : (Fin 2 → K) →ₗ[K] (Fin 2 → K) →ₗ[K] K) = ⊤ by simp,
        rank_top, rank_fin_fun] at hp
      simp at hp
    · exact hb
  · intro hb
    refine ⟨?_, ?_⟩
    · ext x
      rw [QuadraticMap.mem_radical_iff']
      simp only [Submodule.mem_bot]
      constructor
      · rintro ⟨hx, htrans⟩
        have h0 := htrans (Pi.single (0 : Fin 2) 1)
        have h1 := htrans (Pi.single (1 : Fin 2) 1)
        simp [binaryQuadraticFormOfCoefficients, QuadraticMap.proj_apply] at hx h0 h1
        ring_nf at hx h0 h1
        have hx1 : b * x 1 = 0 := by
          linear_combination h0 - hx - a * x 0 * CharP.cast_eq_zero K 2
        have hx0 : b * x 0 = 0 := by
          linear_combination h1 - hx - x 1 * c * CharP.cast_eq_zero K 2
        have hx1' : x 1 = 0 := (mul_eq_zero.mp hx1).resolve_left hb
        have hx0' : x 0 = 0 := (mul_eq_zero.mp hx0).resolve_left hb
        funext i
        fin_cases i <;> assumption
      · intro hx
        subst x
        simp
    · have hker :
          LinearMap.ker (QuadraticMap.polarBilin
            (binaryQuadraticFormOfCoefficients a b c)) = ⊥ := by
        apply le_antisymm
        · intro x hx
          rw [Submodule.mem_bot]
          change QuadraticMap.polarBilin
              (binaryQuadraticFormOfCoefficients a b c) x = 0 at hx
          funext i
          fin_cases i
          · have h1 := DFunLike.congr_fun hx (Pi.single (1 : Fin 2) 1)
            simp [binaryQuadraticFormOfCoefficients, QuadraticMap.polarBilin,
              QuadraticMap.polar, QuadraticMap.proj_apply] at h1
            have hx0 : b * x 0 = 0 := by
              linear_combination h1 - x 1 * c * CharP.cast_eq_zero K 2
            have hx0' : x 0 = 0 := (mul_eq_zero.mp hx0).resolve_left hb
            simpa using hx0'
          · have h0 := DFunLike.congr_fun hx (Pi.single (0 : Fin 2) 1)
            simp [binaryQuadraticFormOfCoefficients, QuadraticMap.polarBilin,
              QuadraticMap.polar, QuadraticMap.proj_apply] at h0
            have hx1 : b * x 1 = 0 := by
              linear_combination h0 - a * x 0 * CharP.cast_eq_zero K 2
            have hx1' : x 1 = 0 := (mul_eq_zero.mp hx1).resolve_left hb
            simpa using hx1'
        · exact bot_le
      rw [hker]
      simp

/-- A finite separable coefficient-field extension together with a
nondegenerate binary quadratic form. -/
structure BinaryQuadraticPair (k : Type u) [Field k] where
  K : Type v
  [fieldK : Field K]
  [algebraK : Algebra k K]
  [finiteK : Module.Finite k K]
  [separableK : Algebra.IsSeparable k K]
  coeffA : K
  coeffB : K
  coeffC : K
  coefficients_nonzero : coeffA ≠ 0 ∨ coeffB ≠ 0 ∨ coeffC ≠ 0
  nondegenerate :
    (binaryQuadraticFormOfCoefficients coeffA coeffB coeffC).Nondegenerate

attribute [instance] BinaryQuadraticPair.fieldK BinaryQuadraticPair.algebraK
  BinaryQuadraticPair.finiteK BinaryQuadraticPair.separableK

/-- The linear form in the formal variables associated to one column of a
linear coordinate change. -/
def linearCoordinateSeries
    {K : Type v} [Field K]
    (ℓ : (Fin 2 → K) ≃ₗ[K] (Fin 2 → K)) (i : Fin 2) :
    MvPowerSeries (Fin 2) K :=
  ∑ j : Fin 2,
    MvPowerSeries.C (ℓ (Pi.single i 1) j) * MvPowerSeries.X j

/-- Linear coordinates have zero constant coefficient, hence they define a
convergent substitution of formal power series. -/
theorem linearCoordinateHasSubst
    {K : Type v} [Field K]
    (ℓ : (Fin 2 → K) ≃ₗ[K] (Fin 2 → K)) :
    MvPowerSeries.HasSubst (fun i => linearCoordinateSeries ℓ i) := by
  apply MvPowerSeries.hasSubst_of_constantCoeff_zero
  intro i
  classical
  simp [linearCoordinateSeries]

/-- The algebra homomorphism lifting a linear change of formal coordinates. -/
noncomputable def linearCoordinateAlgHom
    {K : Type v} [Field K]
    (ℓ : (Fin 2 → K) ≃ₗ[K] (Fin 2 → K)) :
    MvPowerSeries (Fin 2) K →ₐ[K] MvPowerSeries (Fin 2) K :=
  MvPowerSeries.substAlgHom (linearCoordinateHasSubst ℓ)

@[simp]
theorem linearCoordinateAlgHom_X
    {K : Type v} [Field K]
    (ℓ : (Fin 2 → K) ≃ₗ[K] (Fin 2 → K)) (i : Fin 2) :
    linearCoordinateAlgHom ℓ (MvPowerSeries.X i) = linearCoordinateSeries ℓ i := by
  unfold linearCoordinateAlgHom
  exact MvPowerSeries.substAlgHom_X _ i

/-- The two linear-coordinate substitutions associated to inverse linear
equivalences are inverse algebra homomorphisms. -/
theorem linearCoordinateAlgHom_left_inverse
    {K : Type v} [Field K]
    (ℓ : (Fin 2 → K) ≃ₗ[K] (Fin 2 → K))
    (f : MvPowerSeries (Fin 2) K) :
    linearCoordinateAlgHom ℓ.symm (linearCoordinateAlgHom ℓ f) = f := by
  classical
  have hrepr (v : Fin 2 → K) :
      ∑ j : Fin 2, v j • (Pi.single j 1) = v := by
    funext j
    fin_cases j <;> simp [Fin.sum_univ_two, Pi.single_apply]
  have hlin (i : Fin 2) :
      ∑ j : Fin 2, (ℓ (Pi.single i 1) j) • (ℓ.symm (Pi.single j 1)) =
        Pi.single i 1 := by
    calc
      _ = ℓ.symm (∑ j : Fin 2, (ℓ (Pi.single i 1) j) • (Pi.single j 1)) := by
        simp
      _ = ℓ.symm (ℓ (Pi.single i 1)) := by rw [hrepr]
      _ = Pi.single i 1 := ℓ.symm_apply_apply _
  have hcomp (i : Fin 2) :
      linearCoordinateAlgHom ℓ.symm (linearCoordinateSeries ℓ i) =
        MvPowerSeries.X i := by
    change MvPowerSeries.substAlgHom (linearCoordinateHasSubst ℓ.symm)
      (linearCoordinateSeries ℓ i) = MvPowerSeries.X i
    rw [MvPowerSeries.substAlgHom_apply]
    change MvPowerSeries.subst (fun j : Fin 2 => linearCoordinateSeries ℓ.symm j)
      (linearCoordinateSeries ℓ i) = MvPowerSeries.X i
    rw [show linearCoordinateSeries ℓ i =
        MvPowerSeries.C (ℓ (Pi.single i 1) 0) * MvPowerSeries.X 0 +
          MvPowerSeries.C (ℓ (Pi.single i 1) 1) * MvPowerSeries.X 1 by
          simp [linearCoordinateSeries, Fin.sum_univ_two],
      MvPowerSeries.subst_add (linearCoordinateHasSubst ℓ.symm),
      MvPowerSeries.subst_mul (linearCoordinateHasSubst ℓ.symm),
      MvPowerSeries.subst_mul (linearCoordinateHasSubst ℓ.symm),
      MvPowerSeries.subst_C,
      MvPowerSeries.subst_X (linearCoordinateHasSubst ℓ.symm),
      MvPowerSeries.subst_C,
      MvPowerSeries.subst_X (linearCoordinateHasSubst ℓ.symm),
      show linearCoordinateSeries ℓ.symm 0 =
          MvPowerSeries.C (ℓ.symm (Pi.single 0 1) 0) * MvPowerSeries.X 0 +
            MvPowerSeries.C (ℓ.symm (Pi.single 0 1) 1) * MvPowerSeries.X 1 by
        simp [linearCoordinateSeries, Fin.sum_univ_two],
      show linearCoordinateSeries ℓ.symm 1 =
          MvPowerSeries.C (ℓ.symm (Pi.single 1 1) 0) * MvPowerSeries.X 0 +
            MvPowerSeries.C (ℓ.symm (Pi.single 1 1) 1) * MvPowerSeries.X 1 by
        simp [linearCoordinateSeries, Fin.sum_univ_two]]
    have hcoeff (j : Fin 2) :
        (ℓ (Pi.single i 1) 0) * (ℓ.symm (Pi.single 0 1) j) +
            (ℓ (Pi.single i 1) 1) * (ℓ.symm (Pi.single 1 1) j) =
          (Pi.single i 1 : Fin 2 → K) j := by
      have hj := congrArg (fun v : Fin 2 → K => v j) (hlin i)
      simpa [Fin.sum_univ_two, Pi.smul_apply, smul_eq_mul] using hj
    have hC (x y : K) :
        (MvPowerSeries.C x : MvPowerSeries (Fin 2) K) * MvPowerSeries.C y =
          MvPowerSeries.C (x * y) := by
      exact (map_mul (MvPowerSeries.C : K →+* MvPowerSeries (Fin 2) K) x y).symm
    calc
      _ = MvPowerSeries.C (ℓ (Pi.single i 1) 0) *
            MvPowerSeries.C (ℓ.symm (Pi.single 0 1) 0) * MvPowerSeries.X (0 : Fin 2) +
          MvPowerSeries.C (ℓ (Pi.single i 1) 0) *
            MvPowerSeries.C (ℓ.symm (Pi.single 0 1) 1) * MvPowerSeries.X (1 : Fin 2) +
          MvPowerSeries.C (ℓ (Pi.single i 1) 1) *
            MvPowerSeries.C (ℓ.symm (Pi.single 1 1) 0) * MvPowerSeries.X (0 : Fin 2) +
          MvPowerSeries.C (ℓ (Pi.single i 1) 1) *
            MvPowerSeries.C (ℓ.symm (Pi.single 1 1) 1) * MvPowerSeries.X (1 : Fin 2) := by
        rw [mul_add, mul_add]
        ring
      _ = MvPowerSeries.C
            ((ℓ (Pi.single i 1) 0) * (ℓ.symm (Pi.single 0 1) 0)) *
            MvPowerSeries.X (0 : Fin 2) +
          MvPowerSeries.C
            ((ℓ (Pi.single i 1) 0) * (ℓ.symm (Pi.single 0 1) 1)) *
            MvPowerSeries.X (1 : Fin 2) +
          MvPowerSeries.C
            ((ℓ (Pi.single i 1) 1) * (ℓ.symm (Pi.single 1 1) 0)) *
            MvPowerSeries.X (0 : Fin 2) +
          MvPowerSeries.C
            ((ℓ (Pi.single i 1) 1) * (ℓ.symm (Pi.single 1 1) 1)) *
            MvPowerSeries.X (1 : Fin 2) := by
        rw [hC, hC, hC, hC]
      _ = (MvPowerSeries.C
            ((ℓ (Pi.single i 1) 0) * (ℓ.symm (Pi.single 0 1) 0)) +
          MvPowerSeries.C
            ((ℓ (Pi.single i 1) 1) * (ℓ.symm (Pi.single 1 1) 0))) *
            MvPowerSeries.X (0 : Fin 2) +
          (MvPowerSeries.C
            ((ℓ (Pi.single i 1) 0) * (ℓ.symm (Pi.single 0 1) 1)) +
          MvPowerSeries.C
            ((ℓ (Pi.single i 1) 1) * (ℓ.symm (Pi.single 1 1) 1))) *
            MvPowerSeries.X (1 : Fin 2) := by
        ring
      _ = MvPowerSeries.C
            ((ℓ (Pi.single i 1) 0) * (ℓ.symm (Pi.single 0 1) 0) +
              (ℓ (Pi.single i 1) 1) * (ℓ.symm (Pi.single 1 1) 0)) *
            MvPowerSeries.X (0 : Fin 2) +
          MvPowerSeries.C
            ((ℓ (Pi.single i 1) 0) * (ℓ.symm (Pi.single 0 1) 1) +
              (ℓ (Pi.single i 1) 1) * (ℓ.symm (Pi.single 1 1) 1)) *
            MvPowerSeries.X (1 : Fin 2) := by
        rw [← map_add (MvPowerSeries.C : K →+* MvPowerSeries (Fin 2) K),
          ← map_add (MvPowerSeries.C : K →+* MvPowerSeries (Fin 2) K)]
      _ = MvPowerSeries.X i := by
        rw [hcoeff 0, hcoeff 1]
        fin_cases i <;> simp [Pi.single_apply]
  have hfun :
      (fun i : Fin 2 =>
        MvPowerSeries.substAlgHom (linearCoordinateHasSubst ℓ.symm)
          (linearCoordinateSeries ℓ i)) =
        (MvPowerSeries.X : Fin 2 → MvPowerSeries (Fin 2) K) := by
    funext i
    exact hcomp i
  rw [show linearCoordinateAlgHom ℓ.symm (linearCoordinateAlgHom ℓ f) =
      MvPowerSeries.substAlgHom
        ((linearCoordinateHasSubst ℓ).comp (linearCoordinateHasSubst ℓ.symm)) f by
        exact MvPowerSeries.substAlgHom_comp_substAlgHom_apply
          (linearCoordinateHasSubst ℓ) (linearCoordinateHasSubst ℓ.symm) f]
  rw [MvPowerSeries.substAlgHom_apply]
  change MvPowerSeries.subst
      (fun i : Fin 2 =>
        MvPowerSeries.substAlgHom (linearCoordinateHasSubst ℓ.symm)
          (linearCoordinateSeries ℓ i)) f = f
  rw [hfun]
  exact congrFun MvPowerSeries.subst_self f

theorem linearCoordinateAlgHom_right_inverse
    {K : Type v} [Field K]
    (ℓ : (Fin 2 → K) ≃ₗ[K] (Fin 2 → K))
    (f : MvPowerSeries (Fin 2) K) :
    linearCoordinateAlgHom ℓ (linearCoordinateAlgHom ℓ.symm f) = f := by
  simpa using linearCoordinateAlgHom_left_inverse ℓ.symm f

theorem linearCoordinateAlgHom_bijective
    {K : Type v} [Field K]
    (ℓ : (Fin 2 → K) ≃ₗ[K] (Fin 2 → K)) :
    Function.Bijective (linearCoordinateAlgHom ℓ) := by
  constructor
  · intro f g h
    calc
      f = linearCoordinateAlgHom ℓ.symm (linearCoordinateAlgHom ℓ f) :=
        (linearCoordinateAlgHom_left_inverse ℓ f).symm
      _ = linearCoordinateAlgHom ℓ.symm (linearCoordinateAlgHom ℓ g) := congrArg _ h
      _ = g := linearCoordinateAlgHom_left_inverse ℓ g
  · intro f
    exact ⟨linearCoordinateAlgHom ℓ.symm f, linearCoordinateAlgHom_right_inverse ℓ f⟩

/-- The algebra automorphism of a formal power-series ring induced by an
invertible linear coordinate change. -/
noncomputable def linearCoordinateAlgEquiv
    {K : Type v} [Field K]
    (ℓ : (Fin 2 → K) ≃ₗ[K] (Fin 2 → K)) :
    MvPowerSeries (Fin 2) K ≃ₐ[K] MvPowerSeries (Fin 2) K :=
  AlgEquiv.ofBijective (linearCoordinateAlgHom ℓ)
    (linearCoordinateAlgHom_bijective ℓ)

/-- Coefficient-field equivalences lift coefficientwise to formal power
series. -/
noncomputable def powerSeriesCoeffMapAlgHom
    {k : Type u} [Field k] {K : Type v} [Field K]
    {L : Type w} [Field L] [Algebra k K] [Algebra k L]
    (e : K ≃ₐ[k] L) :
    MvPowerSeries (Fin 2) K →ₐ[k] MvPowerSeries (Fin 2) L :=
  MvPowerSeries.mapAlgHom e.toAlgHom

theorem powerSeriesCoeffMapAlgHom_bijective
    {k : Type u} [Field k] {K : Type v} [Field K]
    {L : Type w} [Field L] [Algebra k K] [Algebra k L]
    (e : K ≃ₐ[k] L) :
    Function.Bijective (powerSeriesCoeffMapAlgHom e) := by
  let f := powerSeriesCoeffMapAlgHom e
  let g := powerSeriesCoeffMapAlgHom e.symm
  have hleft : Function.LeftInverse g f := by
    intro p
    ext n
    simp [f, g, powerSeriesCoeffMapAlgHom, MvPowerSeries.mapAlgHom_apply]
  have hright : Function.RightInverse g f := by
    intro q
    ext n
    simp [f, g, powerSeriesCoeffMapAlgHom, MvPowerSeries.mapAlgHom_apply]
  exact ⟨hleft.injective, hright.surjective⟩

/-- The coefficientwise lift of a coefficient-field algebra equivalence. -/
noncomputable def powerSeriesCoeffMapAlgEquiv
    {k : Type u} [Field k] {K : Type v} [Field K]
    {L : Type w} [Field L] [Algebra k K] [Algebra k L]
    (e : K ≃ₐ[k] L) :
    MvPowerSeries (Fin 2) K ≃ₐ[k] MvPowerSeries (Fin 2) L :=
  AlgEquiv.ofBijective (powerSeriesCoeffMapAlgHom e)
    (powerSeriesCoeffMapAlgHom_bijective e)

/-- The formal power-series coordinates obtained from the field equivalence and
the chosen linear change of variables. -/
def binaryQuadraticLiftCoordinate
    {k : Type u} [Field k] (P Q : BinaryQuadraticPair k)
    (e : P.K ≃ₐ[k] Q.K)
    (ℓ : (Fin 2 → P.K) ≃ₗ[P.K] (Fin 2 → P.K)) (i : Fin 2) :
    MvPowerSeries (Fin 2) Q.K :=
  ∑ j : Fin 2,
    MvPowerSeries.C (e (ℓ (Pi.single i 1) j)) * MvPowerSeries.X j

/-- Interface for lifting the field and tangent-linear data occurring in an
equivalence of binary quadratic pairs to their formal power-series rings. -/
theorem binaryQuadraticPair_linearCoordinate_lift
    {k : Type u} [Field k] (P Q : BinaryQuadraticPair k)
    (e : P.K ≃ₐ[k] Q.K)
    (ℓ : (Fin 2 → P.K) ≃ₗ[P.K] (Fin 2 → P.K)) :
    Nonempty
      { φ : MvPowerSeries (Fin 2) P.K ≃ₐ[k]
          MvPowerSeries (Fin 2) Q.K //
        (∀ i, φ (MvPowerSeries.X i) = binaryQuadraticLiftCoordinate P Q e ℓ i) ∧
        (∀ a, φ (MvPowerSeries.C a) = MvPowerSeries.C (e a)) } := by
  let φ :=
    (linearCoordinateAlgEquiv ℓ).restrictScalars k |>.trans
      (powerSeriesCoeffMapAlgEquiv e)
  refine ⟨⟨φ, ?_⟩⟩
  constructor
  · intro i
    simp [φ, binaryQuadraticLiftCoordinate, linearCoordinateAlgEquiv,
      powerSeriesCoeffMapAlgEquiv, powerSeriesCoeffMapAlgHom]
    simp [MvPowerSeries.mapAlgHom_apply, linearCoordinateSeries, Fin.sum_univ_two]
  · intro a
    simp [φ, powerSeriesCoeffMapAlgEquiv, powerSeriesCoeffMapAlgHom]
    have hC :
        linearCoordinateAlgEquiv ℓ (MvPowerSeries.C a) = MvPowerSeries.C a := by
      rw [MvPowerSeries.c_eq_algebraMap]
      exact (linearCoordinateAlgEquiv ℓ).commutes a
    rw [hC]
    rw [MvPowerSeries.mapAlgHom_apply, MvPowerSeries.map_C]
    rfl

/-- Equivalence of the pairs `(k', q)`, allowing a scalar multiple of the
equation as well as a linear change of variables. -/
def binaryQuadraticPairEquivalent
    {k : Type u} [Field k]
    (P Q : BinaryQuadraticPair k) : Prop :=
  ∃ e : P.K ≃ₐ[k] Q.K, ∃ u : P.Kˣ,
    ∃ ℓ : (Fin 2 → P.K) ≃ₗ[P.K] (Fin 2 → P.K),
      ∀ x : Fin 2 → P.K,
        e (binaryQuadraticFormOfCoefficients P.coeffA P.coeffB P.coeffC x) =
          e (u : P.K) *
            binaryQuadraticFormOfCoefficients Q.coeffA Q.coeffB Q.coeffC
              (fun i => e (ℓ x i))

/-- The complete-local model attached to a pair `(k',q)`. -/
abbrev ordinaryDoublePointNormalForm
    {k : Type u} [Field k] (P : BinaryQuadraticPair k) :=
  MvPowerSeries (Fin 2) P.K ⧸
    Ideal.span {binaryQuadraticPowerSeries P.coeffA P.coeffB P.coeffC}

/-- A successive ideal quotient `I/J`, represented as a quotient of the
subtype `I`. -/
abbrev idealPowerQuotient
    {R : Type v} [CommRing R] (I J : Ideal R) : Type v :=
  I ⧸ Submodule.comap I.subtype J

/-- The class of an element of an ideal in a successive ideal quotient. -/
def idealPowerQuotientMk
    {R : Type v} [CommRing R] (I J : Ideal R) (x : R) (hx : x ∈ I) :
    idealPowerQuotient I J :=
  Submodule.Quotient.mk ⟨x, hx⟩

/-- The degree-two class of an element of `I²` in `I²/I³`. -/
def quadraticRelationClass
    {R : Type v} [CommRing R] (I : Ideal R) (q : R) (hq : q ∈ I ^ 2) :
    idealPowerQuotient (I ^ 2) (I ^ 3) :=
  idealPowerQuotientMk (I ^ 2) (I ^ 3) q hq

/-- The submodule generated by a quadratic relation in the degree-two
associated-graded piece. -/
def quadraticRelationSpan
    {R : Type v} [CommRing R] (I : Ideal R) (q : R) (hq : q ∈ I ^ 2) :
    Submodule R (idealPowerQuotient (I ^ 2) (I ^ 3)) :=
  Submodule.span R {quadraticRelationClass I q hq}

theorem quadraticRelationClass_eq_zero_iff
    {R : Type v} [CommRing R] (I : Ideal R) (q : R) (hq : q ∈ I ^ 2) :
    quadraticRelationClass I q hq = 0 ↔ q ∈ I ^ 3 := by
  change
    (Submodule.Quotient.mk
      (p := Submodule.comap (I ^ 2 : Ideal R).subtype (I ^ 3))
      (⟨q, hq⟩ : (I ^ 2 : Ideal R)) = 0) ↔ q ∈ I ^ 3
  simp

/-- A binary quadratic power series lies in the square of the formal maximal
ideal. -/
theorem binaryQuadraticPowerSeries_mem_twoVariableMaximalIdeal_sq
    {K : Type v} [Field K] (a b c : K) :
    binaryQuadraticPowerSeries a b c ∈ twoVariableMaximalIdeal K ^ 2 := by
  let I := twoVariableMaximalIdeal K
  have hX (i : Fin 2) : MvPowerSeries.X i ∈ I := by
    exact Ideal.subset_span ⟨i, rfl⟩
  have hXX (i j : Fin 2) :
      MvPowerSeries.X i * MvPowerSeries.X j ∈ I ^ 2 := by
    rw [pow_two]
    exact Ideal.mul_mem_mul (hX i) (hX j)
  have hsmul {z : MvPowerSeries (Fin 2) K} (r : K) (hz : z ∈ I ^ 2) :
      r • z ∈ I ^ 2 := by
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_left (I ^ 2) _ hz
  change
    a • MvPowerSeries.X (0 : Fin 2) ^ 2 +
        b • (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2)) +
          c • MvPowerSeries.X (1 : Fin 2) ^ 2 ∈ I ^ 2
  exact add_mem (add_mem (hsmul a (by simpa [pow_two] using hXX 0 0)) (hsmul b (hXX 0 1)))
    (hsmul c (by simpa [pow_two] using hXX 1 1))

/-- The degree-two relation attached to the quadratic part of a normal form. -/
def ordinaryDoublePointQuadraticRelation
    {k : Type u} [Field k] (P : BinaryQuadraticPair k) :
    Submodule P.K
      (idealPowerQuotient (twoVariableMaximalIdeal P.K ^ 2)
        (twoVariableMaximalIdeal P.K ^ 3)) :=
  (quadraticRelationSpan (twoVariableMaximalIdeal P.K)
    (binaryQuadraticPowerSeries P.coeffA P.coeffB P.coeffC)
    (binaryQuadraticPowerSeries_mem_twoVariableMaximalIdeal_sq
      P.coeffA P.coeffB P.coeffC)).restrictScalars P.K

/-- The image of the formal maximal ideal in a quadratic normal-form quotient.
This is the maximal ideal used for its `m/m²` interface. -/
def ordinaryDoublePointNormalFormMaximalIdeal
    {k : Type u} [Field k] (P : BinaryQuadraticPair k) :
    Ideal (ordinaryDoublePointNormalForm P) :=
  Ideal.map
    (Ideal.Quotient.mk
      (Ideal.span {binaryQuadraticPowerSeries P.coeffA P.coeffB P.coeffC}))
    (twoVariableMaximalIdeal P.K)

/-- The canonical cotangent-space model `m/m²` of a normal form. -/
abbrev ordinaryDoublePointNormalFormCotangent
    {k : Type u} [Field k] (P : BinaryQuadraticPair k) :=
  Ideal.Cotangent (ordinaryDoublePointNormalFormMaximalIdeal P)

/-- An algebra equivalence carrying one ideal to another. -/
structure IdealAlgebraEquivalence
    {k : Type u} [Field k] {A : Type v} [CommRing A] [Algebra k A]
    {B : Type w} [CommRing B] [Algebra k B]
    (I : Ideal A) (J : Ideal B) where
  ringEquiv : A ≃ₐ[k] B
  map_ideal : Ideal.map (ringEquiv : A →+* B) I = J

/-- The map on conormal modules induced by an ideal-carrying algebra
equivalence. -/
noncomputable def IdealAlgebraEquivalence.cotangentMap
    {k : Type u} [Field k] {A : Type v} [CommRing A] [Algebra k A]
    {B : Type w} [CommRing B] [Algebra k B]
    {I : Ideal A} {J : Ideal B} (E : IdealAlgebraEquivalence (k := k) I J) :
    I.Cotangent →ₗ[k] J.Cotangent :=
  Ideal.mapCotangent I J E.ringEquiv.toAlgHom (by
    intro x hx
    let e : A ≃ₐ[k] B := E.ringEquiv
    have hmap : Ideal.map (e : A →+* B) I = J := by
      simpa [e] using E.map_ideal
    change e x ∈ J
    exact hmap ▸ Ideal.mem_map_of_mem (e : A →+* B) hx)

theorem IdealAlgebraEquivalence.cotangentMap_bijective
    {k : Type u} [Field k] {A : Type v} [CommRing A] [Algebra k A]
    {B : Type w} [CommRing B] [Algebra k B]
    {I : Ideal A} {J : Ideal B} (E : IdealAlgebraEquivalence (k := k) I J) :
    Function.Bijective E.cotangentMap := by
  let E' : IdealAlgebraEquivalence (k := k) J I :=
    { ringEquiv := E.ringEquiv.symm
      map_ideal := by
        calc
          Ideal.map (E.ringEquiv.symm : B →+* A) J =
              Ideal.map (E.ringEquiv.symm : B →+* A)
                (Ideal.map (E.ringEquiv : A →+* B) I) := congrArg _ E.map_ideal.symm
          _ = I := by
            rw [Ideal.map_map]
            rw [show (E.ringEquiv.symm : B →+* A).comp
                (E.ringEquiv : A →+* B) = RingHom.id A from E.ringEquiv.toRingEquiv.symm_comp]
            exact Ideal.map_id I }
  have hleft (x : I.Cotangent) : E'.cotangentMap (E.cotangentMap x) = x := by
    obtain ⟨x, rfl⟩ := I.toCotangent_surjective x
    simp [E', IdealAlgebraEquivalence.cotangentMap]
  have hright (x : J.Cotangent) : E.cotangentMap (E'.cotangentMap x) = x := by
    obtain ⟨x, rfl⟩ := J.toCotangent_surjective x
    simp [E', IdealAlgebraEquivalence.cotangentMap]
  constructor
  · intro x y h
    have := congrArg E'.cotangentMap h
    simpa [hleft] using this
  · intro y
    exact ⟨E'.cotangentMap y, hright y⟩

/-- The induced linear equivalence on `I/I²` and `J/J²`. -/
noncomputable def IdealAlgebraEquivalence.cotangentEquiv
    {k : Type u} [Field k] {A : Type v} [CommRing A] [Algebra k A]
    {B : Type w} [CommRing B] [Algebra k B]
    {I : Ideal A} {J : Ideal B} (E : IdealAlgebraEquivalence (k := k) I J) :
    I.Cotangent ≃ₗ[k] J.Cotangent :=
  LinearEquiv.ofBijective E.cotangentMap E.cotangentMap_bijective

/-- A local algebra equivalence preserves the maximal-ideal cotangent space. -/
noncomputable def maximalIdealCotangentEquiv
    {k : Type u} [Field k] {A : Type v} [CommRing A] [Algebra k A]
    {B : Type w} [CommRing B] [Algebra k B] [IsLocalRing A] [IsLocalRing B]
    (e : A ≃ₐ[k] B)
    (h : Ideal.map (e : A →+* B) (IsLocalRing.maximalIdeal A) =
      IsLocalRing.maximalIdeal B) :
    (IsLocalRing.maximalIdeal A).Cotangent ≃ₗ[k]
      (IsLocalRing.maximalIdeal B).Cotangent :=
  (IdealAlgebraEquivalence.mk (k := k) e h).cotangentEquiv

/-- The maximal-ideal quotient of two quadratic normal forms is preserved by
an algebra equivalence, and its degree-two relation is the extracted tangent
quadratic relation. -/
theorem ordinaryDoublePoint_normalForm_extract_tangent_data
    {k : Type u} [Field k] (P Q : BinaryQuadraticPair k)
    (e : ordinaryDoublePointNormalForm P ≃ₐ[k]
      ordinaryDoublePointNormalForm Q) :
    binaryQuadraticPairEquivalent P Q := by
  sorry

theorem ordinaryDoublePoint_normalForm_equiv_of_pairEquivalent
    {k : Type u} [Field k] (P Q : BinaryQuadraticPair k)
    (h : binaryQuadraticPairEquivalent P Q) :
    Nonempty
      (ordinaryDoublePointNormalForm P ≃ₐ[k]
        ordinaryDoublePointNormalForm Q) := by
  sorry

theorem ordinaryDoublePoint_normalForm_cotangent_equiv
    {k : Type u} [Field k] (P Q : BinaryQuadraticPair k)
    (e : ordinaryDoublePointNormalForm P ≃ₐ[k]
      ordinaryDoublePointNormalForm Q) :
    Nonempty
      (ordinaryDoublePointNormalFormCotangent P ≃ₗ[k]
        ordinaryDoublePointNormalFormCotangent Q) := by
  sorry

/-- A ring is complete and local in the adic sense used for complete local
rings. -/
def IsCompleteLocalRing (A : Type v) [CommRing A] : Prop :=
  ∃ hA : IsLocalRing A,
    letI : IsLocalRing A := hA
    IsAdicComplete (IsLocalRing.maximalIdeal A) A

/-- A source-facing presentation of an ordinary double point. -/
structure OrdinaryDoublePointPresentation
    (k : Type u) [Field k] (A : Type w) [CommRing A] [Algebra k A] where
  complete_local : IsCompleteLocalRing A
  pair : BinaryQuadraticPair.{u, v} k
  definingSeries : MvPowerSeries (Fin 2) pair.K
  order_eq_two : definingSeries.order = 2
  initial_term :
    definingSeries.homogeneousComponent 2 =
      binaryQuadraticPowerSeries pair.coeffA pair.coeffB pair.coeffC
  ringEquiv :
    A ≃ₐ[k] (MvPowerSeries (Fin 2) pair.K ⧸ Ideal.span {definingSeries})

/-- The predicate that a complete local ring is an ordinary double point. -/
def IsOrdinaryDoublePoint
    (k : Type u) [Field k] (A : Type w) [CommRing A] [Algebra k A] : Prop :=
  Nonempty (OrdinaryDoublePointPresentation.{u, v, w} k A)

/-- The formal Morse interface for the defining series in an ordinary double
point presentation. -/
theorem ordinaryDoublePointPresentation_formalMorse
    {k : Type u} [Field k] {A : Type w} [CommRing A] [Algebra k A]
    (D : OrdinaryDoublePointPresentation k A) :
    Nonempty
      (FormalMorseData k D.definingSeries
        (binaryQuadraticPowerSeries D.pair.coeffA D.pair.coeffB D.pair.coeffC)) := by
  sorry

/-- The defining series of an ordinary double point can be replaced by its
nondegenerate quadratic initial term. -/
theorem ordinaryDoublePoint_isomorphic_to_normalForm
    {k : Type u} [Field k] {A : Type w} [CommRing A] [Algebra k A]
    (D : OrdinaryDoublePointPresentation k A) :
    Nonempty (A ≃ₐ[k] ordinaryDoublePointNormalForm D.pair) := by
  obtain ⟨M⟩ := ordinaryDoublePointPresentation_formalMorse D
  exact ⟨D.ringEquiv.trans M.quotientAlgEquiv⟩

/-- The normal forms are classified by the isomorphism classes of their
finite separable coefficient fields and nondegenerate quadratic forms. -/
theorem ordinaryDoublePoint_normalForm_isomorphic_iff
    {k : Type u} [Field k] (P Q : BinaryQuadraticPair k) :
    Nonempty
        (ordinaryDoublePointNormalForm P ≃ₐ[k]
          ordinaryDoublePointNormalForm Q) ↔
      binaryQuadraticPairEquivalent P Q := by
  constructor
  · rintro ⟨e⟩
    exact ordinaryDoublePoint_normalForm_extract_tangent_data P Q e
  · intro h
    exact ordinaryDoublePoint_normalForm_equiv_of_pairEquivalent P Q h

/-! ## The periodic matrix resolution -/

/-- The quotient of a commutative ring by the principal ideal generated by `f`. -/
abbrev principalQuotient (R : Type u) [CommRing R] (f : R) :=
  R ⧸ Ideal.span {f}

/-- Reduce a square matrix modulo the principal ideal `(f)`. -/
def quotientMatrix
    {R : Type u} [CommRing R] {n : ℕ} (f : R)
    (M : Matrix (Fin n) (Fin n) R) :
    Matrix (Fin n) (Fin n) (principalQuotient R f) :=
  M.map (Ideal.Quotient.mk (Ideal.span {f}))

/-- Exactness at both alternating terms of a bi-infinite two-periodic
sequence with matrices `B` and `A`. -/
def periodicResolutionExact
    {S : Type u} [CommRing S] {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) S) : Prop :=
  Function.Exact B.mulVecLin A.mulVecLin ∧
    Function.Exact A.mulVecLin B.mulVecLin

/-- A matrix factorization by a nonzerodivisor gives the exact alternating
resolution over the quotient by that nonzerodivisor. -/
theorem periodicMatrixResolution_exact
    {R : Type u} [CommRing R] {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) R) (f : R) (_hn : 1 ≤ n)
    (hAB : A * B = f • (1 : Matrix (Fin n) (Fin n) R))
    (hf : IsRegular f) :
    periodicResolutionExact (quotientMatrix f A) (quotientMatrix f B) := by
  have hdet : A.det * B.det = f ^ n := by
    rw [← Matrix.det_mul, hAB]
    simp
  have hdetreg : IsRegular (A.det * B.det) := hdet.symm ▸ hf.pow n
  have hAdet : IsRegular A.det := hdetreg.of_mul_left
  have hdetB : A.det • B = f • A.adjugate := by
    calc
      A.det • B = (A.adjugate * A) * B := by rw [Matrix.adjugate_mul]; simp
      _ = A.adjugate * (A * B) := by rw [Matrix.mul_assoc]
      _ = A.adjugate * (f • (1 : Matrix (Fin n) (Fin n) R)) := by rw [hAB]
      _ = f • A.adjugate := by simp
  have hBA : B * A = f • (1 : Matrix (Fin n) (Fin n) R) := by
    have hcancel : A.det • (B * A) = A.det • (f • (1 : Matrix (Fin n) (Fin n) R)) := by
      calc
        A.det • (B * A) = (A.det • B) * A := by simp
        _ = (f • A.adjugate) * A := by rw [hdetB]
        _ = f • (A.adjugate * A) := by simp
        _ = f • (A.det • (1 : Matrix (Fin n) (Fin n) R)) := by
          rw [Matrix.adjugate_mul]
        _ = A.det • (f • (1 : Matrix (Fin n) (Fin n) R)) := by
          rw [smul_smul, smul_smul, mul_comm]
    ext i j
    apply hAdet.left
    simpa [smul_eq_mul] using congrArg (fun M => M i j) hcancel
  have h_exact :
      ∀ (M N : Matrix (Fin n) (Fin n) R),
        M * N = f • (1 : Matrix (Fin n) (Fin n) R) →
        N * M = f • (1 : Matrix (Fin n) (Fin n) R) →
        Function.Exact (quotientMatrix f N).mulVecLin
          (quotientMatrix f M).mulVecLin := by
    intro M N hMN hNM
    let q : R →+* principalQuotient R f :=
      Ideal.Quotient.mk (Ideal.span {f})
    have hMNq : quotientMatrix f M * quotientMatrix f N = 0 := by
      change M.map q * N.map q = 0
      rw [← Matrix.map_mul, hMN]
      ext i j
      simp [q]
    have hNMq : quotientMatrix f N * quotientMatrix f M = 0 := by
      change N.map q * M.map q = 0
      rw [← Matrix.map_mul, hNM]
      ext i j
      simp [q]
    apply LinearMap.exact_of_comp_eq_zero_of_ker_le_range
    · rw [← Matrix.mulVecLin_mul, hMNq]
      simp
    · intro x hx
      change (quotientMatrix f M).mulVecLin x = 0 at hx
      have hMkernel : ∀ i, Matrix.mulVec (M.map q) x i = 0 := by
        intro i
        simpa [quotientMatrix, q, Matrix.mulVecLin_apply] using
          congrArg (fun v => v i) hx
      choose y hy using fun i => Ideal.Quotient.mk_surjective (x i)
      have hyq : q ∘ y = x := by
        funext i
        simpa [q] using hy i
      have hMdiv : ∀ i, f ∣ Matrix.mulVec M y i := by
        intro i
        have hzero : q (Matrix.mulVec M y i) = 0 := by
          rw [RingHom.map_mulVec q M y i, hyq]
          exact hMkernel i
        exact (Ideal.Quotient.eq_zero_iff_dvd f (Matrix.mulVec M y i)).mp (by
          simpa [q] using hzero)
      choose z hz using hMdiv
      have hMzy : Matrix.mulVec M y = f • z := by
        funext i
        simpa [Pi.smul_apply, smul_eq_mul] using hz i
      have hNMvec : Matrix.mulVec N (Matrix.mulVec M y) = f • y := by
        calc
          Matrix.mulVec N (Matrix.mulVec M y) = Matrix.mulVec (N * M) y :=
            Matrix.mulVec_mulVec y N M
          _ = Matrix.mulVec (f • (1 : Matrix (Fin n) (Fin n) R)) y := by rw [hNM]
          _ = f • y := by rw [Matrix.smul_mulVec]; simp
      have hcancel : f • Matrix.mulVec N z = f • y := by
        calc
          f • Matrix.mulVec N z = Matrix.mulVec N (f • z) :=
            (Matrix.mulVec_smul N f z).symm
          _ = Matrix.mulVec N (Matrix.mulVec M y) := by rw [← hMzy]
          _ = f • y := hNMvec
      have hyz : Matrix.mulVec N z = y := by
        funext i
        apply hf.left
        simpa [Pi.smul_apply, smul_eq_mul] using
          congrArg (fun v => v i) hcancel
      refine ⟨q ∘ z, ?_⟩
      ext i
      calc
        (quotientMatrix f N).mulVecLin (q ∘ z) i = q (Matrix.mulVec N z i) := by
          symm
          simpa [quotientMatrix, q, Matrix.mulVecLin_apply] using
            RingHom.map_mulVec q N z i
        _ = q (y i) := by rw [hyz]
        _ = x i := by simpa only [Function.comp_apply] using congrFun hyq i
  exact ⟨h_exact A B hAB hBA, h_exact B A hBA hAB⟩

end

end Formalization.Books.Exercises.Unit14
