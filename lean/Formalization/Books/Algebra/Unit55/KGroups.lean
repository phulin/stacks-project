        rw [← hz]
        change (((0 : R₁), r.2) : R₁ × R₂) •
            (prodIdem₂ (R₁ := R₁) (R₂ := R₂) • z) =
          r • (prodIdem₂ (R₁ := R₁) (R₂ := R₂) • z)
        rw [smul_smul, smul_smul]
        congr 1
        ext <;> simp [prodIdem₂] }
  refine ⟨h, ?_⟩
  apply LinearMap.ext
  intro x
  have hx := LinearMap.congr_fun hh₂ x.val
  exact congrArg Subtype.val hx

private theorem prodFactorMap₁.injective
    {R₁ R₂ M N : Type u} [CommRing R₁] [CommRing R₂]
