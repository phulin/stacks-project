namespace Formalization.Books.Derived.Unit28

/-! ## The zeroth K-group of a triangulated category -/

/-- The relation `[Y] - [X] - [Z]` attached to a distinguished triangle
`X ⟶ Y ⟶ Z ⟶ X⟦1⟧`. -/
structure KZeroRelation (C : Type u) [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C] where
  triangle : Triangle C
  distinguished : triangle ∈ distTriang C

namespace KZeroRelation

/-- The free-group element representing a distinguished-triangle relation. -/
def generator {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    (r : KZeroRelation C) : FreeAbelianGroup C :=
  FreeAbelianGroup.of r.triangle.obj₂ -
    FreeAbelianGroup.of r.triangle.obj₁ - FreeAbelianGroup.of r.triangle.obj₃

end KZeroRelation

/-- The subgroup generated by all distinguished-triangle relations. -/
def KZeroRelations (C : Type u) [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C] :
    AddSubgroup (FreeAbelianGroup C) :=
  AddSubgroup.closure (Set.range (KZeroRelation.generator (C := C)))

/-- The zeroth K-group of a triangulated category. -/
abbrev KZero (C : Type u) [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C] : Type u :=
  FreeAbelianGroup C ⧸ KZeroRelations C

namespace KZero

/-- The class of an object in the triangulated zeroth K-group. -/
def classOf {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    (X : C) : KZero C :=
  QuotientAddGroup.mk' (KZeroRelations C) (FreeAbelianGroup.of X)

end KZero

/-- The defining relation in `KZero`, written as an equality of classes. -/
theorem KZero.classOf_triangle
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    (r : KZeroRelation C) :
    KZero.classOf r.triangle.obj₂ =
      KZero.classOf r.triangle.obj₁ + KZero.classOf r.triangle.obj₃ := by
  sorry

/-- The defining relation in the source's subtractive form. -/
theorem KZero.classOf_triangle_relation
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    (r : KZeroRelation C) :
    KZero.classOf r.triangle.obj₂ - KZero.classOf r.triangle.obj₁ -
        KZero.classOf r.triangle.obj₃ = 0 := by
  sorry

/-- The quotient map from the free group of object generators. -/
def KZero.quotientMap {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C] :
    FreeAbelianGroup C →+ KZero C :=
  QuotientAddGroup.mk' (KZeroRelations C)

/-! ## The shift relation -/

/-- Shifting an object multiplies its K₀-class by the usual alternating sign. -/
theorem KZero.classOf_shift
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    (X : C) (n : ℤ) :
    KZero.classOf ((shiftFunctor C n).obj X) =
      (n.negOnePow : ℤ) • KZero.classOf X := by
  sorry

/-! ## Maps of triangulated K-groups -/

/-- The free-group map induced by a functor on object generators. -/
def kZeroFreeMap {C : Type u} [Category.{v} C]
    {D : Type u'} [Category.{v'} D] (F : C ⥤ D) :
    FreeAbelianGroup C →+ FreeAbelianGroup D :=
  FreeAbelianGroup.lift (fun X => FreeAbelianGroup.of (F.obj X))

/-- An exact triangulated functor sends the defining relations to relations. -/
theorem kZeroFreeMap_relations
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {D : Type u'} [Category.{v'} D] [HasZeroObject D]
    [Preadditive D] [HasShift D ℤ]
    [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated] :
    KZeroRelations C ≤
      AddMonoidHom.ker ((KZero.quotientMap (C := D)).comp (kZeroFreeMap F)) := by
  sorry

/-- The group homomorphism on K₀ induced by an exact triangulated functor. -/
noncomputable def kZeroMap
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {D : Type u'} [Category.{v'} D] [HasZeroObject D]
    [Preadditive D] [HasShift D ℤ]
    [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated] :
    KZero C →+ KZero D := by
  let φ := (KZero.quotientMap (C := D)).comp (kZeroFreeMap F)
  exact QuotientAddGroup.lift (KZeroRelations C) φ (kZeroFreeMap_relations F)

/-- The induced map sends an object class to the class of its image. -/
@[simp]
theorem kZeroMap_classOf
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {D : Type u'} [Category.{v'} D] [HasZeroObject D]
    [Preadditive D] [HasShift D ℤ]
    [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated] (X : C) :
    kZeroMap F (KZero.classOf X) = KZero.classOf (F.obj X) := by
  sorry

/-! ## The bounded-derived comparison -/

/-- The abelian-category K₀ presentation already supplied by Homology 11. -/
abbrev AbelianKZero (A : Type u) [Category.{v} A] [HasZeroMorphisms A] : Type u :=
  Formalization.Books.Homology.Unit11.KZero A

abbrev AbelianKZeroRelations (A : Type u) [Category.{v} A]
    [HasZeroMorphisms A] : AddSubgroup (FreeAbelianGroup A) :=
  Formalization.Books.Homology.Unit11.KZeroRelations A

/-- The quotient map for the reused abelian-category K₀ presentation. -/
def abelianKZeroQuotientMap
    {A : Type u} [Category.{v} A] [HasZeroMorphisms A] :
    FreeAbelianGroup A →+ AbelianKZero A :=
  QuotientAddGroup.mk' (AbelianKZeroRelations A)

/-- A functor from an abelian category to a triangulated category that carries
short exact sequences to distinguished triangles. -/
def MapsShortExactToDistinguished
    {A : Type u} [Category.{v} A] [Abelian A]
    {C : Type u'} [Category.{v'} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    (F : A ⥤ C) : Prop :=
  ∀ (S : ShortComplex A), S.ShortExact →
    ∃ δ : F.obj S.X₃ ⟶ (F.obj S.X₁)⟦(1 : ℤ)⟧,
      Triangle.mk (F.map S.f) (F.map S.g) δ ∈ distTriang C

/-- Short-exact relations map to distinguished-triangle relations. -/
theorem abelianKZero_relations_mapped
    {A : Type u} [Category.{v} A] [Abelian A]
    {C : Type u'} [Category.{v'} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    (F : A ⥤ C) (_hF : MapsShortExactToDistinguished F) :
    AbelianKZeroRelations A ≤
      AddMonoidHom.ker ((KZero.quotientMap (C := C)).comp (kZeroFreeMap F)) := by
  sorry

/-- The homomorphism induced by a functor carrying short exact sequences to
distinguished triangles. -/
noncomputable def abelianToTriangulatedKZeroMap
    {A : Type u} [Category.{v} A] [Abelian A]
    {C : Type u'} [Category.{v'} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    (F : A ⥤ C) (hF : MapsShortExactToDistinguished F) :
    AbelianKZero A →+ KZero C := by
  let φ := (KZero.quotientMap (C := C)).comp (kZeroFreeMap F)
  exact QuotientAddGroup.lift (AbelianKZeroRelations A) φ
    (abelianKZero_relations_mapped F hF)

/-- The induced abelian-to-triangulated map sends `[A]` to `[F(A)]`. -/
@[simp]
theorem abelianToTriangulatedKZeroMap_classOf
    {A : Type u} [Category.{v} A] [Abelian A]
    {C : Type u'} [Category.{v'} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    (F : A ⥤ C) (hF : MapsShortExactToDistinguished F) (X : A) :
    abelianToTriangulatedKZeroMap F hF
        (Formalization.Books.Homology.Unit11.KZero.classOf X) =
      KZero.classOf (F.obj X) := by
  sorry

/-- The canonical stalk functor into the bounded derived category. -/
noncomputable def boundedDerivedSingleFunctor
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A] : A ⥤ DBounded A :=
  (derivedBoundedProperty A).lift (DerivedCategory.singleFunctor A 0) (by
    intro X
    exact ⟨⟨0, inferInstance⟩, ⟨0, inferInstance⟩⟩)

/-- The finite set of degrees in which a bounded derived object has nonzero
cohomology. -/
def boundedDerivedCohomologySupport
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A] (X : DBounded A) : Set ℤ :=
  {i : ℤ | ¬ IsZero ((derivedCohomologyFunctor A i).obj
    ((DerivedCategory.Bounded.ι (C := A)).obj X))}

/-- Boundedness gives finite cohomological support. -/
theorem boundedDerivedCohomologySupport_finite
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A] (X : DBounded A) :
    (boundedDerivedCohomologySupport X).Finite := by
  sorry

/-- The alternating cohomology class `∑ (-1)^i [H^i(X)]`. -/
noncomputable def boundedDerivedEulerClass
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A] (X : DBounded A) : AbelianKZero A :=
  ∑ i ∈ (boundedDerivedCohomologySupport_finite X).toFinset,
    (i.negOnePow : ℤ) •
      Formalization.Books.Homology.Unit11.KZero.classOf
        ((derivedCohomologyFunctor A i).obj
          ((DerivedCategory.Bounded.ι (C := A)).obj X))

/-- The canonical triangle realization of short exact sequences in the
bounded derived category. -/
theorem boundedDerivedSingle_maps_shortExact
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A] :
    MapsShortExactToDistinguished (boundedDerivedSingleFunctor (A := A)) := by
  sorry

/-- The map from the abelian K₀ to the bounded-derived K₀. -/
noncomputable def boundedDerivedKZeroMap
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A] :
    AbelianKZero A →+ KZero (DBounded A) :=
  abelianToTriangulatedKZeroMap (boundedDerivedSingleFunctor (A := A))
    (boundedDerivedSingle_maps_shortExact (A := A))

/-- The bounded-derived K₀ identification, including its stalk and Euler
characteristic formulas. -/
theorem boundedDerivedKZero_identification
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A] :
    ∃ e : AbelianKZero A ≃+ KZero (DBounded A),
      (∀ X : A,
        e (Formalization.Books.Homology.Unit11.KZero.classOf X) =
          KZero.classOf ((boundedDerivedSingleFunctor (A := A)).obj X)) ∧
      (∀ X : DBounded A,
        e.symm (KZero.classOf X) = boundedDerivedEulerClass X) := by
  sorry

/-! The truncation computation displayed in the source. -/

/-- The degrees in which a bounded complex has nonzero terms. -/
def boundedComplexTermSupport
    {A : Type u} [Category.{v} A] [Abelian A]
    (K : BookComplex A) : Set ℤ :=
  {i : ℤ | ¬ IsZero (K.X i)}

/-- A bounded complex has finite term support. -/
theorem boundedComplexTermSupport_finite
    {A : Type u} [Category.{v} A] [Abelian A]
    (K : BookComplex A) (hK : IsBounded K) :
    (boundedComplexTermSupport K).Finite := by
  sorry

/-- The source's stupid-truncation computation of a bounded complex class. -/
theorem boundedComplex_class_alternating_sum
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A] (K : BookComplex A) (hK : IsBounded K) :
    ∃ X : DBounded A,
      Nonempty ((DerivedCategory.Bounded.ι (C := A)).obj X ≅
        (DerivedCategory.Q (C := A)).obj K) ∧
      KZero.classOf X =
        ∑ i ∈ (boundedComplexTermSupport_finite K hK).toFinset,
          (i.negOnePow : ℤ) •
            KZero.classOf ((boundedDerivedSingleFunctor (A := A)).obj (K.X i)) := by
  sorry

/-! ## Homological functors -/

/-- The finite support of the shifted values of a homological functor. -/
def homologicalKZeroSupport
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {A : Type u'} [Category.{v'} A] [Abelian A]
    (H : C ⥤ A) (X : C) : Set ℤ :=
  {i : ℤ | ¬ IsZero (H.obj ((shiftFunctor C i).obj X))}

/-- The source's finiteness hypothesis for a homological functor. -/
def HomologicalKZeroFiniteSupport
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {A : Type u'} [Category.{v'} A] [Abelian A]
    (H : C ⥤ A) : Prop :=
  ∀ X : C, (homologicalKZeroSupport H X).Finite

/-- The alternating class associated to a finitely supported homological
functor value. -/
noncomputable def homologicalKZeroAlternatingClass
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {A : Type u'} [Category.{v'} A] [Abelian A]
    (H : C ⥤ A) (hfinite : HomologicalKZeroFiniteSupport H) (X : C) :
    AbelianKZero A :=
  ∑ i ∈ (hfinite X).toFinset,
    (i.negOnePow : ℤ) •
      Formalization.Books.Homology.Unit11.KZero.classOf
        (H.obj ((shiftFunctor C i).obj X))

/-- The long exact cohomology sequence makes the alternating class additive
on distinguished triangles. -/
theorem homologicalKZero_relations
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {A : Type u'} [Category.{v'} A] [Abelian A]
    (H : C ⥤ A) [H.IsHomological]
    (hfinite : HomologicalKZeroFiniteSupport H) :
    KZeroRelations C ≤
      AddMonoidHom.ker (FreeAbelianGroup.lift (fun X =>
        homologicalKZeroAlternatingClass H hfinite X)) := by
  sorry

/-- The group homomorphism induced by a finitely supported homological
functor. -/
noncomputable def homologicalKZeroMap
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {A : Type u'} [Category.{v'} A] [Abelian A]
    (H : C ⥤ A) [H.IsHomological]
    (hfinite : HomologicalKZeroFiniteSupport H) :
    KZero C →+ AbelianKZero A := by
  let φ := FreeAbelianGroup.lift (fun X =>
    homologicalKZeroAlternatingClass H hfinite X)
  exact QuotientAddGroup.lift (KZeroRelations C) φ
    (homologicalKZero_relations H hfinite)

/-- The homological map has the source's alternating-sum value on a class. -/
@[simp]
theorem homologicalKZeroMap_classOf
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {A : Type u'} [Category.{v'} A] [Abelian A]
    (H : C ⥤ A) [H.IsHomological]
    (hfinite : HomologicalKZeroFiniteSupport H) (X : C) :
    homologicalKZeroMap H hfinite (KZero.classOf X) =
      homologicalKZeroAlternatingClass H hfinite X := by
  sorry

/-! ## Weak Serre subcategories -/

noncomputable instance derivedCohomologyBoundedWithinProperty_isTriangulated
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A]
    (P : ObjectProperty A) [P.IsWeakSerreClass] :
    (derivedCohomologyBoundedWithinProperty P).IsTriangulated := by
  exact (derivedCohomologyWithinProperty_properties P).2.2.2.1

/-- The bounded cohomology support of an object in `Dᵇ_P(𝒜)`. -/
def weakSerreCohomologySupport
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A]
    (P : ObjectProperty A) [P.IsWeakSerreClass]
    (X : derivedCohomologyBoundedWithinSubcategory P) : Set ℤ :=
  {i : ℤ | ¬ IsZero ((derivedCohomologyFunctor A i).obj
    ((DerivedCategory.Bounded.ι (C := A)).obj X.1))}

/-- The cohomology support of an object in `Dᵇ_P(𝒜)` is finite. -/
theorem weakSerreCohomologySupport_finite
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A]
    (P : ObjectProperty A) [P.IsWeakSerreClass]
    (X : derivedCohomologyBoundedWithinSubcategory P) :
    (weakSerreCohomologySupport P X).Finite := by
  sorry

/-- The inverse-map value `∑ (-1)^i [H^i(X)]` in the weak-Serre K₀ theorem. -/
noncomputable def weakSerreEulerClass
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A]
    (P : ObjectProperty A) [P.IsWeakSerreClass]
    (X : derivedCohomologyBoundedWithinSubcategory P) :
    AbelianKZero P.FullSubcategory :=
  ∑ i ∈ (weakSerreCohomologySupport_finite P X).toFinset,
    (i.negOnePow : ℤ) •
      Formalization.Books.Homology.Unit11.KZero.classOf
        (⟨(derivedCohomologyFunctor A i).obj
            ((DerivedCategory.Bounded.ι (C := A)).obj X.1),
          X.property i⟩ : P.FullSubcategory)

/-- The weak-Serre stalk lands in the bounded derived subcategory with
cohomology in `P`. -/
theorem weakSerreBoundedStalk_mem
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A]
    (P : ObjectProperty A) [P.IsWeakSerreClass] (X : P.FullSubcategory) :
    derivedCohomologyBoundedWithinProperty P
      ((boundedDerivedSingleFunctor (A := A)).obj (P.ι.obj X)) := by
  sorry

/-- The canonical stalk functor `𝒝 ⥤ Dᵇ_𝒝(𝒜)`. -/
noncomputable def weakSerreBoundedStalkFunctor
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A]
    (P : ObjectProperty A) [P.IsWeakSerreClass] :
    P.FullSubcategory ⥤ derivedCohomologyBoundedWithinSubcategory P :=
  (derivedCohomologyBoundedWithinProperty P).lift
    (P.ι ⋙ boundedDerivedSingleFunctor (A := A))
    (weakSerreBoundedStalk_mem P)

/-- The stalk functor sends short exact sequences to distinguished triangles. -/
theorem weakSerreBoundedStalk_maps_shortExact
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A]
    (P : ObjectProperty A) [P.IsWeakSerreClass] :
    MapsShortExactToDistinguished (weakSerreBoundedStalkFunctor P) := by
  sorry

/-- The weak-Serre K₀ identification and its inverse cohomology formula. -/
theorem weakSerre_boundedDerivedKZero_identification
    {A : Type u} [Category.{v} A] [Abelian A]
    [HasDerivedCategory.{w} A]
    (P : ObjectProperty A) [P.IsWeakSerreClass] :
    ∃ e : AbelianKZero P.FullSubcategory ≃+
        KZero (derivedCohomologyBoundedWithinSubcategory P),
      (∀ X : P.FullSubcategory,
        e (Formalization.Books.Homology.Unit11.KZero.classOf X) =
          KZero.classOf ((weakSerreBoundedStalkFunctor P).obj X)) ∧
      (∀ X : derivedCohomologyBoundedWithinSubcategory P,
        e.symm (KZero.classOf X) = weakSerreEulerClass P X) := by
  sorry

/-! ## Bilinear pairings -/

/-- The functor obtained from a bifunctor by fixing its first variable. -/
def tensorSectionFirst
    {C : Type u} [Category.{v} C]
    {D : Type u'} [Category.{v'} D]
    {E : Type w} [Category.{w'} E]
    (Tensor : C × D ⥤ E) (X : C) : D ⥤ E :=
  Prod.sectR X D ⋙ Tensor

/-- The functor obtained from a bifunctor by fixing its second variable. -/
def tensorSectionSecond
    {C : Type u} [Category.{v} C]
    {D : Type u'} [Category.{v'} D]
    {E : Type w} [Category.{w'} E]
    (Tensor : C × D ⥤ E) (Y : D) : C ⥤ E :=
  Prod.sectL C Y ⋙ Tensor

/-- A curried additive homomorphism is the bundled bilinear map used below. -/
abbrev KZeroBilinearMap
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {D : Type u'} [Category.{v'} D] [HasZeroObject D]
    [Preadditive D] [HasShift D ℤ]
    [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    {E : Type w} [Category.{w'} E] [HasZeroObject E]
    [Preadditive E] [HasShift E ℤ]
    [∀ n : ℤ, (shiftFunctor E n).Additive] [Pretriangulated E] :=
  KZero C →+ (KZero D →+ KZero E)

/-- Separate exactness in the two variables gives a bilinear K₀ pairing. -/
theorem kZeroBilinearMap_exists
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {D : Type u'} [Category.{v'} D] [HasZeroObject D]
    [Preadditive D] [HasShift D ℤ]
    [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    {E : Type w} [Category.{w'} E] [HasZeroObject E]
    [Preadditive E] [HasShift E ℤ]
    [∀ n : ℤ, (shiftFunctor E n).Additive] [Pretriangulated E]
    (Tensor : C × D ⥤ E)
    (hleft : ∀ X : C, Nonempty (ExactTriangulatedFunctorData
      (tensorSectionFirst Tensor X)))
    (hright : ∀ Y : D, Nonempty (ExactTriangulatedFunctorData
      (tensorSectionSecond Tensor Y))) :
    ∃ b : KZeroBilinearMap (C := C) (D := D) (E := E),
      ∀ X : C, ∀ Y : D,
        b (KZero.classOf X) (KZero.classOf Y) =
          KZero.classOf (Tensor.obj (X, Y)) := by
  sorry

/-- A chosen bilinear map induced by a separately exact tensor functor. -/
noncomputable def kZeroBilinearMap
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {D : Type u'} [Category.{v'} D] [HasZeroObject D]
    [Preadditive D] [HasShift D ℤ]
    [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    {E : Type w} [Category.{w'} E] [HasZeroObject E]
    [Preadditive E] [HasShift E ℤ]
    [∀ n : ℤ, (shiftFunctor E n).Additive] [Pretriangulated E]
    (Tensor : C × D ⥤ E)
    (hleft : ∀ X : C, Nonempty (ExactTriangulatedFunctorData
      (tensorSectionFirst Tensor X)))
    (hright : ∀ Y : D, Nonempty (ExactTriangulatedFunctorData
      (tensorSectionSecond Tensor Y))) :
    KZeroBilinearMap (C := C) (D := D) (E := E) :=
  Classical.choose (kZeroBilinearMap_exists Tensor hleft hright)

/-- The bilinear map sends pairs of object classes to the tensor class. -/
@[simp]
theorem kZeroBilinearMap_classOf
    {C : Type u} [Category.{v} C] [HasZeroObject C]
    [Preadditive C] [HasShift C ℤ]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {D : Type u'} [Category.{v'} D] [HasZeroObject D]
    [Preadditive D] [HasShift D ℤ]
    [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    {E : Type w} [Category.{w'} E] [HasZeroObject E]
    [Preadditive E] [HasShift E ℤ]
    [∀ n : ℤ, (shiftFunctor E n).Additive] [Pretriangulated E]
    (Tensor : C × D ⥤ E)
    (hleft : ∀ X : C, Nonempty (ExactTriangulatedFunctorData
      (tensorSectionFirst Tensor X)))
    (hright : ∀ Y : D, Nonempty (ExactTriangulatedFunctorData
      (tensorSectionSecond Tensor Y))) (X : C) (Y : D) :
    kZeroBilinearMap Tensor hleft hright (KZero.classOf X) (KZero.classOf Y) =
      KZero.classOf (Tensor.obj (X, Y)) := by
  simpa [kZeroBilinearMap] using
    (Classical.choose_spec (kZeroBilinearMap_exists Tensor hleft hright) X Y)

end Formalization.Books.Derived.Unit28
