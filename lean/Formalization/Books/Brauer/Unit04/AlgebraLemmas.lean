/- The source's clause (6) refers to the skew field `End_A(M)` from clause
   (5).  Its assertion about the double commutant needs the smallest
   correction of assuming that `N` is nonzero; the earlier nonzero-module
   theorem is useful as a specialization. -/
theorem finite_module_end_is_matrix_over_simple_module
    (k A M N : Type*) [Field k] [Ring A] [Algebra k A]
    [FiniteDimensional k A] [IsSimpleRing A]
    [AddCommGroup M] [Module A M] [IsSimpleModule A M]
    [Module k M] [IsScalarTower k A M]
    [AddCommGroup N] [Nontrivial N] [Module A N] [Module k N]
    [IsScalarTower k A N]
    [Module.Finite A N] :
    ∃ (n : ℕ) (_ : NeZero n),
      Nonempty
          (Module.End A N ≃ₐ[k]
            Matrix (Fin n) (Fin n) (Module.End A M)) ∧
        Nonempty (Module.End (Module.End A N) N ≃ₐ[k] A) := by
  sorry

