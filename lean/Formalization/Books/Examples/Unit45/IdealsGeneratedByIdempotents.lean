/-!
# Examples, Chapter 45: ideals generated by sets of idempotents and localization

This file records the two examples in the source section.  The first uses a
quotient of an infinite-variable polynomial ring, and the second is the
twisted gluing example whose construction details are deliberately omitted in
the source.  Statements are left for the proving stage.
-/

noncomputable section

namespace Formalization.Books.Examples.Unit45

universe u

section InfiniteIdempotentPolynomialRing

variable (R : Type u) [CommRing R]

/-- The relations `xₙ(xₙ - 1)` and `xₙxₘ` for distinct indices. -/
def bRelations : Set (MvPolynomial ℤ R) :=
  {f | ∃ n : ℤ, f = MvPolynomial.X n * (MvPolynomial.X n - 1)} ∪
    {f | ∃ n m : ℤ, n ≠ m ∧ f = MvPolynomial.X n * MvPolynomial.X m}

/-- The ideal imposing the defining relations of `B(R)`. -/
def bRelationIdeal : Ideal (MvPolynomial ℤ R) :=
  Ideal.span (bRelations R)

/-- The ring `B(R) = R[xₙ ; n ∈ ℤ]/(xₙ(xₙ - 1), xₙxₘ ; n ≠ m)`. -/
abbrev bRing : Type u := MvPolynomial ℤ R ⧸ bRelationIdeal R

/-- The quotient map used in the definition of `B(R)`. -/
def bQuotientMap : MvPolynomial ℤ R →+* bRing R :=
  Ideal.Quotient.mk (bRelationIdeal R)

/-- The image of the coefficient ring in `B(R)`. -/
def bCoefficientMap : R →+* bRing R :=
  (bQuotientMap R).comp MvPolynomial.C

/-- The distinguished idempotent `xₙ` in `B(R)`. -/
def bGenerator (R : Type u) [CommRing R] (n : ℤ) : bRing R :=
  bQuotientMap R (MvPolynomial.X n)

/-- The ideal generated by all the distinguished idempotents. -/
def bIdempotentIdeal : Ideal (bRing R) :=
  Ideal.span (Set.range (bGenerator R))

/-- The ideal `(pB(R), xₙ ; n ∈ ℤ)` appearing in the central copy. -/
def bCentralPrimeIdeal (p : Ideal R) : Ideal (bRing R) :=
  Ideal.map (bCoefficientMap R) p ⊔ bIdempotentIdeal R

/-- The ideal `(pB(R), xₙ - 1, xₘ ; m ≠ n)` appearing in the `n`-th copy. -/
def bBranchPrimeIdeal (p : Ideal R) (n : ℤ) : Ideal (bRing R) :=
  Ideal.map (bCoefficientMap R) p ⊔
    Ideal.span
      (insert (bGenerator R n - 1)
        {f | ∃ m : ℤ, m ≠ n ∧ f = bGenerator R m})

/-- Every distinguished generator is idempotent. -/
theorem bGenerator_isIdempotent (n : ℤ) :
    IsIdempotentElem (bGenerator R n) := by
  sorry

/-- Distinct distinguished generators have zero product. -/
theorem bGenerator_mul_eq_zero {n m : ℤ} (hnm : n ≠ m) :
    bGenerator R n * bGenerator R m = 0 := by
  sorry

/-- The displayed ideals are the two possible forms of a prime ideal of `B(R)`. -/
theorem b_prime_ideal_classification (q : Ideal (bRing R)) (hq : q.IsPrime) :
    (∃ p : Ideal R, p.IsPrime ∧ q = bCentralPrimeIdeal R p) ∨
      ∃ (n : ℤ) (p : Ideal R), p.IsPrime ∧ q = bBranchPrimeIdeal R p n := by
  sorry

/-- The set-theoretic form of the decomposition
`Spec(B(R)) = Spec(R) ⊔ ⨿ₙ Spec(R)`. -/
theorem b_primeSpectrum_decomposition :
    Nonempty
      (PrimeSpectrum (bRing R) ≃
        PrimeSpectrum R ⊕ (Σ _ : ℤ, PrimeSpectrum R)) := by
  sorry

/-- The central copy is the closed set cut out by the idempotent ideal. -/
def bCentralCopy (R : Type u) [CommRing R] : Set (PrimeSpectrum (bRing R)) :=
  PrimeSpectrum.zeroLocus (bIdempotentIdeal R)

/-- The `n`-th copy is the standard open `D(xₙ)`. -/
def bBranchCopy (R : Type u) [CommRing R] (n : ℤ) : Set (PrimeSpectrum (bRing R)) :=
  (PrimeSpectrum.basicOpen (bGenerator R n) : Set (PrimeSpectrum (bRing R)))

theorem bCentralCopy_isClosed (R : Type u) [CommRing R] :
    IsClosed (bCentralCopy R) := by
  sorry

theorem bBranchCopy_isOpen (R : Type u) [CommRing R] (n : ℤ) :
    IsOpen (bBranchCopy R n) := by
  exact PrimeSpectrum.isOpen_basicOpen

/-- Infinitely many branch copies accumulate on the central copy. -/
theorem bCentralCopy_subset_closure_iUnion_of_infinite
    (R : Type u) [CommRing R]
    (S : Set ℤ) (hS : S.Infinite) :
    bCentralCopy R ⊆
      closure (⋃ n ∈ S, bBranchCopy R n) := by
  sorry

/-- The central closed subscheme is cut out by an ideal generated by idempotents. -/
theorem bIdempotentIdeal_isGeneratedByIdempotents (R : Type u) [CommRing R] :
    ∃ s : Set (bRing R),
      (∀ e ∈ s, IsIdempotentElem e) ∧ bIdempotentIdeal R = Ideal.span s := by
  refine ⟨Set.range (bGenerator R), ?_, rfl⟩
  rintro _ ⟨n, rfl⟩
  exact bGenerator_isIdempotent R n

/-- If `Spec(R)` is connected, the displayed pieces are its connected components. -/
theorem b_connected_component_decomposition
    (R : Type u) [CommRing R]
    [ConnectedSpace (PrimeSpectrum R)] :
    ∃ e : PrimeSpectrum (bRing R) ≃
        PrimeSpectrum R ⊕ (Σ _ : ℤ, PrimeSpectrum R),
      ∀ x y,
        ConnectedComponents.mk x = ConnectedComponents.mk y ↔
          match e x, e y with
          | Sum.inl _, Sum.inl _ => True
          | Sum.inr ⟨n, _⟩, Sum.inr ⟨m, _⟩ => n = m
          | _, _ => False := by
  sorry

end InfiniteIdempotentPolynomialRing

section TwistedCurve

/-! ## The two-component affine curve -/

def curveX : MvPolynomial (Fin 2) ℂ := MvPolynomial.X 0

def curveY : MvPolynomial (Fin 2) ℂ := MvPolynomial.X 1

def curveFactor₁ : MvPolynomial (Fin 2) ℂ := curveY - curveX ^ 2 + 1

def curveFactor₂ : MvPolynomial (Fin 2) ℂ := curveY + curveX ^ 2 - 1

/-- The ring `A = ℂ[x,y]/((y - x² + 1)(y + x² - 1))`. -/
abbrev curveRing : Type :=
  MvPolynomial (Fin 2) ℂ ⧸ Ideal.span ({curveFactor₁ * curveFactor₂} : Set _)

/-- The coordinate rings of the two irreducible components. -/
abbrev curveComponent₁ : Type :=
  MvPolynomial (Fin 2) ℂ ⧸ Ideal.span ({curveFactor₁} : Set _)

abbrev curveComponent₂ : Type :=
  MvPolynomial (Fin 2) ℂ ⧸ Ideal.span ({curveFactor₂} : Set _)

def curvePointP : ℂ × ℂ := (-1, 0)

def curvePointQ : ℂ × ℂ := (1, 0)

def curveIntersectionPoints : Set (ℂ × ℂ) :=
  {curvePointP, curvePointQ}

/-- The two component equations meet exactly at `P = (-1,0)` and `Q = (1,0)`. -/
theorem curve_components_intersect_at_P_and_Q :
    {p : ℂ × ℂ |
        (p.2 - p.1 ^ 2 + 1 = 0) ∧ (p.2 + p.1 ^ 2 - 1 = 0)} =
      curveIntersectionPoints := by
  sorry

/-- Each of the two displayed component rings is a domain, hence its spectrum
is irreducible. -/
theorem curve_components_are_irreducible :
    IsDomain curveComponent₁ ∧ IsDomain curveComponent₂ := by
  sorry

def curveParam₁Base : MvPolynomial (Fin 2) ℂ →+* Polynomial ℂ :=
  MvPolynomial.eval₂Hom Polynomial.C
    (fun i => if i = 0 then Polynomial.X else Polynomial.X ^ 2 - 1)

def curveParam₂Base : MvPolynomial (Fin 2) ℂ →+* Polynomial ℂ :=
  MvPolynomial.eval₂Hom Polynomial.C
    (fun i => if i = 0 then Polynomial.X else -Polynomial.X ^ 2 + 1)

/-- The parameter maps `(x,y) = (t,t² - 1)` and `(x,y) = (t,-t² + 1)`. -/
def curveParam₁ : curveComponent₁ →+* Polynomial ℂ :=
  Ideal.Quotient.lift (Ideal.span ({curveFactor₁} : Set _)) curveParam₁Base (by
    intro f hf
    have hle : Ideal.span ({curveFactor₁} : Set _) ≤ RingHom.ker curveParam₁Base := by
      rw [Ideal.span_le]
      intro g hg
      rw [Set.mem_singleton_iff.mp hg]
      simp [curveParam₁Base, curveFactor₁, curveX, curveY]
    exact hle hf)

def curveParam₂ : curveComponent₂ →+* Polynomial ℂ :=
  Ideal.Quotient.lift (Ideal.span ({curveFactor₂} : Set _)) curveParam₂Base (by
    intro f hf
    have hle : Ideal.span ({curveFactor₂} : Set _) ≤ RingHom.ker curveParam₂Base := by
      rw [Ideal.span_le]
      intro g hg
      rw [Set.mem_singleton_iff.mp hg]
      simp [curveParam₂Base, curveFactor₂, curveX, curveY]
    exact hle hf)

theorem curveParam₁_coordinates :
    curveParam₁ (Ideal.Quotient.mk (Ideal.span ({curveFactor₁} : Set _)) curveX) =
        Polynomial.X ∧
      curveParam₁ (Ideal.Quotient.mk (Ideal.span ({curveFactor₁} : Set _)) curveY) =
        Polynomial.X ^ 2 - 1 := by
  sorry

theorem curveParam₂_coordinates :
    curveParam₂ (Ideal.Quotient.mk (Ideal.span ({curveFactor₂} : Set _)) curveX) =
        Polynomial.X ∧
      curveParam₂ (Ideal.Quotient.mk (Ideal.span ({curveFactor₂} : Set _)) curveY) =
        -Polynomial.X ^ 2 + 1 := by
  sorry

/-! ## The twisted gluing and the source existence lemma -/

/-- Ideals generated by sets of idempotents. -/
def IdealGeneratedByIdempotents {S : Type u} [CommRing S] (I : Ideal S) : Prop :=
  ∃ s : Set S, (∀ e ∈ s, IsIdempotentElem e) ∧ I = Ideal.span s

/-- An ideal is locally generated by idempotents on the standard-open cover. -/
def LocallyIdealGeneratedByIdempotents {S : Type u} [CommRing S] (I : Ideal S) : Prop :=
  ∀ p : PrimeSpectrum S, ∃ f : S, f ∉ p.asIdeal ∧
    IdealGeneratedByIdempotents
      (Ideal.map (algebraMap S (Localization.Away f)) I)

/-- The high-level interface supplied by the omitted twisted gluing construction. -/
structure TwistedGluingInterface (A : Type u) [CommRing A] where
  carrier : Type u
  commRing : CommRing carrier
  algebra : Algebra A carrier
  sectionMap : carrier →+* A
  section_comp_algebraMap :
    sectionMap.comp (algebraMap A carrier) = RingHom.id A
  locally_untwisted_away_P : Prop
  locally_untwisted_away_Q : Prop
  index_shift_at_Q : Prop
  spectrum_connected :
    IsConnected (Set.univ : Set (PrimeSpectrum carrier))
  carrier_has_no_nontrivial_idempotents :
    Formalization.Books.Examples.Unit06.NoNontrivialIdempotents carrier
  central_kernel_locally_idempotent_generated :
    LocallyIdealGeneratedByIdempotents (RingHom.ker sectionMap)
  central_kernel_not_idempotent_generated :
    ¬ IdealGeneratedByIdempotents (RingHom.ker sectionMap)

/-- The omitted gluing construction produces an `A`-algebra with the stated properties. -/
theorem exists_twistedGluingInterface :
    Nonempty (TwistedGluingInterface (A := curveRing)) := by
  sorry

/-- A chosen interface object for the ring denoted `B^twist(A)` in the source.
The source omits the actual gluing construction, so the usable Lean object is
the interface carrying exactly the stated properties. -/
noncomputable def twistedGluingInterface : TwistedGluingInterface (A := curveRing) :=
  Classical.choice exists_twistedGluingInterface

/-- The twisted spectrum is connected, despite being locally the untwisted model. -/
theorem twisted_spectrum_connected :
    ∃ (B : Type u) (_ : CommRing B) (_ : Algebra curveRing B)
      (sectionMap : B →+* curveRing),
      sectionMap.comp (algebraMap curveRing B) = RingHom.id curveRing ∧
        IsConnected (Set.univ : Set (PrimeSpectrum B)) ∧
        LocallyIdealGeneratedByIdempotents (RingHom.ker sectionMap) ∧
        ¬ IdealGeneratedByIdempotents (RingHom.ker sectionMap) ∧
        Formalization.Books.Examples.Unit06.NoNontrivialIdempotents B := by
  sorry

/-! ## The local/global obstruction -/

/-- The chapter's final existence statement, in affine ring language. -/
theorem exists_affine_closed_not_globally_idempotent_generated :
    ∃ (S : Type u) (_ : CommRing S) (I : Ideal S),
      LocallyIdealGeneratedByIdempotents I ∧
        ¬ IdealGeneratedByIdempotents I := by
  sorry

end TwistedCurve

end Formalization.Books.Examples.Unit45
