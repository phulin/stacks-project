import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Exercises, Chapter 19: Fraction fields

The source exercise starts with a quotient of a three-variable polynomial ring
and asks for a plane-curve presentation of its fraction field.  The
polynomial rings below use Mathlib's canonical `MvPolynomial` representation.
-/

namespace Formalization.Books.Exercises.Unit19

noncomputable section

/-! ## The source quotient -/

/-- The polynomial ring `ℚ[r, s, t]` in the source exercise. -/
abbrev sourcePolynomialRing := MvPolynomial (Fin 3) ℚ

/-- The relation `s² = (r - 1)(r - 2)(r - 3)`. -/
def sourceSRelation : sourcePolynomialRing :=
  (MvPolynomial.X (1 : Fin 3)) ^ 2 -
    (MvPolynomial.X (0 : Fin 3) - MvPolynomial.C (1 : ℚ)) *
      (MvPolynomial.X (0 : Fin 3) - MvPolynomial.C (2 : ℚ)) *
      (MvPolynomial.X (0 : Fin 3) - MvPolynomial.C (3 : ℚ))

/-- The relation `t² = (r + 1)(r + 2)(r + 3)`. -/
def sourceTRelation : sourcePolynomialRing :=
  (MvPolynomial.X (2 : Fin 3)) ^ 2 -
    (MvPolynomial.X (0 : Fin 3) + MvPolynomial.C (1 : ℚ)) *
      (MvPolynomial.X (0 : Fin 3) + MvPolynomial.C (2 : ℚ)) *
      (MvPolynomial.X (0 : Fin 3) + MvPolynomial.C (3 : ℚ))

/-- The ideal generated by the two displayed relations. -/
def sourceRelationsIdeal : Ideal sourcePolynomialRing :=
  Ideal.span {sourceSRelation, sourceTRelation}

/-- The domain `ℚ[r, s, t]/(s² - (r-1)(r-2)(r-3),
 t² - (r+1)(r+2)(r+3))`. -/
abbrev sourceRing := sourcePolynomialRing ⧸ sourceRelationsIdeal

/-! ## A plane-curve presentation -/

/-- The polynomial ring `ℚ[x, y]` used for the requested presentation. -/
abbrev planePolynomialRing := MvPolynomial (Fin 2) ℚ

/-- The first cubic in the primitive-element relation, in the variable `x`. -/
def planeFirstCubic : planePolynomialRing :=
  (MvPolynomial.X (0 : Fin 2) - MvPolynomial.C (1 : ℚ)) *
    (MvPolynomial.X (0 : Fin 2) - MvPolynomial.C (2 : ℚ)) *
    (MvPolynomial.X (0 : Fin 2) - MvPolynomial.C (3 : ℚ))

/-- The second cubic in the primitive-element relation, in the variable `x`. -/
def planeSecondCubic : planePolynomialRing :=
  (MvPolynomial.X (0 : Fin 2) + MvPolynomial.C (1 : ℚ)) *
    (MvPolynomial.X (0 : Fin 2) + MvPolynomial.C (2 : ℚ)) *
    (MvPolynomial.X (0 : Fin 2) + MvPolynomial.C (3 : ℚ))

/--
The relation obtained by taking `y = s + t`:
`(y² - P(x) - Q(x))² = 4 P(x) Q(x)`.
-/
def planeRelation : planePolynomialRing :=
  ((MvPolynomial.X (1 : Fin 2)) ^ 2 - planeFirstCubic - planeSecondCubic) ^ 2 -
    4 * planeFirstCubic * planeSecondCubic

/-- The plane curve `ℚ[x, y]/(planeRelation)`. -/
abbrev planeCurveRing := planePolynomialRing ⧸ Ideal.span {planeRelation}

end

end Formalization.Books.Exercises.Unit19
