/-! ## Basic completion and torsion notation -/

/-- The `f`-adic completion `R^` from the source, using Mathlib's canonical
adic completion for the principal ideal generated by `f`. -/
abbrev fAdicCompletion (R : Type u) [CommRing R] (f : R) :=
  AdicCompletion (Ideal.span ({f} : Set R)) R

/-- The canonical map from a ring to its `f`-adic completion. -/
abbrev fAdicCompletionMap (R : Type u) [CommRing R] (f : R) :
    R →+* fAdicCompletion R f :=
  algebraMap R (fAdicCompletion R f)

/-- The map on the `n`-th principal quotients induced by a ring map. -/
abbrev powerQuotientMap {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (n : ℕ) :
    R ⧸ Ideal.span ({f ^ n} : Set R) →+*
      S ⧸ Ideal.map φ (Ideal.span ({f ^ n} : Set R)) :=
  idealQuotientMap φ (Ideal.span ({f ^ n} : Set R))

/-- The quotient-isomorphism hypothesis used for a Beauville--Laszlo pair. -/
def SamePowerQuotients {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  ∀ n : ℕ, 0 < n → Function.Bijective (powerQuotientMap φ f n)

/-- The canonical `f`-power torsion submodule, in the notation of the source.
This is the principal-ideal specialization of Chapter 89's canonical
`idealPowerTorsionSubmoduleInfinity`. -/
abbrev fPowerTorsionSubmodule {R M : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] (f : R) : Submodule R M :=
  idealPowerTorsionSubmoduleInfinity (Ideal.span ({f} : Set R))

/-- The source's finite-level notation `M[f^n]`. -/
abbrev fPowerTorsionSubmoduleAt {R M : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] (f : R) (n : ℕ) : Submodule R M :=
  idealPowerTorsionSubmodule (Ideal.span ({f} : Set R)) n

theorem mem_fPowerTorsionSubmoduleAt_iff
    {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    (f : R) (n : ℕ) (x : M) :
    x ∈ fPowerTorsionSubmoduleAt f n ↔
      ∀ a : R, a ∈ Ideal.span ({f} : Set R) ^ n → a • x = 0 := by
  exact mem_idealPowerTorsionSubmodule_iff (Ideal.span ({f} : Set R)) n x

theorem fPowerTorsionSubmoduleInfinity_eq_iUnion
    {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    (f : R) :
    ((fPowerTorsionSubmodule (M := M) f : Submodule R M) : Set M) =
      ⋃ n : ℕ, ((fPowerTorsionSubmoduleAt (M := M) f (n + 1)) : Set M) := by
  exact idealPowerTorsionSubmoduleInfinity_coe_eq_iUnion (Ideal.span ({f} : Set R))

theorem fPowerTorsionSubmodule_eq_kernel_localizedMap
    {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    (f : R) :
    fPowerTorsionSubmodule f =
      LinearMap.ker (LocalizedModule.mkLinearMap (Submonoid.powers f) M) := by
  sorry

/-- The source's assertion that a module is `f`-power torsion. -/
abbrev IsFPowerTorsion {R M : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] (f : R) : Prop :=
  IsIPowerTorsion (Ideal.span ({f} : Set R)) M

theorem isFPowerTorsion_iff
    {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    (f : R) :
    IsFPowerTorsion (M := M) f ↔
      ∀ x : M, ∃ n : ℕ, 0 < n ∧ f ^ n • x = 0 := by
  exact principal_isIPowerTorsion_iff f

/-- The map on `f`-power torsion elements, expressed without introducing a
parallel submodule map between differently-scalared modules. -/
def MapsFPowerTorsion {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  ∀ x : R, x ∈ fPowerTorsionSubmodule f →
    φ x ∈ fPowerTorsionSubmodule (M := S) (φ f)

def InjectiveOnFPowerTorsion {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  ∀ ⦃x y : R⦄, x ∈ fPowerTorsionSubmodule f →
    y ∈ fPowerTorsionSubmodule f → φ x = φ y → x = y

def SurjectiveOnFPowerTorsion {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  ∀ y : S, y ∈ fPowerTorsionSubmodule (M := S) (φ f) →
    ∃ x : R, x ∈ fPowerTorsionSubmodule f ∧ φ x = y

def BijectiveOnFPowerTorsion {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  MapsFPowerTorsion φ f ∧ InjectiveOnFPowerTorsion φ f ∧
    SurjectiveOnFPowerTorsion φ f

/-! ## The Cech sequence and glueing pairs -/

/- The source's four-term Cech sequence is the compatible-pair pullback for
the principal ring square.  Chapter 5 provides that pullback and Chapter 90
provides the canonical square and module base-change functor. -/

abbrev blRingSquare {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) :=
  principalGlueingRingSquare φ f

abbrev blGlueingCategory {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) :=
  ModuleGluingCategory (blRingSquare φ f)

noncomputable abbrev blCanFunctor {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) :
    ModuleCat.{u} R ⥤ blGlueingCategory φ f :=
  moduleBaseChangeFunctor (blRingSquare φ f)

noncomputable abbrev blH0Functor {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) :
    blGlueingCategory φ f ⥤ ModuleCat.{u} R :=
  moduleFiberProductRightAdjointCanonical (blRingSquare φ f)

noncomputable abbrev blCanH0Unit {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (M : ModuleCat.{u} R) :
    M ⟶ (blH0Functor φ f).obj ((blCanFunctor φ f).obj M) :=
  (moduleFiberProductAdjunctionData (blRingSquare φ f)).adjunction.unit.app M

def blRingCechLeft {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : R → S × Localization.Away f :=
  fun r => (φ r, algebraMap R (Localization.Away f) r)

def blRingCechRight {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) :
    S × Localization.Away f → Localization.Away (φ f) :=
  fun x => algebraMap S (Localization.Away (φ f)) x.1 -
    Localization.awayMap φ f x.2

def CechExactOnRight {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  Function.Surjective (blRingCechRight φ f)

def CechExactOnLeft {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  Function.Injective (blRingCechLeft φ f)

def CechExactInMiddle {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  Function.Exact (blRingCechLeft φ f) (blRingCechRight φ f)

def RingCechSequenceExact {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  CechExactOnLeft φ f ∧ CechExactInMiddle φ f ∧ CechExactOnRight φ f

def IsGlueingPair {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) : Prop :=
  SamePowerQuotients φ f ∧ RingCechSequenceExact φ f

/-- The principal-specialized notion `GlueingPair (R,f)` in the source. -/
def IsSelfGlueingPair {R : Type u} [CommRing R] (f : R) : Prop :=
  IsGlueingPair (fAdicCompletionMap R f) f

theorem same_quotients_for_fAdicCompletion
    {R : Type u} [CommRing R] (f : R) :
    SamePowerQuotients (fAdicCompletionMap R f) f := by
  sorry

theorem fAdicCompletion_is_self_glueing_pair
    {R : Type u} [CommRing R] (f : R)
    (h : BijectiveOnFPowerTorsion (fAdicCompletionMap R f) f) :
    IsSelfGlueingPair f := by
  sorry

theorem cech_exact_on_right
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hquot : SamePowerQuotients φ f) :
    CechExactOnRight φ f := by
  sorry

theorem cech_exact_on_left_iff
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hquot : SamePowerQuotients φ f) :
    CechExactOnLeft φ f ↔ InjectiveOnFPowerTorsion φ f := by
  sorry

theorem cech_exact_in_middle_iff
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) (hquot : SamePowerQuotients φ f) :
    CechExactInMiddle φ f ↔ SurjectiveOnFPowerTorsion φ f := by
