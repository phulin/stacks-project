import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.Algebra.MvPolynomial.Division
import Mathlib.RingTheory.Ideal.AssociatedPrime.Basic
import Mathlib.RingTheory.Ideal.Quotient.Noetherian
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Exercises, Chapter 10: a prime square with an extra associated prime

The second exercise is witnessed by the quotient
`k[x,y]/(x^2,xy)`.  The image of `x` generates a prime ideal whose square is
zero, while the ring itself has the additional associated maximal ideal
generated by the images of `x` and `y`.
-/

noncomputable section

universe u

namespace Formalization.Books.Exercises.Unit10

/-! ## The explicit Noetherian example -/

/-- The polynomial ring used for the prime-square example. -/
abbrev squareExamplePolynomialRing (k : Type u) [Field k] :=
  MvPolynomial (Fin 2) k

/-- The two coordinate variables in the polynomial presentation. -/
def squareExampleXPolynomial (k : Type u) [Field k] :
    squareExamplePolynomialRing k :=
  MvPolynomial.X (0 : Fin 2)

def squareExampleYPolynomial (k : Type u) [Field k] :
    squareExamplePolynomialRing k :=
  MvPolynomial.X (1 : Fin 2)

/-- The relations `x²` and `xy`. -/
def squareExampleRelationIdeal (k : Type u) [Field k] :
    Ideal (squareExamplePolynomialRing k) :=
  Ideal.span
    ({squareExampleXPolynomial k ^ 2,
      squareExampleXPolynomial k * squareExampleYPolynomial k} :
      Set (squareExamplePolynomialRing k))

/-- The Noetherian quotient ring `k[x,y]/(x²,xy)`. -/
abbrev squareExampleRing (k : Type u) [Field k] :=
  squareExamplePolynomialRing k ⧸ squareExampleRelationIdeal k

/-- The images of `x` and `y` in the quotient ring. -/
def squareExampleX (k : Type u) [Field k] : squareExampleRing k :=
  Ideal.Quotient.mk (squareExampleRelationIdeal k)
    (squareExampleXPolynomial k)

def squareExampleY (k : Type u) [Field k] : squareExampleRing k :=
  Ideal.Quotient.mk (squareExampleRelationIdeal k)
    (squareExampleYPolynomial k)

/-- The prime ideal `p=(x)` in the quotient ring. -/
def squareExamplePrimeIdeal (k : Type u) [Field k] : Ideal (squareExampleRing k) :=
  Ideal.span ({squareExampleX k} : Set (squareExampleRing k))

/-- The extra associated maximal ideal `q=(x,y)`. -/
def squareExampleExtraPrimeIdeal (k : Type u) [Field k] : Ideal (squareExampleRing k) :=
  Ideal.span ({squareExampleX k, squareExampleY k} : Set (squareExampleRing k))

/-- The quotient module `R/p²` from the exercise. -/
abbrev squareExamplePrimeSquareQuotient (k : Type u) [Field k] :=
  squareExampleRing k ⧸ (squareExamplePrimeIdeal k) ^ 2

/-- The displayed example ring is Noetherian. -/
theorem square_example_ring_is_noetherian (k : Type u) [Field k] :
    IsNoetherianRing (squareExampleRing k) := by
  infer_instance

/-- The ideal `p=(x)` is prime. -/
theorem square_example_prime_is_prime (k : Type u) [Field k] :
    (squareExamplePrimeIdeal k).IsPrime := by
  let P : Ideal (squareExamplePolynomialRing k) :=
    Ideal.span ({squareExampleXPolynomial k} : Set _)
  let hP : P.IsPrime := Ideal.isPrime_span_singleton_of_prime
    (MvPolynomial.X_prime : Prime (squareExampleXPolynomial k))
  have hIP : squareExampleRelationIdeal k ≤ P := by
    rw [squareExampleRelationIdeal, Ideal.span_le]
    intro f hf
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hf
    rcases hf with rfl | rfl
    · apply P.mul_mem_left
      exact Ideal.subset_span (by simp)
    · apply P.mul_mem_right
      exact Ideal.subset_span (by simp)
  have hmap : Ideal.map (Ideal.Quotient.mk (squareExampleRelationIdeal k)) P =
      squareExamplePrimeIdeal k := by
    simp [P, squareExamplePrimeIdeal, squareExampleX, Ideal.map_span]
  rw [← hmap]
  exact @Ideal.isPrime_map_quotientMk_of_isPrime _ _ _ _ P hP hIP

/-- The square of `p` is zero in the displayed quotient ring. -/
theorem square_example_prime_square_eq_bot (k : Type u) [Field k] :
    (squareExamplePrimeIdeal k) ^ 2 = (⊥ : Ideal (squareExampleRing k)) := by
  sorry

/-- The example has exactly one associated prime besides `p`. -/
theorem square_example_associated_primes (k : Type u) [Field k] :
    associatedPrimes (squareExampleRing k)
        (squareExamplePrimeSquareQuotient k) =
      ({squareExamplePrimeIdeal k, squareExampleExtraPrimeIdeal k} :
        Set (Ideal (squareExampleRing k))) := by
  sorry

end Formalization.Books.Exercises.Unit10
