import Mathlib.Algebra.Module.LocalizedModule.AtPrime
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Spectrum.Maximal.Defs
import Mathlib.RingTheory.Spectrum.Prime.Basic

/-!
# Exercises, Chapter 7: Localization

This file records the criteria for detecting zero elements and zero modules
after localization.  The source's annihilator of an element is the canonical
span-annihilator ideal `(Submodule.span A {m}).annihilator`.
-/

noncomputable section

universe u v

namespace Formalization.Books.Exercises.Unit07

/-! ## Annihilators and localization at primes -/

/-- The canonical annihilator ideal of the cyclic submodule generated by an
element has the expected membership criterion. -/
theorem annihilator_of_element_mem_iff
    {A : Type u} [CommRing A]
    {M : Type v} [AddCommGroup M] [Module A M]
    (m : M) (a : A) :
    a ∈ (Submodule.span A ({m} : Set M)).annihilator ↔ a • m = 0 := by
  exact Submodule.mem_annihilator_span_singleton m a

/-- An element vanishes in the localization at a prime exactly when its
annihilator is not contained in that prime. -/
theorem localize_at_prime_eq_zero_iff_annihilator_not_le
    {A : Type u} [CommRing A]
    {M : Type v} [AddCommGroup M] [Module A M]
    (p : PrimeSpectrum A) (m : M) :
    (LocalizedModule.mkLinearMap p.asIdeal.primeCompl M) m = 0 ↔
      ¬ (Submodule.span A ({m} : Set M)).annihilator ≤ p.asIdeal := by
  sorry

/-- An element is zero exactly when all of its prime-localized images are
zero. -/
theorem element_eq_zero_iff_all_prime_localizations_eq_zero
    {A : Type u} [CommRing A]
    {M : Type v} [AddCommGroup M] [Module A M]
    (m : M) :
    m = 0 ↔
      ∀ p : PrimeSpectrum A,
        (LocalizedModule.mkLinearMap p.asIdeal.primeCompl M) m = 0 := by
  sorry

/-- An element is zero exactly when all of its maximal-localized images are
zero. -/
theorem element_eq_zero_iff_all_maximal_localizations_eq_zero
    {A : Type u} [CommRing A]
    {M : Type v} [AddCommGroup M] [Module A M]
    (m : M) :
    m = 0 ↔
      ∀ p : MaximalSpectrum A,
        (LocalizedModule.mkLinearMap p.asIdeal.primeCompl M) m = 0 := by
  sorry

/-- A module is zero exactly when all of its maximal-localized modules are
zero. -/
theorem module_subsingleton_iff_all_maximal_localizations_subsingleton
    {A : Type u} [CommRing A]
    {M : Type v} [AddCommGroup M] [Module A M] :
    Subsingleton M ↔
      ∀ p : MaximalSpectrum A,
        Subsingleton (LocalizedModule.AtPrime p.asIdeal M) := by
  sorry

end Formalization.Books.Exercises.Unit07
