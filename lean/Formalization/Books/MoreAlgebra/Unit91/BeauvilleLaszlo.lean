def IsFRegularOnModule {R M : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] (f : R) : Prop :=
  Function.Injective (fun x : M => f • x)

theorem selfGlueingPair_of_isRegular
    {R : Type u} [CommRing R] (f : R) (hf : IsRegular f) :
