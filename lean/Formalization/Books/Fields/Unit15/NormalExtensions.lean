import Formalization.Books.Fields.Unit12.SeparableAlgebraicExtensions
import Mathlib.Algebra.Polynomial.Splits
import Mathlib.FieldTheory.Normal.Basic
import Mathlib.FieldTheory.Normal.Closure

/-!
# Fields, Chapter 15: Normal extensions

The source's “splits completely” predicate is Mathlib's canonical
`Polynomial.Splits`.  Normality is likewise Mathlib's `Normal` class, which
packages algebraicity with splitting of every minimal polynomial.  A
`K`-algebra embedding is an `AlgHom`, an automorphism group is `Gal(L/K)`, and
the source's separable degree is `Field.finSepDegree`.
-/

namespace Formalization.Books.Fields.Unit15

noncomputable section

open Polynomial

universe u v w

/-! ## Splitting and normality -/

/- `Polynomial.Splits` is the existing definition of splitting into a scalar
   and monic linear factors.  The following source-facing statement records
   the nonconstant case from the displayed factorization in the text, using a
   finite multiset for the list of roots. -/
/-- A nonconstant polynomial splits completely exactly when it is a nonzero
    scalar times a nonempty finite product of linear factors. -/
theorem polynomial_splits_completely_iff
    {F : Type u} [Field F] {P : F[X]} (hP : P.natDegree ≠ 0) :
    P.Splits ↔
      ∃ (c : F) (roots : Multiset F),
        c ≠ 0 ∧ 0 < roots.card ∧
          P = C c * (roots.map (X - C ·)).prod := by
  sorry

/- `Normal F E` is Mathlib's definition of a normal algebraic extension.  Its
   fields, and the stronger existing `normal_iff`, directly cover the source
   definition, so no parallel normality predicate is introduced here. -/

/-! ## Basic properties -/

/-- Normality goes up a tower: if `K/F` is normal, then `K/E` is normal. -/
theorem normal_goes_up
    {F E K : Type*} [Field F] [Field E] [Field K]
    [Algebra F E] [Algebra E K] [Algebra F K] [IsScalarTower F E K]
    [Normal F K] :
    Normal E K :=
  Normal.tower_top_of_normal F E K

/-- The intersection of a nonempty family of normal intermediate fields is
    normal. -/
theorem normal_intersection
    {F M ι : Type*} [Field F] [Field M] [Algebra F M]
    [Algebra.IsAlgebraic F M] [Nonempty ι]
    (E : ι → IntermediateField F M)
    [hE : ∀ i, Normal F (E i)] :
    Normal F (⨅ i, E i : IntermediateField F M) := by
  infer_instance

/-- The separable subextension of a normal extension is normal over the base. -/
theorem separable_closure_normal
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Normal F E] :
    Normal F (separableClosure F E) := by
  sorry

/-! ## Embeddings and generators -/

/-- An algebraic extension is normal exactly when all of its embeddings into a
    chosen algebraic closure have the same intermediate-field image. -/
theorem normal_iff_algebraic_closure_embedding_ranges
    {F E L : Type*} [Field F] [Field E] [Field L]
    [Algebra F E] [Algebra F L] [IsAlgClosure F L]
    [Algebra.IsAlgebraic F E] :
    Normal F E ↔
      ∀ σ σ' : E →ₐ[F] L, σ.fieldRange = σ'.fieldRange := by
  sorry

/-- If an algebraic extension is generated by elements whose minimal
    polynomials split in it, then the extension is normal. -/
theorem normal_of_generated_by_splits
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Algebra.IsAlgebraic F E] (S : Set E)
    (hS : IntermediateField.adjoin F S = ⊤)
    (hsplits : ∀ α ∈ S,
      ((minpoly F α).map (algebraMap F E)).Splits) :
    Normal F E := by
  sorry

/-! ## Lifting maps and automorphisms -/

/-- If `M/K` is normal, an automorphism of `L/K` restricts to an
    automorphism of `M/K`. -/
theorem automorphism_restricts_to_normal_subextension
    {K M L : Type*} [Field K] [Field M] [Field L]
    [Algebra K M] [Algebra M L] [Algebra K L] [IsScalarTower K M L]
    [Algebra.IsAlgebraic M L] [Normal K M]
    (τ : L ≃ₐ[K] L) :
    ∃ σ : M ≃ₐ[K] M,
      ∀ x : M, algebraMap M L (σ x) = τ (algebraMap M L x) := by
  sorry

/- The canonical `AlgHom.liftNormal` constructs the extension homomorphism;
   normality makes it bijective, so this is the source's automorphism-valued
   interface. -/
/-- Extend a `K`-algebra map `M → L` to an automorphism of a normal extension
    `L/K`. -/
noncomputable def extend_map_to_normal_automorphism
    {K M L : Type*} [Field K] [Field M] [Field L]
    [Algebra K M] [Algebra M L] [Algebra K L] [IsScalarTower K M L]
    [Normal K L] (σ : M →ₐ[K] L) : L ≃ₐ[K] L :=
  AlgEquiv.ofBijective (σ.liftNormal L) (AlgHom.normal_bijective K L L _)

/-- Every `K`-algebra map from the middle field into a normal top field
    extends to an automorphism of the top field. -/
theorem normal_extension_lifts_algebra_map
    {K M L : Type*} [Field K] [Field M] [Field L]
    [Algebra K M] [Algebra M L] [Algebra K L] [IsScalarTower K M L]
    [Algebra.IsAlgebraic K M] [Algebra.IsAlgebraic M L] [Normal K L]
    (σ : M →ₐ[K] L) :
    ∃ τ : L ≃ₐ[K] L,
      ∀ x : M, τ (algebraMap M L x) = σ x := by
  sorry

/- `Gal(E/F)` is Mathlib's canonical notation for the automorphism group
   `E ≃ₐ[F] E`, so the source's automorphism definition is already present. -/

/-! ## Automorphism counts -/

/-- For a finite extension, the automorphism group has cardinality at most the
    separable degree. -/
theorem finite_extension_automorphism_card_le_finSepDegree
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [FiniteDimensional F E] :
    Nat.card (Gal(E / F)) ≤ Field.finSepDegree F E := by
  sorry

/-- For a finite extension, the automorphism-cardinality bound is an equality
    exactly when the extension is normal. -/
theorem finite_extension_automorphism_card_eq_finSepDegree_iff_normal
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [FiniteDimensional F E] :
    Nat.card (Gal(E / F)) = Field.finSepDegree F E ↔ Normal F E := by
  sorry

/-! ## Embeddings into an extension -/

/-- For an algebraic normal extension `L/K`, two `K`-embeddings of `L` into a
    field `E` differ by an automorphism of `L/K`; if no embedding exists, the
    first alternative holds. -/
theorem normal_embeddings_empty_or_differ_by_automorphism
    {K L E : Type*} [Field K] [Field L] [Field E]
    [Algebra K L] [Algebra K E] [Normal K L] :
    (¬ Nonempty (L →ₐ[K] E)) ∨
      ∃ τ : L →ₐ[K] E,
        ∀ φ : L →ₐ[K] E,
          ∃ σ : Gal(L / K), φ = τ.comp σ.toAlgHom := by
  sorry

end

end Formalization.Books.Fields.Unit15
