      map_smul' := by
        intro r x
        apply Subtype.ext
        change g ⟨r • x⟩ = (((0 : R₁), r) : R₁ × R₂) • g ⟨x⟩
        rw [← g.map_smul]
        congr 1 }
  have hf₂ : Function.Surjective f₂ :=
    prodComponentMap₂.surjective f hf
  obtain ⟨h₂, hh₂⟩ := Module.projective_lifting_property f₂ g₂ hf₂
  let h : prodFactor₂ R₁ M →ₗ[R₁ × R₂] N :=
    { toFun := fun x ↦ (h₂ x.val : N)
      map_add' := by
        intro x y
