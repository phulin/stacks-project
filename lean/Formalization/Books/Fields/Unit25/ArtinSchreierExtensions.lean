import Formalization.Books.Fields.Unit21.GaloisTheory
import Mathlib.Data.ZMod.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# Fields, Chapter 25: Artin–Schreier extensions

The source's field generated by a root is Mathlib's
`IntermediateField.adjoin`.  The additive group `ℤ/pℤ` is presented as the
multiplicative group `Multiplicative (ZMod p)` when it is the codomain of a
group homomorphism.  Its implicit map into a characteristic-`p` field is
written with `ZMod.cast`.
-/

namespace Formalization.Books.Fields.Unit25

noncomputable section

/-! ## Artin–Schreier extensions -/

/- The displayed expression `σ(b) - b` is kept as a concrete field-valued
   function.  The following theorem packages its canonical `ZMod p`-valued
   group-homomorphism interpretation. -/
def artinSchreierDifference
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    (b : L) (σ : Gal(L / K)) : L :=
  σ b - b

/- A root of `x^p - x = a` which generates the extension gives a separable
   splitting field: all other roots differ from it by an element of the prime
   field. -/
/-- An extension generated by an Artin–Schreier root is Galois. -/
theorem artin_schreier_extension_is_galois
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    (p : ℕ) (hp : 0 < p) [CharP K p] (a : K) (b : L)
    (hroot : b ^ p - b = algebraMap K L a)
    (hgen : IntermediateField.adjoin K ({b} : Set L) = ⊤) :
    IsGalois K L := by
  sorry

/- The source identifies the roots of `x^p - x = 0` with `ℤ/pℤ`.  Lean keeps
   that identification explicit: the group homomorphism has codomain
   `Multiplicative (ZMod p)`, and its value casts back to the displayed field
   difference through `K`. -/
/-- The Artin–Schreier Galois-group map is injective and has the displayed
    formula. -/
theorem artin_schreier_galois_group_map
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    (p : ℕ) (hp : 0 < p) [CharP K p] (a : K) (b : L)
    (hroot : b ^ p - b = algebraMap K L a)
    (hgen : IntermediateField.adjoin K ({b} : Set L) = ⊤) :
    ∃ φ : Gal(L / K) →* Multiplicative (ZMod p),
      Function.Injective φ ∧
        ∀ σ : Gal(L / K),
          algebraMap K L (ZMod.cast (Multiplicative.toAdd (φ σ)) : K) =
            artinSchreierDifference b σ := by
  sorry

/- The preceding injection realizes the Galois group as a subgroup of the
   cyclic additive group `ZMod p`; this is the source's stated consequence. -/
/-- The Artin–Schreier Galois group is cyclic and its order divides `p`. -/
theorem artin_schreier_galois_group_is_cyclic
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    (p : ℕ) (hp : 0 < p) [CharP K p] (a : K) (b : L)
    (hroot : b ^ p - b = algebraMap K L a)
    (hgen : IntermediateField.adjoin K ({b} : Set L) = ⊤) :
    IsCyclic (Gal(L / K)) ∧ Nat.card (Gal(L / K)) ∣ p := by
  sorry

/- In the converse, “the Galois group is `ℤ/pℤ`” means a group equivalence
   with the multiplicative wrapper of the additive group `ZMod p`. -/
/-- A Galois extension with Galois group `ℤ/pℤ` is generated by an
    Artin–Schreier element. -/
theorem exists_artin_schreier_generator
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    (p : ℕ) (hp : 0 < p) [CharP K p] [IsGalois K L]
    (hG : Nonempty (Gal(L / K) ≃* Multiplicative (ZMod p))) :
    ∃ z : L,
      IntermediateField.adjoin K ({z} : Set L) = ⊤ ∧
        ∃ a : K, z ^ p - z = algebraMap K L a := by
  sorry

end

end Formalization.Books.Fields.Unit25
