import Formalization.Books.Dpa.Unit06
import Formalization.Books.MoreAlgebra.Unit29.KoszulComplex
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.TensorProduct.Basic

/-!
# Divided Power Algebra, Chapter 12: Koszul complexes and Tate resolutions

This chapter uses the Koszul chain-complex API from More Algebra, Chapter 29,
and the divided-power DGA/Tate-resolution interfaces from Chapter 6.  The
source uses homological grading throughout this section; in particular, the
Koszul complexes below are the chain-complex convention rather than the
cochain convention used by the cited result in More Algebra.
-/

namespace Formalization.Books.Dpa.Unit12

open Formalization.Books.Dpa.Unit06
open Formalization.Books.MoreAlgebra.Unit29
open scoped TensorProduct

universe u

noncomputable section

/-! ## Koszul DGAs with divided powers -/

/-- The exterior algebra underlying the Koszul algebra on `r` generators. -/
abbrev koszulUnderlyingAlgebra (R : Type u) [CommRing R] (r : ℕ) : Type u :=
  ExteriorAlgebra R (Fin r → R)

/-- The sequence of powers used to define `K_n`. -/
def koszulPowerSequence {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) (n : ℕ) : Fin r → R :=
  fun i => f i ^ n

/- The finitely generated ideal used in the chapter's initial setup. -/
def idealGeneratedBySequence {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) : Ideal R :=
  Ideal.span (Set.range f)

/-- The ideal generated by the `n`th powers of the chosen sequence. -/
def koszulPowerIdeal {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) (n : ℕ) : Ideal R :=
  idealGeneratedBySequence r (koszulPowerSequence r f n)

/-- The quotient ring occurring in the degree-zero part of `K_n`. -/
abbrev koszulPowerQuotient {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) (n : ℕ) : Type u :=
  R ⧸ koszulPowerIdeal r f n

/-- The canonical quotient map in the Koszul construction. -/
abbrev koszulPowerQuotientMap {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) (n : ℕ) : R →+* koszulPowerQuotient r f n :=
  Ideal.Quotient.mk (koszulPowerIdeal r f n)

/-- The differential on the exterior algebra for the sequence `f_i^n`. -/
noncomputable def koszulDifferentialOn {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) :
    koszulUnderlyingAlgebra R r →ₗ[R] koszulUnderlyingAlgebra R r :=
  koszulAlgebraDifferential R (Fin r → R)
    (sequenceLinearMap R r f)

/-- The degree-one exterior generator corresponding to `i`. -/
def koszulGenerator {R : Type u} [CommRing R] (r : ℕ)
    (i : Fin r) : koszulUnderlyingAlgebra R r :=
  ExteriorAlgebra.ι R (Pi.single i 1)

theorem koszulDifferentialOn_generator {R : Type u} [CommRing R]
    (r : ℕ) (f : Fin r → R) (i : Fin r) :
    koszulDifferentialOn r f (koszulGenerator r i) =
      algebraMap R (koszulUnderlyingAlgebra R r) (f i) := by
  sorry

/-- A divided-power DGA model for the Koszul algebra.  The underlying algebra
and differential are fixed by the canonical exterior-algebra construction;
the remaining data are precisely the compatible grading and divided powers.
-/
structure KoszulDividedPowerDGA (R : Type u) [CommRing R]
    (r : ℕ) (f : Fin r → R) where
  dga : DividedPowerDGA R (koszulUnderlyingAlgebra R r)
  differential_eq : dga.differential.d = koszulDifferentialOn r f

/-- The ordinary divided-power identity required of a Koszul divided-power
structure.  It is the factorial formulation of the source's axioms. -/
def IsCompatibleKoszulDividedPowers {R : Type u} [CommRing R]
    {r : ℕ} {f : Fin r → R} (K : KoszulDividedPowerDGA R r f) : Prop :=
  ∀ {n : ℕ} {x : koszulUnderlyingAlgebra R r},
    K.dga.gradedAlgebra.IsPositiveEven x →
      (Nat.factorial n : koszulUnderlyingAlgebra R r) *
          K.dga.dividedPowers.dpow n x = x ^ n

/-- Existence of the unique divided-power structure on the Koszul DGA. -/
theorem exists_unique_koszul_dividedPowerDGA
    {R : Type u} [CommRing R] (r : ℕ) (f : Fin r → R) :
    ∃! K : KoszulDividedPowerDGA R r f,
      IsCompatibleKoszulDividedPowers K := by
  sorry

/-- A chosen model for `K_n`; the choice is harmless because the source
asserts uniqueness of the compatible divided powers. -/
noncomputable def koszulDGAData {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) (n : ℕ) : KoszulDividedPowerDGA R r (koszulPowerSequence r f n) :=
  Classical.choose (exists_unique_koszul_dividedPowerDGA r
    (koszulPowerSequence r f n))

/-- The source's notation `K_n`. -/
abbrev koszulK {R : Type u} [CommRing R] (r : ℕ) (f : Fin r → R) (n : ℕ) :=
  koszulDGAData r f n

theorem koszulK_differential_generator {R : Type u} [CommRing R]
    (r : ℕ) (f : Fin r → R) (n : ℕ) (i : Fin r) :
    (koszulK r f n).dga.differential.d (koszulGenerator r i) =
      algebraMap R (koszulUnderlyingAlgebra R r) (f i ^ n) := by
  sorry

/-- A diagonal map on the free module of Koszul generators. -/
def diagonalLinearMap {R : Type u} [CommRing R] (r : ℕ)
    (a : Fin r → R) : (Fin r → R) →ₗ[R] (Fin r → R) :=
  { toFun := fun x i => a i * x i
    map_add' := by
      intro x y
      ext i
      simp [mul_add]
    map_smul' := by
      intro c x
      ext i
      simp [smul_eq_mul, mul_left_comm] }

/-- The map on Koszul generators sending `xi_i` to
`f_i^(m-n) xi_i`. -/
def koszulTransitionGeneratorMap {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) {n m : ℕ} (_h : n ≤ m) :
    (Fin r → R) →ₗ[R] (Fin r → R) :=
  diagonalLinearMap r (fun i => f i ^ (m - n))

/-- The divided-power DGA map expressing the Koszul transition formula. -/
def IsKoszulTransition {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) {n m : ℕ} (h : n ≤ m)
    (φ : DividedPowerDGA.Hom (koszulDGAData r f m).dga
      (koszulDGAData r f n).dga) : Prop :=
  φ.toAlgHom = ExteriorAlgebra.map
    (koszulTransitionGeneratorMap r f h)

theorem exists_koszulTransition {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) {n m : ℕ} (h : n ≤ m) :
    Nonempty {φ : DividedPowerDGA.Hom (koszulDGAData r f m).dga
      (koszulDGAData r f n).dga // IsKoszulTransition r f h φ} := by
  sorry

/-- A selected transition map, with the source's generator formula. -/
noncomputable def koszulTransition {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) {n m : ℕ} (h : n ≤ m) :
    DividedPowerDGA.Hom (koszulDGAData r f m).dga
      (koszulDGAData r f n).dga :=
  (Classical.choice (exists_koszulTransition r f h)).1

theorem koszulTransition_formula {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) {n m : ℕ} (h : n ≤ m) :
    (koszulTransition r f h).toAlgHom =
      ExteriorAlgebra.map (koszulTransitionGeneratorMap r f h) := by
  exact (Classical.choice (exists_koszulTransition r f h)).2

/-- The power ideals are ordered in the direction needed for the quotient
transition maps. -/
theorem koszulPowerIdeal_mono {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) {n m : ℕ} (h : n ≤ m) :
    koszulPowerIdeal r f m ≤ koszulPowerIdeal r f n := by
  sorry

/-- The canonical map `R/(f_i^m) → R/(f_i^n)` for `n ≤ m`. -/
noncomputable def koszulPowerQuotientTransition {R : Type u} [CommRing R]
    (r : ℕ) (f : Fin r → R) {n m : ℕ} (h : n ≤ m) :
    koszulPowerQuotient r f m →ₐ[R] koszulPowerQuotient r f n :=
  Ideal.Quotient.factorₐ R (koszulPowerIdeal_mono r f h)

/-- The augmentation killing all positive-degree Koszul generators. -/
noncomputable def koszulAugmentation {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) (n : ℕ) :
    koszulUnderlyingAlgebra R r →ₐ[R] koszulPowerQuotient r f n :=
  ExteriorAlgebra.lift R
    ⟨(0 : (Fin r → R) →ₗ[R] koszulPowerQuotient r f n), by
      intro x
      simp⟩

/-! ## The lift to a Tate resolution -/

/-- A Tate-resolution record with the carrier's algebra instances exposed as
parameters.  This is a small bridge because the earlier `TateResolution`
structure stores those instances as ordinary fields. -/
structure TateResolutionModel {R S A : Type u} [CommRing R] [CommRing S]
    [Ring A] [Algebra R A] (q : R →+* S) where
  dga : DividedPowerDGA R A
  augmentation : A →+* S
  augmentation_restricts : ∀ r : R,
    augmentation (algebraMap R A r) = q r
  degree_zero_polynomial_surjective :
    IsDegreeZeroPolynomialSurjection dga.gradedAlgebra augmentation
  degree_zero_is_base_ring : ∀ x : A,
    x ∈ dga.gradedAlgebra.component 0 → ∃ r : R, x = algebraMap R A r
  quasi_isomorphism :
    DividedPowerDGA.IsQuasiIsomorphism dga augmentation
  graded_divided_power_polynomial : IsGradedDividedPowerPolynomial dga
  finite_generators : @IsFiniteInEachDegree R A _ _ _ dga

/-- A degree-zero homology map is the canonical quotient map after choosing
the homology identifications supplied by the quasi-isomorphisms. -/
def InducesCanonicalDegreeZeroMap
    {R A B S T : Type u} [CommRing R] [Ring A] [Ring B]
    [CommRing S] [CommRing T] [Algebra R A] [Algebra R B]
    [Algebra R S] [Algebra R T]
    (D : DividedPowerDGA R A) (E : DividedPowerDGA R B)
    (F : DividedPowerDGA.Hom D E) (q : S →ₐ[R] T) : Prop :=
  ∃ eD : DividedPowerDGA.homologyComponent D 0 ≃ₗ[R] S,
    ∃ eE : DividedPowerDGA.homologyComponent E 0 ≃ₗ[R] T,
      ∀ x : DividedPowerDGA.cycles D 0,
        eE (DividedPowerDGA.homologyZeroMap D E F x) =
          q.toLinearMap (eD (Submodule.Quotient.mk x))

/-- All data in the lift lemma, including the seven numbered properties in
the source.  `A` is the Tate resolution, so its augmentation is the map to
the quotient and its quasi-isomorphism field supplies property (2). -/
structure KoszulTateLift {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) (n N : ℕ) (h : n ≤ N) where
  A : Type u
  [ringA : Ring A]
  [algebraA : Algebra R A]
  resolution : TateResolutionModel
    (koszulPowerQuotientMap r f N) (A := A)
  fromKoszul : DividedPowerDGA.Hom (koszulDGAData r f N).dga resolution.dga
  toKoszul : DividedPowerDGA.Hom resolution.dga (koszulDGAData r f n).dga
  augmentation_is_canonical :
    resolution.augmentation.comp fromKoszul.toAlgHom.toRingHom =
      (koszulAugmentation r f N).toRingHom
  composition_is_transition :
    toKoszul.toAlgHom.toRingHom.comp fromKoszul.toAlgHom.toRingHom =
      (koszulTransition r f h).toAlgHom.toRingHom
  degree_zero_is_canonical :
    ∀ x : R,
      resolution.augmentation (algebraMap R A x) =
        koszulPowerQuotientMap r f N x
  degree_zero_homology_is_canonical :
    InducesCanonicalDegreeZeroMap resolution.dga (koszulDGAData r f n).dga toKoszul
      (koszulPowerQuotientTransition r f h)

/-- The lift-to-Koszul theorem. -/
theorem exists_koszulTateLift {R : Type u} [CommRing R] [IsNoetherianRing R]
    (r : ℕ) (f : Fin r → R) (n : ℕ) :
    ∃ N : ℕ, n ≤ N ∧ ∃ h : n ≤ N, Nonempty (KoszulTateLift r f n N h) := by
  sorry

/-! ## The pro-system remark -/

/-- The transition diagram of the `K_{n_i}` and Tate models.  The explicit
`A`-transition is included so the commuting diagram in the source is part of
the declaration rather than only an informal picture. -/
structure KoszulTateProSystem {R : Type u} [CommRing R]
    (r : ℕ) (f : Fin r → R) where
  index : ℕ → ℕ
  index_zero : index 0 = 1
  index_strict : ∀ i, index i < index (i + 1)
  stage : ∀ i : ℕ,
    KoszulTateLift r f (index i) (index (i + 1))
      (Nat.le_of_lt (index_strict i))
  A_transition : ∀ i : ℕ,
    @RingHom (stage (i + 1)).A (stage i).A
      (stage (i + 1)).ringA.toSemiring.toNonAssocSemiring
      (stage i).ringA.toSemiring.toNonAssocSemiring
  A_transition_factors : ∀ (i : ℕ) (x : (stage (i + 1)).A),
    letI : Ring (stage (i + 1)).A := (stage (i + 1)).ringA
    letI : Algebra R (stage (i + 1)).A := (stage (i + 1)).algebraA
    letI : Ring (stage i).A := (stage i).ringA
    letI : Algebra R (stage i).A := (stage i).algebraA
    A_transition i x =
      (stage i).fromKoszul.toAlgHom.toRingHom
        ((stage (i + 1)).toKoszul.toAlgHom.toRingHom x)

/-- The pro-isomorphism assertion in the source, expressed by its explicit
cofinal index sequence and commuting comparison diagram. -/
theorem exists_koszul_tate_pro_system {R : Type u} [CommRing R]
    [IsNoetherianRing R] (r : ℕ) (f : Fin r → R) :
    Nonempty (KoszulTateProSystem r f) := by
  sorry

/-! ## Homology after adjoining a variable -/

/-- An extension obtained by adjoining one variable in degree `d`, in the
precise sense of the differential-extension interface from Chapter 6. -/
structure AdjoinedVariableModel {R A B : Type u} [CommRing R] [Ring A]
    [Ring B] [Algebra R A] [Algebra R B]
    (D : DividedPowerDGA R A) (d : ℕ) (f : A) where
  extensionDGA : DividedPowerDGA R B
  inclusion : A →ₐ[R] B
  T : B
  f_mem : f ∈ D.gradedAlgebra.component (d - 1)
  f_closed : D.differential.d f = 0
  T_mem : T ∈ extensionDGA.gradedAlgebra.component d
  is_extension :
    DividedPowerDGA.IsDifferentialExtension D extensionDGA.gradedAlgebra
      extensionDGA.dividedPowers f D.differential.d
      extensionDGA.differential.d inclusion T

/- The quotient-level action represented by multiplication by a homogeneous
closed element.  Its representative clause records the source's phrase
"the class of `f * ξ`". -/
structure HomologyMultiplicationByF {R A : Type u} [CommRing R] [Ring A]
    [Algebra R A] (D : DividedPowerDGA R A) (d : ℕ) (f : A) where
  map : ∀ k : ℕ,
    DividedPowerDGA.homologyComponent D k →ₗ[R]
      DividedPowerDGA.homologyComponent D (k + d - 1)
  map_on_representatives : ∀ (k : ℕ) (x : DividedPowerDGA.cycles D k),
    ∃ y : DividedPowerDGA.cycles D (k + d - 1),
      y.1 = f * x.1 ∧
        map k (Submodule.Quotient.mk x) = Submodule.Quotient.mk y

/-- The exact tail displayed in degree zero for adjoining an odd variable. -/
structure LongExactHZeroTail {R A B : Type u} [CommRing R] [Ring A]
    [Ring B] [Algebra R A] [Algebra R B]
    {D : DividedPowerDGA R A} {f : A}
    (M : AdjoinedVariableModel (B := B) D 1 f) where
  multiplication_by_f : HomologyMultiplicationByF D 1 f
  multiplication : DividedPowerDGA.homologyComponent D 0 →ₗ[R]
    DividedPowerDGA.homologyComponent D 0
  comparison : DividedPowerDGA.homologyComponent D 0 →ₗ[R]
    DividedPowerDGA.homologyComponent M.extensionDGA 0
  multiplication_is_f : multiplication = multiplication_by_f.map 0
  exact_at_homology_zero : Function.Exact multiplication comparison
  comparison_surjective : Function.Surjective comparison

/-- The `E_1` term in bidegree `(i,j)`, with negative homological degrees
represented by the zero module. -/
noncomputable def adjoiningHomologyAtInt {R A : Type u} [CommRing R]
    [Ring A] [Algebra R A] (D : DividedPowerDGA R A) (k : ℤ) : Type u :=
  if 0 ≤ k then DividedPowerDGA.homologyComponent D k.toNat
  else Fin 0 → R

abbrev adjoiningEOneTerm {R A : Type u} [CommRing R] [Ring A]
    [Algebra R A] (D : DividedPowerDGA R A) (i j : ℤ) : Type u :=
  if 0 ≤ i then adjoiningHomologyAtInt D (j - i) else Fin 0 → R

/-- The associated graded term of a filtration, used to state convergence
without introducing a second spectral-sequence implementation. -/
def adjoiningAssociatedGradedTerm {R A : Type u} [CommRing R] [Ring A]
    [Algebra R A] (E : DividedPowerDGA R A)
    (F : ∀ k : ℕ, ℤ → Submodule R (DividedPowerDGA.homologyComponent E k))
    (k : ℕ) (i : ℤ) (_h : F k (i - 1) ≤ F k i) : Type u :=
  F k i ⧸ Submodule.comap (F k i).subtype (F k (i - 1))

/-- Convergence data for the bounded spectral sequence in the source. -/
structure AdjoiningSpectralSequenceConvergence
    {R A B : Type u} [CommRing R] [Ring A] [Ring B]
    [Algebra R A] [Algebra R B]
    (D : DividedPowerDGA R A) (E : DividedPowerDGA R B)
  (page : ℤ → ℤ → Type u) where
  filtration : ∀ k : ℕ, ℤ → Submodule R (DividedPowerDGA.homologyComponent E k)
  filtration_mono : ∀ k i, filtration k i ≤ filtration k (i + 1)
  page_equiv : ∀ (i j : ℤ) (_hij : 0 ≤ i + j),
    Nonempty ((page i j) ≃
      adjoiningAssociatedGradedTerm E filtration (i + j).toNat i
        (by
          simpa using filtration_mono (i + j).toNat (i - 1)))

/-- A bounded spectral-sequence presentation of the adjoining-variable
calculation.  The equality `differential_one_formula` is the displayed rule
`ξ*T^[i] ↦ f*ξ*T^[i-1]`. -/
structure AdjoiningSpectralSequenceData
    {R A B : Type u} [CommRing R] [Ring A] [Ring B]
    [Algebra R A] [Algebra R B]
    {D : DividedPowerDGA R A} {d : ℕ} {f : A}
    (M : AdjoinedVariableModel (B := B) D d f) where
  multiplication_action : HomologyMultiplicationByF D d f
  differential_one : ∀ i j : ℤ,
    adjoiningEOneTerm D i j → adjoiningEOneTerm D (i - 1) j
  multiplication_by_f : ∀ i j : ℤ,
    adjoiningEOneTerm D i j → adjoiningEOneTerm D (i - 1) j
  differential_one_formula : ∀ i j,
    differential_one i j = multiplication_by_f i j
  bounded : ∀ i j, i < 0 → ∀ x y : adjoiningEOneTerm D i j, x = y
  convergence : AdjoiningSpectralSequenceConvergence D M.extensionDGA
    (fun i j => adjoiningEOneTerm D i j)

theorem compute_homology_adjoin_variable_degree_one
    {R A B : Type u} [CommRing R] [Ring A] [Ring B]
    [Algebra R A] [Algebra R B]
    {D : DividedPowerDGA R A} {f : A}
    (M : AdjoinedVariableModel (B := B) D 1 f) :
    Nonempty (LongExactHZeroTail M) := by
  sorry

theorem compute_homology_adjoin_variable_degree_two
    {R A B : Type u} [CommRing R] [Ring A] [Ring B]
    [Algebra R A] [Algebra R B]
    {D : DividedPowerDGA R A} {f : A}
    (M : AdjoinedVariableModel (B := B) D 2 f) :
    Nonempty (AdjoiningSpectralSequenceData M) := by
  sorry

/-! ## The derived tensor-factorization map -/

/-- A DGA together with the ring and algebra structures on its carrier.  The
bundle makes the derived-category roof below independent of projection-level
instance synthesis. -/
structure DGAWithInstances (R : Type u) [CommRing R] where
  carrier : Type u
  ringCarrier : Ring carrier
  algebraCarrier : Algebra R carrier
  dga : @DividedPowerDGA R carrier _ ringCarrier algebraCarrier

def DGAWithInstances.differential {R : Type u} [CommRing R]
    (D : DGAWithInstances R) : D.carrier → D.carrier :=
  letI : Ring D.carrier := D.ringCarrier
  letI : Algebra R D.carrier := D.algebraCarrier
  D.dga.differential.d

def DGAWithInstances.scalar {R : Type u} [CommRing R]
    (D : DGAWithInstances R) (r : R) : D.carrier :=
  letI : Ring D.carrier := D.ringCarrier
  letI : Algebra R D.carrier := D.algebraCarrier
  algebraMap R D.carrier r

def DGAWithInstances.mul {R : Type u} [CommRing R]
    (D : DGAWithInstances R) (x y : D.carrier) : D.carrier :=
  letI : Ring D.carrier := D.ringCarrier
  x * y

structure DGAHom {R : Type u} [CommRing R]
    (D E : DGAWithInstances R) where
  ringHom : @RingHom D.carrier E.carrier
    D.ringCarrier.toSemiring.toNonAssocSemiring
    E.ringCarrier.toSemiring.toNonAssocSemiring
  map_scalar : ∀ r : R,
    ringHom (DGAWithInstances.scalar D r) = DGAWithInstances.scalar E r
  map_differential : ∀ x, E.differential (ringHom x) = ringHom (D.differential x)
  map_divided_powers :
    letI : Ring D.carrier := D.ringCarrier
    letI : Ring E.carrier := E.ringCarrier
    letI : Algebra R D.carrier := D.algebraCarrier
    letI : Algebra R E.carrier := E.algebraCarrier
    ∀ (n : ℕ) (x : D.carrier),
      E.dga.dividedPowers.dpow n (ringHom x) =
        ringHom (D.dga.dividedPowers.dpow n x)

def DGAHomCompEq {R : Type u} [CommRing R]
    {D E F : DGAWithInstances R} (f : DGAHom D E) (g : DGAHom E F)
    (h : DGAHom D F) : Prop :=
  ∀ x : D.carrier,
    g.ringHom (f.ringHom x) = h.ringHom x

def DGAIsQuasiIsomorphism {R : Type u} [CommRing R]
    (D E : DGAWithInstances R) (f : DGAHom D E) : Prop :=
  @DividedPowerDGA.IsQuasiIsomorphism R D.carrier E.carrier _ D.ringCarrier
    E.ringCarrier D.algebraCarrier D.dga f.ringHom

/-- The canonical DGA bundle attached to `K_n`. -/
def koszulDGABundle {R : Type u} [CommRing R] (r : ℕ)
    (f : Fin r → R) (n : ℕ) : DGAWithInstances R :=
  { carrier := koszulUnderlyingAlgebra R r
    ringCarrier := inferInstance
    algebraCarrier := inferInstance
    dga := (koszulDGAData r f n).dga }

/-- A DGA model for `K_n ⊗ K_t`, together with maps to the two Koszul
factors.  The linear identification records the tensor-product target even
though the source's DG-algebra tensor product is not bundled by Chapter 6.
-/
structure KoszulTensorModel {R : Type u} [CommRing R]
    (r : ℕ) (f : Fin r → R) (n t : ℕ) where
  dga : DGAWithInstances R
  tensorIdentification :
    letI : Ring dga.carrier := dga.ringCarrier
    letI : Algebra R dga.carrier := dga.algebraCarrier
    dga.carrier ≃ₗ[R]
      TensorProduct R (koszulUnderlyingAlgebra R r)
        (koszulUnderlyingAlgebra R r)
  multiplicationToN : DGAHom dga (koszulDGABundle r f n)
  multiplicationToT : DGAHom dga (koszulDGABundle r f t)

/-- A roof representing a map in the derived category of left DG `K_N`
modules.  The action-compatibility equations make the module category part
of the interface, while the quasi-isomorphism leg is the usual roof. -/
structure DerivedLeftKoszulTensorMap {R : Type u} [CommRing R]
    (r : ℕ) (f : Fin r → R) (n t N : ℕ) (h : t ≤ n) where
  target : KoszulTensorModel r f n t
  middle : DGAWithInstances R
  middleToT : DGAHom middle (koszulDGABundle r f t)
  middleToTarget : DGAHom middle target.dga
  middleToT_quasi_isomorphism :
    DGAIsQuasiIsomorphism middle (koszulDGABundle r f t) middleToT
  actionOnT : DGAHom (koszulDGABundle r f N) (koszulDGABundle r f t)
  actionOnTarget : DGAHom (koszulDGABundle r f N) target.dga
  actionOnMiddle : DGAHom (koszulDGABundle r f N) middle
  actionOnT_is_transition :
    ∃ hN : t ≤ N, ∀ x,
      actionOnT.ringHom x =
        (koszulTransition r f hN).toAlgHom.toRingHom x
  target_multiplication_is_transition :
    ∃ hN : n ≤ N, ∀ x,
      target.multiplicationToN.ringHom (actionOnTarget.ringHom x) =
        (koszulTransition r f hN).toAlgHom.toRingHom x
  middle_action_commutes :
    DGAHomCompEq actionOnMiddle middleToT actionOnT
  target_action_commutes :
    DGAHomCompEq actionOnMiddle middleToTarget actionOnTarget
  multiplicationToT_comp :
    DGAHomCompEq middleToTarget target.multiplicationToT middleToT

/-- One-variable auxiliary data from the proof of the final lemma.  The three
displayed images of `x`, `z`, and `u` are included literally. -/
structure OneVariableAuxiliaryWitness {R : Type u} [CommRing R]
    (f : R) (n t N : ℕ) (h : n + t ≤ N) where
  dga : DGAWithInstances R
  x : dga.carrier
  z : dga.carrier
  u : dga.carrier
  differential_x : dga.differential x = dga.scalar (f ^ t)
  differential_z : dga.differential z = dga.scalar (f ^ N)
  differential_u :
    letI : Ring dga.carrier := dga.ringCarrier
    dga.differential u = z - dga.mul (dga.scalar (f ^ (N - t))) x
  fromKN : DGAHom (koszulDGABundle 1 (fun _ => f) N) dga
  fromKN_generator : fromKN.ringHom (koszulGenerator 1 0) = z
  toKt : DGAHom dga (koszulDGABundle 1 (fun _ => f) t)
  toKt_x : toKt.ringHom x = koszulGenerator 1 0
  toKt_z : toKt.ringHom z =
      (algebraMap R (koszulUnderlyingAlgebra R 1) (f ^ (N - t))) *
      koszulGenerator 1 0
  toKt_u : toKt.ringHom u = (0 : koszulUnderlyingAlgebra R 1)
  tensorModel : KoszulTensorModel 1 (fun _ => f) n t
  toTensor : DGAHom dga tensorModel.dga
  toTensor_x : tensorModel.tensorIdentification (toTensor.ringHom x) =
    TensorProduct.tmul R (1 : koszulUnderlyingAlgebra R 1)
      (koszulGenerator 1 0)
  toTensor_z : tensorModel.tensorIdentification (toTensor.ringHom z) =
    TensorProduct.tmul R
      ((algebraMap R (koszulUnderlyingAlgebra R 1) (f ^ (N - n))) *
        koszulGenerator 1 0)
      (1 : koszulUnderlyingAlgebra R 1)
  toTensor_u : tensorModel.tensorIdentification (toTensor.ringHom u) =
    -TensorProduct.tmul R
      ((algebraMap R (koszulUnderlyingAlgebra R 1) (f ^ (N - n - t))) *
        koszulGenerator 1 0)
      (koszulGenerator 1 0)
  toKt_quasi_isomorphism :
    DGAIsQuasiIsomorphism dga (koszulDGABundle 1 (fun _ => f) t) toKt

theorem exists_oneVariableAuxiliaryWitness {R : Type u} [CommRing R]
    (f : R) {n t N : ℕ} (ht : 1 ≤ t) (hN : n + t ≤ N) :
    Nonempty (OneVariableAuxiliaryWitness f n t N hN) := by
  sorry

/-- The derived-category map in the final lemma. -/
theorem exists_derived_left_koszul_tensor_map {R : Type u} [CommRing R]
    (r : ℕ) (f : Fin r → R) {n t : ℕ} (ht : 1 ≤ t) (h : t ≤ n) :
    ∃ N : ℕ, n < N ∧
      ∃ T : KoszulTensorModel r f n t,
        Nonempty (DerivedLeftKoszulTensorMap r f n t N h) := by
  sorry

end

