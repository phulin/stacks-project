import Formalization.Books.Dga.Unit11.LeftModules
import Mathlib.Algebra.DirectSum.Module
import Mathlib.LinearAlgebra.TensorProduct.Quotient

/-!
# Differential Graded Algebra, Chapter 12: Tensor product

The ordinary relative tensor product is the quotient of the tensor product
over the base ring by the submodule generated by the balancing relations.
The differential graded construction is the corresponding cokernel in
cochain complexes; its relation map is the difference of the two module
actions.
-/

noncomputable section

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.MonoidalCategory
open Formalization.Books.Dga.Unit03
open Formalization.Books.Dga.Unit04
open Formalization.Books.Dga.Unit11
open scoped TensorProduct

universe u v

namespace Formalization.Books.Dga.Unit12

/-! ## Relative tensor products of modules -/

/-- The right action of `A` on a right `A`-module represented as an
`Aᵐᵒᵖ`-module. -/
def rightAction {R A M : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    (m : M) (a : A) : M := MulOpposite.op a • m

/-- The balancing condition for an `R`-bilinear map on a right and a left
`A`-module. -/
def IsABalanced {R A M N Q : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup N] [Module R N] [Module A N]
    [AddCommGroup Q] [Module R Q]
    (f : M →ₗ[R] N →ₗ[R] Q) : Prop :=
  ∀ (a : A) (m : M) (n : N),
    f (rightAction (R := R) (A := A) (M := M) m a) n = f m (a • n)

/-- The submodule of `M ⊗[R] N` generated by the balancing relations. -/
def relativeTensorProductBalanceSubmodule
    {R A M N : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup N] [Module R N] [Module A N] :
    Submodule R (TensorProduct R M N) :=
  Submodule.span R {z | ∃ (a : A) (m : M) (n : N),
    z = rightAction (R := R) (A := A) (M := M) m a ⊗ₜ[R] n -
      m ⊗ₜ[R] (a • n)}

/-- The relative tensor product `M ⊗_A N`, represented by its canonical
quotient presentation over `R`. -/
abbrev relativeTensorProduct
    {R A M N : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup N] [Module R N] [Module A N] : Type u :=
  TensorProduct R M N ⧸ relativeTensorProductBalanceSubmodule (R := R) (A := A)
    (M := M) (N := N)

/-- The universal `A`-balanced map into the relative tensor product. -/
def relativeTensorProductMk
    {R A M N : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup N] [Module R N] [Module A N] :
    M →ₗ[R] N →ₗ[R] relativeTensorProduct (R := R) (A := A) (M := M) (N := N) where
  toFun m := (Submodule.mkQ (relativeTensorProductBalanceSubmodule (R := R) (A := A)
    (M := M) (N := N))).comp ((TensorProduct.mk R M N) m)
  map_add' m m' := by
    ext n
    rw [map_add]
    simp
  map_smul' r m := by
    ext n
    rw [map_smul]
    simp

@[simp]
theorem relativeTensorProductMk_apply
    {R A M N : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup N] [Module R N] [Module A N]
    (m : M) (n : N) :
    relativeTensorProductMk (R := R) (A := A) (M := M) (N := N) m n =
      Submodule.Quotient.mk (m ⊗ₜ[R] n) := rfl

/-- Lift an `A`-balanced bilinear map through the relative tensor product. -/
def relativeTensorProductLift
    {R A M N Q : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup N] [Module R N] [Module A N]
    [AddCommGroup Q] [Module R Q]
    (f : M →ₗ[R] N →ₗ[R] Q)
    (hf : IsABalanced (R := R) (A := A) (M := M) (N := N) (Q := Q) f) :
    relativeTensorProduct (R := R) (A := A) (M := M) (N := N) →ₗ[R] Q :=
  (relativeTensorProductBalanceSubmodule (R := R) (A := A) (M := M) (N := N)).liftQ
    (TensorProduct.lift f) (by
    apply Submodule.span_le.2
    rintro z ⟨a, m, n, rfl⟩
    change TensorProduct.lift f
      (rightAction (R := R) (A := A) (M := M) m a ⊗ₜ[R] n -
        m ⊗ₜ[R] (a • n)) = 0
    rw [map_sub, TensorProduct.lift.tmul, TensorProduct.lift.tmul,
      sub_eq_zero.mpr (hf a m n)])

@[simp]
theorem relativeTensorProductLift_mk
    {R A M N Q : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup N] [Module R N] [Module A N]
    [AddCommGroup Q] [Module R Q]
    (f : M →ₗ[R] N →ₗ[R] Q)
    (hf : IsABalanced (R := R) (A := A) (M := M) (N := N) (Q := Q) f) (m : M) (n : N) :
    relativeTensorProductLift (A := A) (M := M) (N := N) f hf
        (relativeTensorProductMk (R := R) (A := A) (M := M) (N := N) m n) = f m n := by
  rfl

/-- The universal property of the relative tensor product: balanced bilinear
maps are exactly linear maps out of `M ⊗_A N`. -/
theorem relativeTensorProduct_universal
    {R A M N Q : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup N] [Module R N] [Module A N]
    [AddCommGroup Q] [Module R Q]
    (f : M →ₗ[R] N →ₗ[R] Q)
    (hf : IsABalanced (R := R) (A := A) (M := M) (N := N) (Q := Q) f) :
    ∃! F : relativeTensorProduct (R := R) (A := A) (M := M) (N := N) →ₗ[R] Q,
      ∀ m n, F (relativeTensorProductMk (R := R) (A := A) (M := M) (N := N) m n) = f m n := by
  sorry

/-! ## Right exactness and colimits -/

/-- A morphism of right `A`-modules, with the base-ring linearity made
explicit so that it can be tensored over `R`. -/
structure RightAModuleHom
    {R A M M' : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup M'] [Module R M'] [Module Aᵐᵒᵖ M'] where
  toLinearMap : M →ₗ[R] M'
  map_right_action : ∀ (a : A) (m : M),
    toLinearMap (rightAction (R := R) (A := A) (M := M) m a) =
      rightAction (R := R) (A := A) (M := M') (toLinearMap m) a

/-- A morphism of left `A`-modules, with its base-ring linearity explicit. -/
structure LeftAModuleHom
    {R A N N' : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup N] [Module R N] [Module A N]
    [AddCommGroup N'] [Module R N'] [Module A N'] where
  toLinearMap : N →ₗ[R] N'
  map_left_action : ∀ (a : A) (n : N),
    toLinearMap (a • n) = a • toLinearMap n

def rightAModuleId
    {R A M : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M] :
    RightAModuleHom (R := R) (A := A) (M := M) (M' := M) where
  toLinearMap := LinearMap.id
  map_right_action := by intro a m; rfl

def leftAModuleId
    {R A N : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup N] [Module R N] [Module A N] :
    LeftAModuleHom (R := R) (A := A) (N := N) (N' := N) where
  toLinearMap := LinearMap.id
  map_left_action := by intro a n; rfl

/-- The map induced on relative tensor products by compatible module maps. -/
def relativeTensorProductMap
    {R A M M' N N' : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup M'] [Module R M'] [Module Aᵐᵒᵖ M']
    [AddCommGroup N] [Module R N] [Module A N]
    [AddCommGroup N'] [Module R N'] [Module A N']
    (f : RightAModuleHom (R := R) (A := A) (M := M) (M' := M'))
    (g : LeftAModuleHom (R := R) (A := A) (N := N) (N' := N')) :
    relativeTensorProduct (R := R) (A := A) (M := M) (N := N) →ₗ[R]
      relativeTensorProduct (R := R) (A := A) (M := M') (N := N') := by
  let p := relativeTensorProductBalanceSubmodule (R := R) (A := A) (M := M) (N := N)
  let p' := relativeTensorProductBalanceSubmodule (R := R) (A := A) (M := M') (N := N')
  let h : TensorProduct R M N →ₗ[R]
      relativeTensorProduct (R := R) (A := A) (M := M') (N := N') :=
    (Submodule.mkQ p').comp (TensorProduct.map f.toLinearMap g.toLinearMap)
  exact p.liftQ h (by
    apply Submodule.span_le.2
    rintro z ⟨a, m, n, rfl⟩
    change p'.mkQ ((TensorProduct.map f.toLinearMap g.toLinearMap)
      (rightAction (R := R) (A := A) (M := M) m a ⊗ₜ[R] n -
        m ⊗ₜ[R] (a • n))) = 0
    rw [map_sub, TensorProduct.map_tmul, TensorProduct.map_tmul,
      f.map_right_action, g.map_left_action]
    exact sub_eq_zero.mpr ((Submodule.Quotient.eq p').2
      (Submodule.subset_span ⟨a, f.toLinearMap m, g.toLinearMap n, rfl⟩)))

@[simp]
theorem relativeTensorProductMap_mk
    {R A M M' N N' : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup M'] [Module R M'] [Module Aᵐᵒᵖ M']
    [AddCommGroup N] [Module R N] [Module A N]
    [AddCommGroup N'] [Module R N'] [Module A N']
    (f : RightAModuleHom (R := R) (A := A) (M := M) (M' := M'))
    (g : LeftAModuleHom (R := R) (A := A) (N := N) (N' := N')) (m : M) (n : N) :
    relativeTensorProductMap f g
        (relativeTensorProductMk (R := R) (A := A) (M := M) (N := N) m n) =
      relativeTensorProductMk (R := R) (A := A) (M := M') (N := N')
        (f.toLinearMap m) (g.toLinearMap n) := by
  sorry

/- The module-category presentation makes the colimit assertion precise.  The
base-ring action on an `A`-module is obtained by restriction of scalars along
the algebra map; the relative tensor product itself is still the quotient
defined above. -/

noncomputable def relativeTensorProductModuleCat
    {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
    (M : ModuleCat.{u} Aᵐᵒᵖ) (N : ModuleCat.{u} A) : ModuleCat.{u} R := by
  letI : Module R (M : Type u) := Module.compHom (M : Type u) (algebraMap R Aᵐᵒᵖ)
  letI : Module R (N : Type u) := Module.compHom (N : Type u) (algebraMap R A)
  exact ModuleCat.of R
    (relativeTensorProduct (R := R) (A := A) (M := (M : Type u)) (N := (N : Type u)))

noncomputable def relativeTensorProductModuleCatMap
    {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
    {M M' : ModuleCat.{u} Aᵐᵒᵖ} {N N' : ModuleCat.{u} A}
    (f : M ⟶ M') (g : N ⟶ N') :
    relativeTensorProductModuleCat (R := R) (A := A) M N ⟶
      relativeTensorProductModuleCat (R := R) (A := A) M' N' := by
  letI : Module R (M : Type u) := Module.compHom (M : Type u) (algebraMap R Aᵐᵒᵖ)
  letI : Module R (M' : Type u) := Module.compHom (M' : Type u) (algebraMap R Aᵐᵒᵖ)
  letI : Module R (N : Type u) := Module.compHom (N : Type u) (algebraMap R A)
  letI : Module R (N' : Type u) := Module.compHom (N' : Type u) (algebraMap R A)
  exact ModuleCat.ofHom (relativeTensorProductMap
    { toLinearMap :=
        { toFun := f.hom
          map_add' := by intro x y; exact f.hom.map_add x y
          map_smul' := by intro r x; exact f.hom.map_smul (algebraMap R Aᵐᵒᵖ r) x }
      map_right_action := by
        intro a m
        exact f.hom.map_smul (MulOpposite.op a) m }
    { toLinearMap :=
        { toFun := g.hom
          map_add' := by intro x y; exact g.hom.map_add x y
          map_smul' := by intro r x; exact g.hom.map_smul (algebraMap R A r) x }
      map_left_action := by
        intro a n
        exact g.hom.map_smul a n })

/-- Tensoring on the right is a functor from right `A`-modules to `R`-modules. -/
noncomputable def relativeTensorProductRightFunctor
    {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
    (N : ModuleCat.{u} A) : ModuleCat.{u} Aᵐᵒᵖ ⥤ ModuleCat.{u} R where
  obj M := relativeTensorProductModuleCat (R := R) (A := A) M N
  map f := relativeTensorProductModuleCatMap (R := R) (A := A) f (𝟙 N)
  map_id := by sorry
  map_comp := by sorry

/-- Tensoring on the left is a functor from left `A`-modules to `R`-modules. -/
noncomputable def relativeTensorProductLeftFunctor
    {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
    (M : ModuleCat.{u} Aᵐᵒᵖ) : ModuleCat.{u} A ⥤ ModuleCat.{u} R where
  obj N := relativeTensorProductModuleCat (R := R) (A := A) M N
  map g := relativeTensorProductModuleCatMap (R := R) (A := A) (𝟙 M) g
  map_id := by sorry
  map_comp := by sorry

/-- Relative tensor product commutes with arbitrary colimits in either
variable; arbitrary direct sums are the coproduct special case. -/
theorem relativeTensorProduct_preserves_colimits_right
    {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
    (N : ModuleCat.{u} A) (J : Type v) [Category J] :
    PreservesColimitsOfShape J (relativeTensorProductRightFunctor (R := R) (A := A) N) := by
  sorry

theorem relativeTensorProduct_preserves_colimits_left
    {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
    (M : ModuleCat.{u} Aᵐᵒᵖ) (J : Type v) [Category J] :
    PreservesColimitsOfShape J (relativeTensorProductLeftFunctor (R := R) (A := A) M) := by
  sorry

/-- Tensoring a short exact pair on either side remains right exact. -/
theorem relativeTensorProduct_right_exact_right
    {R A M₁ M₂ M₃ N : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M₁] [Module R M₁] [Module Aᵐᵒᵖ M₁]
    [AddCommGroup M₂] [Module R M₂] [Module Aᵐᵒᵖ M₂]
    [AddCommGroup M₃] [Module R M₃] [Module Aᵐᵒᵖ M₃]
    [AddCommGroup N] [Module R N] [Module A N]
    (f : RightAModuleHom (R := R) (A := A) (M := M₁) (M' := M₂))
    (g : RightAModuleHom (R := R) (A := A) (M := M₂) (M' := M₃))
    (h : Function.Exact f.toLinearMap g.toLinearMap) :
    Function.Exact
      (relativeTensorProductMap f (leftAModuleId (R := R) (A := A) (N := N)))
      (relativeTensorProductMap g (leftAModuleId (R := R) (A := A) (N := N))) := by
  sorry

theorem relativeTensorProduct_right_exact_left
    {R A M N₁ N₂ N₃ : Type u} [CommRing R] [Ring A] [Algebra R A]
    [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
    [AddCommGroup N₁] [Module R N₁] [Module A N₁]
    [AddCommGroup N₂] [Module R N₂] [Module A N₂]
    [AddCommGroup N₃] [Module R N₃] [Module A N₃]
    (f : LeftAModuleHom (R := R) (A := A) (N := N₁) (N' := N₂))
    (g : LeftAModuleHom (R := R) (A := A) (N := N₂) (N' := N₃))
    (h : Function.Exact f.toLinearMap g.toLinearMap) :
    Function.Exact
      (relativeTensorProductMap (rightAModuleId (R := R) (A := A) (M := M)) f)
      (relativeTensorProductMap (rightAModuleId (R := R) (A := A) (M := M)) g) := by
  sorry

/-! ## Graded relative tensor products -/

abbrev gradedPairIndex (n : ℤ) := {p : ℤ × ℤ // p.1 + p.2 = n}
abbrev gradedTripleIndex (n : ℤ) :=
  {p : ℤ × ℤ × ℤ // p.1 + p.2.1 + p.2.2 = n}

abbrev gradedPairSum (R : Type u) (n : ℤ) (M N : ℤ → Type u)
    [CommRing R] [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    [∀ i, AddCommGroup (N i)] [∀ i, Module R (N i)] :=
  DirectSum (gradedPairIndex n) (fun p => TensorProduct R (M p.1.1) (N p.1.2))

abbrev gradedTripleSum (R : Type u) (n : ℤ) (M A N : ℤ → Type u)
    [CommRing R] [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    [∀ i, AddCommGroup (N i)] [∀ i, Module R (N i)] :=
  DirectSum (gradedTripleIndex n) (fun p =>
    TensorProduct R (TensorProduct R (M p.1.1) (A p.1.2.1)) (N p.1.2.2))

/-- The graded balancing map whose cokernel is the degree-`n` piece of the
graded relative tensor product. -/
def gradedTensorRelationMap
    {R : Type u} [CommRing R] (n : ℤ)
    (M A N : ℤ → Type u)
    [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    [∀ i, AddCommGroup (N i)] [∀ i, Module R (N i)]
    (rightAction : ∀ p q, M p →ₗ[R] A q →ₗ[R] M (p + q))
    (leftAction : ∀ p q, A p →ₗ[R] N q →ₗ[R] N (p + q)) :
    gradedTripleSum R n M A N →ₗ[R] gradedPairSum R n M N :=
  DirectSum.toModule R (gradedTripleIndex n) (gradedPairSum R n M N) (fun p =>
    (DirectSum.lof R (gradedPairIndex n)
      (fun i => TensorProduct R (M i.1.1) (N i.1.2))
      ⟨⟨p.1.1, p.1.2.1 + p.1.2.2⟩, by omega⟩).comp
      (TensorProduct.map LinearMap.id (TensorProduct.lift (leftAction p.1.2.1 p.1.2.2)))
      ∘ₗ (TensorProduct.assoc R (M p.1.1) (A p.1.2.1) (N p.1.2.2)).toLinearMap -
    (DirectSum.lof R (gradedPairIndex n)
      (fun i => TensorProduct R (M i.1.1) (N i.1.2))
      ⟨⟨p.1.1 + p.1.2.1, p.1.2.2⟩, p.2⟩).comp
      (TensorProduct.map (TensorProduct.lift (rightAction p.1.1 p.1.2.1)) LinearMap.id))

/-- The degree-`n` graded relative tensor product, in the source's displayed
cokernel form. -/
abbrev gradedRelativeTensorProductComponent
    {R : Type u} [CommRing R] (n : ℤ)
    (M A N : ℤ → Type u)
    [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    [∀ i, AddCommGroup (N i)] [∀ i, Module R (N i)]
    (rightAction : ∀ p q, M p →ₗ[R] A q →ₗ[R] M (p + q))
    (leftAction : ∀ p q, A p →ₗ[R] N q →ₗ[R] N (p + q)) :=
  gradedPairSum R n M N ⧸ LinearMap.range (gradedTensorRelationMap n M A N rightAction leftAction)

/-- The homogeneous pure tensor in the graded relative tensor product. -/
def gradedRelativeTensorProductMk
    {R : Type u} [CommRing R] (n p q : ℤ)
    (M A N : ℤ → Type u)
    [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    [∀ i, AddCommGroup (N i)] [∀ i, Module R (N i)]
    (rightAction : ∀ p q, M p →ₗ[R] A q →ₗ[R] M (p + q))
    (leftAction : ∀ p q, A p →ₗ[R] N q →ₗ[R] N (p + q))
    (hpq : p + q = n) (m : M p) (x : N q) :
    gradedRelativeTensorProductComponent n M A N rightAction leftAction :=
  Submodule.Quotient.mk
    (DirectSum.of (fun i : gradedPairIndex n =>
      TensorProduct R (M i.1.1) (N i.1.2)) ⟨⟨p, q⟩, hpq⟩ (m ⊗ₜ[R] x))

/-- A graded `A`-balanced bilinear map into a graded `R`-module `Q`. -/
structure GradedABilinearMap
    {R : Type u} [CommRing R] (M A N Q : ℤ → Type u)
    [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    [∀ i, AddCommGroup (N i)] [∀ i, Module R (N i)]
    [∀ i, AddCommGroup (Q i)] [∀ i, Module R (Q i)]
    (rightAction : ∀ p q, M p →ₗ[R] A q →ₗ[R] M (p + q))
    (leftAction : ∀ p q, A p →ₗ[R] N q →ₗ[R] N (p + q)) where
  map : ∀ p q, M p →ₗ[R] N q →ₗ[R] Q (p + q)
  balanced : ∀ p q r (m : M p) (a : A q) (n : N r),
    map (p + q) r (rightAction p q m a) n =
    transportGraded (by omega) (map p (q + r) m (leftAction q r a n))

/-- Universal property of each graded component of the relative tensor
product. -/
theorem gradedRelativeTensorProduct_universal
    {R : Type u} [CommRing R] (n : ℤ)
    (M A N Q : ℤ → Type u)
    [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    [∀ i, AddCommGroup (N i)] [∀ i, Module R (N i)]
    [∀ i, AddCommGroup (Q i)] [∀ i, Module R (Q i)]
    (rightAction : ∀ p q, M p →ₗ[R] A q →ₗ[R] M (p + q))
    (leftAction : ∀ p q, A p →ₗ[R] N q →ₗ[R] N (p + q))
    (f : GradedABilinearMap M A N Q rightAction leftAction) :
    ∃! F : gradedRelativeTensorProductComponent n M A N rightAction leftAction →ₗ[R] Q n,
      ∀ (p q : ℤ) (hpq : p + q = n) (m : M p) (x : N q),
        F (gradedRelativeTensorProductMk n p q M A N rightAction leftAction hpq m x) =
          (hpq ▸ f.map p q m x) := by
  sorry

/-! ## Differential graded relative tensor products -/

/-- The chain map imposing the differential graded balancing relations. -/
noncomputable def differentialGradedTensorRelation
    {R : Type u} [CommRing R] {A : DifferentialGradedAlgebra R}
    (M : DifferentialGradedModule A) (N : LeftDifferentialGradedModule A) :
    tensorProductComplex R (tensorProductComplex R M.complex A.complex) N.complex ⟶
      tensorProductComplex R M.complex N.complex :=
  (HomologicalComplex.associator M.complex A.complex N.complex).hom ≫
      tensorHomComplex (𝟙 M.complex) N.action -
    tensorHomComplex M.action (𝟙 N.complex)

/-- The differential graded tensor product `M ⊗_A N`, as the cokernel of the
balancing relation map in cochain complexes. -/
noncomputable abbrev differentialGradedTensorProduct
    {R : Type u} [CommRing R] {A : DifferentialGradedAlgebra R}
    (M : DifferentialGradedModule A) (N : LeftDifferentialGradedModule A) :
    CochainComplexOver R :=
  cokernel (differentialGradedTensorRelation M N)

/-- The homogeneous pure-tensor map into the differential graded tensor
product. -/
noncomputable def differentialGradedTensorProductMk
    {R : Type u} [CommRing R] {A : DifferentialGradedAlgebra R}
    (M : DifferentialGradedModule A) (N : LeftDifferentialGradedModule A)
    (p q : ℤ) :
    M.complex.X p ⊗ N.complex.X q ⟶
      (differentialGradedTensorProduct M N).X (p + q) :=
  HomologicalComplex.ιTensorObj M.complex N.complex p q (p + q) rfl ≫
    (cokernel.π (differentialGradedTensorRelation M N)).f (p + q)

/-- The differential on a pure tensor is the signed sum of the two
differentials. -/
theorem differentialGradedTensorProduct_differential_on_pure
    {R : Type u} [CommRing R] {A : DifferentialGradedAlgebra R}
    (M : DifferentialGradedModule A) (N : LeftDifferentialGradedModule A)
    (p q : ℤ) (x : M.complex.X p) (y : N.complex.X q) :
    ((differentialGradedTensorProduct M N).d (p + q) (p + q + 1)).hom
        ((differentialGradedTensorProductMk M N p q).hom (x ⊗ₜ[R] y)) =
      transportComponent (C := differentialGradedTensorProduct M N) (by omega)
          ((differentialGradedTensorProductMk M N (p + 1) q).hom
            ((M.complex.d p (p + 1)).hom x ⊗ₜ[R] y)) +
        ((p.negOnePow : ℤ) : R) •
          transportComponent (C := differentialGradedTensorProduct M N) (by omega)
            ((differentialGradedTensorProductMk M N p (q + 1)).hom
              (x ⊗ₜ[R] (N.complex.d q (q + 1)).hom y)) := by
  sorry

/-- A differential graded `A`-balanced bilinear map to a cochain complex. -/
structure DifferentialGradedABilinearMap
    {R : Type u} [CommRing R] {A : DifferentialGradedAlgebra R}
    (M : DifferentialGradedModule A) (N : LeftDifferentialGradedModule A)
    (Q : CochainComplexOver R) where
  map : ∀ p q, M.complex.X p →ₗ[R] N.complex.X q →ₗ[R] Q.X (p + q)
  balanced : ∀ p q r (x : M.complex.X p) (a : A.complex.X q)
    (y : N.complex.X r),
    map (p + q) r (M.actionOnHomogeneous p q x a) y =
      transportGraded (X := fun i => (Q.X i : Type u)) (by omega)
        (map p (q + r) x (N.actionOnHomogeneous q r a y))
  differential : ∀ p q (x : M.complex.X p) (y : N.complex.X q),
    (Q.d (p + q) (p + q + 1)).hom (map p q x y) =
      transportComponent (C := Q) (by omega)
          (map (p + 1) q ((M.complex.d p (p + 1)).hom x) y) +
        ((p.negOnePow : ℤ) : R) •
          transportComponent (C := Q) (by omega)
            (map p (q + 1) x ((N.complex.d q (q + 1)).hom y))

/-- Universal property of the differential graded relative tensor product. -/
theorem differentialGradedTensorProduct_universal
    {R : Type u} [CommRing R] {A : DifferentialGradedAlgebra R}
    (M : DifferentialGradedModule A) (N : LeftDifferentialGradedModule A)
    (Q : CochainComplexOver R) (f : DifferentialGradedABilinearMap M N Q) :
    ∃! F : differentialGradedTensorProduct M N ⟶ Q,
      ∀ (p q : ℤ) (x : M.complex.X p) (y : N.complex.X q),
        F.f (p + q) ((differentialGradedTensorProductMk M N p q).hom
          (x ⊗ₜ[R] y)) = f.map p q x y := by
  sorry

end Formalization.Books.Dga.Unit12
