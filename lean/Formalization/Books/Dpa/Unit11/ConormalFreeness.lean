/-!
# Divided Power Algebra, Chapter 11: Freeness of the conormal module

The conormal module is Mathlib's canonical `Ideal.Cotangent`.  The two
Vasconcelos statements below use explicit submodules and complements for the
source's direct summands.  The final statements use the existing project
interface for the naive cotangent object in the derived category.
-/

namespace Formalization.Books.Dpa.Unit11

open Formalization.Books.Algebra.Unit136
open Formalization.Books.Algebra.Unit78
open Formalization.Books.MoreAlgebra.Unit32
open Formalization.Books.MoreAlgebra.Unit67
open Formalization.Books.MoreAlgebra.Unit69
open Formalization.Books.MoreAlgebra.Unit75
open Formalization.Books.MoreAlgebra.Unit83
open Formalization.Books.MoreAlgebra.Unit85

noncomputable section

universe w u

/-! ## Direct summands of the conormal module -/

/-- A conormal submodule is a direct summand free of the indicated finite rank. -/
def IsConormalDirectSummandOfRank
    {R : Type u} [CommRing R] (I : Ideal R)
    (F : Submodule (R ⧸ I) I.Cotangent) (r : ℕ) : Prop :=
  ∃ G : Submodule (R ⧸ I) I.Cotangent,
    IsCompl F G ∧
      Nonempty (F ≃ₗ[R ⧸ I] (Fin r →₀ (R ⧸ I)))

/-- The rank-one direct-summand hypothesis in the first Vasconcelos lemma. -/
def IsConormalDirectSummandEquivalentToQuotient
    {R : Type u} [CommRing R] (I : Ideal R)
    (F : Submodule (R ⧸ I) I.Cotangent) : Prop :=
  ∃ G : Submodule (R ⧸ I) I.Cotangent,
    IsCompl F G ∧ Nonempty (F ≃ₗ[R ⧸ I] (R ⧸ I))

/-- One conormal class generates a specified conormal submodule. -/
def ConormalElementGenerates
    {R : Type u} [CommRing R] (I : Ideal R)
    (F : Submodule (R ⧸ I) I.Cotangent) (x : I) : Prop :=
  Submodule.span (R ⧸ I) ({I.toCotangent x} : Set I.Cotangent) = F

/-- A finite family of elements of an ideal generates a specified conormal
submodule after passage modulo the square of the ideal. -/
def ConormalFamilyGenerates
    {R : Type u} [CommRing R] (I : Ideal R)
    (F : Submodule (R ⧸ I) I.Cotangent) {r : ℕ} (xs : Fin r → I) : Prop :=
  Submodule.span (R ⧸ I)
      (Set.range (fun i => I.toCotangent (xs i))) = F

/-! ## The local Vasconcelos lemmas -/

/-- A rank-one free direct summand of `I/I²` has a generator which is a
nonzerodivisor in `I`. -/
theorem exists_regular_element_generating_conormal_summand
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [HasDerivedCategory.{w} (ModuleCat.{u} R)]
    (I : Ideal R)
    (hI : HasFiniteProjectiveDimension (R := R)
      (K := Formalization.Books.MoreAlgebra.Unit67.moduleInDerived R
        (ModuleCat.of R I)))
    (F : Submodule (R ⧸ I) I.Cotangent)
    (hF : IsConormalDirectSummandEquivalentToQuotient I F) :
    ∃ x : I, IsRegular (x : R) ∧ ConormalElementGenerates I F x := by
  sorry

/-- A free direct summand of rank `r` in `I/I²` is generated by the classes of
a regular sequence of length `r`. -/
theorem exists_regular_sequence_generating_conormal_summand
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [HasDerivedCategory.{w} (ModuleCat.{u} R)]
    (I : Ideal R)
    (hI : HasFiniteProjectiveDimension (R := R)
      (K := Formalization.Books.MoreAlgebra.Unit67.moduleInDerived R
        (ModuleCat.of R I)))
    (r : ℕ) (F : Submodule (R ⧸ I) I.Cotangent)
    (hF : IsConormalDirectSummandOfRank I F r) :
    ∃ xs : Fin r → I,
      RingTheory.Sequence.IsRegular R
          (List.ofFn (fun i => (xs i : R))) ∧
        ConormalFamilyGenerates I F xs := by
  sorry

/-! ## The regular-ideal criterion -/

/-- Finite projective dimension and finite local freeness of the conormal
module force an ideal to be regular. -/
theorem regular_ideal_of_finite_projective_dimension_of_finite_locally_free
    {R : Type u} [CommRing R] [IsNoetherianRing R]
    [HasDerivedCategory.{w} (ModuleCat.{u} R)]
    (I : Ideal R)
    (hI : HasFiniteProjectiveDimension (R := R)
      (K := Formalization.Books.MoreAlgebra.Unit67.moduleInDerived R
        (ModuleCat.of R I)))
    (hconormal : FiniteLocallyFree (R ⧸ I) I.Cotangent) :
    IsRegularIdeal R I := by
  sorry

/-! ## Naive cotangent complexes and local complete intersections -/

/-- A local complete intersection map has a perfect naive cotangent complex
of tor-amplitude `[-1, 0]`.  This is the source's assertion immediately
before the characterizations below, exposed by the existing Chapter 86
interface. -/
theorem local_complete_intersection_naive_cotangent_is_perfect
    {A B : Type u} [CommRing A] [CommRing B]
    [HasDerivedCategory.{w} (ModuleCat.{u} B)]
    (f : A →+* B) (hf : IsLocalCompleteIntersectionHom f)
    [NaiveCotangentComplexData f] :
    Perfect B (naiveCotangentObject f) ∧
      TorAmplitude B (naiveCotangentObject f) (-1 : ℤ) 0 :=
  Formalization.Books.MoreAlgebra.Unit86.lci_NL f hf

/-- For a perfect map of Noetherian rings, the naive cotangent complex has
tor-amplitude `[-1, 0]` exactly when it is a perfect object of that amplitude,
and exactly when the map is a local complete intersection.  The existing
`NaiveCotangentComplexData` class supplies the canonical derived object used
by the project's derived-category formalization. -/
theorem perfect_naive_cotangent_iff_local_complete_intersection
    {A B : Type u} [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B]
    [HasDerivedCategory.{w} (ModuleCat.{u} B)]
    (f : A →+* B) (hperfect : IsPerfectRingMap f)
    [NaiveCotangentComplexData f] :
    List.TFAE
      [ TorAmplitude B (naiveCotangentObject f) (-1 : ℤ) 0,
        Perfect B (naiveCotangentObject f) ∧
          TorAmplitude B (naiveCotangentObject f) (-1 : ℤ) 0,
        IsLocalCompleteIntersectionHom f ] := by
  sorry

/-- For a flat finitely presented map, the naive cotangent complex has
tor-amplitude `[-1, 0]`, is perfect of that amplitude, the map is syntomic,
and the map is a local complete intersection, all equivalently. -/
theorem flat_finite_presentation_naive_cotangent_iff_syntomic_iff_lci
    {A B : Type u} [CommRing A] [CommRing B]
    [HasDerivedCategory.{w} (ModuleCat.{u} B)]
    (f : A →+* B) (hflat : RingHom.Flat f)
    (hfp : RingHom.FinitePresentation f)
    [NaiveCotangentComplexData f] :
    List.TFAE
      [ TorAmplitude B (naiveCotangentObject f) (-1 : ℤ) 0,
        Perfect B (naiveCotangentObject f) ∧
          TorAmplitude B (naiveCotangentObject f) (-1 : ℤ) 0,
        IsSyntomic f,
        IsLocalCompleteIntersectionHom f ] := by
  sorry

end

end Formalization.Books.Dpa.Unit11
