import Formalization.Books.Algebra.Unit21.OpenAndClosed
import Formalization.Books.Topology.Unit12.QuasiCompactSpacesAndMaps
import Mathlib.RingTheory.Ideal.Quotient.Basic

/-!
# Commutative Algebra, Chapter 22: Connected components of spectra

The topological predicates for intersections of clopens and unions of
connected components are reused from Topology, Chapter 12.  The remaining
ring-theoretic phrase “generated by idempotents” is recorded as a predicate
on ideals, while spectra and their connected components use Mathlib's
canonical `PrimeSpectrum` and `connectedComponent` constructions.
-/

namespace Formalization.Books.Algebra.Unit22

universe u

noncomputable section

/-! ## Ideals generated by idempotents -/

/-- An ideal is generated by idempotents if it is the span of a set of
idempotent elements. -/
def Ideal.IsGeneratedByIdempotents {R : Type u} [CommRing R] (I : Ideal R) : Prop :=
  ∃ S : Set R, (∀ e ∈ S, IsIdempotentElem e) ∧ I = Ideal.span S

/-! ## Closed unions of connected components -/

/-- Closed unions of connected components, intersections of clopens, and
vanishing loci of ideals generated by idempotents are equivalent conditions. -/
theorem closed_union_connected_components_tfae
    {R : Type u} [CommRing R] (T : Set (PrimeSpectrum R)) :
    List.TFAE
      [ IsClosed T ∧
          Formalization.Books.Topology.Unit12.IsUnionOfConnectedComponents T,
        Formalization.Books.Topology.Unit12.IsIntersectionOfClopens T,
        ∃ I : Ideal R,
          Ideal.IsGeneratedByIdempotents I ∧
            T = PrimeSpectrum.zeroLocus (I : Set R) ] := by
  sorry

/-- An ideal generated by idempotents which defines a given vanishing locus is
unique. -/
theorem idempotent_generated_ideal_unique
    {R : Type u} [CommRing R] {T : Set (PrimeSpectrum R)}
    {I J : Ideal R}
    (hI : Ideal.IsGeneratedByIdempotents I)
    (hJ : Ideal.IsGeneratedByIdempotents J)
    (hTI : T = PrimeSpectrum.zeroLocus (I : Set R))
    (hTJ : T = PrimeSpectrum.zeroLocus (J : Set R)) :
    I = J := by
  sorry

/-! ## Connected components -/

/-- Every connected component of a spectrum is the vanishing locus of an
ideal generated by idempotents, and every idempotent becomes zero or one in
the corresponding quotient. -/
theorem connected_component_eq_zeroLocus_of_idempotent_generated_ideal
    {R : Type u} [CommRing R] (p : PrimeSpectrum R) :
    ∃ I : Ideal R,
      Ideal.IsGeneratedByIdempotents I ∧
        connectedComponent p = PrimeSpectrum.zeroLocus (I : Set R) ∧
          ∀ e : R, IsIdempotentElem e →
            Ideal.Quotient.mk I e = 0 ∨ Ideal.Quotient.mk I e = 1 := by
  sorry

end

end Formalization.Books.Algebra.Unit22
