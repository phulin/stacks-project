import Formalization.Books.Dualizing.Unit02.Essential
import Mathlib.Algebra.Module.Projective
import Mathlib.Algebra.Module.Submodule.LinearMap
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.Ideal.Quotient.Basic
import Mathlib.RingTheory.LocalRing.Basic
import Mathlib.RingTheory.Polynomial.Basic

/-!
# Dualizing Complexes, Chapter 4: Projective covers

The source defines projective covers as essential surjections from projective
modules, records the polynomial-ring obstruction to their existence, proves
uniqueness up to isomorphism, and gives existence over local rings for finite
modules.
-/

namespace Formalization.Books.Dualizing.Unit04

open CategoryTheory
open Formalization.Books.Dualizing.Unit02

universe u v

noncomputable section

/-! ## Projective covers -/

/-- An essential surjection whose source is a projective module. -/
def ProjectiveCover {R : Type u} [Ring R] {P M : ModuleCat.{v} R}
    (f : P ⟶ M) : Prop :=
  Module.Projective R P ∧ EssentialSurjection f

/-- The underlying module map of a projective cover is surjective. -/
theorem ProjectiveCover.surjective
    {R : Type u} [Ring R] {P M : ModuleCat.{v} R} {f : P ⟶ M}
    (hf : ProjectiveCover f) : Function.Surjective f.hom :=
  (ModuleCat.epi_iff_surjective f).mp hf.2.1

/-- The submodule of a module generated by multiplying all elements by `r`.
This is the module-theoretic notation for the principal multiple `rP`. -/
def principalMultipleSubmodule {R : Type u} [Ring R]
    (P : ModuleCat.{v} R) (r : R) : Submodule R P :=
  (Ideal.span ({r} : Set R) : Ideal R) • (⊤ : Submodule R P)

/-- Restriction of a module map to a principal multiple submodule. -/
def principalMultipleMap {R : Type u} [Ring R]
    {P M : ModuleCat.{v} R} (f : P ⟶ M) (r : R) :
    ModuleCat.of R (principalMultipleSubmodule P r) ⟶ M :=
  ModuleCat.ofHom (f.hom.domRestrict (principalMultipleSubmodule P r))

/-! The example showing that projective covers need not exist. -/

/-- The residue module `k[x]/(x)` from the source's nonexistence example. -/
def polynomialResidueModule (k : Type u) [Field k] :
    ModuleCat.{u} (Polynomial k) :=
  ModuleCat.of (Polynomial k)
    (Polynomial k ⧸ Ideal.span ({(Polynomial.X : Polynomial k)} : Set (Polynomial k)))

/-- For a surjection from a projective `k[x]`-module to `k[x]/(x)`, the
proper submodule `(x - 1)P` still maps surjectively to the residue module. -/
theorem polynomial_residue_principal_multiple_surjective
    (k : Type u) [Field k]
    (P : ModuleCat.{u} (Polynomial k))
    (f : P ⟶ polynomialResidueModule k)
    [Module.Projective (Polynomial k) P]
    (hf : Function.Surjective f.hom) :
    principalMultipleSubmodule P (Polynomial.X - 1) ≠ ⊤ ∧
      Function.Surjective
        (principalMultipleMap f (Polynomial.X - 1)).hom := by
  sorry

/-- The module `k[x]/(x)` has no projective cover. -/
theorem polynomial_residue_no_projective_cover (k : Type u) [Field k] :
    ¬ ∃ (P : ModuleCat.{u} (Polynomial k))
        (f : P ⟶ polynomialResidueModule k), ProjectiveCover f := by
  sorry

/-! Uniqueness and existence results. -/

/-- Two projective covers of the same module are uniquely isomorphic over that
module. -/
theorem projective_cover_unique
    {R : Type u} [Ring R] {M P P' : ModuleCat.{v} R}
    {f : P ⟶ M} {g : P' ⟶ M}
    (hf : ProjectiveCover f) (hg : ProjectiveCover g) :
    ∃ e : P ≅ P', e.hom ≫ g = f := by
  sorry

/-- Every finite module over a commutative local ring has a projective cover. -/
theorem exists_projective_cover_of_finite
    {R : Type u} [CommRing R] [IsLocalRing R]
    (M : ModuleCat.{u} R) [Module.Finite R M] :
    ∃ P : ModuleCat.{u} R, ∃ f : P ⟶ M, ProjectiveCover f := by
  sorry

end

end Formalization.Books.Dualizing.Unit04
