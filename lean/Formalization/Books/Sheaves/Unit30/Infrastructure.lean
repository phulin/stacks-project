            ((r • m : M.val.obj U) : M.val.presheaf.obj (op (unop U)))) =
        (ConcreteCategory.hom (N.val.presheaf.map f.op))
          ((r • (ConcreteCategory.hom (α.app (op (unop U)))) m : N.val.obj U) :
