import Formalization.Books.Dpa.Unit07.ApplicationToCompleteIntersections
import Formalization.Books.Algebra.Unit135.LocalCompleteIntersections
import Mathlib.RingTheory.AdicCompletion.Algebra
import Mathlib.RingTheory.AdicCompletion.LocalRing
import Mathlib.RingTheory.Ideal.Cotangent
import Mathlib.RingTheory.KrullDimension.Basic
import Mathlib.RingTheory.Spectrum.Maximal.Basic

/-!
# Divided Power Algebra, Chapter 8: Local complete intersection rings

The source defines complete intersections for complete Noetherian local
rings by regular-local-ring presentations, then passes to completions for
arbitrary local rings. The presentation predicate below uses Mathlib's
`IsRegularLocalRing` and the regular-sequence predicate from Chapter 7.
Localizations, adic completions, maximal spectra, and conormal modules use
their canonical Mathlib constructions.
-/

namespace Formalization.Books.Dpa.Unit08

open Formalization.Books.Dpa.Unit07
open Formalization.Books.Algebra.Unit135

noncomputable section

universe u

/-! ## Complete-intersection presentations -/

/-- A presentation of a ring by a regular sequence in a regular local ring. -/
structure CompleteIntersectionPresentation
    (A : Type u) [CommRing A] where
  R : Type u
  [ringR : CommRing R]
  [regularLocalR : IsRegularLocalRing R]
  map : R →+* A
  surjective : Function.Surjective map
  kernel_regular : IsGeneratedByRegularSequence R (RingHom.ker map)

/-- The source's complete-intersection notion for a complete local ring. -/
def IsCompleteIntersectionInCompleteSense
    (A : Type u) [CommRing A] : Prop :=
  Nonempty (CompleteIntersectionPresentation A)

/-- A local ring is a complete intersection when its adic completion has a
regular-local-ring presentation by a regular sequence. The local and
Noetherian structures are existential here so that the predicate can also be
used for quotient rings whose canonical local instances are not synthesized
automatically by Mathlib. -/
def IsCompleteIntersection (A : Type u) [CommRing A] : Prop :=
  ∃ (hlocal : IsLocalRing A) (hnoetherian : IsNoetherianRing A),
    @IsCompleteIntersectionInCompleteSense
      (AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (by infer_instance)

/-- The completion predicate with local and Noetherian structures supplied. -/
def IsCompleteIntersectionAtLocal
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] : Prop :=
  IsCompleteIntersectionInCompleteSense
    (AdicCompletion (IsLocalRing.maximalIdeal A) A)

/-! ## Independence of the complete-local presentation -/

/-- For a complete Noetherian local ring, the regular-sequence kernel
condition is independent of the chosen regular-local-ring surjection. -/
theorem complete_intersection_well_defined
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (hcomplete : IsAdicComplete (IsLocalRing.maximalIdeal A) A) :
    ((∀ (R : Type u) [CommRing R] [IsRegularLocalRing R]
        (f : R →+* A),
        Function.Surjective f →
          IsGeneratedByRegularSequence R (RingHom.ker f)) ↔
      IsCompleteIntersectionInCompleteSense A) := by
  sorry

/-! ## Quotients of regular rings -/

/-- The prime of `R ⧸ I` induced by a prime of `R` containing `I`. -/
def quotientPrime
    {R : Type u} [CommRing R] (p : PrimeSpectrum R)
    (I : Ideal R) (hI : I ≤ p.asIdeal) : PrimeSpectrum (R ⧸ I) :=
  { asIdeal := Ideal.map (Ideal.Quotient.mk I) p.asIdeal
    isPrime := by
      exact Ideal.isPrime_map_quotientMk_of_isPrime hI }

/-- The extension of an ideal to the localization at a prime. -/
def localizedIdeal
    {R : Type u} [CommRing R] (p : PrimeSpectrum R) (I : Ideal R) :
    Ideal (Localization.AtPrime p.asIdeal) :=
  Ideal.map (algebraMap R (Localization.AtPrime p.asIdeal)) I

/-- The localization of `(R/I)` at the prime induced by `p`. -/
abbrev quotientAtPrime
    {R : Type u} [CommRing R] (p : PrimeSpectrum R)
    (I : Ideal R) (hI : I ≤ p.asIdeal) : Type u :=
  Localization.AtPrime (quotientPrime p I hI).asIdeal

/-- The conormal module of the localized defining ideal is generated by
`n` elements. -/
def ConormalGeneratedBy
    {R : Type u} [CommRing R] (p : PrimeSpectrum R) (I : Ideal R)
    (n : ℕ) : Prop :=
  ∃ xs : Fin n → (localizedIdeal p I).Cotangent,
    Submodule.span
        (Localization.AtPrime p.asIdeal ⧸ localizedIdeal p I)
        (Set.range xs) = ⊤

/-- The source's dimension-difference formulation for finite generation of the
localized conormal module. -/
def IsConormalGeneratedByDimensionDifference
    {R : Type u} [CommRing R] (p : PrimeSpectrum R) (I : Ideal R)
    (hI : I ≤ p.asIdeal) : Prop :=
  ∃ n : ℕ,
    ringKrullDim (Localization.AtPrime p.asIdeal) =
        ringKrullDim (quotientAtPrime p I hI) +
          (((n : ℕ∞) : WithBot ℕ∞)) ∧
      ConormalGeneratedBy p I n

/-- A list lying in a prime generates an ideal contained in that prime. -/
def ofList_le_of_mem
    {R : Type u} [CommRing R] (p : PrimeSpectrum R) (fs : List R)
    (hmem : ∀ f ∈ fs, f ∈ p.asIdeal) :
    Ideal.ofList fs ≤ p.asIdeal :=
  Ideal.span_le.2 hmem

/-- The completion of the localization of a regular ring by a regular
sequence is a complete intersection. -/
theorem quotient_regular_ring_by_regular_sequence
    {R : Type u} [CommRing R] [IsRegularRing R]
    (p : PrimeSpectrum R) (fs : List R)
    (hmem : ∀ f ∈ fs, f ∈ p.asIdeal)
    (hregular : RingTheory.Sequence.IsRegular R fs) :
    IsCompleteIntersection
      (quotientAtPrime p (Ideal.ofList fs)
        (ofList_le_of_mem p fs hmem)) := by
  sorry

/-- The three specified equivalent criteria for a quotient of a regular ring:
its completed local quotient is a complete intersection, its localized ideal
is generated by a regular sequence, and its localized conormal module has the
expected number of generators. -/
theorem quotient_regular_ring_iff
    {R : Type u} [CommRing R] [IsRegularRing R]
    (p : PrimeSpectrum R) (I : Ideal R) (hI : I ≤ p.asIdeal) :
    List.TFAE
      [ IsCompleteIntersection (quotientAtPrime p I hI),
        IsGeneratedByRegularSequence (Localization.AtPrime p.asIdeal)
          (localizedIdeal p I),
        IsConormalGeneratedByDimensionDifference p I hI ] := by
  sorry

/-! ## Avramov's flat-local criterion -/

/-- The fibre ring over the source maximal ideal. -/
abbrev residueFibreRing
    {A B : Type u} [CommRing A] [CommRing B] [IsLocalRing A]
    (f : A →+* B) : Type u :=
  B ⧸ Ideal.map f (IsLocalRing.maximalIdeal A)

/-- Avramov's criterion in the completion formulation of the source. -/
theorem avramov_completion_iff
    {A B : Type u} [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B]
    [IsLocalRing A] [IsLocalRing B]
    (f : A →+* B) (hflat : RingHom.Flat f)
    (hlocal : IsLocalHom f) :
    IsCompleteIntersectionAtLocal B ↔
      IsCompleteIntersectionAtLocal A ∧
        IsCompleteIntersection (residueFibreRing f) := by
  sorry

/-! ## Local complete intersections -/

/-- A Noetherian ring is a local complete intersection when all of its local
rings at prime ideals are complete intersections. -/
def IsLocalCompleteIntersection
    (A : Type u) [CommRing A] : Prop :=
  ∃ hnoetherian : IsNoetherianRing A,
    ∀ p : PrimeSpectrum A,
      IsCompleteIntersection (Localization.AtPrime p.asIdeal)

/-- A complete intersection local ring remains one after localization at any
prime. -/
theorem complete_intersection_localization
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (p : PrimeSpectrum A) (hA : IsCompleteIntersection A) :
    IsCompleteIntersection (Localization.AtPrime p.asIdeal) := by
  sorry

/-- The local-complete-intersection property can be checked at maximal
ideals. -/
theorem local_complete_intersection_iff_maximal
    {A : Type u} [CommRing A] [IsNoetherianRing A] :
    IsLocalCompleteIntersection A ↔
      ∀ m : MaximalSpectrum A,
        IsCompleteIntersection (Localization.AtPrime m.asIdeal) := by
  sorry

/-! ## Agreement with the finite-type terminology -/

/-- For a finite-type algebra over a field, the local ring definitions of
complete intersection agree with the earlier Algebra chapter's definition. -/
theorem finite_type_complete_intersection_agrees
    {k S : Type u} [Field k] [CommRing S] [Algebra k S]
    [Algebra.FiniteType k S] (q : PrimeSpectrum S) :
    Formalization.Books.Algebra.Unit135.IsCompleteIntersection k
        (Localization.AtPrime q.asIdeal) ↔
      IsCompleteIntersection (Localization.AtPrime q.asIdeal) := by
  sorry

/-- For a finite-type algebra over a field, the global local-complete-
intersection predicates agree. -/
theorem finite_type_local_complete_intersection_agrees
    {k S : Type u} [Field k] [CommRing S] [Algebra k S]
    [Algebra.FiniteType k S] :
    Formalization.Books.Algebra.Unit135.IsLocalCompleteIntersection k S ↔
      IsLocalCompleteIntersection S := by
  sorry

/-! ## The local Avramov reformulation -/

/-- Avramov's completion criterion is equivalently the same criterion stated
using the local complete-intersection predicate. -/
theorem avramov_iff
    {A B : Type u} [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B]
    [IsLocalRing A] [IsLocalRing B]
    (f : A →+* B) (hflat : RingHom.Flat f)
    (hlocal : IsLocalHom f) :
    IsCompleteIntersection B ↔
      IsCompleteIntersection A ∧
        IsCompleteIntersection (residueFibreRing f) := by
  sorry

end

end Formalization.Books.Dpa.Unit08
