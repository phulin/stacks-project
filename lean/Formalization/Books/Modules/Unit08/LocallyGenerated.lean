import Formalization.Books.Modules.Unit04.Sections
import Formalization.Books.Sheaves.Unit31.Infrastructure
import Mathlib.CategoryTheory.Sites.ConstantSheaf

/-!
# Sheaves of Modules, Chapter 8: Modules locally generated by sections

This file formalizes the source section `Modules locally generated by
sections`.  Open restriction is Mathlib's `SheafOfModules.over`, global
generation is the Chapter 4 free-sheaf interface, and pullback is the
canonical ringed-space module pullback from Chapter 3.
-/

namespace Formalization.Books.Modules.Unit08

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Formalization.Books.Modules.Unit03
open Formalization.Books.Modules.Unit04
open Formalization.Books.Sheaves.Unit10
open Formalization.Books.Sheaves.Unit22

universe v

noncomputable section

/-! ## Modules locally generated by sections -/

/--
A sheaf of modules on a ringed space is locally generated by sections when
each point has an open neighbourhood on which the restricted sheaf is
globally generated.

The restriction is the canonical open-subspace module restriction functor;
it is the precise categorical version of `F|_U` and uses the corresponding
restricted structure sheaf.
-/
def locallyGenerated {X : RingedSpace.{v}} (F : Mod X.structureSheaf) : Prop :=
  ∀ x : X, ∃ U : Opens X.carrier, x ∈ U ∧
    globallyGenerated ((openModuleRestrictionFunctor X U).obj F)

/-- The source's direct-sum formulation of local generation.  The free sheaf
`SheafOfModules.free I` is the canonical categorical direct sum of `I`
copies of the structure sheaf, and `globalGenerationMap` is the associated
map determined by the family of sections.
-/
theorem locallyGenerated_iff_exists_free_surjection
    {X : RingedSpace.{v}} (F : Mod X.structureSheaf) :
    locallyGenerated F ↔
      ∀ x : X, ∃ U : Opens X.carrier, x ∈ U ∧
        ∃ (I : Type v)
          (s : I → ((openModuleRestrictionFunctor X U).obj F).sections),
          Epi (globalGenerationMap s) := by
  constructor
  · intro h x
    rcases h x with ⟨U, hxU, hU⟩
    rcases (globallyGenerated_iff ((openModuleRestrictionFunctor X U).obj F)).mp hU
      with ⟨I, s, hs⟩
    exact ⟨U, hxU, I, s, hs⟩
  · intro h x
    rcases h x with ⟨U, hxU, I, s, hs⟩
    refine ⟨U, hxU, ?_⟩
    apply (globallyGenerated_iff ((openModuleRestrictionFunctor X U).obj F)).mpr
    exact ⟨I, s, hs⟩

/-! ## The pullback lemma -/

/-- Pullback along a morphism of ringed spaces preserves local generation.

The proof follows the source: restrict to the inverse image of a generating
neighbourhood, use the canonical compatibility of restriction with pullback,
and apply the pullback functor's preservation of colimits and right exactness
to the free-sheaf epimorphism.
-/
theorem locallyGenerated_pullback
    {X Y : RingedSpace.{v}} (f : RingedSpaceHom X Y)
    (G : Mod Y.structureSheaf) (hG : locallyGenerated G)
    [((SheafOfModules.pushforward (F := Opens.map f.continuous)
      f.sharp).IsRightAdjoint)] :
    locallyGenerated ((sheafModuleRingedSpacePullback f).obj G) := by
  sorry

/-! ## The motivating extension-by-zero example -/

/-
The opening example is an abelian sheaf rather than a module over a
previously chosen ringed space.  The following small interface records the
same ``generated by sections'' idea for additive sheaves: a section is
represented by a map from the constant sheaf on the coefficient group, and a
family generates when the induced coproduct map is an epimorphism.
-/

/-- The constant additive sheaf used to represent one integral section. -/
noncomputable def integralConstantSheaf {X : TopCat.{v}} :
    TopCat.Sheaf AddCommGrpCat.{v} X :=
  (CategoryTheory.constantSheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{v}).obj (AddCommGrpCat.of (ULift.{v} ℤ))

/-- The coproduct map associated to a family of additive-sheaf sections. -/
noncomputable def additiveGlobalGenerationMap
    {X : TopCat.{v}} {F : TopCat.Sheaf AddCommGrpCat.{v} X}
    {I : Type v}
    (s : I → (integralConstantSheaf (X := X) ⟶ F)) :
    (∐ fun _ : I => integralConstantSheaf (X := X)) ⟶ F :=
  Cofan.IsColimit.desc (coproductIsCoproduct _) s

/-- Global generation for an additive sheaf, expressed using the constant
integral sheaf and its coproduct. -/
def additiveGloballyGenerated {X : TopCat.{v}}
  (F : TopCat.Sheaf AddCommGrpCat.{v} X) : Prop :=
  ∃ (I : Type v) (s : I → (integralConstantSheaf (X := X) ⟶ F)),
    Epi (additiveGlobalGenerationMap s)

/-- Local generation for the additive-sheaf formulation used by the example. -/
def additiveLocallyGenerated {X : TopCat.{v}}
    (F : TopCat.Sheaf AddCommGrpCat.{v} X) : Prop :=
  ∀ x : X, ∃ U : Opens X, x ∈ U ∧
    additiveGloballyGenerated
      ((Formalization.Books.Sheaves.Unit22.openSheafRestriction
        AddCommGrpCat U).obj F)

/-! The real-line example `j : (0,∞) ↪ ℝ`. -/

abbrev realLine : TopCat := TopCat.of ℝ

/-- The open positive half-line. -/
def positiveHalfLine : Opens realLine :=
  ⟨Set.Ioi (0 : ℝ), isOpen_Ioi⟩

/-- The constant sheaf `\underline{ℤ}` on the positive half-line. -/
noncomputable def positiveHalfLineIntegers :
    TopCat.Sheaf AddCommGrpCat (Formalization.Books.Sheaves.Unit22.openSubspace
      positiveHalfLine) :=
  (CategoryTheory.constantSheaf
      (Opens.grothendieckTopology
        (Formalization.Books.Sheaves.Unit22.openSubspace positiveHalfLine))
      AddCommGrpCat).obj (AddCommGrpCat.of ℤ)

/-- The extension by zero `j_!\underline{ℤ}_{(0,∞)}`. -/
noncomputable def positiveHalfLineExtension :
    TopCat.Sheaf AddCommGrpCat realLine :=
  (Formalization.Books.Sheaves.Unit22.openAbelianSheafExtensionFunctor
      positiveHalfLine).obj positiveHalfLineIntegers

/-- The stalk of the extension by zero at the boundary point `0` is zero. -/
theorem positiveHalfLineExtension_stalk_zero :
    Nonempty
      (positiveHalfLineExtension.presheaf.stalk (0 : realLine) ≅
        (⊥_ AddCommGrpCat)) := by
  sorry

/-- Sections of the extension by zero on an open interval containing `0` are
the zero additive group. -/
theorem positiveHalfLineExtension_interval_sections_zero
    (a b : ℝ) (ha : a < 0) (hb : 0 < b) :
    IsZero
      (positiveHalfLineExtension.presheaf.obj
        (op (⟨Set.Ioo a b, isOpen_Ioo⟩ : Opens realLine))) := by
  sorry

/-- No neighbourhood of `0` globally generates the extension by zero from
its integral sections. -/
theorem positiveHalfLineExtension_not_locally_generated :
    ¬ additiveLocallyGenerated positiveHalfLineExtension := by
  sorry

end

end Formalization.Books.Modules.Unit08
