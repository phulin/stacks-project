/-!
# Divided Power Algebra, Chapter 7: Application to complete intersections

This file records the degree-two derivation construction, its polynomial
relation calculation, and the local complete-intersection criteria from the
source section.  Chapter 6 supplies the graded divided-power DGA and Tate
resolution interfaces; Mathlib supplies quotient rings, regular sequences,
local rings, and polynomial algebras.
-/

namespace Formalization.Books.Dpa.Unit07

open Formalization.Books.Dpa.Unit06
open Formalization.Books.MoreAlgebra.Unit67
open Formalization.Books.MoreAlgebra.Unit83
open CategoryTheory
open scoped BigOperators

noncomputable section

universe u

/-! ## Degree-two derivations -/

/-- A derivation of homological degree `-2`, called a degree-two derivation in
the source.  The low-degree field records that negative graded pieces are
zero, so the natural-number presentation agrees with the source's `A_(d-2)`.
-/
structure DegreeTwoDerivation {R A : Type u} [CommRing R] [Ring A]
    [Algebra R A] (D : DividedPowerDGA R A) where
  toLinearMap : A →ₗ[R] A
  degree : ∀ {n : ℕ} {x : A}, x ∈ D.gradedAlgebra.component n →
    toLinearMap x ∈ D.gradedAlgebra.component (n - 2)
  low_degree : ∀ {n : ℕ} {x : A}, n < 2 →
    x ∈ D.gradedAlgebra.component n → toLinearMap x = 0
  leibniz : ∀ x y : A,
    toLinearMap (x * y) = toLinearMap x * y + x * toLinearMap y
  commutes_with_differential : ∀ x : A,
    toLinearMap (D.differential.d x) = D.differential.d (toLinearMap x)
  divided_power : ∀ (n d : ℕ) {x : A},
    x ∈ D.gradedAlgebra.component (2 * d) →
      toLinearMap (D.dividedPowers.dpow n x) =
        toLinearMap x * D.dividedPowers.dpow (n - 1) x

/-! ## Square-zero extensions and coefficient annihilators -/

/-- A square-zero surjection whose kernel is generated by one element.  The
annihilator field makes precise the coefficient ideal used by the source:
because the kernel is square-zero, the condition is independent of the
chosen lift of an element of `R`.
-/
structure SquareZeroPrincipalExtension (R R' : Type u)
    [CommRing R] [CommRing R'] where
  toRingHom : R' →+* R
  surjective : Function.Surjective toRingHom
  generator : R'
  kernel_generated : RingHom.ker toRingHom = Ideal.span ({generator} : Set R')
  kernel_square_zero : (RingHom.ker toRingHom) * (RingHom.ker toRingHom) = ⊥
  annihilator : Ideal R
  annihilator_iff : ∀ r : R, r ∈ annihilator ↔
    ∀ r' : R', toRingHom r' = r → r' * generator = 0

namespace SquareZeroPrincipalExtension

variable {R R' : Type u} [CommRing R] [CommRing R']

abbrev coefficientQuotient (E : SquareZeroPrincipalExtension R R') :=
  R ⧸ E.annihilator

end SquareZeroPrincipalExtension

/-! ## Quotient DGAs and the induced homology action -/

/- A quotient by the scalar ideal is represented by its universal quotient
model.  This keeps the source's general (possibly noncommutative) graded DGA
coefficient ring while recording the quotient's concrete DGA structure. -/
structure ScalarQuotientDGA {R A : Type u} [CommRing R] [Ring A]
    [Algebra R A] (D : DividedPowerDGA R A) (I : Ideal R) where
  Q : Type u
  [ringQ : Ring Q]
  [algebraQ : Algebra R Q]
  dga : DividedPowerDGA R Q
  quotient_map : A →ₐ[R] Q
  map_graded : ∀ {n : ℕ} {x : A},
    x ∈ D.gradedAlgebra.component n →
      quotient_map x ∈ dga.gradedAlgebra.component n
  map_differential : ∀ x : A,
    quotient_map (D.differential.d x) = dga.differential.d (quotient_map x)
  map_divided_powers : ∀ {n : ℕ} {x : A},
    D.gradedAlgebra.IsPositiveEven x →
      quotient_map (D.dividedPowers.dpow n x) =
        dga.dividedPowers.dpow n (quotient_map x)
  scalar_relations : ∀ r : R, r ∈ I →
    quotient_map (algebraMap R A r) = 0
  lift : ∀ {B : Type u} [Ring B] [Algebra R B]
    (f : A →ₐ[R] B),
    (∀ r : R, r ∈ I → f (algebraMap R A r) = 0) →
      ∃ u : Q →ₐ[R] B, f = u.comp quotient_map
  lift_unique : ∀ {B : Type u} [Ring B] [Algebra R B]
    (f : A →ₐ[R] B)
    (hf : ∀ r : R, r ∈ I → f (algebraMap R A r) = 0)
    (u v : Q →ₐ[R] B),
    f = u.comp quotient_map → f = v.comp quotient_map → u = v

attribute [instance] ScalarQuotientDGA.ringQ ScalarQuotientDGA.algebraQ

/-- The degree-two derivation construction in the quotient notation of the
source. -/
abbrev IsDegreeTwoDerivationOnScalarQuotient
    {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
    (D : DividedPowerDGA R A) (I : Ideal R)
    (Q : ScalarQuotientDGA D I)
    (θ : Q.Q →ₗ[R] Q.Q) : Prop :=
  ∃ δ : DegreeTwoDerivation Q.dga, δ.toLinearMap = θ

/-- A Tate-style quotient DGA supplies the induced degree-two map on homology.
The representative clause is the source's assertion that the homology action
is induced by applying `θ` to a cycle representative in positive degrees.
-/
theorem exists_degreeTwo_homology_action
    {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
    {D : DividedPowerDGA R A} {I : Ideal R}
    (Q : ScalarQuotientDGA (R := R) (A := A) D I)
    (θ : Q.Q →ₗ[R] Q.Q)
    (hθ : IsDegreeTwoDerivationOnScalarQuotient D I Q θ) :
    ∃ Φ : ∀ n : ℕ,
      DividedPowerDGA.homologyComponent Q.dga n →ₗ[R]
        DividedPowerDGA.homologyComponent Q.dga (n - 2),
      ∀ n : ℕ, 2 ≤ n → ∀ x : DividedPowerDGA.cycles Q.dga n,
        ∃ y : DividedPowerDGA.cycles Q.dga (n - 2),
          Φ n (Submodule.Quotient.mk x) = Submodule.Quotient.mk y ∧
            y.1 = θ x.1 := by
  sorry

/-- A chosen induced homology action of a degree-two derivation. -/
noncomputable def thetaOnHomology
    {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
    {D : DividedPowerDGA R A} {I : Ideal R}
    (Q : ScalarQuotientDGA D I)
    (θ : Q.Q →ₗ[R] Q.Q)
    (hθ : IsDegreeTwoDerivationOnScalarQuotient D I Q θ)
    (n : ℕ) : DividedPowerDGA.homologyComponent Q.dga n →ₗ[R]
      DividedPowerDGA.homologyComponent Q.dga (n - 2) :=
  (Classical.choose (exists_degreeTwo_homology_action Q θ hθ)) n

/-- Gulliksen's construction of the quotient DGA and its degree-two
derivation. -/
theorem exists_scalarQuotientDGA_degreeTwoDerivation
    {R R' A : Type u} [CommRing R] [CommRing R'] [Ring A]
    [Algebra R A]
    (E : SquareZeroPrincipalExtension R R')
    (D : DividedPowerDGA R A)
    (hpoly : IsGradedDividedPowerPolynomial D)
    (hfinite : IsFiniteInEachDegree D) :
    ∃ Q : ScalarQuotientDGA D E.annihilator,
      ∃ θ : Q.Q →ₗ[R] Q.Q,
        IsDegreeTwoDerivationOnScalarQuotient D E.annihilator Q θ := by
  sorry

/-! ## Polynomial presentations and the lifted relation -/

/-- The polynomial quotient occurring as `S` in the source. -/
structure PolynomialQuotientPresentation (R : Type u) [CommRing R] where
  numVariables : ℕ
  relationsCount : ℕ
  relations : Fin relationsCount → MvPolynomial (Fin numVariables) R

namespace PolynomialQuotientPresentation

variable {R : Type u} [CommRing R]

def relationIdeal (P : PolynomialQuotientPresentation R) :
    Ideal (MvPolynomial (Fin P.numVariables) R) :=
  Ideal.span (Set.range P.relations)

abbrev ring (P : PolynomialQuotientPresentation R) :=
  MvPolynomial (Fin P.numVariables) R ⧸ P.relationIdeal

def mapToRing (P : PolynomialQuotientPresentation R) :
    MvPolynomial (Fin P.numVariables) R →+* P.ring :=
  Ideal.Quotient.mk P.relationIdeal

def algebraMapToRing (P : PolynomialQuotientPresentation R) : R →+* P.ring :=
  algebraMap R P.ring

def classOf (P : PolynomialQuotientPresentation R)
    (g : MvPolynomial (Fin P.numVariables) R) : P.ring :=
  P.mapToRing g

def scalarIdeal (P : PolynomialQuotientPresentation R) (I : Ideal R) :
    Ideal P.ring :=
  Ideal.map (algebraMap R P.ring) I

def classModulo (P : PolynomialQuotientPresentation R) (I : Ideal R)
    (g : MvPolynomial (Fin P.numVariables) R) : P.ring ⧸ P.scalarIdeal I :=
  Ideal.Quotient.mk (P.scalarIdeal I) (P.classOf g)

end PolynomialQuotientPresentation

/-- The data in the displayed relation of the source.  The map of polynomial
coefficients is Mathlib's canonical `MvPolynomial.map`; all choices of lifts
and the identity `∑ r'_j f'_j = g f` are retained explicitly.
-/
structure LiftedPolynomialRelation
    {R R' : Type u} [CommRing R] [CommRing R']
    (E : SquareZeroPrincipalExtension R R')
    (P : PolynomialQuotientPresentation R) where
  coefficients : Fin P.relationsCount → MvPolynomial (Fin P.numVariables) R
  relation : ∑ j, coefficients j * P.relations j = 0
  liftedCoefficients :
    Fin P.relationsCount → MvPolynomial (Fin P.numVariables) R'
  liftedRelations : Fin P.relationsCount → MvPolynomial (Fin P.numVariables) R'
  coefficients_lift : ∀ j,
    MvPolynomial.map E.toRingHom (liftedCoefficients j) = coefficients j
  relations_lift : ∀ j,
    MvPolynomial.map E.toRingHom (liftedRelations j) = P.relations j
  g : MvPolynomial (Fin P.numVariables) R
  liftedG : MvPolynomial (Fin P.numVariables) R'
  g_lift : MvPolynomial.map E.toRingHom liftedG = g
  lifted_relation :
    ∑ j, liftedCoefficients j * liftedRelations j =
      MvPolynomial.C E.generator * liftedG
  coefficients_in_annihilator : ∀ j d,
    (coefficients j).coeff d ∈ E.annihilator

namespace LiftedPolynomialRelation

variable {R R' : Type u} [CommRing R] [CommRing R']
  {E : SquareZeroPrincipalExtension R R'}
  {P : PolynomialQuotientPresentation R}

def gModulo (L : LiftedPolynomialRelation E P) :
    P.ring ⧸ P.scalarIdeal E.annihilator :=
  P.classModulo E.annihilator L.g

end LiftedPolynomialRelation

/-! ## The theta calculation on homology -/

/-- A degree-two derivation on a homology algebra, where there is no
differential to record.  This is the interface used for the source identity
`theta^n(gamma_n(xi)) = g^n`.
-/
structure HomologyDegreeTwoDerivation
    {R H : Type u} [CommRing R] [Ring H] [Algebra R H]
    (G : GradedCommAlgebra R H) (γ : GradedDividedPowers G) where
  toLinearMap : H →ₗ[R] H
  degree : ∀ {n : ℕ} {x : H}, x ∈ G.component n →
    toLinearMap x ∈ G.component (n - 2)
  low_degree : ∀ {n : ℕ} {x : H}, n < 2 →
    x ∈ G.component n → toLinearMap x = 0
  leibniz : ∀ x y : H,
    toLinearMap (x * y) = toLinearMap x * y + x * toLinearMap y
  divided_power : ∀ (n d : ℕ) {x : H},
    x ∈ G.component (2 * d) →
      toLinearMap (γ.dpow n x) = toLinearMap x * γ.dpow (n - 1) x

/-- The iterated divided-power identity displayed in the proof of the
non-finite-Tor lemma. -/
theorem theta_iterate_gamma_eq_pow
    {R H : Type u} [CommRing R] [Ring H] [Algebra R H]
    {G : GradedCommAlgebra R H} {γ : GradedDividedPowers G}
    (θ : HomologyDegreeTwoDerivation G γ)
    {ξ g : H} (hξ : G.IsPositiveEven ξ)
    (hbase : θ.toLinearMap ξ = g) :
    ∀ n : ℕ, θ.toLinearMap^[n] (γ.dpow n ξ) = g ^ n := by
  sorry

/-- The homology calculation supplied by a scalar quotient of a Tate model.
It records the source identification of the quotient homology with Tor in
the even degrees.
-/
def IsTorModelInEvenDegrees
    {R A S T : Type u} [CommRing R] [Ring A] [CommRing S] [CommRing T]
    [Algebra R A] [Algebra R S] [Algebra R T]
    (D : DividedPowerDGA R A) : Prop :=
  ∀ n : ℕ, Nonempty
    (DividedPowerDGA.homologyComponent D (2 * n) ≃ₗ[R]
      DividedPowerDGA.torComponent R S T (2 * n))

/-- Gulliksen's theta-computation lemma.  The quotient homology degree zero
is identified with the displayed polynomial quotient modulo the annihilator.
-/
theorem exists_theta_homology_class
    {R R' A : Type u} [CommRing R] [CommRing R'] [Ring A]
    [Algebra R A]
    (E : SquareZeroPrincipalExtension R R')
    (D : DividedPowerDGA R A)
    (hpoly : IsGradedDividedPowerPolynomial D)
    (hfinite : IsFiniteInEachDegree D)
    (Q : ScalarQuotientDGA D E.annihilator)
    (θ : Q.Q →ₗ[R] Q.Q)
    (hθ : IsDegreeTwoDerivationOnScalarQuotient D E.annihilator Q θ)
    (P : PolynomialQuotientPresentation R)
    (L : LiftedPolynomialRelation E P)
    (hH₁ : Subsingleton (DividedPowerDGA.homologyComponent D 1))
    (hH₀ : Nonempty
      (P.ring ≃ₗ[R] DividedPowerDGA.homologyComponent D 0))
    (hquotH₀ : Nonempty
      ((P.ring ⧸ P.scalarIdeal E.annihilator) ≃ₗ[R]
        DividedPowerDGA.homologyComponent Q.dga 0)) :
    ∃ ξ : DividedPowerDGA.homologyComponent Q.dga 2,
      (Classical.choice hquotH₀).symm
          (thetaOnHomology Q θ hθ 2 ξ) = L.gModulo := by
  sorry

/-! ## Failure of finite Tor dimension -/

/-- The non-nilpotence hypothesis from Gulliksen's criterion. -/
def IsNonNilpotentInScalarQuotient
    {R R' : Type u} [CommRing R] [CommRing R']
    (E : SquareZeroPrincipalExtension R R')
    (P : PolynomialQuotientPresentation R)
    (L : LiftedPolynomialRelation E P) : Prop :=
  ¬ IsNilpotent L.gModulo

/-- A square-zero lifted relation with non-nilpotent `g` obstructs finite Tor
dimension, equivalently the perfectness predicate for the presented ring map.
-/
theorem not_perfect_of_squareZero_relation
    {R R' : Type u} [CommRing R] [CommRing R']
    [IsNoetherianRing R] [IsNoetherianRing R']
    (E : SquareZeroPrincipalExtension R R')
    (P : PolynomialQuotientPresentation R)
    (L : LiftedPolynomialRelation E P)
    (hg : IsNonNilpotentInScalarQuotient E P L) :
    ¬ IsPerfectRingMap P.algebraMapToRing := by
  sorry

/-! ## Local quotient Tor dimension and conormal maps -/

/-- The quotient map between two quotient rings induced by an inclusion of
ideals. -/
def quotientFactorRingHom {A : Type u} [CommRing A]
    (I J : Ideal A) (hIJ : I ≤ J) : A ⧸ I →+* A ⧸ J :=
  Ideal.Quotient.factor hIJ

/-- Finite Tor dimension of `A/J` over `A/I`, expressed using the project's
canonical module Tor-dimension predicate. -/
def QuotientHasFiniteTorDimension
    {A : Type u} [CommRing A] (I J : Ideal A)
    (hIJ : I ≤ J) : Prop :=
  ModuleHasFiniteTorDimension (A ⧸ I)
    ((ModuleCat.restrictScalars (quotientFactorRingHom I J hIJ)).obj
      (ModuleCat.of (A ⧸ J) (A ⧸ J)))

/-- The quotient of an ideal by a smaller ideal, as a module quotient of the
ideal subtype. -/
abbrev idealModuloIdeal {A : Type u} [CommRing A]
    (I K : Ideal A) (hKI : K ≤ I) : Type u :=
  ((I : Type u) ⧸ Submodule.comap I.subtype K)

/-- The map `I / K_I -> J / K_J` induced by `I ⊆ J`. -/
def idealModuloIdealMap {A : Type u} [CommRing A]
    (I J : Ideal A) (hIJ : I ≤ J)
    (KI KJ : Ideal A) (hKI : KI ≤ I) (hKJ : KJ ≤ J)
    (hKmap : KI ≤ KJ) :
    idealModuloIdeal I KI hKI →ₗ[A] idealModuloIdeal J KJ hKJ := by
  let f : I →ₗ[A] J :=
    { toFun := fun x => ⟨x.1, hIJ x.2⟩
      map_add' := by intro x y; rfl
      map_smul' := by intro r x; rfl }
  exact Submodule.mapQ (Submodule.comap I.subtype KI)
    (Submodule.comap J.subtype KJ) f (by
    intro x hx
    exact hKmap hx)

/-- The conormal map used in the local injectivity lemma. -/
def conormalMap {A : Type u} [CommRing A] [IsLocalRing A]
    (I J : Ideal A) (hIJ : I ≤ J) :
    idealModuloIdeal I (IsLocalRing.maximalIdeal A * I)
        (by exact Ideal.mul_le_left) →ₗ[A]
      idealModuloIdeal J (IsLocalRing.maximalIdeal A * J)
        (by exact Ideal.mul_le_left) :=
  idealModuloIdealMap I J hIJ
    (IsLocalRing.maximalIdeal A * I) (IsLocalRing.maximalIdeal A * J)
    Ideal.mul_le_left
    Ideal.mul_le_left
    (Ideal.mul_mono_right hIJ)

/-- Rodicio's local injectivity lemma. -/
theorem conormalMap_injective_of_finiteTorDimension
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I J : Ideal A) (hIJ : I ≤ J) (hIproper : I ≠ ⊤) (hJproper : J ≠ ⊤)
    (hfd : QuotientHasFiniteTorDimension I J hIJ) :
    Function.Injective (conormalMap I J hIJ) := by
  sorry

/-! ## Regular sequences and ideals -/

/-- An ideal is generated by a regular sequence in the source's sense. -/
def IsGeneratedByRegularSequence
    (A : Type u) [CommRing A] (I : Ideal A) : Prop :=
  ∃ f : List A, RingTheory.Sequence.IsRegular A f ∧ I = Ideal.ofList f

/-- The ideal `J/I` in the quotient ring `A/I`. -/
def quotientIdealOfIdeal {A : Type u} [CommRing A]
    (I J : Ideal A) (hIJ : I ≤ J) : Ideal (A ⧸ I) :=
  Ideal.map (Ideal.Quotient.mk I) J

/-- If `A/J` has finite Tor dimension over `A/I` and `J` is regular, then
both `I` and `J/I` are generated by regular sequences. -/
theorem regularSequence_generators_of_finiteTorDimension
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I J : Ideal A) (hIJ : I ≤ J) (hIproper : I ≠ ⊤) (hJproper : J ≠ ⊤)
    (hfd : QuotientHasFiniteTorDimension I J hIJ)
    (hJregular : IsGeneratedByRegularSequence A J) :
    IsGeneratedByRegularSequence A I ∧
      IsGeneratedByRegularSequence (A ⧸ I)
        (quotientIdealOfIdeal I J hIJ) := by
  sorry

/-! ## The perfect-map criterion -/

/-- The fiber of a local map over the source residue field. -/
abbrev residueFiber {R S : Type u} [CommRing R] [CommRing S]
    [IsLocalRing R]
    (f : R →+* S) :=
  S ⧸ Ideal.map f (IsLocalRing.maximalIdeal R)

/-- The quotient map `R/I -> S/J` associated to a ring map and an extended
ideal inclusion. -/
def quotientMapOfRingHom {R S : Type u} [CommRing R] [CommRing S]
    (f : R →+* S) (I : Ideal R) (J : Ideal S)
    (hISJ : Ideal.map f I ≤ J) : R ⧸ I →+* S ⧸ J :=
  Ideal.Quotient.lift I
    ((Ideal.Quotient.mk J).comp f) (by
      intro r hr
      apply (Ideal.Quotient.eq_zero_iff_mem).mpr
      exact hISJ (Ideal.mem_map_of_mem f hr))

/-- `S/J` viewed as an `R/I`-module. -/
def quotientModuleOfRingHom {R S : Type u} [CommRing R] [CommRing S]
    (f : R →+* S) (I : Ideal R) (J : Ideal S)
    (hISJ : Ideal.map f I ≤ J) : ModuleCat (R ⧸ I) :=
  (ModuleCat.restrictScalars (quotientMapOfRingHom f I J hISJ)).obj
    (ModuleCat.of (S ⧸ J) (S ⧸ J))

/-- Finite Tor dimension of `S/J` over `R/I` for the perfect-map criterion. -/
def quotientMapHasFiniteTorDimension
    {R S : Type u} [CommRing R] [CommRing S]
    (f : R →+* S) (I : Ideal R) (J : Ideal S)
    (hISJ : Ideal.map f I ≤ J) : Prop :=
  ModuleHasFiniteTorDimension (R ⧸ I)
    (quotientModuleOfRingHom f I J hISJ)

/-- The residue field module over `R/I`, for `I` contained in the maximal
ideal. -/
def residueModuleOverQuotient {R : Type u} [CommRing R] [IsLocalRing R]
    (I : Ideal R) (hIm : I ≤ IsLocalRing.maximalIdeal R) :
    ModuleCat (R ⧸ I) :=
  (ModuleCat.restrictScalars (Ideal.Quotient.factor hIm)).obj
    (ModuleCat.of (R ⧸ IsLocalRing.maximalIdeal R)
      (R ⧸ IsLocalRing.maximalIdeal R))

/-- The source's second condition: the relevant Tor groups vanish above a
finite degree. -/
def TorWithResidueVanishingAbove
    {R S : Type u} [CommRing R] [CommRing S] [IsLocalRing R]
    (f : R →+* S) (I : Ideal R) (J : Ideal S)
    (hISJ : Ideal.map f I ≤ J)
    (hIm : I ≤ IsLocalRing.maximalIdeal R) : Prop :=
  ∃ N : ℕ, ∀ p : ℕ, N < p →
    CategoryTheory.Limits.IsZero (Formalization.Books.Algebra.Unit75.Tor
      (quotientModuleOfRingHom f I J hISJ)
      (residueModuleOverQuotient I hIm) p)

/-- The three equivalent conditions in the final lemma of the source. -/
theorem perfectMap_completeIntersection_iff
    {R S : Type u} [CommRing R] [CommRing S]
    [IsNoetherianRing R] [IsNoetherianRing S]
    [IsLocalRing R] [IsLocalRing S]
    (f : R →+* S) (hlocal : IsLocalHom f) (hflat : RingHom.Flat f)
    (I : Ideal R) (J : Ideal S)
    (hISJ : Ideal.map f I ≤ J)
    [IsRegularLocalRing (residueFiber f)]
    (hIm : I ≤ IsLocalRing.maximalIdeal R) :
    List.TFAE
      [ IsGeneratedByRegularSequence S J ∧
          quotientMapHasFiniteTorDimension f I J hISJ,
        IsGeneratedByRegularSequence S J ∧
          TorWithResidueVanishingAbove f I J hISJ hIm,
        IsGeneratedByRegularSequence R I ∧
          IsGeneratedByRegularSequence (S ⧸ Ideal.map f I)
            (Ideal.map (Ideal.Quotient.mk (Ideal.map f I)) J) ] := by
  sorry

end

end Formalization.Books.Dpa.Unit07
