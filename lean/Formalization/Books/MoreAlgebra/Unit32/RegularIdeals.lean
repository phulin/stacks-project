import Formalization.Books.MoreAlgebra.Unit30.KoszulRegularSequences
import Mathlib.RingTheory.Finiteness.Ideal
import Mathlib.RingTheory.Ideal.Cotangent
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.RingHom.FaithfullyFlat
import Mathlib.RingTheory.Spectrum.Prime.Basic

/-!
# More on Algebra, Chapter 32: Regular ideals

The four ideal predicates are stated using the canonical spectrum, principal
localization, ideal-image, and finite-list regular-sequence APIs.  The
conormal module is Mathlib's `Ideal.Cotangent`, the canonical realization of
`I/I^2`.
-/

namespace Formalization.Books.MoreAlgebra.Unit32

open Formalization.Books.MoreAlgebra.Unit30
open Formalization.Books.Algebra.Unit69

noncomputable section

universe u v

/-! ## Local definitions of regular ideals -/

/-- An ideal is regular when it is locally generated by a regular sequence on
the vanishing locus of the ideal. -/
def IsRegularIdeal (R : Type u) [CommRing R] (I : Ideal R) : Prop :=
  ∀ p : PrimeSpectrum R,
    p ∈ PrimeSpectrum.zeroLocus (I : Set R) →
      ∃ g : R, g ∉ p.asIdeal ∧
        ∃ f : List (Localization.Away g),
          RingTheory.Sequence.IsRegular (Localization.Away g) f ∧
            Ideal.map (algebraMap R (Localization.Away g)) I =
              Ideal.ofList f

/-- An ideal is Koszul-regular when it is locally generated by a
Koszul-regular sequence on the vanishing locus of the ideal. -/
def IsKoszulRegularIdeal (R : Type u) [CommRing R] (I : Ideal R) : Prop :=
  ∀ p : PrimeSpectrum R,
    p ∈ PrimeSpectrum.zeroLocus (I : Set R) →
      ∃ g : R, g ∉ p.asIdeal ∧
        ∃ f : List (Localization.Away g),
          IsKoszulRegular (Localization.Away g) f ∧
            Ideal.map (algebraMap R (Localization.Away g)) I =
              Ideal.ofList f

/-- An ideal is `H₁`-regular when it is locally generated by an
`H₁`-regular sequence on the vanishing locus of the ideal. -/
def IsHOneRegularIdeal (R : Type u) [CommRing R] (I : Ideal R) : Prop :=
  ∀ p : PrimeSpectrum R,
    p ∈ PrimeSpectrum.zeroLocus (I : Set R) →
      ∃ g : R, g ∉ p.asIdeal ∧
        ∃ f : List (Localization.Away g),
          IsHOneRegular (Localization.Away g) f ∧
            Ideal.map (algebraMap R (Localization.Away g)) I =
              Ideal.ofList f

/-- An ideal is quasi-regular when it is locally generated by a
quasi-regular sequence on the vanishing locus of the ideal. -/
def IsQuasiRegularIdeal (R : Type u) [CommRing R] (I : Ideal R) : Prop :=
  ∀ p : PrimeSpectrum R,
    p ∈ PrimeSpectrum.zeroLocus (I : Set R) →
      ∃ g : R, g ∉ p.asIdeal ∧
        ∃ f : List (Localization.Away g),
          IsQuasiRegular (Localization.Away g) f ∧
            Ideal.map (algebraMap R (Localization.Away g)) I =
              Ideal.ofList f

/-! ## Comparison and finite generation -/

/-- Regular ideals are Koszul-regular. -/
theorem isKoszulRegularIdeal_of_isRegularIdeal
    (R : Type u) [CommRing R] (I : Ideal R) :
    IsRegularIdeal R I → IsKoszulRegularIdeal R I := by
  sorry

/-- Koszul-regular ideals are `H₁`-regular. -/
theorem isHOneRegularIdeal_of_isKoszulRegularIdeal
    (R : Type u) [CommRing R] (I : Ideal R) :
    IsKoszulRegularIdeal R I → IsHOneRegularIdeal R I := by
  sorry

/-- `H₁`-regular ideals are quasi-regular. -/
theorem isQuasiRegularIdeal_of_isHOneRegularIdeal
    (R : Type u) [CommRing R] (I : Ideal R) :
    IsHOneRegularIdeal R I → IsQuasiRegularIdeal R I := by
  sorry

/- The source's sentence that every ideal in the comparison chain is finitely
generated is covered for the stronger predicates by this implication chain. -/
/-- A quasi-regular ideal is finitely generated. -/
theorem quasiRegularIdeal_fg
    (R : Type u) [CommRing R] (I : Ideal R)
    (hI : IsQuasiRegularIdeal R I) :
    I.FG := by
  sorry

/-- For a quasi-regular ideal, the conormal module `I/I²` is finite
projective over `R/I`. -/
theorem quasiRegularIdeal_conormal_finite_projective
    (R : Type u) [CommRing R] (I : Ideal R)
    (hI : IsQuasiRegularIdeal R I) :
    Module.Finite (R ⧸ I) I.Cotangent ∧
      Module.Projective (R ⧸ I) I.Cotangent := by
  sorry

/-! ## Faithfully flat descent -/

/-- Koszul-regularity of ideals descends along faithfully flat ring maps. -/
theorem isKoszulRegularIdeal_of_faithfullyFlat
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    (f : A →+* B) (hff : RingHom.FaithfullyFlat f) (I : Ideal A) :
    IsKoszulRegularIdeal B (Ideal.map f I) → IsKoszulRegularIdeal A I := by
  sorry

/-- `H₁`-regularity of ideals descends along faithfully flat ring maps. -/
theorem isHOneRegularIdeal_of_faithfullyFlat
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    (f : A →+* B) (hff : RingHom.FaithfullyFlat f) (I : Ideal A) :
    IsHOneRegularIdeal B (Ideal.map f I) → IsHOneRegularIdeal A I := by
  sorry

/-- Quasi-regularity of ideals descends along faithfully flat ring maps. -/
theorem isQuasiRegularIdeal_of_faithfullyFlat
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    (f : A →+* B) (hff : RingHom.FaithfullyFlat f) (I : Ideal A) :
    IsQuasiRegularIdeal B (Ideal.map f I) → IsQuasiRegularIdeal A I := by
  sorry

/-! ## The conormal intersection identity -/

/-- If `J/I` is an `H₁`-regular ideal in `A/I`, then
`I ∩ J² = IJ`. -/
theorem ideal_inf_sq_eq_mul_of_isHOneRegularIdeal_quotient
    (A : Type u) [CommRing A] (I J : Ideal A) (hIJ : I ≤ J)
    (hJ : IsHOneRegularIdeal (A ⧸ I)
      (Ideal.map (Ideal.Quotient.mk I) J)) :
    I ⊓ J ^ 2 = I * J := by
  sorry

end

end Formalization.Books.MoreAlgebra.Unit32
