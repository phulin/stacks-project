end PreRelation

/-! ## Relative fppf reading and source-level aliases -/

variable {J : GrothendieckTopology C}
variable {B U R : AlgebraicSpace J}

/-- In the source, “surjective as a map of fppf sheaves” is the local
surjectivity predicate on the corresponding sheaf morphism. -/
abbrev IsFppfSheafSurjective {X Y : AlgebraicSpace J} (f : X ⟶ Y) : Prop :=
  Presheaf.IsLocallySurjective J f.hom

/-- A groupoid's quotient declarations use the same quotient construction;
the groupoid supplies its underlying pre-relation `j = (target, source)`. -/
def GroupoidHasRepresentableQuotient (P : PreRelation J B U R)
    [J.Subcanonical] : Prop :=
  P.HasRepresentableQuotient

