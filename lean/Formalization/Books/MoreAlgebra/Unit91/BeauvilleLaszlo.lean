theorem isGlueingPair_iff_fPowerTorsion_bijective
    {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : R) :
    IsGlueingPair φ f ↔ BijectiveOnFPowerTorsion φ f := by
