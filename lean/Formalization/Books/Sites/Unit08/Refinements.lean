import Formalization.Books.Sites.Unit07.Sheaves
import Mathlib.CategoryTheory.Limits.Shapes.Pullback.HasPullback

/-!
# Sites and Sheaves, Chapter 8: Families of morphisms with fixed target

This file formalizes the source section `Families of morphisms with fixed
target`.  Mathlib's `Presieve` remains the canonical site interface from the
preceding chapters.  The indexed-family structures below retain the source's
indexing data when discussing refinements and tautological equivalence, and
their associated presieves connect those discussions to Mathlib's sheaf API.
-/

namespace Formalization.Books.Sites.Unit08

open CategoryTheory CategoryTheory.Limits CategoryTheory.Presieve
open Formalization.Books.Sites.Unit02
open Formalization.Books.Sites.Unit06
open Formalization.Books.Sites.Unit07
open Opposite

universe u v w

variable {C : Type u} [Category.{v} C]

/-! ## Families and morphisms of families -/

/-- An indexed family of morphisms with fixed target `U`. -/
structure IndexedFamily (C : Type u) [Category.{v} C] (U : C) where
  index : Type w
  domain : index → C
  map : ∀ i, domain i ⟶ U

/-- The arrow of `C` represented by a member of an indexed family. -/
def IndexedFamily.arrow {U : C} (𝒰 : IndexedFamily C U) (i : 𝒰.index) :
    Σ V : C, V ⟶ U :=
  ⟨𝒰.domain i, 𝒰.map i⟩

/-- The presieve generated by an indexed family. -/
def IndexedFamily.presieve {U : C} (𝒰 : IndexedFamily C U) :
    FamilyOfMorphisms U :=
  Presieve.ofArrows 𝒰.domain 𝒰.map

/-- A morphism of indexed families, including its map on targets. -/
structure MorphismOfFamilies {U V : C}
    (𝒰 : IndexedFamily C U) (𝒱 : IndexedFamily C V) where
  base : U ⟶ V
  indexMap : 𝒰.index → 𝒱.index
  lift : ∀ i, 𝒰.domain i ⟶ 𝒱.domain (indexMap i)
  comm : ∀ i, lift i ≫ 𝒱.map (indexMap i) = 𝒰.map i ≫ base

/-- Refinement is a morphism of families whose map on the fixed target is the
identity. -/
def IsRefinement {U : C} (𝒰 𝒱 : IndexedFamily C U) : Prop :=
  ∃ m : MorphismOfFamilies 𝒰 𝒱, m.base = 𝟙 U

/-- A family with a nonempty index cannot refine an empty family. -/
theorem nonempty_family_not_refines_empty_family {U : C}
    {𝒰 𝒱 : IndexedFamily C U} (h𝒰 : Nonempty 𝒰.index)
    (h𝒱 : IsEmpty 𝒱.index) :
    ¬ IsRefinement 𝒰 𝒱 := by
  sorry

/-! ## Combinatorial and tautological equivalence -/

/-- Two families with the same target are combinatorially equivalent when they
have the same arrows after reindexing in both directions. -/
def CombinatoriallyEquivalent {U : C}
    (𝒰 𝒱 : IndexedFamily C U) : Prop :=
  ∃ (α : 𝒰.index → 𝒱.index) (β : 𝒱.index → 𝒰.index),
    (∀ i, 𝒰.arrow i = 𝒱.arrow (α i)) ∧
      ∀ j, 𝒱.arrow j = 𝒰.arrow (β j)

/-- Data witnessing the two families' isomorphisms over their fixed target. -/
structure TautologicalWitness {U : C}
    (𝒰 𝒱 : IndexedFamily C U) where
  forwardIndex : 𝒰.index → 𝒱.index
  backwardIndex : 𝒱.index → 𝒰.index
  forwardIso : ∀ i, 𝒰.domain i ≅ 𝒱.domain (forwardIndex i)
  backwardIso : ∀ j, 𝒱.domain j ≅ 𝒰.domain (backwardIndex j)
  forward_comm : ∀ i,
    (forwardIso i).hom ≫ 𝒱.map (forwardIndex i) = 𝒰.map i
  backward_comm : ∀ j,
    (backwardIso j).hom ≫ 𝒰.map (backwardIndex j) = 𝒱.map j

/-- Two families are tautologically equivalent when they admit the source's
two reindexings by isomorphisms over the target. -/
def TautologicallyEquivalent {U : C}
    (𝒰 𝒱 : IndexedFamily C U) : Prop :=
  Nonempty (TautologicalWitness 𝒰 𝒱)

/-- Combinatorial equivalence gives tautological equivalence by using identity
isomorphisms after reindexing. -/
theorem combinatoriallyEquivalent_tautologicallyEquivalent {U : C}
    {𝒰 𝒱 : IndexedFamily C U}
    (h : CombinatoriallyEquivalent 𝒰 𝒱) :
    TautologicallyEquivalent 𝒰 𝒱 := by
  sorry

/-- A tautological equivalence supplies a refinement in either direction. -/
theorem tautologicallyEquivalent_isRefinement {U : C}
    {𝒰 𝒱 : IndexedFamily C U}
    (h : TautologicallyEquivalent 𝒰 𝒱) :
    IsRefinement 𝒰 𝒱 ∧ IsRefinement 𝒱 𝒰 := by
  sorry

/-- Combinatorial equivalence is an equivalence relation on indexed families
with a fixed target. -/
theorem combinatoriallyEquivalent_equivalence (U : C) :
    Equivalence (fun (𝒰 𝒱 : IndexedFamily C U) =>
      CombinatoriallyEquivalent 𝒰 𝒱) := by
  sorry

/-- Tautological equivalence is an equivalence relation on indexed families
with a fixed target. -/
theorem tautologicallyEquivalent_equivalence (U : C) :
    Equivalence (fun (𝒰 𝒱 : IndexedFamily C U) =>
      TautologicallyEquivalent 𝒰 𝒱) := by
  sorry

/-- Mutual refinement is an equivalence relation on indexed families with a
fixed target. -/
def MutuallyRefine {U : C} (𝒰 𝒱 : IndexedFamily C U) : Prop :=
  IsRefinement 𝒰 𝒱 ∧ IsRefinement 𝒱 𝒰

theorem mutuallyRefine_equivalence (U : C) :
    Equivalence (fun (𝒰 𝒱 : IndexedFamily C U) => MutuallyRefine 𝒰 𝒱) := by
  sorry

/-! ## Sheaf conditions for indexed families -/

/-- The sheaf condition for a presheaf with respect to an indexed family,
expressed through the generated presieve and Mathlib's canonical API. -/
def HasSheafCondition {U : C} (F : Presheaf C)
    (𝒰 : IndexedFamily C U) : Prop :=
  IsSheafFor F 𝒰.presieve

/-- A chosen system of fiber products for two indexed families over one
target.  The `isLimit` field records the universal property, so this is a
choice of genuine fiber products rather than merely a choice of cones. -/
structure PullbackSystem {U : C}
    (𝒰 𝒱 : IndexedFamily C U) where
  object : ∀ _i _j, C
  fst : ∀ i j, object i j ⟶ 𝒰.domain i
  snd : ∀ i j, object i j ⟶ 𝒱.domain j
  condition : ∀ i j, fst i j ≫ 𝒰.map i = snd i j ≫ 𝒱.map j
  isLimit : ∀ i j,
    IsLimit (PullbackCone.mk (fst i j) (snd i j) (condition i j))

/-- Existence of all pairwise fiber products for one family. -/
def HasPairwisePullbacks {U : C} (𝒰 : IndexedFamily C U) : Prop :=
  Nonempty (PullbackSystem 𝒰 𝒰)

/-- Existence of all fiber products between two families over their common
target. -/
def HasCrossPullbacks {U : C}
    (𝒰 𝒱 : IndexedFamily C U) : Prop :=
  Nonempty (PullbackSystem 𝒰 𝒱)

/-- The restriction map used in the source's separatedness hypothesis,
relative to a chosen system of fiber products. -/
def crossRestrictionMap {U : C} (F : Presheaf C)
    {𝒰 𝒱 : IndexedFamily C U} (P : PullbackSystem 𝒰 𝒱) (i : 𝒰.index) :
    F.obj (op (𝒰.domain i)) →
      ∀ j, F.obj (op (P.object i j)) :=
  fun s j => F.map (P.fst i j).op s

/-- The source's injectivity condition on every `U_i` after restriction to
the family of fiber products `U_i ×_U V_j`. -/
def CrossRestrictionInjective {U : C} (F : Presheaf C)
    {𝒰 𝒱 : IndexedFamily C U} (P : PullbackSystem 𝒰 𝒱) : Prop :=
  ∀ i, Function.Injective (crossRestrictionMap F P i)

/-- Tautologically equivalent families impose equivalent sheaf conditions. -/
theorem tautologicallyEquivalent_same_sheaf_condition {U : C}
    {𝒰 𝒱 : IndexedFamily C U}
    (hU : HasPairwisePullbacks 𝒰) (hV : HasPairwisePullbacks 𝒱)
    (h : TautologicallyEquivalent 𝒰 𝒱) (F : Presheaf C) :
    HasSheafCondition F 𝒰 ↔ HasSheafCondition F 𝒱 := by
  sorry

/-! ## Comparison under a refinement -/

/-- Restriction of sections along all arrows in an indexed family. -/
def restrictionMap {U : C} (F : Presheaf C)
    (𝒰 : IndexedFamily C U) :
    F.obj (op U) → ∀ i, F.obj (op (𝒰.domain i)) :=
  fun s i => F.map (𝒰.map i).op s

/-- If a refinement detects equality of sections, then the original family
does so as well. -/
theorem compare_separated_presheaf_condition {U : C}
    {𝒱 𝒰 : IndexedFamily C U} (m : MorphismOfFamilies 𝒱 𝒰)
    (hm : m.base = 𝟙 U) (F : Presheaf C)
    (h : Function.Injective (restrictionMap F 𝒱)) :
    Function.Injective (restrictionMap F 𝒰) := by
  sorry

/-- A sheaf condition descends from a refinement under the source's
fiber-product and local-separatedness hypotheses. -/
theorem compare_sheaf_condition {U : C}
    {𝒱 𝒰 : IndexedFamily C U} (m : MorphismOfFamilies 𝒱 𝒰)
    (hm : m.base = 𝟙 U) (F : Presheaf C)
    (hUU : HasPairwisePullbacks 𝒰)
    (hUV : HasCrossPullbacks 𝒰 𝒱)
    (hVV : HasPairwisePullbacks 𝒱)
    (P : PullbackSystem 𝒰 𝒱)
    (hP : CrossRestrictionInjective F P)
    (hF : HasSheafCondition F 𝒱) :
    HasSheafCondition F 𝒰 := by
  sorry

/-! ## Coverage systems and comparison of sites -/

variable [HasPullbacks C]

/-- A family-indexed covering system.  Its fiber-product and transitivity
axioms are supplied by `IsSiteCoverage`; the definition keeps the indexed
families visible as in the source. -/
abbrev IndexedCoverage (C : Type u) [Category.{v} C] :=
  ∀ U : C, Set (IndexedFamily C U)

/-- A canonical Mathlib site realizes an indexed covering system when its
covering presieves are exactly the presieves generated by that system. -/
def IsSiteCoverage [HasPullbacks C] (Cov : IndexedCoverage C) : Prop :=
  ∃ J : Site C, ∀ (U : C) (𝒰 : IndexedFamily C U),
    𝒰 ∈ Cov U ↔ 𝒰.presieve ∈ coverings J U

/-- Set-valued sheaves for an indexed covering system. -/
def IsSheafForCoverage (Cov : IndexedCoverage C) (F : Presheaf C) : Prop :=
  ∀ (U : C) (𝒰 : IndexedFamily C U), 𝒰 ∈ Cov U → HasSheafCondition F 𝒰

/-- The full subcategory of presheaves satisfying an indexed covering
system's sheaf conditions. -/
abbrev SheavesForCoverage (Cov : IndexedCoverage C) :=
  ObjectProperty.FullSubcategory (IsSheafForCoverage Cov : Presheaf C → Prop)

/-- Every covering family in one system has a tautologically equivalent
covering family in a second system. -/
def TautologicalCoveringComparison (Cov₁ Cov₂ : IndexedCoverage C) : Prop :=
  ∀ (U : C) (𝒰 : IndexedFamily C U), 𝒰 ∈ Cov₁ U →
    ∃ 𝒱 : IndexedFamily C U, 𝒱 ∈ Cov₂ U ∧
      TautologicallyEquivalent 𝒰 𝒱

/-- The tautological comparison in the source gives inclusion of sheaf
categories. -/
theorem refine_same_topology_tautological
    (Cov₁ Cov₂ : IndexedCoverage C)
    (h₁ : IsSiteCoverage Cov₁) (h₂ : IsSiteCoverage Cov₂)
    (h : TautologicalCoveringComparison Cov₁ Cov₂)
    (F : Presheaf C) :
    IsSheafForCoverage Cov₂ F → IsSheafForCoverage Cov₁ F := by
  sorry

/-- Every covering family in one system has a refinement in a second system. -/
def RefiningCoveringComparison (Cov₁ Cov₂ : IndexedCoverage C) : Prop :=
  ∀ (U : C) (𝒰 : IndexedFamily C U), 𝒰 ∈ Cov₁ U →
    ∃ 𝒱 : IndexedFamily C U, 𝒱 ∈ Cov₂ U ∧ IsRefinement 𝒱 𝒰

/-- A refining covering comparison gives the corresponding inclusion of
sheaf categories. -/
theorem refine_same_topology_refinement
    (Cov₁ Cov₂ : IndexedCoverage C)
    (h₁ : IsSiteCoverage Cov₁) (h₂ : IsSiteCoverage Cov₂)
    (h : RefiningCoveringComparison Cov₁ Cov₂)
    (F : Presheaf C) :
    IsSheafForCoverage Cov₂ F → IsSheafForCoverage Cov₁ F := by
  sorry

/-- Two-way tautological comparisons identify the associated sheaf
predicates. -/
theorem refine_same_topology_tautological_iff
    (Cov₁ Cov₂ : IndexedCoverage C)
    (h₁ : IsSiteCoverage Cov₁) (h₂ : IsSiteCoverage Cov₂)
    (h12 : TautologicalCoveringComparison Cov₁ Cov₂)
    (h21 : TautologicalCoveringComparison Cov₂ Cov₁)
    (F : Presheaf C) :
    IsSheafForCoverage Cov₁ F ↔ IsSheafForCoverage Cov₂ F := by
  sorry

/-- Two-way refinement comparisons identify the associated sheaf predicates. -/
theorem refine_same_topology_refinement_iff
    (Cov₁ Cov₂ : IndexedCoverage C)
    (h₁ : IsSiteCoverage Cov₁) (h₂ : IsSiteCoverage Cov₂)
    (h12 : RefiningCoveringComparison Cov₁ Cov₂)
    (h21 : RefiningCoveringComparison Cov₂ Cov₁)
    (F : Presheaf C) :
    IsSheafForCoverage Cov₁ F ↔ IsSheafForCoverage Cov₂ F := by
  sorry

/-- The associated full subcategories are equal when the two sheaf
predicates are equal pointwise. -/
theorem sheavesForCoverage_eq_of_iff
    (Cov₁ Cov₂ : IndexedCoverage C)
    (h : ∀ F : Presheaf C,
      IsSheafForCoverage Cov₁ F ↔ IsSheafForCoverage Cov₂ F) :
    SheavesForCoverage Cov₁ = SheavesForCoverage Cov₂ := by
  sorry

/-! ## Choice of representatives -/

/-- Every family in an ambient covering system has a combinatorially
equivalent representative in a chosen sub-system. -/
def HasCombinatorialRepresentatives
    (Cov Cov' : IndexedCoverage C) : Prop :=
  ∀ (U : C) (𝒰 : IndexedFamily C U), 𝒰 ∈ Cov U →
    ∃ 𝒱 : IndexedFamily C U, 𝒱 ∈ Cov' U ∧
      CombinatoriallyEquivalent 𝒰 𝒱

/-- If two site covering systems contain combinatorially equivalent
representatives of every ambient covering, their sheaf predicates agree. -/
theorem choice_of_coverings_immaterial
    (Cov Cov₁ Cov₂ : IndexedCoverage C)
    (hCov : IsSiteCoverage Cov) (h₁ : IsSiteCoverage Cov₁)
    (h₂ : IsSiteCoverage Cov₂)
    (hCov₁ : HasCombinatorialRepresentatives Cov Cov₁)
    (hCov₂ : HasCombinatorialRepresentatives Cov Cov₂)
    (F : Presheaf C) :
    IsSheafForCoverage Cov₁ F ↔ IsSheafForCoverage Cov₂ F := by
  sorry

end Formalization.Books.Sites.Unit08
