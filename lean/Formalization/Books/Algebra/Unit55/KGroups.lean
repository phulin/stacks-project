import Formalization.Books.Algebra.Unit52.Length
import Formalization.Books.Algebra.Unit53.ArtinianRings
import Mathlib.Algebra.Colimit.Module
import Mathlib.Algebra.Module.Projective
import Mathlib.Algebra.Polynomial.Eval.Algebra
import Mathlib.GroupTheory.Congruence.Hom
import Mathlib.GroupTheory.FreeAbelianGroup
import Mathlib.RingTheory.EuclideanDomain
import Mathlib.RingTheory.Finiteness.Cardinality

/-!
# Commutative Algebra, Chapter 55: K-groups

The two Grothendieck groups in this chapter are presented using finite
quotients of finite free modules.  This is the set-sized version of the
book's presentation by all finite modules.
-/

namespace Formalization.Books.Algebra.Unit55

open scoped BigOperators

universe u v

noncomputable section

/-- A finite presentation of a finite module by a quotient of a finite free
module. -/
structure FiniteModulePresentation (R : Type u) [CommRing R] where
  rank : ℕ
  relations : Submodule R (Fin rank → R)

namespace FiniteModulePresentation

variable {R : Type u} [CommRing R]

/-- The module represented by a finite presentation. -/
abbrev module (P : FiniteModulePresentation R) : Type u :=
  (Fin P.rank → R) ⧸ P.relations

instance finite (P : FiniteModulePresentation R) :
    Module.Finite R P.module := by
  infer_instance

end FiniteModulePresentation

/-- Every finite module has one of the finite presentations used below. -/
theorem exists_finite_module_presentation
    {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] [Module.Finite R M] :
    ∃ P : FiniteModulePresentation R, Nonempty (P.module ≃ₗ[R] M) := by
  rcases Module.Finite.exists_fin_quot_equiv R M with ⟨n, K, ⟨e⟩⟩
  exact ⟨⟨n, K⟩, ⟨e⟩⟩

/-- A short exact sequence of finite modules, with all three terms given by
finite presentations. -/
structure FiniteModuleShortExact (R : Type u) [CommRing R] where
  left : FiniteModulePresentation R
  middle : FiniteModulePresentation R
  right : FiniteModulePresentation R
  leftToMiddle : left.module →ₗ[R] middle.module
  middleToRight : middle.module →ₗ[R] right.module
  left_injective : Function.Injective leftToMiddle
  middle_surjective : Function.Surjective middleToRight
  exact : Function.Exact leftToMiddle middleToRight

abbrev KPrimeZeroFree (R : Type u) [CommRing R] :=
  FreeAbelianGroup (FiniteModulePresentation R)

/-- The generator corresponding to a finite module presentation. -/
def kPrimeZeroGenerator
    {R : Type u} [CommRing R] (P : FiniteModulePresentation R) :
    KPrimeZeroFree R :=
  FreeAbelianGroup.of P

/-- The elementary exact-sequence relation in the free group on finite
presentations. -/
def kPrimeZeroRelation
    {R : Type u} [CommRing R] (S : FiniteModuleShortExact R)
    (x y : KPrimeZeroFree R) : Prop :=
  x = kPrimeZeroGenerator S.middle ∧
    y = kPrimeZeroGenerator S.left + kPrimeZeroGenerator S.right

/-- The congruence generated by all exact-sequence relations. -/
def kPrimeZeroCon (R : Type u) [CommRing R] : AddCon (KPrimeZeroFree R) :=
  addConGen (fun x y => ∃ S : FiniteModuleShortExact R,
    kPrimeZeroRelation S x y)

/-- The K′₀ group.  The quotient is a set-sized model for the book's group
generated by classes of all finite modules. -/
abbrev KPrimeZero (R : Type u) [CommRing R] :=
  (kPrimeZeroCon R).Quotient

/-- The class of a chosen finite-module presentation. -/
def kPrimeZeroClassOfPresentation
    {R : Type u} [CommRing R] (P : FiniteModulePresentation R) :
    KPrimeZero R :=
  (kPrimeZeroCon R).mk' (kPrimeZeroGenerator P)

/-- The class of an arbitrary finite module, using a chosen finite
presentation. -/
noncomputable def kPrimeZeroClass
    {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] [Module.Finite R M] :
    KPrimeZero R :=
  let P := Classical.choose
    (exists_finite_module_presentation (R := R) (M := M))
  kPrimeZeroClassOfPresentation P

private theorem kPrimeZeroClassOfPresentation_eq_of_linearEquiv
    {R : Type u} [CommRing R]
    (P Q : FiniteModulePresentation R) (ePQ : P.module ≃ₗ[R] Q.module) :
    kPrimeZeroClassOfPresentation P =
      kPrimeZeroClassOfPresentation Q := by
  let Z : FiniteModulePresentation R := ⟨0, ⊥⟩
  let S : FiniteModuleShortExact R :=
    { left := P
      middle := Q
      right := Z
      leftToMiddle := ePQ.toLinearMap
      middleToRight := 0
      left_injective := ePQ.injective
      middle_surjective := by
        intro z
        exact ⟨0, Subsingleton.elim _ _⟩
      exact :=
        (LinearMap.exact_zero_iff_surjective Z.module ePQ.toLinearMap).2
          ePQ.surjective }
  have hrel : kPrimeZeroCon R
      (kPrimeZeroGenerator Q)
      (kPrimeZeroGenerator P + kPrimeZeroGenerator Z) := by
    change AddConGen.Rel
      (fun x y : KPrimeZeroFree R =>
        ∃ S : FiniteModuleShortExact R, kPrimeZeroRelation S x y)
      (kPrimeZeroGenerator Q)
      (kPrimeZeroGenerator P + kPrimeZeroGenerator Z)
    exact AddConGen.Rel.of _ _ ⟨S, rfl, rfl⟩
  have hq :
      kPrimeZeroClassOfPresentation Q =
        kPrimeZeroClassOfPresentation P +
          kPrimeZeroClassOfPresentation Z := by
    change (kPrimeZeroGenerator Q : KPrimeZero R) =
      (kPrimeZeroGenerator P + kPrimeZeroGenerator Z : KPrimeZero R)
    exact (kPrimeZeroCon R).eq.mpr hrel
  let T : FiniteModuleShortExact R :=
    { left := Z
      middle := Z
      right := Z
      leftToMiddle := 0
      middleToRight := 0
      left_injective := by
        intro z₁ z₂ _
        exact Subsingleton.elim _ _
      middle_surjective := by
        intro z
        exact ⟨0, Subsingleton.elim _ _⟩
      exact :=
        (LinearMap.exact_zero_iff_surjective Z.module
          (0 : Z.module →ₗ[R] Z.module)).2 (by
            intro z
            exact ⟨0, Subsingleton.elim _ _⟩) }
  have hrelZ : kPrimeZeroCon R
      (kPrimeZeroGenerator Z)
      (kPrimeZeroGenerator Z + kPrimeZeroGenerator Z) := by
    change AddConGen.Rel
      (fun x y : KPrimeZeroFree R =>
        ∃ S : FiniteModuleShortExact R, kPrimeZeroRelation S x y)
      (kPrimeZeroGenerator Z)
      (kPrimeZeroGenerator Z + kPrimeZeroGenerator Z)
    exact AddConGen.Rel.of _ _ ⟨T, rfl, rfl⟩
  have hqZ :
      kPrimeZeroClassOfPresentation Z =
        kPrimeZeroClassOfPresentation Z +
          kPrimeZeroClassOfPresentation Z := by
    change (kPrimeZeroGenerator Z : KPrimeZero R) =
      (kPrimeZeroGenerator Z + kPrimeZeroGenerator Z : KPrimeZero R)
    exact (kPrimeZeroCon R).eq.mpr hrelZ
  have hzero : kPrimeZeroClassOfPresentation Z = 0 := by
    have hqZ' :
        kPrimeZeroClassOfPresentation Z +
            kPrimeZeroClassOfPresentation Z =
          kPrimeZeroClassOfPresentation Z := hqZ.symm
    calc
      kPrimeZeroClassOfPresentation Z =
          kPrimeZeroClassOfPresentation Z + 0 := (add_zero _).symm
      _ = kPrimeZeroClassOfPresentation Z +
            (kPrimeZeroClassOfPresentation Z -
              kPrimeZeroClassOfPresentation Z) := by
            rw [sub_self, add_zero]
      _ = (kPrimeZeroClassOfPresentation Z +
            kPrimeZeroClassOfPresentation Z) -
            kPrimeZeroClassOfPresentation Z := by abel
      _ = kPrimeZeroClassOfPresentation Z -
            kPrimeZeroClassOfPresentation Z := by rw [hqZ']
      _ = 0 := sub_self _
  rw [hq, hzero, add_zero]

/-- The chosen presentation does not affect the class, up to the
linear-equivalence invariance supplied by the exact-sequence relations. -/
theorem kPrimeZeroClass_eq_of_linearEquiv
    {R : Type u} [CommRing R] {M N : Type v}
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N]
    (e : M ≃ₗ[R] N) :
    kPrimeZeroClass (R := R) (M := M) =
      kPrimeZeroClass (R := R) (M := N) := by
  let P := Classical.choose
    (exists_finite_module_presentation (R := R) (M := M))
  let Q := Classical.choose
    (exists_finite_module_presentation (R := R) (M := N))
  let eP := Classical.choice
    (Classical.choose_spec
      (exists_finite_module_presentation (R := R) (M := M)))
  let eQ := Classical.choice
    (Classical.choose_spec
      (exists_finite_module_presentation (R := R) (M := N)))
  let ePQ : P.module ≃ₗ[R] Q.module :=
    eP.trans (e.trans eQ.symm)
  exact kPrimeZeroClassOfPresentation_eq_of_linearEquiv P Q ePQ

/-- Every class in K′₀ is an integer linear combination of module classes.
The definition of the relation congruence records that the only imposed
relations are the exact-sequence relations. -/
theorem kPrimeZero_generated
    {R : Type u} [CommRing R] (x : KPrimeZero R) :
    ∃ n : ℕ, ∃ P : Fin n → FiniteModulePresentation R,
      ∃ z : Fin n → ℤ,
        x = ∑ i, z i • kPrimeZeroClassOfPresentation (P i) := by
  refine AddCon.induction_on x ?_
  intro y
  induction y using FreeAbelianGroup.induction_on with
  | zero =>
      refine ⟨0, (fun i => Fin.elim0 i), (fun i => Fin.elim0 i), ?_⟩
      simp [kPrimeZeroClassOfPresentation]
  | of P =>
      refine ⟨1, (fun _ => P), (fun _ => 1), ?_⟩
      simp only [Fin.sum_univ_one, one_smul]
      exact (kPrimeZeroCon R).eq.mpr
        ((kPrimeZeroCon R).refl (FreeAbelianGroup.of P))
  | neg P ih =>
      refine ⟨1, (fun _ => P), (fun _ => -1), ?_⟩
      change (-(FreeAbelianGroup.of P) : KPrimeZero R) = _
      simp [kPrimeZeroClassOfPresentation, kPrimeZeroGenerator]
  | add y z ihy ihz =>
      rcases ihy with ⟨n, P, a, hP⟩
      rcases ihz with ⟨m, Q, b, hQ⟩
      refine ⟨n + m, Fin.addCases P Q, Fin.addCases a b, ?_⟩
      change (y : KPrimeZero R) + (z : KPrimeZero R) = _
      rw [hP, hQ]
      simp [Fin.sum_univ_add]

/-- The exact-sequence relation for the classes of arbitrary finite modules. -/
theorem kPrimeZeroClass_exact
    {R : Type u} [CommRing R] {M' M M'' : Type v}
    [AddCommGroup M'] [Module R M'] [Module.Finite R M']
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup M''] [Module R M''] [Module.Finite R M'']
    (f : M' →ₗ[R] M) (g : M →ₗ[R] M'')
    (hf : Function.Injective f) (hg : Function.Surjective g)
    (hfg : Function.Exact f g) :
    kPrimeZeroClass (R := R) (M := M) =
      kPrimeZeroClass (R := R) (M := M') +
        kPrimeZeroClass (R := R) (M := M'') := by
  let P' := Classical.choose
    (exists_finite_module_presentation (R := R) (M := M'))
  let P := Classical.choose
    (exists_finite_module_presentation (R := R) (M := M))
  let P'' := Classical.choose
    (exists_finite_module_presentation (R := R) (M := M''))
  let eP' := Classical.choice
    (Classical.choose_spec
      (exists_finite_module_presentation (R := R) (M := M')))
  let eP := Classical.choice
    (Classical.choose_spec
      (exists_finite_module_presentation (R := R) (M := M)))
  let eP'' := Classical.choice
    (Classical.choose_spec
      (exists_finite_module_presentation (R := R) (M := M'')))
  let f' : P'.module →ₗ[R] P.module :=
    eP.symm.toLinearMap.comp (f.comp eP'.toLinearMap)
  let g' : P.module →ₗ[R] P''.module :=
    eP''.symm.toLinearMap.comp (g.comp eP.toLinearMap)
  have hf' : Function.Injective f' := by
    intro x y hxy
    apply eP'.injective
    apply hf
    simpa [f'] using congrArg (fun t => eP t) hxy
  have hg' : Function.Surjective g' := by
    intro y
    obtain ⟨x, hx⟩ := hg (eP'' y)
    refine ⟨eP.symm x, ?_⟩
    simpa [g'] using congrArg (fun t => eP''.symm t) hx
  have hcomm₁₂ :
      f'.comp eP'.symm.toLinearMap =
        eP.symm.toLinearMap.comp f := by
    ext x
    simp [f']
  have hcomm₂₃ :
      g'.comp eP.symm.toLinearMap =
        eP''.symm.toLinearMap.comp g := by
    ext x
    simp [g']
  have hfg' : Function.Exact f' g' :=
    (LinearMap.exact_iff_of_surjective_of_bijective_of_injective
      f g f' g' eP'.symm.toLinearMap eP.symm.toLinearMap
      eP''.symm.toLinearMap hcomm₁₂ hcomm₂₃ eP'.symm.surjective
      ⟨eP.symm.injective, eP.symm.surjective⟩ eP''.symm.injective).mp hfg
  let S : FiniteModuleShortExact R :=
    { left := P'
      middle := P
      right := P''
      leftToMiddle := f'
      middleToRight := g'
      left_injective := hf'
      middle_surjective := hg'
      exact := hfg' }
  have hrel : kPrimeZeroCon R
      (kPrimeZeroGenerator P)
      (kPrimeZeroGenerator P' + kPrimeZeroGenerator P'') := by
    change AddConGen.Rel
      (fun x y : KPrimeZeroFree R =>
        ∃ S : FiniteModuleShortExact R, kPrimeZeroRelation S x y)
      (kPrimeZeroGenerator P)
      (kPrimeZeroGenerator P' + kPrimeZeroGenerator P'')
    exact AddConGen.Rel.of _ _ ⟨S, rfl, rfl⟩
  change kPrimeZeroClassOfPresentation P =
    kPrimeZeroClassOfPresentation P' +
      kPrimeZeroClassOfPresentation P''
  exact (kPrimeZeroCon R).eq.mpr hrel

/-- A finite projective module presentation. -/
structure FiniteProjectivePresentation (R : Type u) [CommRing R] where
  presentation : FiniteModulePresentation R
  projective : Module.Projective R presentation.module

namespace FiniteProjectivePresentation

variable {R : Type u} [CommRing R]

instance finite (P : FiniteProjectivePresentation R) :
    Module.Finite R P.presentation.module := by
  infer_instance

instance isProjective (P : FiniteProjectivePresentation R) :
    Module.Projective R P.presentation.module :=
  P.projective

end FiniteProjectivePresentation

/-- Every finite projective module has a finite projective presentation. -/
theorem exists_finite_projective_presentation
    {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.Projective R M] :
    ∃ P : FiniteProjectivePresentation R,
      Nonempty (P.presentation.module ≃ₗ[R] M) := by
  rcases exists_finite_module_presentation (R := R) (M := M) with ⟨P, ⟨e⟩⟩
  let hP : Module.Projective R P.module :=
    Module.Projective.of_equiv' e.symm
  exact ⟨⟨P, hP⟩, ⟨e⟩⟩

/-- A short exact sequence of finite projective modules. -/
structure FiniteProjectiveShortExact (R : Type u) [CommRing R] where
  left : FiniteProjectivePresentation R
  middle : FiniteProjectivePresentation R
  right : FiniteProjectivePresentation R
  leftToMiddle :
    left.presentation.module →ₗ[R] middle.presentation.module
  middleToRight :
    middle.presentation.module →ₗ[R] right.presentation.module
  left_injective : Function.Injective leftToMiddle
  middle_surjective : Function.Surjective middleToRight
  exact : Function.Exact leftToMiddle middleToRight

/-- Forget the projective structure in a projective exact sequence. -/
def FiniteProjectiveShortExact.toFiniteModuleShortExact
    {R : Type u} [CommRing R] (S : FiniteProjectiveShortExact R) :
    FiniteModuleShortExact R :=
  { left := S.left.presentation
    middle := S.middle.presentation
    right := S.right.presentation
    leftToMiddle := S.leftToMiddle
    middleToRight := S.middleToRight
    left_injective := S.left_injective
    middle_surjective := S.middle_surjective
    exact := S.exact }

abbrev KZeroFree (R : Type u) [CommRing R] :=
  FreeAbelianGroup (FiniteProjectivePresentation R)

/-- The generator corresponding to a finite projective presentation. -/
def kZeroGenerator
    {R : Type u} [CommRing R] (P : FiniteProjectivePresentation R) :
    KZeroFree R :=
  FreeAbelianGroup.of P

/-- The elementary exact-sequence relation in the free group on finite
projective presentations. -/
def kZeroRelation
    {R : Type u} [CommRing R] (S : FiniteProjectiveShortExact R)
    (x y : KZeroFree R) : Prop :=
  x = kZeroGenerator S.middle ∧
    y = kZeroGenerator S.left + kZeroGenerator S.right

/-- The congruence generated by all exact-sequence relations. -/
def kZeroCon (R : Type u) [CommRing R] : AddCon (KZeroFree R) :=
  addConGen (fun x y => ∃ S : FiniteProjectiveShortExact R,
    kZeroRelation S x y)

/-- The K₀ group. -/
abbrev KZero (R : Type u) [CommRing R] :=
  (kZeroCon R).Quotient

/-- The class of a finite projective presentation. -/
def kZeroClassOfPresentation
    {R : Type u} [CommRing R] (P : FiniteProjectivePresentation R) :
    KZero R :=
  (kZeroCon R).mk' (kZeroGenerator P)

/-- The class of an arbitrary finite projective module. -/
noncomputable def kZeroClass
    {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.Projective R M] :
    KZero R :=
  let P := Classical.choose
    (exists_finite_projective_presentation (R := R) (M := M))
  kZeroClassOfPresentation P

/-- Every class in K₀ is an integer linear combination of projective-module
classes, and the defining relations are exactly the projective exact-sequence
relations. -/
theorem kZero_generated
    {R : Type u} [CommRing R] (x : KZero R) :
    ∃ n : ℕ, ∃ P : Fin n → FiniteProjectivePresentation R,
      ∃ z : Fin n → ℤ,
        x = ∑ i, z i • kZeroClassOfPresentation (P i) := by
  refine AddCon.induction_on x ?_
  intro y
  induction y using FreeAbelianGroup.induction_on with
  | zero =>
      refine ⟨0, (fun i => Fin.elim0 i), (fun i => Fin.elim0 i), ?_⟩
      simp [kZeroClassOfPresentation]
  | of P =>
      refine ⟨1, (fun _ => P), (fun _ => 1), ?_⟩
      simp only [Fin.sum_univ_one, one_smul]
      exact (kZeroCon R).eq.mpr
        ((kZeroCon R).refl (FreeAbelianGroup.of P))
  | neg P ih =>
      refine ⟨1, (fun _ => P), (fun _ => -1), ?_⟩
      change (-(FreeAbelianGroup.of P) : KZero R) = _
      simp [kZeroClassOfPresentation, kZeroGenerator]
  | add y z ihy ihz =>
      rcases ihy with ⟨n, P, a, hP⟩
      rcases ihz with ⟨m, Q, b, hQ⟩
      refine ⟨n + m, Fin.addCases P Q, Fin.addCases a b, ?_⟩
      change (y : KZero R) + (z : KZero R) = _
      rw [hP, hQ]
      simp [Fin.sum_univ_add]

/-- The exact-sequence relation in K₀. -/
theorem kZeroClass_exact
    {R : Type u} [CommRing R] {M' M M'' : Type v}
    [AddCommGroup M'] [Module R M'] [Module.Finite R M']
    [Module.Projective R M']
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.Projective R M]
    [AddCommGroup M''] [Module R M''] [Module.Finite R M'']
    [Module.Projective R M'']
    (f : M' →ₗ[R] M) (g : M →ₗ[R] M'')
    (hf : Function.Injective f) (hg : Function.Surjective g)
    (hfg : Function.Exact f g) :
    kZeroClass (R := R) (M := M) =
      kZeroClass (R := R) (M := M') +
        kZeroClass (R := R) (M := M'') := by
  sorry

/-- The homomorphism from the free K₀ generators to K′₀. -/
def kZeroFreeToKPrime
    {R : Type u} [CommRing R] :
    KZeroFree R →+ KPrimeZero R :=
  FreeAbelianGroup.lift (fun P =>
    kPrimeZeroClassOfPresentation P.presentation)

/-- The K₀ generator map respects the exact-sequence relations. -/
theorem kZeroFreeToKPrime_respects_relations
    {R : Type u} [CommRing R] :
    kZeroCon R ≤ AddCon.ker (kZeroFreeToKPrime (R := R)) := by
  sorry

/-- The canonical homomorphism K₀(R) → K′₀(R). -/
noncomputable def kZeroToKPrime
    {R : Type u} [CommRing R] :
    KZero R →+ KPrimeZero R :=
  (kZeroCon R).lift (kZeroFreeToKPrime (R := R))
    (kZeroFreeToKPrime_respects_relations (R := R))

@[simp]
theorem kZeroToKPrime_apply_class
    {R : Type u} [CommRing R] (P : FiniteProjectivePresentation R) :
    kZeroToKPrime (R := R) (kZeroClassOfPresentation P) =
      kPrimeZeroClassOfPresentation P.presentation := by
  sorry

/-- The length of a finite presented module over an Artinian ring. -/
def finitePresentationLength
    {R : Type u} [CommRing R] [IsArtinianRing R]
    (P : FiniteModulePresentation R) : ℕ :=
  (Module.length R P.module).toNat

/-- Length on the free abelian group of finite-module generators. -/
def kPrimeZeroLengthOnFree
    {R : Type u} [CommRing R] [IsArtinianRing R] :
    KPrimeZeroFree R →+ ℤ :=
  FreeAbelianGroup.lift (fun P => (finitePresentationLength P : ℤ))

/-- Exact-sequence relations preserve length. -/
theorem kPrimeZeroLengthOnFree_respects_relations
    {R : Type u} [CommRing R] [IsArtinianRing R] :
    kPrimeZeroCon R ≤
      AddCon.ker (kPrimeZeroLengthOnFree (R := R)) := by
  sorry

/-- The length homomorphism K′₀(R) → ℤ. -/
noncomputable def kPrimeZeroLength
    {R : Type u} [CommRing R] [IsArtinianRing R] :
    KPrimeZero R →+ ℤ :=
  (kPrimeZeroCon R).lift (kPrimeZeroLengthOnFree (R := R))
    (kPrimeZeroLengthOnFree_respects_relations (R := R))

@[simp]
theorem kPrimeZeroLength_apply_class
    {R : Type u} [CommRing R] [IsArtinianRing R]
    (P : FiniteModulePresentation R) :
    kPrimeZeroLength (R := R) (kPrimeZeroClassOfPresentation P) =
      finitePresentationLength P := by
  sorry

/-- Over a local ring, a finite projective module has a finite free basis. -/
theorem finite_projective_is_free_over_local
    {R M : Type u} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.Projective R M] :
    Module.Free R M := by
  sorry

/-- A finite free presentation of a finite projective module over a local
ring. -/
theorem finite_projective_is_finite_free_over_local
    {R M : Type u} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.Projective R M] :
    ∃ n : ℕ, Nonempty (M ≃ₗ[R] (Fin n → R)) := by
  sorry

/-- The finite free rank of a projective presentation over a local ring. -/
noncomputable def finiteProjectiveRank
    {R : Type u} [CommRing R] [IsLocalRing R]
    (P : FiniteProjectivePresentation R) : ℕ :=
  Classical.choose
    (finite_projective_is_finite_free_over_local
      (R := R) (M := P.presentation.module))

/-- Rank on the free abelian group of projective generators. -/
def kZeroRankOnFree
    {R : Type u} [CommRing R] [IsLocalRing R] :
    KZeroFree R →+ ℤ :=
  FreeAbelianGroup.lift (fun P => (finiteProjectiveRank P : ℤ))

/-- Exact-sequence relations preserve rank over a local ring. -/
theorem kZeroRankOnFree_respects_relations
    {R : Type u} [CommRing R] [IsLocalRing R] :
    kZeroCon R ≤ AddCon.ker (kZeroRankOnFree (R := R)) := by
  sorry

/-- The rank homomorphism K₀(R) → ℤ over a local ring. -/
noncomputable def kZeroRank
    {R : Type u} [CommRing R] [IsLocalRing R] :
    KZero R →+ ℤ :=
  (kZeroCon R).lift (kZeroRankOnFree (R := R))
    (kZeroRankOnFree_respects_relations (R := R))

@[simp]
theorem kZeroRank_apply_class
    {R : Type u} [CommRing R] [IsLocalRing R]
    (P : FiniteProjectivePresentation R) :
    kZeroRank (R := R) (kZeroClassOfPresentation P) =
      finiteProjectiveRank P := by
  sorry

/-- For a field, the K′₀ length is the vector-space dimension. -/
theorem kPrimeZeroLength_field_eq_finrank
    {k : Type u} [Field k] {M : Type v}
    [AddCommGroup M] [Module k M] [Module.Finite k M] :
    kPrimeZeroLength (R := k) (kPrimeZeroClass (R := k) (M := M)) =
      Module.finrank k M := by
  sorry

/-! ## The PID calculation -/

/- A finite free module has a finite basis, represented here by a linear
equivalence with a finite free module. -/
theorem exists_finite_free_equiv
    {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Free R M] :
    ∃ n : ℕ, Nonempty (M ≃ₗ[R] (Fin n → R)) := by
  sorry

/- The rank is the cardinality of any finite free basis. -/
noncomputable def finiteFreeRank
    {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Free R M] :
    ℕ :=
  Classical.choose (exists_finite_free_equiv (R := R) (M := M))

theorem finiteFreeRank_eq_of_linearEquiv
    {R : Type u} [CommRing R] [Nontrivial R] {M : Type v}
    [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Free R M]
    {n : ℕ} (e : M ≃ₗ[R] (Fin n → R)) :
    finiteFreeRank (R := R) (M := M) = n := by
  sorry

/- A finite projective module over a PID is finite free. -/
theorem finite_projective_is_free_pid
    {R M : Type u} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.Projective R M] :
    Module.Free R M := by
  sorry

/- A short exact sequence of finite free modules splits, so its middle term
is the direct sum of its outer terms.  A binary product is the additive
direct-sum model used for this source-facing statement. -/
theorem finite_free_short_exact_splits_pid
    {R M' M M'' : Type u} [CommRing R] [IsDomain R]
    [IsPrincipalIdealRing R]
    [AddCommGroup M'] [Module R M'] [Module.Finite R M'] [Module.Free R M']
    [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Free R M]
    [AddCommGroup M''] [Module R M''] [Module.Finite R M''] [Module.Free R M'']
    (f : M' →ₗ[R] M) (g : M →ₗ[R] M'')
    (hf : Function.Injective f) (hg : Function.Surjective g)
    (hfg : Function.Exact f g) :
    Nonempty (M ≃ₗ[R] M' × M'') := by
  sorry

theorem finite_free_rank_add_of_short_exact_pid
    {R M' M M'' : Type u} [CommRing R] [IsDomain R]
    [IsPrincipalIdealRing R]
    [AddCommGroup M'] [Module R M'] [Module.Finite R M'] [Module.Free R M']
    [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Free R M]
    [AddCommGroup M''] [Module R M''] [Module.Finite R M''] [Module.Free R M'']
    (f : M' →ₗ[R] M) (g : M →ₗ[R] M'')
    (hf : Function.Injective f) (hg : Function.Surjective g)
    (hfg : Function.Exact f g) :
    finiteFreeRank (R := R) (M := M) =
      finiteFreeRank (R := R) (M := M') +
        finiteFreeRank (R := R) (M := M'') := by
  sorry

/- The structure theorem for finitely generated modules over a PID.  The
finite direct sum is represented by DirectSum. -/
abbrev pidTorsionSummand (R : Type u) [CommRing R] (d : R) :=
  R ⧸ Ideal.span ({d} : Set R)

theorem finite_module_structure_pid
    {R M : Type u} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M] :
    ∃ r k : ℕ, ∃ d : Fin k → R,
      Nonempty (M ≃ₗ[R]
        (Fin r → R) × DirectSum (Fin k) (fun i => pidTorsionSummand R (d i))) := by
  sorry

/-- For a field, both K-groups are identified with ℤ by dimension. -/
theorem kGroups_field
    (k : Type u) [Field k] :
    ∃ e₀ : KZero k ≃+ ℤ, ∃ e₀' : KPrimeZero k ≃+ ℤ,
      (∀ x, e₀ x = kZeroRank x) ∧
      (∀ x, e₀' x = kPrimeZeroLength x) ∧
      (∀ x, e₀' (kZeroToKPrime x) = e₀ x) := by
  sorry

/-- Torsion finite modules over a PID have zero K′₀ class. -/
theorem kPrimeZeroClass_torsion_pid
    {R M : Type u} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (hM : Module.IsTorsion R M) :
    kPrimeZeroClass (R := R) (M := M) = 0 := by
  sorry

/-- For a PID, both K-groups are identified with ℤ by rank. -/
theorem kGroups_pid
    (R : Type u) [CommRing R] [IsDomain R] [IsPrincipalIdealRing R] :
    ∃ e₀ : KZero R ≃+ ℤ, ∃ e₀' : KPrimeZero R ≃+ ℤ,
      (∀ x, e₀' (kZeroToKPrime x) = e₀ x) := by
  sorry

/-- The polynomial-ring example, obtained by applying the PID example to
the polynomial ring. -/
theorem kGroups_polynomial
    (k : Type u) [Field k] :
    ∃ e₀ : KZero (Polynomial k) ≃+ ℤ,
      ∃ e₀' : KPrimeZero (Polynomial k) ≃+ ℤ,
        ∀ x, e₀' (kZeroToKPrime x) = e₀ x := by
  sorry

/-- The coordinate ring of the node in the source's example. -/
def nodeRing (k : Type u) [Field k] : Subalgebra k (Polynomial k) :=
  AlgHom.equalizer (Polynomial.aeval (0 : k)) (Polynomial.aeval (1 : k))

/-- The node example: the projective K-group has an extra unit-class
summand, while the finite-module K-group is ℤ. -/
theorem kGroups_node
    (k : Type u) [Field k] :
    Nonempty (KZero (nodeRing k) ≃+ (Additive (kˣ) × ℤ)) ∧
      Nonempty (KPrimeZero (nodeRing k) ≃+ ℤ) := by
  sorry

/-- The canonical map need not be an isomorphism; the node example gives a
concrete failure whenever the field is infinite. -/
theorem kZeroToKPrime_node_not_bijective
    (k : Type u) [Field k] [Infinite k] :
    ¬ Function.Bijective (kZeroToKPrime (R := nodeRing k)) := by
  sorry

/-- Product decomposition for both K-groups. -/
theorem kGroups_prod
    {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] :
    Nonempty (KZero (R₁ × R₂) ≃+ (KZero R₁ × KZero R₂)) ∧
      Nonempty (KPrimeZero (R₁ × R₂) ≃+
        (KPrimeZero R₁ × KPrimeZero R₂)) := by
  sorry

/-- The length map is an isomorphism for an Artinian local ring. -/
theorem kPrimeZeroLength_artinian_local_bijective
    (R : Type u) [CommRing R] [IsArtinianRing R] [IsLocalRing R] :
    Function.Bijective (kPrimeZeroLength (R := R)) := by
  sorry

/-- The rank map is an isomorphism for a local ring. -/
theorem kZeroRank_local_bijective
    (R : Type u) [CommRing R] [IsLocalRing R] :
    Function.Bijective (kZeroRank (R := R)) := by
  sorry

/-- Multiplication by an integer, as an additive homomorphism. -/
def intMul (n : ℤ) : ℤ →+ ℤ where
  toFun z := n * z
  map_zero' := by simp
  map_add' x y := by simp [mul_add]

/-- The rank/length square for an Artinian local ring. -/
theorem kZero_kPrimeZero_artinian_local
    (R : Type u) [CommRing R] [IsArtinianRing R] [IsLocalRing R] :
    (∀ x : KZero R,
        kPrimeZeroLength (R := R) (kZeroToKPrime (R := R) x) =
          intMul (Module.length R R).toNat (kZeroRank (R := R) x)) ∧
      Function.Bijective (kZeroRank (R := R)) ∧
      Function.Bijective (kPrimeZeroLength (R := R)) := by
  sorry

end

