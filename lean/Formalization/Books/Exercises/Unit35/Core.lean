import Mathlib.Algebra.DualNumber
import Mathlib.AlgebraicGeometry.Limits
import Mathlib.AlgebraicGeometry.ResidueField
import Mathlib.CategoryTheory.Limits.Shapes.Pullback.HasPullback
import Mathlib.Data.Matrix.Basic
import Mathlib.LinearAlgebra.Dimension.Finite
import Mathlib.RingTheory.LocalRing.Pullback
import Mathlib.Algebra.MvPolynomial.PDeriv

/-!
# Exercises, Chapter 35: Tangent Spaces

This file contains the reusable constructions for the chapter.  Dual numbers,
residue fields, and scheme morphisms are Mathlib's canonical constructions.
The dotted-arrow type is kept explicit so that the source's definition is
usable independently of the later computations.
-/

namespace Formalization.Books.Exercises.Unit35

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry
open Opposite

universe u

noncomputable section

/-! ## Dual numbers -/

/-- The ring of dual numbers over `R`, using Mathlib's canonical construction. -/
abbrev dualNumberRing (R : Type u) [CommRing R] := DualNumber R

/-- The square-zero element of the dual-number ring. -/
def dualNumberEpsilon (R : Type u) [CommRing R] : dualNumberRing R :=
  DualNumber.eps

/-- The reduction `R[ε] → R`. -/
def dualNumberProjection (R : Type u) [CommRing R] :
    dualNumberRing R →+* R :=
  (TrivSqZeroExt.fstHom R R R).toRingHom

/-- The inclusion `R → R[ε]`. -/
def dualNumberInclusion (R : Type u) [CommRing R] :
    R →+* dualNumberRing R :=
  algebraMap R (dualNumberRing R)

/-- The affine scheme associated to a commutative ring. -/
abbrev affineSpec (R : Type u) [CommRing R] : Scheme.{u} :=
  Scheme.Spec.obj (op (CommRingCat.of R))

/-- The contravariant scheme map associated to a ring homomorphism. -/
def affineSpecMap {R T : Type u} [CommRing R] [CommRing T]
    (φ : R →+* T) : affineSpec T ⟶ affineSpec R :=
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)

/-- A chosen point of the spectrum of a field. -/
def fieldSpectrumPoint (K : Type u) [Field K] : affineSpec K :=
  ⟨⊥, by infer_instance⟩

/-- The closed-point map `Spec(R) → Spec(R[ε])`. -/
def dualNumberClosedPoint (R : Type u) [CommRing R] :
    affineSpec R ⟶ affineSpec (dualNumberRing R) :=
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (dualNumberProjection R))

/-- The structure map `Spec(R[ε]) → Spec(R)`. -/
def dualNumberStructureMap (R : Type u) [CommRing R] :
    affineSpec (dualNumberRing R) ⟶ affineSpec R :=
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (dualNumberInclusion R))

/-! ## Dotted arrows and tangent spaces -/

/-- The canonical map from the residue-field spectrum of a point to a scheme. -/
abbrev residueFieldPoint {X : Scheme.{u}} (x : X) :
    affineSpec (X.residueField x) ⟶ X :=
  X.fromSpecResidueField x

/-- The map from the dual-number thickening to the residue-field spectrum of
the image point.  It is induced by the residue-field map of the scheme
morphism and the canonical inclusion into the dual numbers. -/
def tangentBaseMap {X S : Scheme.{u}} (f : X ⟶ S) (x : X) :
    affineSpec (dualNumberRing (X.residueField x)) ⟶ S :=
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      ((dualNumberInclusion (X.residueField x)).comp
        (f.residueFieldMap x).hom)) ≫ residueFieldPoint (f x)

/-- A dotted arrow in the diagram defining the tangent space at `x`. -/
structure TangentArrow {X S : Scheme.{u}} (f : X ⟶ S) (x : X) where
  lift : affineSpec (dualNumberRing (X.residueField x)) ⟶ X
  restricts : dualNumberClosedPoint (X.residueField x) ≫ lift = residueFieldPoint x
  lies_over : lift ≫ f = tangentBaseMap f x

/-- The tangent space of `X` over `S` at `x`, as the set of dotted arrows. -/
abbrev TangentSpace {X S : Scheme.{u}} (f : X ⟶ S) (x : X) :=
  TangentArrow f x

/-- Data recording that a tangent-space map is represented by the local-ring
map on stalks. -/
structure TangentMapLocalRingAgreement
    {X Y S : Scheme.{u}} (pX : X ⟶ S) (pY : Y ⟶ S)
    (f : X ⟶ Y) (x : X) where
  map : TangentSpace pX x → TangentSpace pY (f x)
  lift_eq : ∀ v, HEq (map v).lift (v.lift ≫ f)
  localRingMap : (Y.presheaf.stalk (f x) : Type u) →+*
    (X.presheaf.stalk x : Type u)
  localRingMap_eq : localRingMap = (f.stalkMap x).hom

/-- A tangent vector is an element of the tangent space. -/
abbrev TangentVector {X S : Scheme.{u}} (f : X ⟶ S) (x : X) :=
  TangentSpace f x

/-- A source-facing finite-dimensionality statement for the tangent space.
The underlying finite coordinate set records the dimension; the vector-space
structure is supplied by the vector-space exercise below. -/
def HasTangentSpaceDimension {X S : Scheme.{u}} (f : X ⟶ S) (x : X)
    (n : ℕ) : Prop :=
  Nonempty (TangentSpace f x ≃ (Fin n → (X.residueField x : Type u)))

/-! ## The local-ring quotient in the Zariski description -/

/-- The ideal in the local ring at `x` generated by the square of the maximal
ideal and the image of the maximal ideal at `f(x)`. -/
def tangentDenominatorIdeal {X S : Scheme.{u}} (f : X ⟶ S) (x : X) :
    Ideal (X.presheaf.stalk x : Type u) :=
  IsLocalRing.maximalIdeal (X.presheaf.stalk x : Type u) ^ 2 ⊔
    Ideal.map (f.stalkMap x).hom
      (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x) : Type u))

/-- The quotient `mₓ/(mₓ² + mₛ Oₓ)` occurring in the Zariski description. -/
def tangentCotangentQuotient {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Type u :=
  let A := (X.presheaf.stalk x : Type u)
  let m := (IsLocalRing.maximalIdeal A : Submodule A A)
  let d := (tangentDenominatorIdeal f x : Submodule A A)
  (m : Type u) ⧸ Submodule.comap m.subtype d

/-- The additive maps from the relative cotangent quotient to the residue field
which are linear for the local-ring action.  Under an identification of the
residue fields this is the source's `Hom_{κ(x)}` space. -/
def tangentLinearMaps {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Type u :=
  let A := (X.presheaf.stalk x : Type u)
  let K := (X.residueField x : Type u)
  let m := (IsLocalRing.maximalIdeal A : Submodule A A)
  let d := (tangentDenominatorIdeal f x : Submodule A A)
  { φ : (m : Type u) →+ K //
      (∀ (a : A) (v : (m : Type u)),
        φ (a • v) = (X.residue x).hom a * φ v) ∧
      (∀ v : Submodule.comap m.subtype d, φ v = 0) }

/-! ## The simple pushout -/

/-- The ring-theoretic pullback of the two reductions `K[εᵢ] → K`.  It is
canonically the displayed ring `K[ε₁, ε₂]/(ε₁ε₂)` with both squares zero. -/
abbrev dualNumberPushoutRing (K : Type u) [Field K] :=
  AlgHom.pullback (TrivSqZeroExt.fstHom K K K) (TrivSqZeroExt.fstHom K K K)

/-- The polynomial presentation displayed for the simple pushout. -/
abbrev dualNumberPushoutPolynomialRing (K : Type u) [Field K] :=
  MvPolynomial (Fin 2) K

def dualNumberPushoutRelationIdeal (K : Type u) [Field K] :
    Ideal (dualNumberPushoutPolynomialRing K) :=
  Ideal.span ({MvPolynomial.X (0 : Fin 2) ^ 2,
    MvPolynomial.X (1 : Fin 2) ^ 2,
    MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)} :
      Set (dualNumberPushoutPolynomialRing K))

abbrev dualNumberDisplayedPushoutRing (K : Type u) [Field K] :=
  dualNumberPushoutPolynomialRing K ⧸ dualNumberPushoutRelationIdeal K

/-- The two maps from the dual-number rings into the ring-theoretic pullback. -/
def dualNumberPushoutLeft (K : Type u) [Field K] :
    dualNumberPushoutRing K →+* dualNumberRing K :=
  (AlgHom.pullbackFst (TrivSqZeroExt.fstHom K K K)
    (TrivSqZeroExt.fstHom K K K)).toRingHom

def dualNumberPushoutRight (K : Type u) [Field K] :
    dualNumberPushoutRing K →+* dualNumberRing K :=
  (AlgHom.pullbackSnd (TrivSqZeroExt.fstHom K K K)
    (TrivSqZeroExt.fstHom K K K)).toRingHom

/-- The scheme map from the first dual-number factor to the pushout. -/
def dualNumberPushoutInl (K : Type u) [Field K] :
    affineSpec (dualNumberRing K) ⟶ affineSpec (dualNumberPushoutRing K) :=
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (dualNumberPushoutLeft K))

/-- The scheme map from the second dual-number factor to the pushout. -/
def dualNumberPushoutInr (K : Type u) [Field K] :
    affineSpec (dualNumberRing K) ⟶ affineSpec (dualNumberPushoutRing K) :=
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (dualNumberPushoutRight K))

/-! ## Affine examples -/

abbrev affineLineRing (k : Type u) [Field k] := Polynomial k
abbrev affineLine (k : Type u) [Field k] := affineSpec (affineLineRing k)

def affineLineStructureMap (k : Type u) [Field k] :
    affineLine k ⟶ affineSpec k :=
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k)))

def affineLineOverIntStructureMap (k : Type) [Field k] :
    affineLine k ⟶
      Scheme.Spec.obj (op (CommRingCat.of ℤ)) :=
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ℤ (Polynomial k)))

abbrev affineSpaceRing (k : Type u) [Field k] (n : ℕ) :=
  MvPolynomial (Fin n) k
abbrev affineSpace (k : Type u) [Field k] (n : ℕ) : Scheme.{u} :=
  affineSpec (affineSpaceRing k n)

def affineSpaceStructureMap (k : Type u) [Field k] (n : ℕ) :
    affineSpace k n ⟶ affineSpec k :=
  affineSpecMap (algebraMap k (MvPolynomial (Fin n) k))

/-- A point is generic on the affine line when it specializes to every point. -/
def IsAffineLineGenericPoint {k : Type u} [Field k] (η : affineLine k) : Prop :=
  ∀ z : affineLine k, η ≤ z

def affinePolynomialMorphism {k : Type u} [Field k] {n m : ℕ}
    (p : Fin m → MvPolynomial (Fin n) k) :
    affineSpace k n ⟶ affineSpace k m :=
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom
    (MvPolynomial.eval₂Hom (MvPolynomial.C : k →+* MvPolynomial (Fin n) k) p))

/-- The Jacobian matrix of a tuple of multivariate polynomials. -/
def jacobianMatrix {k : Type u} [CommRing k] {n m : ℕ}
    (p : Fin m → MvPolynomial (Fin n) k) :
    Matrix (Fin m) (Fin n) (MvPolynomial (Fin n) k) :=
  fun j i => MvPolynomial.pderiv i (p j)

/-- Evaluation of the Jacobian at an affine point. -/
def jacobianAt {k : Type u} [CommRing k] {n m : ℕ}
    (p : Fin m → MvPolynomial (Fin n) k) (a : Fin n → k) :
    Matrix (Fin m) (Fin n) k :=
  fun j i => MvPolynomial.eval a (MvPolynomial.pderiv i (p j))

/-! ## The cusp -/

abbrev cuspPolynomialRing (k : Type u) [Field k] :=
  MvPolynomial (Fin 2) k

def cuspRelation {k : Type u} [Field k] : cuspPolynomialRing k :=
  (MvPolynomial.X 0) ^ 2 - (MvPolynomial.X 1) ^ 3

abbrev cuspIdeal (k : Type u) [Field k] : Ideal (cuspPolynomialRing k) :=
  Ideal.span ({cuspRelation (k := k)} : Set (cuspPolynomialRing k))

abbrev cuspRing (k : Type u) [Field k] :=
  cuspPolynomialRing k ⧸ cuspIdeal k

abbrev cuspScheme (k : Type u) [Field k] : Scheme.{u} :=
  affineSpec (cuspRing k)

end
end Formalization.Books.Exercises.Unit35
