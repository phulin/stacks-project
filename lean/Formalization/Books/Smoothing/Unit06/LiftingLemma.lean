  have qsolve : ∀ ℓ : Fin d.m,
      qmap (MvPolynomial.X (Sum.inr ℓ)) =
        IsLocalization.Away.invSelf (liftingAuxiliaryModPiElement d k) *
          ∑ j : Fin (d.e k),
            qmap (liftLiftingPolynomial (d.h k ℓ j)) *
              qmap (MvPolynomial.X (Sum.inr (d.selected k j))) :=
    liftingAuxiliary_modPi_solve_z_variables d k qmap
      (IsLocalization.Away.invSelf (liftingAuxiliaryModPiElement d k))
      hpi qcorr hqainv
  have htmap_model : ∀ p : liftingPresentationModPiModel d,
      tmap ((algebraMap (liftingPresentationModPiModel d) T) p) = smap2 p := by
    intro p
    change (IsLocalization.Away.lift
      (liftingPresentationModPiElement d k) hsunit)
      ((algebraMap (liftingPresentationModPiModel d) T) p) = smap2 p
    rw [IsLocalization.Away.lift_eq
      (liftingPresentationModPiElement d k) hsunit]
  have htmap_pmod : ∀ r : R, tmap (pmod r) = qmap (MvPolynomial.C r) := by
    intro r
    calc
      tmap (pmod r) = tmap (evalx (MvPolynomial.C r)) := by rw [pmod_spec]
      _ = tmap ((algebraMap (liftingPresentationModPiModel d) T)
          (p2mk ((MvPolynomial.map (piQuotientMk (π ^ 2)))
            (MvPolynomial.C r)))) := by rw [evalx_spec]
      _ = smap2 (p2mk ((MvPolynomial.map (piQuotientMk (π ^ 2)))
          (MvPolynomial.C r))) := htmap_model _
      _ = smap2 ((Ideal.Quotient.mk (liftingPresentationModPiIdeal d))
          ((Ideal.Quotient.mk (liftingReducedRelationIdeal d))
            ((MvPolynomial.map (piQuotientMk (π ^ 2)))
              (MvPolynomial.C r)))) := by rw [p2mk_spec]
      _ = smap ((Ideal.Quotient.mk (liftingReducedRelationIdeal d))
          ((MvPolynomial.map (piQuotientMk (π ^ 2)))
            (MvPolynomial.C r))) := by rw [smap2_spec]
      _ = pmap ((MvPolynomial.map (piQuotientMk (π ^ 2)))
          (MvPolynomial.C r)) := by rw [smap_spec]
      _ = qmap (liftLiftingPolynomial (MvPolynomial.C r)) :=
        pmap_lift (MvPolynomial.C r)
      _ = qmap (MvPolynomial.C r) := by
        simp only [liftLiftingPolynomial, MvPolynomial.rename_C]
  have htmap_pX : ∀ i : Fin d.n, tmap (pX i) =
      qmap (MvPolynomial.X (Sum.inl i)) := by
    intro i
    calc
      tmap (pX i) = tmap (evalx (MvPolynomial.X i)) := by
        change tmap (bsetup.pX i) = tmap (bsetup.evalx (MvPolynomial.X i))
        exact congrArg tmap (pX_spec i)
      _ = tmap ((algebraMap (liftingPresentationModPiModel d) T)
          (p2mk ((MvPolynomial.map (piQuotientMk (π ^ 2)))
            (MvPolynomial.X i)))) := by rw [evalx_spec]
      _ = smap2 (p2mk ((MvPolynomial.map (piQuotientMk (π ^ 2)))
          (MvPolynomial.X i))) := htmap_model _
      _ = smap2 ((Ideal.Quotient.mk (liftingPresentationModPiIdeal d))
          ((Ideal.Quotient.mk (liftingReducedRelationIdeal d))
            ((MvPolynomial.map (piQuotientMk (π ^ 2)))
              (MvPolynomial.X i)))) := by rw [p2mk_spec]
      _ = smap ((Ideal.Quotient.mk (liftingReducedRelationIdeal d))
          ((MvPolynomial.map (piQuotientMk (π ^ 2)))
            (MvPolynomial.X i))) := by rw [smap2_spec]
      _ = pmap ((MvPolynomial.map (piQuotientMk (π ^ 2)))
          (MvPolynomial.X i)) := by rw [smap_spec]
      _ = qmap (liftLiftingPolynomial (MvPolynomial.X i)) :=
        pmap_lift (MvPolynomial.X i)
      _ = qmap (MvPolynomial.X (Sum.inl i)) := by
        simp [liftLiftingPolynomial]
  have htmap_evalx : ∀ p : MvPolynomial (Fin d.n) R,
      tmap (evalx p) = qmap (liftLiftingPolynomial p) := by
    have hh : tmap.comp evalx =
        qmap.comp (MvPolynomial.rename Sum.inl).toRingHom := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        have hpmod : pmod r = evalx (MvPolynomial.C r) := pmod_spec r
        change tmap (evalx (MvPolynomial.C r)) =
          qmap (MvPolynomial.rename Sum.inl (MvPolynomial.C r))
        rw [MvPolynomial.rename_C, ← hpmod]
        exact htmap_pmod r
      · intro i
        have hpX : pX i = evalx (MvPolynomial.X i) := pX_spec i
        change tmap (evalx (MvPolynomial.X i)) =
          qmap (MvPolynomial.rename Sum.inl (MvPolynomial.X i))
        rw [MvPolynomial.rename_X, ← hpX]
        exact htmap_pX i
    intro p
    exact RingHom.congr_fun hh p
  have htmap_ainv : tmap ainv =
      IsLocalization.Away.invSelf (liftingAuxiliaryModPiElement d k) := by
    have hta : qmap (liftLiftingPolynomial (d.a k)) * tmap ainv = 1 := by
      have h := IsLocalization.Away.mul_invSelf
        (R := liftingPresentationModPiModel d) (S := T)
        (liftingPresentationModPiElement d k)
      calc
        qmap (liftLiftingPolynomial (d.a k)) * tmap ainv =
            smap2 (liftingPresentationModPiElement d k) * tmap ainv := by
              rw [hqa, setup.smap2_element]
        _ = tmap ((algebraMap (liftingPresentationModPiModel d) T)
            (liftingPresentationModPiElement d k)) * tmap ainv := by
              rw [htmap_model]
        _ = tmap ((algebraMap (liftingPresentationModPiModel d) T)
              (liftingPresentationModPiElement d k) *
            IsLocalization.Away.invSelf
              (liftingPresentationModPiElement d k)) := by
                dsimp [ainv]
                rw [ainv_spec]
                rw [map_mul]
        _ = tmap 1 := by rw [h]
        _ = 1 := by simp
    calc
      tmap ainv = 1 * tmap ainv := by simp
      _ = (IsLocalization.Away.invSelf
          (liftingAuxiliaryModPiElement d k) *
          qmap (liftLiftingPolynomial (d.a k))) * tmap ainv := by
            calc
              1 * tmap ainv =
                  (qmap (liftLiftingPolynomial (d.a k)) *
                    IsLocalization.Away.invSelf
                      (liftingAuxiliaryModPiElement d k)) * tmap ainv := by
                        rw [hqainv]
              _ = _ := by ring
      _ = IsLocalization.Away.invSelf
          (liftingAuxiliaryModPiElement d k) *
          (qmap (liftLiftingPolynomial (d.a k)) * tmap ainv) := by ring
      _ = _ := by rw [hta]; simp
  have hbmap_C : ∀ r : R, bmap (MvPolynomial.C r) = bcoeff r := by
    intro r
    exact bmap_C r
  have hbcoeff_spec : ∀ r : R, bcoeff r = MvPolynomial.C (pmod r) := by
    intro r
    exact bcoeff_spec r
  have hbmap_X : ∀ v : Fin d.n ⊕ Fin d.m,
      bmap (MvPolynomial.X v) = bvar v := by
    intro v
    exact bmap_X v
  have hbvar_inl : ∀ i : Fin d.n,
      bvar (Sum.inl i) = MvPolynomial.C (pX i) := by
    intro i
    exact bvar_inl i
  have hbvar_inr : ∀ ℓ : Fin d.m,
      bvar (Sum.inr ℓ) = MvPolynomial.C ainv * ∑ j : Fin (d.e k),
        MvPolynomial.C (evalx (d.h k ℓ j)) * MvPolynomial.X j := by
    intro ℓ
    exact bvar_inr ℓ
  have hgmap_C : ∀ s : T, gmap (MvPolynomial.C s) = tmap s := by
    intro s
    change MvPolynomial.eval₂Hom tmap gvar (MvPolynomial.C s) = tmap s
    rw [MvPolynomial.eval₂Hom_C]
  have hgmap_inr : ∀ ℓ : Fin d.m,
      gmap (bvar (Sum.inr ℓ)) =
        tmap ainv * ∑ j : Fin (d.e k),
          tmap (evalx (d.h k ℓ j)) * gvar j := by
    intro ℓ
    rw [hbvar_inr]
    change MvPolynomial.eval₂Hom tmap gvar
      (MvPolynomial.C ainv * ∑ j : Fin (d.e k),
        MvPolynomial.C (evalx (d.h k ℓ j)) * MvPolynomial.X j) =
      tmap ainv * ∑ j : Fin (d.e k),
        tmap (evalx (d.h k ℓ j)) * gvar j
    rw [map_mul, map_sum]
    simp only [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X', map_mul]
  have hgvar : ∀ j : Fin (d.e k),
      gvar j = qmap (MvPolynomial.X (Sum.inr (d.selected k j))) := by
    intro j
    simpa [gvar] using
      (setup.qmap_spec (MvPolynomial.X (Sum.inr (d.selected k j)))).symm
  have gf_base : gmap.comp bmap = qmap := by
    apply MvPolynomial.ringHom_ext'
    · ext r
      calc
        gmap (bmap (MvPolynomial.C r)) = gmap (bcoeff r) := by
          rw [hbmap_C]
        _ = gmap (MvPolynomial.C (pmod r)) := by rw [hbcoeff_spec]
        _ = tmap (pmod r) := hgmap_C _
        _ = qmap (MvPolynomial.C r) := htmap_pmod r
    · intro v
      rcases v with i | ℓ
      · calc
          gmap (bmap (MvPolynomial.X (Sum.inl i))) =
              gmap (bvar (Sum.inl i)) := by rw [hbmap_X]
          _ = gmap (MvPolynomial.C (pX i)) := by rw [hbvar_inl]
          _ = tmap (pX i) := hgmap_C _
          _ = qmap (MvPolynomial.X (Sum.inl i)) := htmap_pX i
      · calc
          gmap (bmap (MvPolynomial.X (Sum.inr ℓ))) =
              gmap (bvar (Sum.inr ℓ)) := by rw [hbmap_X]
          _ = tmap ainv * ∑ j : Fin (d.e k),
              tmap (evalx (d.h k ℓ j)) * gvar j := hgmap_inr ℓ
          _ = IsLocalization.Away.invSelf
                (liftingAuxiliaryModPiElement d k) *
              ∑ j : Fin (d.e k),
                qmap (liftLiftingPolynomial (d.h k ℓ j)) *
                  qmap (MvPolynomial.X (Sum.inr (d.selected k j))) := by
            rw [htmap_ainv]
            congr 1
            apply Finset.sum_congr rfl
            intro j hj
            rw [htmap_evalx, hgvar]
          _ = qmap (MvPolynomial.X (Sum.inr ℓ)) := (qsolve ℓ).symm
  have hf0q : ∀ p : liftingPolynomial R d.n d.m,
      f0 (qmk p) = bmap p := by
    intro p
    rw [qmk_spec p]
    change (Ideal.Quotient.lift (liftingAuxiliaryModPiIdeal d k) fD _)
        (Ideal.Quotient.mk (liftingAuxiliaryModPiIdeal d k) _) = _
    rfl
  have gf0 : gmap.comp f0 = algebraMap A U := by
    apply Ideal.Quotient.ringHom_ext
    apply Ideal.Quotient.ringHom_ext
    apply RingHom.ext
    intro p
    change gmap (f0 (Ideal.Quotient.mk (liftingAuxiliaryModPiIdeal d k)
      (Ideal.Quotient.mk (liftingAuxiliaryDefiningIdeal d k) p))) =
      (algebraMap A U)
        (Ideal.Quotient.mk (liftingAuxiliaryModPiIdeal d k)
          (Ideal.Quotient.mk (liftingAuxiliaryDefiningIdeal d k) p))
    have hf0p : f0 (Ideal.Quotient.mk (liftingAuxiliaryModPiIdeal d k)
        (Ideal.Quotient.mk (liftingAuxiliaryDefiningIdeal d k) p)) =
        fD (Ideal.Quotient.mk (liftingAuxiliaryDefiningIdeal d k) p) := by
      change (Ideal.Quotient.lift (liftingAuxiliaryModPiIdeal d k) fD _)
          (Ideal.Quotient.mk (liftingAuxiliaryModPiIdeal d k) _) = _
      rfl
    have hfdp : fD (Ideal.Quotient.mk (liftingAuxiliaryDefiningIdeal d k) p) =
        bmap p := by
      change (Ideal.Quotient.lift (liftingAuxiliaryDefiningIdeal d k) bmap _)
          (Ideal.Quotient.mk (liftingAuxiliaryDefiningIdeal d k) _) = _
      rfl
    rw [hf0p, hfdp]
    rw [← qmk_spec p]
    have h := congrArg (fun h => h p) gf_base
    calc
      gmap (bmap p) = qmap p := by simpa using h
      _ = (algebraMap A U) (qmk p) := by
        rw [qmap_eq]
        rfl
  have gf : gmap.comp f = RingHom.id U := by
    apply IsLocalization.ringHom_ext (Submonoid.powers
      (liftingAuxiliaryModPiElement d k))
    apply RingHom.ext
    intro x
    change gmap (f ((algebraMap A U) x)) = (algebraMap A U) x
    dsimp [f]
    rw [IsLocalization.Away.lift_eq]
    exact RingHom.congr_fun gf0 x
  have fsbase : f.comp smap2 =
      (algebraMap T B).comp (algebraMap
        (liftingPresentationModPiModel d) T) := by
    apply Ideal.Quotient.ringHom_ext
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext'
    · apply Ideal.Quotient.ringHom_ext
      apply RingHom.ext
      intro r
      have hru : rmapU r = (algebraMap A U) (qmk (MvPolynomial.C r)) := by
        calc
          rmapU r = qmap (MvPolynomial.C r) := (qmap_C r).symm
          _ = (algebraMap A U) (qmk (MvPolynomial.C r)) := by
            simp [qmap_eq]
      calc
        f (smap2 ((Ideal.Quotient.mk (liftingPresentationModPiIdeal d))
            ((Ideal.Quotient.mk (liftingReducedRelationIdeal d))
              (MvPolynomial.C (piQuotientMk (π ^ 2) r)))) ) =
            f (pmap (MvPolynomial.C (piQuotientMk (π ^ 2) r))) := by
              rw [smap2_spec, smap_spec]
        _ = f (rmap2 (piQuotientMk (π ^ 2) r)) := by
              change f (setup.pmap (MvPolynomial.C (piQuotientMk (π ^ 2) r))) =
                f (setup.rmap2 (piQuotientMk (π ^ 2) r))
              rw [setup.pmap_eq]
              simp
        _ = f (rmapU r) := by rw [hrmap2 r]
        _ = f ((algebraMap A U) (qmk (MvPolynomial.C r))) := by rw [hru]
        _ = bmap (MvPolynomial.C r) := by
              dsimp [f]
              rw [IsLocalization.Away.lift_eq]
              exact hf0q _
        _ = (algebraMap T B)
            ((algebraMap (liftingPresentationModPiModel d) T)
              ((Ideal.Quotient.mk (liftingPresentationModPiIdeal d))
                ((Ideal.Quotient.mk (liftingReducedRelationIdeal d))
                  (MvPolynomial.C (piQuotientMk (π ^ 2) r))))) := by
              rw [bmap_C r, bcoeff_spec r, pmod_spec r, evalx_spec]
              rw [p2mk_spec]
              rw [MvPolynomial.map_C, MvPolynomial.algebraMap_apply]
              rfl
    · intro i
      simp only [RingHom.comp_apply]
      calc
        f (smap2 ((Ideal.Quotient.mk (liftingPresentationModPiIdeal d))
            ((Ideal.Quotient.mk (liftingReducedRelationIdeal d))
              (MvPolynomial.X i)))) =
            f (pmap (MvPolynomial.X i)) := by
                rw [smap2_spec, smap_spec]
        _ = f (qmap (MvPolynomial.X (Sum.inl i))) := by
              change f (setup.pmap (MvPolynomial.X i)) =
                f (setup.qmap (MvPolynomial.X (Sum.inl i)))
              have hp : setup.pmap (MvPolynomial.X i) =
                  setup.qmap (MvPolynomial.X (Sum.inl i)) := by
                simpa [MvPolynomial.map_X, liftLiftingPolynomial] using
                  setup.pmap_lift (MvPolynomial.X i)
              rw [hp]
        _ = bmap (MvPolynomial.X (Sum.inl i)) := by
              rw [qmap_eq]
              dsimp [f]
              rw [IsLocalization.Away.lift_eq]
              exact hf0q _
        _ = (algebraMap T B)
            ((algebraMap (liftingPresentationModPiModel d) T)
              ((Ideal.Quotient.mk (liftingPresentationModPiIdeal d))
                ((Ideal.Quotient.mk (liftingReducedRelationIdeal d))
                  (MvPolynomial.X i)))) := by
              rw [bmap_X, bvar_inl, pX_spec, evalx_spec]
              rw [p2mk_spec]
              rw [MvPolynomial.map_X, MvPolynomial.algebraMap_apply]
              rfl
  have ft : f.comp tmap = algebraMap T B := by
    apply IsLocalization.ringHom_ext (Submonoid.powers
      (liftingPresentationModPiElement d k))
    calc
      (f.comp tmap).comp
          (algebraMap (liftingPresentationModPiModel d) T) =
          f.comp smap2 := by
        apply RingHom.ext
        intro p
        simp only [RingHom.comp_apply]
        exact congrArg f (htmap_model p)
      _ = (algebraMap T B).comp
          (algebraMap (liftingPresentationModPiModel d) T) := fsbase
  have fgvar : ∀ j : Fin (d.e k), f (gvar j) = MvPolynomial.X j := by
    intro j
    change f ((algebraMap A U)
      (qmk (MvPolynomial.X (Sum.inr ((d.selected k) j))))) =
      MvPolynomial.X j
    dsimp [f]
    rw [IsLocalization.Away.lift_eq]
    rw [hf0q]
    rw [bmap_X, bvar_inr]
    classical
    simp_rw [d.selected_h]
    rw [Finset.sum_eq_single j]
    · rw [if_pos rfl]
      rw [← mul_assoc]
      rw [← map_mul]
      rw [mul_comm bsetup.ainv (bsetup.evalx (d.a k)), haT]
      simp
    · intro b hb hbj
      simp [hbj]
    · simp
  have fg : f.comp gmap = RingHom.id B := by
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro s
      simp only [RingHom.comp_apply]
      rw [hgmap_C]
      have h := congrArg (fun h => h s) ft
      rw [MvPolynomial.algebraMap_apply] at h
      exact h
    · intro j
      simp only [RingHom.comp_apply, gmap,
        MvPolynomial.eval₂Hom_X']
      rw [fgvar]
      rfl
  refine ⟨RingEquiv.ofBijective f ⟨?_, ?_⟩⟩
  · intro x y hxy
    have hx : gmap (f x) = x := by
      simpa only [RingHom.comp_apply, RingHom.id_apply] using
        RingHom.congr_fun gf x
    have hy : gmap (f y) = y := by
      simpa only [RingHom.comp_apply, RingHom.id_apply] using
        RingHom.congr_fun gf y
    calc
      x = gmap (f x) := hx.symm
      _ = gmap (f y) := congrArg gmap hxy
      _ = y := hy
  · intro y
    refine ⟨gmap y, ?_⟩
    simpa only [RingHom.comp_apply, RingHom.id_apply] using
      RingHom.congr_fun fg y

/-- The localized polynomial calculation for the auxiliary ring. -/
theorem liftingAuxiliary_modPi_localized_equiv
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
    Nonempty
      (Localization.Away (liftingAuxiliaryModPiElement d k) ≃+*
        MvPolynomial (Fin (d.e k))
      (Localization.Away (liftingPresentationModPiElement d k))) := by
  exact liftingAuxiliary_modPi_localized_equiv_right d k
    (liftingAuxiliary_modPi_localized_setup d k)
    (liftingAuxiliary_modPi_localized_b_setup d k)
/-- The polynomial algebra in the localized mod-`π` presentation is smooth
over its coefficient ring; the preceding equivalence identifies it with the
localized auxiliary quotient. -/
theorem liftingAuxiliary_modPi_localized_smooth
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r) :
    Algebra.Smooth (Localization.Away (liftingPresentationModPiElement d k))
      (MvPolynomial (Fin (d.e k))
        (Localization.Away (liftingPresentationModPiElement d k))) := by
  let hfp : Algebra.FinitePresentation
      (Localization.Away (liftingPresentationModPiElement d k))
      (Localization.Away (liftingPresentationModPiElement d k)) :=
    Algebra.FinitePresentation.self _
  refine ⟨?_, ?_⟩
  · exact Algebra.instFormallySmoothMvPolynomial
      (R := Localization.Away (liftingPresentationModPiElement d k)) (Fin (d.e k))
  · exact @Algebra.FinitePresentation.mvPolynomial
      (Localization.Away (liftingPresentationModPiElement d k))
      (Localization.Away (liftingPresentationModPiElement d k))
      _ _ _ hfp (Fin (d.e k)) inferInstance

/-- The finite-presentation assertion for the explicit ring `D`. -/
theorem liftingRing_finitePresentation
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) :
    Algebra.FinitePresentation R (liftingRing d) := by
  have hfinite :
      Set.Finite
        (Set.range (fun ℓ : Fin d.m =>
            liftingBaseRelation π d.relations ℓ) ∪
          ⋃ k : Fin d.r, Set.range (fun ℓ : Fin d.m =>
            liftingCorrectionRelation π d.a d.h d.g d.selected k ℓ)) := by
    apply Set.Finite.union
    · exact Set.finite_range _
    · exact Set.finite_iUnion (fun k => Set.finite_range _)
  have hfg : (liftingDefiningIdeal d).FG := by
    rw [liftingDefiningIdeal]
    exact Submodule.fg_span hfinite
  exact Algebra.FinitePresentation.quotient hfg

/-- The ring equivalence underlying the localization calculation, together
with the compatibility needed to promote it to an algebra equivalence. -/
private structure LiftingRingLocalizationEquivData
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) where
  equivalence :
    Localization.Away (algebraMap R (liftingRing d) π) ≃+*
      MvPolynomial (Fin d.n) (Localization.Away π)
  commutes : ∀ r : R,
    equivalence (algebraMap R
      (Localization.Away (algebraMap R (liftingRing d) π)) r) =
      algebraMap R (MvPolynomial (Fin d.n) (Localization.Away π)) r

/-- The shared equivalence data underlying the localization calculation. -/
private theorem liftingCorrectionRelation_map_eq_zero
    {R P : Type u} [CommRing R] [CommRing P] [Algebra R P] {π : R}
    (d : LiftingConstructionData R π)
    (xeval : MvPolynomial (Fin d.n) R →+* P) (sinv : P)
    (pmap : liftingPolynomial R d.n d.m →+* P)
    (hpmap_lift : ∀ p : MvPolynomial (Fin d.n) R,
      pmap (liftLiftingPolynomial p) = xeval p)
    (hidentity : ∀ k : Fin d.r, ∀ ℓ : Fin d.m,
      xeval (d.a k) * xeval (d.relations ℓ) =
        (∑ j : Fin (d.e k),
          xeval (d.h k ℓ j) * xeval (d.relations (d.selected k j))) +
          (algebraMap R P) (π ^ 2) * xeval (d.g k ℓ))
    (hpi2 : sinv * (algebraMap R P) (π ^ 2) = (algebraMap R P) π)
    (hC : pmap (MvPolynomial.C π) = (algebraMap R P) π)
    (hzvar : ∀ ℓ : Fin d.m,
      pmap (MvPolynomial.X (Sum.inr ℓ)) = sinv * xeval (d.relations ℓ)) :
    ∀ k : Fin d.r, ∀ ℓ : Fin d.m,
      pmap (liftingCorrectionRelation π d.a d.h d.g d.selected k ℓ) = 0 := by
  intro k ℓ
  have hrel :
      pmap (liftingCorrectionRelation π d.a d.h d.g d.selected k ℓ) =
        sinv *
          (xeval (d.a k) * xeval (d.relations ℓ) -
            (∑ j : Fin (d.e k),
              xeval (d.h k ℓ j) * xeval (d.relations (d.selected k j))) -
            (algebraMap R P) (π ^ 2) * xeval (d.g k ℓ)) := by
    simp only [liftingCorrectionRelation, map_sub, map_mul, map_sum]
    simp only [hpmap_lift, hzvar, hC, map_pow]
    have hpi2' : sinv * ((algebraMap R P) π) ^ 2 = (algebraMap R P) π := by
      simpa only [map_pow] using hpi2
    have hlast := congrArg (fun t : P => t * xeval (d.g k ℓ)) hpi2'.symm
    have hsum :
        (∑ j : Fin (d.e k),
          xeval (d.h k ℓ j) *
            (sinv * xeval (d.relations (d.selected k j)))) =
          sinv * ∑ j : Fin (d.e k),
            xeval (d.h k ℓ j) * xeval (d.relations (d.selected k j)) := by
      calc
        _ = ∑ j : Fin (d.e k), sinv *
            (xeval (d.h k ℓ j) * xeval (d.relations (d.selected k j))) := by
              apply Finset.sum_congr rfl
              intro j hj
              ring
        _ = _ := by rw [Finset.mul_sum]
    rw [hsum, hlast]
    ring
  rw [hrel, hidentity k ℓ]
  ring

private theorem liftingRing_localization_base_relation
    {R : Type u} [CommRing R] {π : R} (d : LiftingConstructionData R π) :
    let D := liftingRing d
    let L := Localization.Away (algebraMap R D π)
    ∀ ℓ : Fin d.m,
      algebraMap D L
          (Ideal.Quotient.mk (liftingDefiningIdeal d)
            (liftLiftingPolynomial (d.relations ℓ))) =
        algebraMap D L
          ((algebraMap R D π) *
            Ideal.Quotient.mk (liftingDefiningIdeal d)
              (MvPolynomial.X (Sum.inr ℓ))) := by
  dsimp only
  intro ℓ
  have hzero :
      Ideal.Quotient.mk (liftingDefiningIdeal d)
          (liftingBaseRelation π d.relations ℓ) = 0 := by
    apply Ideal.Quotient.eq_zero_iff_mem.2
    rw [liftingDefiningIdeal]
    exact Ideal.subset_span (Or.inl ⟨ℓ, rfl⟩)
  have hsub := congrArg
    (algebraMap (liftingRing d)
      (Localization.Away (algebraMap R (liftingRing d) π))) hzero
  have hπ : (algebraMap R (liftingRing d)) π =
      Ideal.Quotient.mk (liftingDefiningIdeal d) (MvPolynomial.C π) := by
    rw [← Ideal.Quotient.mk_algebraMap R (liftingDefiningIdeal d) π]
    rfl
  have hmk :
      (algebraMap R (liftingRing d) π) *
          Ideal.Quotient.mk (liftingDefiningIdeal d)
            (MvPolynomial.X (Sum.inr ℓ)) =
        Ideal.Quotient.mk (liftingDefiningIdeal d)
          (MvPolynomial.C π * MvPolynomial.X (Sum.inr ℓ)) := by
    rw [hπ, ← map_mul]
  rw [hmk]
  apply sub_eq_zero.mp
  simpa [liftingBaseRelation, map_sub] using hsub

private theorem liftingRing_localization_algEquiv_aux
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) :
    Nonempty (LiftingRingLocalizationEquivData d) := by
  classical
  let D := liftingRing d
  let L := Localization.Away (algebraMap R D π)
  let S := Localization.Away π
  let P := MvPolynomial (Fin d.n) S
  let _ : Algebra R P := Algebra.compHom P (algebraMap R S)
  let _ : IsScalarTower R S P :=
    IsScalarTower.of_algebraMap_eq (fun r => rfl)
  let gR : R →+* L := (algebraMap D L).comp (algebraMap R D)
  have hgR : IsUnit (gR π) := by
    exact IsLocalization.Away.algebraMap_isUnit (S := L) (algebraMap R D π)
  let smapL : S →+* L :=
    IsLocalization.Away.lift (R := R) (S := S) (g := gR) π hgR
  let xeval : MvPolynomial (Fin d.n) R →+* P :=
    MvPolynomial.eval₂Hom (algebraMap R P) (fun i => MvPolynomial.X i)
  let sinv : P := (algebraMap S P) (IsLocalization.Away.invSelf π)
  let zvar : Fin d.m → P := fun ℓ =>
    sinv * xeval (d.relations ℓ)
  let pmap : liftingPolynomial R d.n d.m →+* P :=
    MvPolynomial.eval₂Hom (algebraMap R P) (fun v =>
      match v with
      | Sum.inl i => MvPolynomial.X i
      | Sum.inr ℓ => zvar ℓ)
  have hpmap_lift : ∀ p : MvPolynomial (Fin d.n) R,
      pmap (liftLiftingPolynomial p) = xeval p := by
    have h : pmap.comp (MvPolynomial.rename Sum.inl).toRingHom = xeval := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        simp [pmap, xeval]
      · intro i
        simp [pmap, xeval]
    intro p
    exact RingHom.congr_fun h p
  have hpi : (algebraMap R P) π * sinv = 1 := by
    change (algebraMap S P) (algebraMap R S π) *
      (algebraMap S P) (IsLocalization.Away.invSelf π) = 1
    rw [← map_mul, IsLocalization.Away.mul_invSelf]
    simp
  have hpmap_base : ∀ ℓ : Fin d.m,
      pmap (liftingBaseRelation π d.relations ℓ) = 0 := by
    intro ℓ
    rw [liftingBaseRelation, map_sub, hpmap_lift]
    simp [pmap, zvar]
    rw [← mul_assoc, hpi]
    simp
  have hidentity : ∀ k : Fin d.r, ∀ ℓ : Fin d.m,
      xeval (d.a k) * xeval (d.relations ℓ) =
        (∑ j : Fin (d.e k),
          xeval (d.h k ℓ j) * xeval (d.relations (d.selected k j))) +
          (algebraMap R P) (π ^ 2) * xeval (d.g k ℓ) := by
    intro k ℓ
    have h := congrArg xeval (d.relation_identity k ℓ)
    have hC : xeval (MvPolynomial.C (π ^ 2)) = (algebraMap R P) (π ^ 2) := by
      simp [xeval]
    simpa only [map_mul, map_add, map_sum, hC] using h
  have hpi2 : sinv * (algebraMap R P) (π ^ 2) = (algebraMap R P) π := by
    rw [map_pow]
    calc
      sinv * ((algebraMap R P) π) ^ 2 =
          sinv * ((algebraMap R P) π * (algebraMap R P) π) := by rw [pow_two]
      _ =
          (sinv * (algebraMap R P) π) * (algebraMap R P) π := by ring
      _ = (algebraMap R P) π := by
        rw [show sinv * (algebraMap R P) π = 1 by simpa [mul_comm] using hpi]
        simp
  have hpmap_corr : ∀ k : Fin d.r, ∀ ℓ : Fin d.m,
      pmap (liftingCorrectionRelation π d.a d.h d.g d.selected k ℓ) = 0 :=
    liftingCorrectionRelation_map_eq_zero d xeval sinv pmap hpmap_lift
      hidentity hpi2 (by simp [pmap]) (fun ℓ => by simp [pmap, zvar])
  have hkill : ∀ p ∈ liftingDefiningIdeal d, pmap p = 0 := by
    intro p hp
    have hle : liftingDefiningIdeal d ≤ Ideal.comap pmap ⊥ := by
      rw [liftingDefiningIdeal]
      apply Ideal.span_le.2
      intro x hx
      rcases hx with hx | hx
      · rcases hx with ⟨ℓ, rfl⟩
        simpa [Ideal.mem_comap] using hpmap_base ℓ
      · rcases Set.mem_iUnion.mp hx with ⟨k, hx⟩
        rcases hx with ⟨ℓ, rfl⟩
        simpa [Ideal.mem_comap] using hpmap_corr k ℓ
    exact hle hp
  let qmap : D →+* P :=
    Ideal.Quotient.lift (liftingDefiningIdeal d) pmap (by
      intro p hp
      exact hkill p hp)
  have hq_pi_eq : qmap (algebraMap R D π) = (algebraMap R P) π := by
    change pmap (MvPolynomial.C π) = _
    simp [pmap]
  have hq_pi : IsUnit (qmap (algebraMap R D π)) := by
    rw [hq_pi_eq]
    rw [IsScalarTower.algebraMap_apply R S P]
    exact IsUnit.map (algebraMap S P)
      (IsLocalization.Away.algebraMap_isUnit (R := R) (S := S) π)
  let f : L →+* P :=
    IsLocalization.Away.lift (R := D) (S := L) (g := qmap)
      (algebraMap R D π) hq_pi
  let gvar : Fin d.n → L := fun i =>
    algebraMap D L
      (Ideal.Quotient.mk (liftingDefiningIdeal d)
        (MvPolynomial.X (Sum.inl i)))
  let gmap : P →+* L := MvPolynomial.eval₂Hom smapL gvar
  have hgmap_xeval : ∀ p : MvPolynomial (Fin d.n) R,
      gmap (xeval p) =
        algebraMap D L
          (Ideal.Quotient.mk (liftingDefiningIdeal d)
            (liftLiftingPolynomial p)) := by
    have h : gmap.comp xeval =
        (algebraMap D L).comp
          ((Ideal.Quotient.mk (liftingDefiningIdeal d)).comp
            (MvPolynomial.rename Sum.inl).toRingHom) := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        simp only [RingHom.comp_apply]
        have hx : xeval (MvPolynomial.C r) =
            MvPolynomial.C ((algebraMap R S) r) := by
          simp [xeval]
          change (algebraMap S P) ((algebraMap R S) r) = _
          rw [MvPolynomial.algebraMap_apply]
          simp
        rw [hx]
        change MvPolynomial.eval₂Hom smapL gvar
            (MvPolynomial.C ((algebraMap R S) r)) = _
        rw [MvPolynomial.eval₂Hom_C, IsLocalization.Away.lift_eq]
        simp [gR, D, MvPolynomial.algebraMap_eq]
        have hmk :
            Ideal.Quotient.mk (liftingDefiningIdeal d) (MvPolynomial.C r) =
              algebraMap R D r := by
          rw [← MvPolynomial.algebraMap_eq]
          exact Ideal.Quotient.mk_algebraMap R (liftingDefiningIdeal d) r
        rw [hmk]
      · intro i
        simp only [RingHom.comp_apply]
        have hx : xeval (MvPolynomial.X i) = MvPolynomial.X i := by
          simp [xeval]
        rw [hx]
        change MvPolynomial.eval₂Hom smapL gvar (MvPolynomial.X i) = _
        rw [MvPolynomial.eval₂Hom_X']
        simp [gvar, MvPolynomial.rename_X]
    intro p
    exact RingHom.congr_fun h p
  have hpiL :
      smapL (IsLocalization.Away.invSelf π) *
          algebraMap D L (algebraMap R D π) = 1 := by
    have h := congrArg smapL
      (IsLocalization.Away.mul_invSelf (R := R) (S := S) π)
    rw [map_mul] at h
    rw [IsLocalization.Away.lift_eq π hgR _] at h
    simpa [gR, mul_comm] using h
  have hbaseD : ∀ ℓ : Fin d.m,
      algebraMap D L
          (Ideal.Quotient.mk (liftingDefiningIdeal d)
            (liftLiftingPolynomial (d.relations ℓ))) =
        algebraMap D L
          ((algebraMap R D π) *
            Ideal.Quotient.mk (liftingDefiningIdeal d)
              (MvPolynomial.X (Sum.inr ℓ))) :=
    liftingRing_localization_base_relation d
  have hgq : gmap.comp qmap = algebraMap D L := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext'
    · ext r
      have h := hgmap_xeval (MvPolynomial.C r)
      simpa [qmap, pmap, xeval, liftLiftingPolynomial,
        MvPolynomial.algebraMap_apply, MvPolynomial.algebraMap_eq] using h
    · intro v
      rcases v with i | ℓ
      · have h := hgmap_xeval (MvPolynomial.X i)
        simpa [qmap, pmap, xeval, liftLiftingPolynomial,
          MvPolynomial.rename_X] using h
      · have hsinv : gmap sinv = smapL (IsLocalization.Away.invSelf π) := by
          change MvPolynomial.eval₂Hom smapL gvar
              (MvPolynomial.C (IsLocalization.Away.invSelf π)) = _
          rw [MvPolynomial.eval₂Hom_C]
        have h := hgmap_xeval (d.relations ℓ)
        change gmap (pmap (MvPolynomial.X (Sum.inr ℓ))) = _
        simp [pmap, zvar]
        rw [hsinv, h]
        rw [hbaseD]
        calc
          smapL (IsLocalization.Away.invSelf π) *
                algebraMap D L
                  ((algebraMap R D) π *
                    Ideal.Quotient.mk (liftingDefiningIdeal d)
                      (MvPolynomial.X (Sum.inr ℓ))) =
              smapL (IsLocalization.Away.invSelf π) *
                (algebraMap D L (algebraMap R D π) *
                  algebraMap D L
                    (Ideal.Quotient.mk (liftingDefiningIdeal d)
                      (MvPolynomial.X (Sum.inr ℓ)))) := by rw [map_mul]
          _ =
              (smapL (IsLocalization.Away.invSelf π) *
                algebraMap D L (algebraMap R D π)) *
                  algebraMap D L
                    (Ideal.Quotient.mk (liftingDefiningIdeal d)
                      (MvPolynomial.X (Sum.inr ℓ))) := by ring
          _ = _ := by rw [hpiL]; simp
  have hfbase : f.comp (algebraMap D L) = qmap := by
    apply RingHom.ext
    intro x
    simp only [RingHom.comp_apply]
    rw [IsLocalization.Away.lift_eq (algebraMap R D π) hq_pi x]
  have hgf : gmap.comp f = RingHom.id L := by
    apply IsLocalization.ringHom_ext (Submonoid.powers
      (algebraMap R D π))
    change gmap.comp (f.comp (algebraMap D L)) = algebraMap D L
    rw [hfbase]
    exact hgq
  have hfS : f.comp smapL = algebraMap S P := by
    apply IsLocalization.ringHom_ext (Submonoid.powers π)
    apply RingHom.ext
    intro r
    simp only [RingHom.comp_apply]
    rw [IsLocalization.Away.lift_eq π hgR r]
    change f (gR r) = _
    rw [show gR r = algebraMap D L (algebraMap R D r) by rfl]
    rw [IsLocalization.Away.lift_eq (algebraMap R D π) hq_pi
      (algebraMap R D r)]
    change qmap (algebraMap R D r) = _
    change pmap (MvPolynomial.C r) = _
    simp [pmap]
    exact IsScalarTower.algebraMap_apply R S P r
  have hfg : f.comp gmap = RingHom.id P := by
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro s
      simp only [RingHom.comp_apply]
      change f (gmap (MvPolynomial.C s)) = MvPolynomial.C s
      have hgC : gmap (MvPolynomial.C s) = smapL s := by
        change MvPolynomial.eval₂Hom smapL gvar
          (MvPolynomial.C s) = _
        rw [MvPolynomial.eval₂Hom_C]
      rw [hgC]
      have hs := congrArg (fun h => h s) hfS
      change f (smapL s) = (algebraMap S P) s at hs
      rw [MvPolynomial.algebraMap_apply] at hs
      exact hs
    · intro i
      have hfvar : f (gvar i) = MvPolynomial.X i := by
        change f (algebraMap D L
          (Ideal.Quotient.mk (liftingDefiningIdeal d)
            (MvPolynomial.X (Sum.inl i)))) = _
        rw [IsLocalization.Away.lift_eq (algebraMap R D π) hq_pi]
        change qmap (Ideal.Quotient.mk (liftingDefiningIdeal d)
          (MvPolynomial.X (Sum.inl i))) = _
        change pmap (MvPolynomial.X (Sum.inl i)) = _
        simp [pmap]
      simp only [RingHom.comp_apply]
      change f (gmap (MvPolynomial.X i)) = MvPolynomial.X i
      rw [MvPolynomial.eval₂Hom_X']
      exact hfvar
  let e : L ≃+* P := RingEquiv.ofBijective f ⟨by
    intro x y hxy
    calc
      x = gmap (f x) := by
        have h := congrArg (fun h => h x) hgf
        simpa using h.symm
      _ = gmap (f y) := by rw [hxy]
      _ = y := by
        have h := congrArg (fun h => h y) hgf
        simpa using h, by
    intro y
    refine ⟨gmap y, ?_⟩
    have h := congrArg (fun h => h y) hfg
    simpa using h⟩
  have hcomm : ∀ r : R,
      e (algebraMap R L r) = (algebraMap R P) r := by
    intro r
    change f (algebraMap R L r) = _
    change f (algebraMap D L (algebraMap R D r)) = _
    rw [IsLocalization.Away.lift_eq (algebraMap R D π) hq_pi
      (algebraMap R D r)]
    change qmap (algebraMap R D r) = _
    change pmap (MvPolynomial.C r) = _
    simp [pmap]
  exact ⟨{ equivalence := e, commutes := hcomm }⟩

/-- Inverting `π` identifies `D` with a polynomial algebra over `R[1/π]`. -/
theorem liftingRing_localization_smooth
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) :
    Algebra.Smooth R
      (Localization.Away (algebraMap R (liftingRing d) π)) := by
  let L := Localization.Away (algebraMap R (liftingRing d) π)
  let S := Localization.Away π
  let P := MvPolynomial (Fin d.n) S
  let _ : Algebra R P := Algebra.compHom P (algebraMap R S)
  let _ : IsScalarTower R S P :=
    IsScalarTower.of_algebraMap_eq (fun r => rfl)
  obtain ⟨edata⟩ := liftingRing_localization_algEquiv_aux d
  let ae : L ≃ₐ[R] P :=
    AlgEquiv.ofRingEquiv (f := edata.equivalence) edata.commutes
  have hSR : Algebra.Smooth R S := by
    exact Formalization.Books.Algebra.Unit137.smooth_localization
      (R := R) (S := R) π
  have hSP : Algebra.Smooth S P := by
    let hfp : Algebra.FinitePresentation S S :=
      Algebra.FinitePresentation.self _
    exact ⟨Algebra.instFormallySmoothMvPolynomial
        (R := S) (Fin d.n),
      @Algebra.FinitePresentation.mvPolynomial
        S S _ _ _ hfp (Fin d.n) inferInstance⟩
  have hRP : Algebra.Smooth R P := by
    exact @Algebra.Smooth.comp R _ S P _ _ _ _ _ _ hSR hSP
  have hformL : Algebra.FormallySmooth R L :=
    @Algebra.FormallySmooth.of_equiv R _ P L _ _ _ _ hRP.1 ae.symm
  have hfpL : Algebra.FinitePresentation R L :=
    @Algebra.FinitePresentation.equiv R P L _ _ _ _ _ hRP.2 ae.symm
  exact { formallySmooth := hformL, finitePresentation := hfpL }

/-- The explicit inverse pair underlying the localization smoothness proof. -/
private theorem liftingRing_localization_equiv_aux
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) :
    Nonempty
      (Localization.Away (algebraMap R (liftingRing d) π) ≃+*
        MvPolynomial (Fin d.n) (Localization.Away π)) := by
  obtain ⟨e⟩ := liftingRing_localization_algEquiv_aux d
  exact ⟨e.equivalence⟩

/-- The explicit polynomial presentation of `D[1/π]` used in the proof of (b). -/
theorem liftingRing_localization_equiv
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) :
    Nonempty
      (Localization.Away (algebraMap R (liftingRing d) π) ≃+*
        MvPolynomial (Fin d.n) (Localization.Away π)) := by
  exact liftingRing_localization_equiv_aux d

/-- The source's property (b) for the explicit construction. -/
theorem liftingRing_smoothAt_of_pi_not_mem
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (q : PrimeSpectrum (liftingRing d))
    (hq : algebraMap R (liftingRing d) π ∉ q.asIdeal) :
    Formalization.Books.Algebra.Unit137.IsSmoothAt R (liftingRing d) q := by
  exact ⟨algebraMap R (liftingRing d) π, hq, liftingRing_localization_smooth d⟩

/-- The source's local smoothness conclusion for the auxiliary ring, assuming
the selected basic open of the presented `\bar C` is smooth. -/
theorem liftingAuxiliaryRing_smoothAt_of_good_prime
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r)
    (q : PrimeSpectrum (liftingAuxiliaryRing d k))
    (hbase :
      Algebra.Smooth (piQuotient R (π ^ 2))
        (Localization.Away (liftingPresentationElement d k)))
    (hAnnR :
      annihilatorOf (R := R) (M := R) π =
        annihilatorOf (R := R) (M := R) (π ^ 2))
    (hπ : algebraMap R (liftingAuxiliaryRing d k) π ∈ q.asIdeal)
    (ha : liftingAuxiliaryElement d k ∉ q.asIdeal) :
    Formalization.Books.Algebra.Unit137.IsSmoothAt R
      (liftingAuxiliaryRing d k) q := by
  sorry

/-- The final local-ring identification `D_{q} = (D_k)_{q_k}`.  The
annihilator equality and smoothness of `Dₖ` supply the flatness used in the
source's cancellation argument. -/
theorem liftingAuxiliary_localRing_equiv
    {R : Type u} [CommRing R] {π : R}
    (d : LiftingConstructionData R π) (k : Fin d.r)
    (q : PrimeSpectrum (liftingRing d))
    (qk : PrimeSpectrum (liftingAuxiliaryRing d k))
    (hcomap : PrimeSpectrum.comap (liftingAuxiliaryToLiftingRing d k) q = qk)
    (hAnnR :
      annihilatorOf (R := R) (M := R) π =
        annihilatorOf (R := R) (M := R) (π ^ 2))
    (hSmoothK :
      Formalization.Books.Algebra.Unit137.IsSmoothAt R
        (liftingAuxiliaryRing d k) qk)
    (hπ : algebraMap R (liftingRing d) π ∈ q.asIdeal)
    (ha : liftingElement d (d.a k) ∉ q.asIdeal) :
    Nonempty
      (Localization.AtPrime qk.asIdeal ≃+*
        Localization.AtPrime q.asIdeal) := by
  sorry

/-! ## The intrinsic lifting diagram -/

/-- The quotient maps and commutativities in the lifting diagram. -/
structure LiftingDiagram
    {R Λ Cbar D : Type u} [CommRing R] [CommRing Λ] [CommRing Cbar]
    [CommRing D] [Algebra R Λ] [Algebra R D]
    (π : R) [Algebra (piQuotient R (π ^ 2)) Cbar]
    (hbar : Cbar →+* piQuotient Λ ((algebraMap R Λ π) ^ 2))
    (φ : D →ₐ[R] Λ) where
  rToD : piQuotient R π →+* piQuotient D (algebraMap R D π)
  cbarToD : Cbar →+* piQuotient D (algebraMap R D π)
  cbarModToD :
    piQuotient Cbar
        (quotientAlgebraMap (R := R) (A := Cbar)
          (Ideal.span ({π ^ 2} : Set R)) π) →+*
      piQuotient D (algebraMap R D π)
  dToLambda :
    piQuotient D (algebraMap R D π) →+* piQuotient Λ (algebraMap R Λ π)
  rToD_fac :
    rToD.comp (piQuotientMk π) =
      (piQuotientMk (algebraMap R D π)).comp (algebraMap R D)
  cbarModToD_fac :
    cbarModToD.comp
        (piQuotientMk
          (quotientAlgebraMap (R := R) (A := Cbar)
            (Ideal.span ({π ^ 2} : Set R)) π)) =
      cbarToD
  dToLambda_fac :
    dToLambda.comp (piQuotientMk (algebraMap R D π)) =
      (piQuotientMk (algebraMap R Λ π)).comp φ.toRingHom
  left_commutes :
    cbarToD.comp (algebraMap (piQuotient R (π ^ 2)) Cbar) =
      rToD.comp (piSquaredToPi π)
  right_commutes :
    dToLambda.comp cbarToD =
      (piSquaredToPi (algebraMap R Λ π)).comp hbar

/-- A prime of `D` lies over a prime of `\bar C` through the mod-`π` diagram. -/
def LiftingPrimeOver
    {R Λ Cbar D : Type u} [CommRing R] [CommRing Λ] [CommRing Cbar]
    [CommRing D] [Algebra R Λ] [Algebra R D]
    {π : R} [Algebra (piQuotient R (π ^ 2)) Cbar]
    {hbar : Cbar →+* piQuotient Λ ((algebraMap R Λ π) ^ 2)}
    {φ : D →ₐ[R] Λ}
    (diagram : LiftingDiagram π hbar φ)
    (p : PrimeSpectrum Cbar) (q : PrimeSpectrum D) : Prop :=
  quotientAlgebraMap (R := R) (A := Cbar)
      (Ideal.span ({π ^ 2} : Set R)) π ∈ p.asIdeal ∧
    algebraMap R D π ∈ q.asIdeal ∧
    ∃ (pbar : PrimeSpectrum
        (piQuotient Cbar
          (quotientAlgebraMap (R := R) (A := Cbar)
            (Ideal.span ({π ^ 2} : Set R)) π)))
      (qbar : PrimeSpectrum (piQuotient D (algebraMap R D π))),
      PrimeSpectrum.comap
          (piQuotientMk
            (quotientAlgebraMap (R := R) (A := Cbar)
              (Ideal.span ({π ^ 2} : Set R)) π)) pbar = p ∧
        PrimeSpectrum.comap (piQuotientMk (algebraMap R D π)) qbar = q ∧
        PrimeSpectrum.comap diagram.cbarModToD qbar = pbar

/-- Smoothness at a prime of a ring map, using its canonical algebra structure. -/
def IsSmoothAtRingHom
    {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B)
    (q : PrimeSpectrum B) : Prop :=
  letI : Algebra A B := f.toAlgebra
  Formalization.Books.Algebra.Unit137.IsSmoothAt A B q

/-! ## The lifting lemma -/

/-- Elkik's lifting lemma, including its commutative quotient diagram and all
four local properties stated in the source. -/
theorem lifting_lemma
    {R Λ Cbar : Type u} [CommRing R] [CommRing Λ] [CommRing Cbar]
    [Algebra R Λ] [IsNoetherianRing R]
    (π : R) [Algebra (piQuotient R (π ^ 2)) Cbar]
    [Algebra.FinitePresentation (piQuotient R (π ^ 2)) Cbar]
    (hAnnR :
      annihilatorOf (R := R) (M := R) π =
        annihilatorOf (R := R) (M := R) (π ^ 2))
    (hAnnΛ :
      annihilatorOf (R := Λ) (M := Λ) (algebraMap R Λ π) =
        annihilatorOf (R := Λ) (M := Λ) ((algebraMap R Λ π) ^ 2))
    (hbar : Cbar →+* piQuotient Λ ((algebraMap R Λ π) ^ 2))
    (hbar_algebra :
      hbar.comp
          (quotientAlgebraMap (R := R) (A := Cbar)
            (Ideal.span ({π ^ 2} : Set R))) =
        (piQuotientMk ((algebraMap R Λ π) ^ 2)).comp (algebraMap R Λ)) :
    ∃ (D : Type u) (hD : CommRing D) (hRD : Algebra R D),
      letI : CommRing D := hD
      letI : Algebra R D := hRD
      ∃ (φ : D →ₐ[R] Λ),
        ∃ (diagram : LiftingDiagram π hbar φ),
          Algebra.FinitePresentation R D ∧
          (∀ q : PrimeSpectrum D,
            algebraMap R D π ∉ q.asIdeal →
              Formalization.Books.Algebra.Unit137.IsSmoothAt R D q) ∧
          (∀ (p : PrimeSpectrum Cbar) (q : PrimeSpectrum D),
            LiftingPrimeOver diagram p q →
              Formalization.Books.Algebra.Unit137.IsSmoothAt
                (piQuotient R (π ^ 2)) Cbar p →
                Formalization.Books.Algebra.Unit137.IsSmoothAt R D q) ∧
          (∀ (pbar : PrimeSpectrum
              (piQuotient Cbar
                (quotientAlgebraMap (R := R) (A := Cbar)
                  (Ideal.span ({π ^ 2} : Set R)) π)))
              (qbar : PrimeSpectrum (piQuotient D (algebraMap R D π))),
            PrimeSpectrum.comap diagram.cbarModToD qbar = pbar →
            Formalization.Books.Algebra.Unit137.IsSmoothAt
              (piQuotient R (π ^ 2)) Cbar
              (PrimeSpectrum.comap
                (piQuotientMk
                  (quotientAlgebraMap (R := R) (A := Cbar)
                    (Ideal.span ({π ^ 2} : Set R)) π)) pbar) →
            IsSmoothAtRingHom diagram.cbarModToD qbar) := by
  sorry

end

end Formalization.Books.Smoothing.Unit06
